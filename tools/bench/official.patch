+// Benchmark patch: the trace of the port (PINGUS_TRACE=1), with the time
+// of the port (updates done before the current one).
+void
+bench_trace(Pingu* p, const char* act)
+{
+  if (getenv("PINGUS_TRACE") && p->get_world()) {
+    printf("%5d pingu %2u %-9s %4d %4d\n", p->get_world()->get_time(), p->get_id(),
+           act, static_cast<int>(p->get_x()), static_cast<int>(p->get_y()));
+  }
+}
