@@ -38,6 +40,14 @@ std::unique_ptr<Framebuffer> Display::s_framebuffer;
 void
 Display::flip_display()
 {
+  // Benchmark patch: frames drawn, printed at exit (PINGUS_COUNT=1)
+  static int frames = 0;
+  static bool registered = false;
+  if (!registered && getenv("PINGUS_COUNT")) {
+    registered = true;
+    atexit([]() { fprintf(stderr, "frames: %d\n", frames); });
+  }
+  frames++;
   return s_framebuffer->flip();
 }
 
