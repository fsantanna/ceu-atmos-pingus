;; Digger: digs down, one radius every 4 ticks (the 4th, 8th, ...).

func digger_something (p) {
    match rel(p, 0, -1) {
        GP.nothing => false
        GP.solid   => do {
            sound "chink"
            false
        }
        else => true
    }
}

func digger_dig (p, final) {
    val r = res_surface("pingus/common/digger_radius")
    val gfx = if final => res_surface("pingus/common/digger_radius_final_gfx") =>
                          res_surface("pingus/common/digger_radius_gfx")
    val col = if final => gfx => r
    val w, h = pg.size(r)
    ground_remove(gfx, col, trunc(p.x) - (w//2), trunc(p.y) - h + 2)
    set p.x = trunc(p.x)
    set p.y = trunc(p.y) + 1
}

task Digger (p, g) {
    spawn Sprite(pspr(p, "digger/left"), p, PSPR1)
    loop {
        loop k in 4 {
            await :tick
            val px = rel(p, 0, -1)
            if (px == GP.water) || (px == GP.lava) {
                return :drown
            }
            if !digger_something(p) {
                digger_dig(p, true)
                return :walker
            }
            if k == 3 {
                digger_dig(p, false)
            }
        }
    }
}
