;; Basher: bashes horizontally, while there is something to bash.

val BASHER_MIN_HEIGHT = 5
val BASHER_MAX_HEIGHT = 33
val BASHER_MAX_DOWN   = 3

func basher_bash (p) {
    val gfx = res_surface("pingus/common/bash_radius_gfx")
    val col = res_surface("pingus/common/bash_radius")
    val w, h = pg.size(col)
    ground_remove(gfx, col, trunc(p.x) - (w//2), trunc(p.y) - h + 1)
}

;; Something to bash within reach.
func basher_something (p) {
    val w, h = pg.size(res_surface("pingus/common/bash_radius"))
    loop x in w {
        val y = loop y in (BASHER_MIN_HEIGHT, BASHER_MAX_HEIGHT) {
            until rel(p, x, y) == GP.ground, true
        }
        until y, true
    } || false
}

;; One step forward, down up to 3 pixels. False to fall.
func basher_walk (p) {
    val down = loop i in (0, BASHER_MAX_DOWN) {
        until rel(p, 0, -i-1) != GP.nothing, [i]
    }
    if down {
        set p.x += p.dir
        set p.y += down@0
        true
    } else {
        false
    }
}

task Basher (p, g) {
    spawn Sprite(pspr(p, "basher"), p, PSPR)
    basher_bash(p)
    ;; a step every 3 ticks, a bash every 2 steps; with nothing to bash,
    ;; it stops past 60% of its cycle of 12 frames of 100ms (the frame
    ;; comes from the ticks of the loop, as the clock of the original)
    loop i {
        await Ticks(3)
        val c = 3 * (i + 1)
        if !basher_walk(p) {
            return :faller
        }
        val px = rel(p, 0, -1)
        ifs {
            (px == GP.water) || (px == GP.lava) => return :drown
            px != GP.nothing => {
                ifs {
                    (rel(p, 0, 0) == GP.solid) || (rel(p, 0, PINGU.height) == GP.solid) => {
                        sound "chink"
                        turn(p)
                        return :walker
                    }
                    basher_something(p) => {
                        if (c % 2) == 0 {
                            basher_bash(p)
                        }
                    }
                    ((((33 * c) // 100) % 12) / 12) > 0.6 => return :walker
                    else => nil
                }
            }
            else => nil
        }
    }
}
