;; Basher: bashes horizontally, while there is something to bash.

val BASHER_MIN_HEIGHT = 5
val BASHER_MAX_HEIGHT = 33
val BASHER_MAX_DOWN   = 3

func basher_bash (p) {
    val gfx = res_surface("pingus/common/bash_radius_gfx")
    val col = res_surface("pingus/common/bash_radius")
    val w, h = pg.size(col)
    ground_remove(gfx, col, p.x - (w//2), p.y - h + 1)
}

;; Something to bash within reach.
func basher_something (p) {
    val w, h = pg.size(res_surface("pingus/common/bash_radius"))
    loop x in w {
        val y = loop y in (BASHER_MIN_HEIGHT, BASHER_MAX_HEIGHT) {
            until rel(p, x, y) == GP.ground, true
        }
        until y, true
    } || false
}

;; One step forward, down up to 3 pixels. False to fall.
func basher_walk (p) {
    val down = loop i in (0, BASHER_MAX_DOWN) {
        until rel(p, 0, -i-1) != GP.nothing, [i]
    }
    if down {
        set p.x += p.dir
        set p.y += down@0
        true
    } else {
        false
    }
}

task Basher (p, g) {
    val n = do {
        val d = res_desc(pspr(p, "basher/left"))
        d.array@0 * d.array@1
    }
    spawn Sprite(pspr(p, "basher"), p, PSPR)
    basher_bash(p)

    ;; with nothing to bash, it stops at 60% of the animation
    par :any {
        await :frame until (it.n > (n * 0.6)) && !basher_something(p)
        :walker
    } with {
        loop {
            loop k in 2 {
                await Ticks(3)
                if !basher_walk(p) {
                    return :faller
                }
                if rel(p, 0, -1) != GP.nothing {
                    if (rel(p, 0, 0) == GP.solid) || (rel(p, 0, PINGU.height) == GP.solid) {
                        sound "chink"
                        turn(p)
                        return :walker
                    }
                    if (k == 1) && basher_something(p) {
                        basher_bash(p)
                    }
                }
            }
        }
    }
}
