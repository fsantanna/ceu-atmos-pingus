;; Jumper: jumps forward, or off the wall if it was climbing.

task Jumper (p, g, prev) {
    spawn Sprite(pspr(p, "jumper"), p, PSPR)
    await :tick
    if prev == :climber {
        turn(p)
    }
    set p.vx = vel(p.vx + pg.f32(4.58 * p.dir))
    set p.vy = vel(p.vy - pg.f32(4.58))
    set p.y -= 1
    :faller
}
