;; Jumper: jumps forward, or off the wall if it was climbing.

task Jumper (p, g, prev) {
    spawn Sprite(pspr(p, "jumper"), p, PSPR)
    await :tick
    if prev == :climber {
        turn(p)
    }
    set p.vx = clamp(p.vx + (4.58 * p.dir), -PINGU.terminal, PINGU.terminal)
    set p.vy = clamp(p.vy - 4.58, -PINGU.terminal, PINGU.terminal)
    set p.y -= 1
    :faller
}
