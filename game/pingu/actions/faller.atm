;; Faller: falls with gravity, bounces off walls, and lands: as a walker
;; (or as a blocker again), or drowns, or splashes if it falls too fast.
;; With the floater ability, it floats.
;;
;; The landing is decided in the same tick as the collision, as in the
;; original. (The Céu rewrite waited one tick, a workaround of the order
;; of its mover and its pingu.)

func tumbling (p) {
    (math.abs(p.vx) > PINGU.deadly) || (math.abs(p.vy) > PINGU.deadly)
}

task Faller (p, g, prev) {
    spawn {
        watching :tick until tumbling(p) {
            await Sprite(pspr(p, "faller"), p, PSPR)
        }
        await Sprite(pspr(p, "tumbler"), p, PSPR)
    }
    loop on :tick {
        if (p.vy > 5.0) && p.fall {
            return p.fall
        }
        set p.vy = vel(p.vy + PINGU.gravity)
        if move(p) {
            ifs {
                (rel(p,0,-1) == GP.nothing) && (rel(p,0,-2) == GP.nothing) &&
                (rel(p,0,-3) == GP.nothing) && (rel(p,1,0) != GP.nothing) &&
                (rel(p,1,0) != GP.bridge) => {
                    ;; a wall: bounces off it
                    set p.vx = vel(-(p.vx / 3.0))
                    set p.dir = if p.vx > 0.0 => 1 => -1
                }
                p.vy > 0.0 => {
                    ;; the ground, the water, or too fast
                    val px = rel(p, 0, -1)
                    return ifs {
                        (px == GP.water) || (px == GP.lava) => :drown
                        math.abs(p.vy) > PINGU.deadly       => :splashed
                        prev == :blocker                    => :blocker
                        else                                => :walker
                    }
                }
                else => {
                    ;; the ceiling
                    set p.vy = 0.0
                    set p.vx = vel(p.vx / 3.0)
                }
            }
        }
    }
}
