;; Faller: falls with gravity, bounces off walls, and lands as a walker
;; (or as a blocker again). With the floater ability, it floats.
;;
;; The Mover moves the pingu and signals collisions. The collision is
;; handled one tick later, so that the danger of hitting the ground too
;; fast (in the Pingu task) is checked first, as in the original.

func tumbling (p) {
    (math.abs(p.vx) > PINGU.deadly) || (math.abs(p.vy) > PINGU.deadly)
}

task Faller (p, g, prev) {
    spawn {
        watching :tick until tumbling(p) {
            await Sprite(pspr(p, "faller"), p, PSPR)
        }
        await Sprite(pspr(p, "tumbler"), p, PSPR)
    }
    par :any {
        loop on :tick {
            if (p.vy > 5.0) && p.fall {
                return p.fall
            }
            set p.vy += PINGU.gravity
        }
    } with {
        await Mover(p)
    } with {
        loop {
            await :collided
            await :tick
            ifs {
                (rel(p,0,-1) == GP.nothing) && (rel(p,0,-2) == GP.nothing) &&
                (rel(p,0,-3) == GP.nothing) && (rel(p,1,0) != GP.nothing) &&
                (rel(p,1,0) != GP.bridge) => {
                    ;; a wall: bounces off it
                    set p.vx = -(p.vx / 3.0)
                    set p.dir = if p.vx > 0.0 => 1 => -1
                }
                p.vy > 0.0 => {
                    ;; the ground
                    return (if prev == :blocker => :blocker => :walker)
                }
                else => {
                    ;; the ceiling
                    set p.vy = 0.0
                    set p.vx = p.vx / 3.0
                }
            }
        }
    }
}
