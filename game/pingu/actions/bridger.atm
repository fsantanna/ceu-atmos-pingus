;; Bridger: builds up to 15 bricks, and walks up each one.

val BRIDGER_BRICKS = 15

;; The way ahead is free to walk up the bridge.
func bridger_free (p) {
    val blocked = loop _, x in [1, 2, 3, 4] {
        until (rel(p, x, 2) != GP.nothing) || head(p, x, 2), true
    }
    !blocked
}

func bridger_brick (p, left) {
    if left < 4 {
        sound "ting"
    }
    if p.dir == 1 {
        val b = res_surface("other/brick_right")
        val w, h = pg.size(b)
        ground_put(b, p.x + 10 - w, p.y, GP.bridge)
    } else {
        ground_put(res_surface("other/brick_left"), p.x - 10, p.y, GP.bridge)
    }
}

task Bridger (p, g) {
    loop i in (1, BRIDGER_BRICKS) {
        set p.bricks = BRIDGER_BRICKS - i
        ;; BUILDING: the brick is placed at the frame 7
        pin s = spawn Sprite(pspr(p, "bridger"), p, PSPR)
        await :frame until it.n == 7
        if head(p, 0, 2) {
            turn(p)
            return :walker
        }
        bridger_brick(p, BRIDGER_BRICKS - i)
        await(s)

        ;; the last brick has no walk
        if i == BRIDGER_BRICKS {
            return :waiter
        }

        ;; WALKING: one step up the bridge
        await Sprite(pspr(p, "bridger_walk"), p, PSPR)
        if !bridger_free(p) {
            turn(p)
            return :walker
        }
        set p.x += 4 * p.dir
        set p.y -= 2
    }
}
