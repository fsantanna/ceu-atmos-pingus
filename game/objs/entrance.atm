;; Entrance: releases the pingus, at a rate, until all are out or the
;; armageddon starts. The first one comes after 3 seconds, for the
;; "let's go" sound.

task Entrance (g, o) {
    val x, y = o.position@0, o.position@1
    val owner = if (o.owner_id ?? :number) && (o.owner_id >= 0) && (o.owner_id <= 3) =>
                    o.owner_id => 0
    val rate = o.release_rate || 150
    ;; "misc" alternates: right, left, ...
    val dirs = match o.direction {
        :left  => [-1]
        :right => [1]
        else   => [1, -1]
    }
    watching :game.armageddon {
        await Ticks(150)
        loop {
            loop _, d in dirs {
                if pingu_in(g) {
                    spawn @(g.pingus) Pingu(g, x, y, d, owner)
                }
                await Ticks(rate)
            }
        }
    }
}
