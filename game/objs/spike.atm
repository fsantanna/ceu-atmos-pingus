;; Spike: comes out when a pingu walks over it, and kills the pingus
;; that are over it at its frame 3. As the original, it is hidden while
;; idle, and its timing is its own clock (14 frames of 100ms, looping),
;; counted from the ticks of its loop: it kills while the frame is 3, and
;; rests at the frame 13.

func spike_kill (g, pos) {
    loop _, t in g.pingus {
        if in_zone(pos, t.pub, 16-12, 0, 16+12, 32) {
            emit @t :pingu.set [act=:dead]
        }
    }
}

task Spike (g, o) {
    val pos = [x=o.position@0, y=o.position@1]
    loop {
        await :tick until zone_any(g, pos, 16-5, 0, 16+5, 32)
        par :any {
            await Sprite("traps/spike", pos, [world=true, cycle=true])
        } with {
            loop k {
                await :tick
                val f = ((33 * (k + 1)) // 100) % 14
                if f == 3 {
                    spike_kill(g, pos)
                }
                until f == 13
            }
        }
    }
}
