;; Levels: reading a converted level, and resolving its prefabs and
;; groups into a flat list of objects.
;;
;; A prefab is a file of objects, placed at a position, with fields
;; that the level may override (as `OverrideFileReader` of the
;; original). A group is a list of objects. Both are expanded here, so
;; that the game only sees the objects it creates.

;; The kinds of objects that the game implements, and the actions.
val OBJS_KNOWN = [
    :entrance, :exit, :groundpiece, :guillotine, :hotspot, :laser_exit,
    :liquid, :smasher, :spike, :surface_background,
]

func level_load (path) {
    val lvl = data_load(path)
    ;; a name in pieces, as `""Crystal-Desert" Temple"` of a level
    val n = lvl.head.levelname
    set lvl.head.levelname = ifs {
        n == nil     => path
        n ?? :table  => vector.join(n, '"')
        else         => n
    }
    ;; texts in many strings, or with none
    loop _, k in [:description, :author, :comment] {
        val v = lvl.head@(k)
        set lvl.head@(k) = ifs {
            v == nil    => ""
            v ?? :table => vector.join(v, "")
            else        => tostring(v)
        }
    }
    lvl
}

;; The objects of a list, with the offset `dx,dy` and the overrides
;; `ov`, appended to `out`.
func level_flatten (objs, dx, dy, ov, out) {
    loop _, o in objs {
        val obj = if ov => (o ++ ov) => o
        match obj {
            :group => level_flatten(obj.objects, dx, dy, nil, out)
            :prefab => do {
                val name = string.sub(obj.name, #"prefabs/")
                val pf = data_load("data/prefabs/" ++ name ++ ".prefab.atm")
                val pos = obj.position || [0, 0, 0]
                level_flatten(pf.objects, dx + pos@0, dy + pos@1, obj.overrides, out)
            }
            else => do {
                val c = X.copy(obj)
                set c.tag = obj.tag
                if c.position {
                    set c.position = [
                        ;; reals, as the original: a pingu starts at the
                        ;; real position of its entrance
                        c.position@0 + dx,
                        c.position@1 + dy,
                        c.position@2 || 0,
                    ]
                }
                vector.insert(out, c)
            }
        }
    }
    out
}

;; The depth of an object: the third coordinate of its position, or a
;; fixed one for some kinds, as the official game.
val OBJ_Z = [
    solidcolor_background = -10, starfield_background = -10,
    snow_generator = 1000, rain_generator = 1000,
    switchdoor_door = 100, switchdoor_switch = 100,
]

func obj_z (o) {
    OBJ_Z@(o.tag) || (o.position && o.position@2) || 0
}

;; The objects of a level, flat, in the order of their depth, as the
;; official game sets them up (a stable sort: the order of the file for
;; the same depth). The ground, water and holes depend on this order.
func level_objects (lvl) {
    val v = level_flatten(lvl.objects, 0, 0, nil, [])
    vector.sort(v, \(a, b) { obj_z(a) < obj_z(b) })
    v
}

;; The time of the level in ticks of the world (20ms), as a text.
func time_str (ticks) {
    if ticks < 0 {
        tr("unlimited")
    } else {
        val secs = (ticks * 20) // 1000
        string.format("%2d:%02d", secs // 60, secs % 60)
    }
}
