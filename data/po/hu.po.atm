        @"Miner" = "Bányászó",
        @"Slider" = "Csúszó",
        @"Smashed" = "Nyomi",
        @"Splashed" = "Szétplaccsant",
        @"Superman" = "Szuperman!",
        @"Teleported" = "Teleportált",
        @"Waiter" = "Váró",
        @"Walker" = "Sétáló",
        @"skip" = "kihagyás",
        @"Number of Pingus: " = "Pingvinek száma: ",
        @"Number to Save: " = "Megmentendőek: ",
        @"Time: " = "Idő: ",
        @"Author: " = "Szerző: ",
        @"Close" = "Bezár",
        @"Resolution:" = "Felbontás:",
        @"Language:" = "Nyelv:",
        @"Sound Volume:" = "Hangerő:",
        @"Music Volume:" = "Zene hangerő:",
        @"Option Menu" = "Beállítások menü",
        @"Story" = "Történet",
        @"..:: Start the game ::.." = "..:: Játék indítása ::..",
        @"Editor" = "Szerkesztő",
        @"..:: Create your own levels ::.." = "..:: Saját pályák készítése ::..",
        @"Levelsets" = "Pályacsomagok",
        @"..:: Play User Built levels ::.." = "..:: Felhasználók által készített pályákon játszás ::..",
        @"..:: Bye, bye ::.." = "..:: Pá, pá! ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: egér megfogása  ::  F10: fps számláló  ::  F11: teljes képernyő  ::  F12: képernyőmentés ::..",
        @"Retry" = "Újrapróbál",
        @"Success!" = "Siker!",
        @"Failure!" = "Kudarc!",
        @"Perfect! You saved everyone possible - great!" = "Tökéletes! Mindenkit megmentettél!",
        @"No-one got killed, pretty good work." = "Senki se halt meg, igen jó munka.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Pont annyit mentettél meg, amenyit kellett -\nmost megcsináltad, de talán jobban is teljesíthetnél",
        @"Not everybody was saved, but still good work!" = "Nem mindenkit sikerült megmenteni, de így is jó munka!",
        @"What can I say, you made it - congratulations!" = "Amit csak tudok mondani, azt megcsinálod - gratulálok!",
        @"You killed everybody, not good." = "Mindenkit megöltél, ez így nem jó.",
        @"No-one got saved - I know you can do better." = "Senkit se mentettél meg - tudom hogy többre is képes vagy.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Nem mentettél meg eleget, viszont sikerült megmenteni egy párat.\nLegközelebb lehet hogy jobban sikerül.",
        @"Only one more and you would have made it - try again!" = "Csak még egy kellet volna, hogy megcsináld - próbáld meg újból!",
        @"Only a handful more and you would have made it - try again!" = "Csak egy maréknyival kelett volna több - próbáld újra!",
        @"Better luck next time!" = "Több szerencsét legközelebb!",
        @"Saved: " = "Megmentve: ",
        @"Died: " = "Meghalt: ",
        @"Time left: " = "Hátralévő idő: ",
        @"Solved:" = "Megoldva:",
        @"levels" = "pálya",
        @"Show Ending?" = "Befejezés megmutatása?",
        @"Leave?" = "Elhagyás?",
        @"Displays this help" = "Eme súgóüzenet megjelenítése",
        @"Print version number and exit" = "Verziószám kiírása, majd kilépés",
        @"Start in Window Mode" = "Indítás ablakos módban",
        @"Start in Fullscreen" = "Indítás teljes képernyős módban",
        @"Enable software cursor" = "Szoftveres kurzor engedélyezése",
        @"Disable automatic scrolling" = "Automatikus görgetés letiltása",
        @"Disable sound" = "Hang letiltása",
        @"Disable music" = "Zene letiltása",
        @"Select language to use with Pingus" = "Pingus által használandó nyelv kiválasztása",
        @"List all available languages" = "Összes lehetséges nyelv listázása",
        @"Loads the level editor" = "Betölti a pályaszerkesztőt",
        @"Don't read ~/.pingus/config" = "Ne olvassa be a ~/.pingus/config fájlt",
        @"FILE" = "FILE",
        @"Uses the controller given in FILE" = "FÁJLban megadot controller használata",
        @"Set the game speed (0=fastest, >0=slower)" = "Játék sebességének beállítása (0: leggyorsabb; >0: lassabb)",
        @"Set the size of the map tiles (default: 32)" = "Térkép-csempék méretének beállítása (alapértelmezett: 32)",
        @"Pingus: Out of memory!" = "Pingus: Kifogyott a memória!",
        @"Pingus: Standard exception caught!:\n" = "Pingus: Normál hiba történt!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: Ismeretlen hiba történt!",
        @"unlimited" = "végtelen",
        @"Screenshot: Saving screenshot to: " = "Képernyőmentés: Mentés ide: ",
        @"Screenshot: Screenshot is done." = "Képernyőmentés: Képernyőmentés sikeresen elkészült.",
        @"Screenshot: Couldn't write file: " = "Képernyőmentés: Nem sikerült írni a fájlba: ",
        @"If the way is blocked, bash away" = "Ha az út blokkolva van, törd át",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "Hasonlóan az ásó utasításhoz, amit már előzőleg megismertél, van egy másik utasítás, amitől a Pingu vízszintesen fog ásni, az ásó függőlegességével ellentétben. Ezt az utasítást vízszintes ásónak hívják. ",
        @"Sacrifice a few and save the rest" = "Néhány feláldozása a többiek megmentéért",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Néha, mikor semmi más utasítás nem érhető el, akkor át kell bombáznod az utat a földön keresztül. Ezt a Pinguk úgy teszik, hogy felrobbantják magukat. Ettől ők meghalnak, de néha szükséges, hogy feláldozzunk egy párat a többiek megmentésének az érdekében. ",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Ez az első küldetésed. Mint mindig, ez igen egyszerű. Összvissz annyit kell tenned hogy egy Pingunak azt az utasításd adod, hogy ásson egy gödröt a fölbe, és így elérjék a kijáratot. Ezt úgy érheted el, hogy rákattintasz egy Pingura. ",
        @"Float or Die" = "Repülj, vagy meghalsz",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "A jól teljesített első küldetésed után lássuk a következőt! Most a Pingukat egy kicsi propellerel fogod ellátni, amelynek következtében simán elszállnak a földig. Ha egy Pingu túl magasról esik le propeller nélkül, akkor meghal, szóval tartsd a szemed nyitva! ",
        @"Jump for joy" = "Ugrálás az örömért",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "Néha a Pinguknak egy olyan földdarabot kell elérniük ami messze van, és nem elérhető járással. Ekkor jön jól az ugrás - a Pingu csinál egy kis ugrást, aminek segítségével elérheti a földdarabot. ",
        @"Miner's heaven" = "Bányászok paradicsoma",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "Egy újabb utásítás látja meg a napvilgot - mégegy ásó utasítás, de ezúttal átlós irányban. Így a Pinguk átlós írányban is áshatnak utat a földön keresztül, és ezáltal egy utat csinálva a többieknek. Az utasítás neve: bányászó. ",
        @"Panic Island (float/bash)" = "Pánik sziget(repülés/vízszintes ásás)",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Még az előző pályák nem követeltek sok gyors akciót, ez egy kicsit cselesebb. A Pinguk két bejáraton keresztül jönnek, a te dolgod pedig hogy a két csoportot bölcsen irányítsd. ",
        @"Jump'n Bump... and Bash..." = "Ugrándozás és vízszintes ásás",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "Ez a pánik ideje mefint. A Pinguk nem fognak gyorsan kijönni, de mivel megfordulnak, ha fallal találkoznak, gyorsan össze lehet zavarodni. Mivel csak 5 Pingut kell megmentened, így valószínüleg megcsinálható, de ha sehogy se sikerül, próbáld meg a szünet-módot ('p' gomb) hogy átnézhesd a dolgokat. ",
        @"Two groups in parallel, coordinate wisely" = "Két párhuzamos csoport, írányíts bölcsen",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Most két csoport van amit irányítanod kéne. Semmi ok a pánikra, ezen a pályán elég időd van, hogy meggondold mit teszel. Nem kapsz több tippet most, csak sok szerencsét! ",
        @"Block'a Rock" = "Blokkolj és bombázz",
        @"Climb, Climber,... Boom!" = "Mászni, mászó,... Boom!",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Ahogy már valószínüleg észrevetted az előző pályákon, sokszor kombinálni kell a különböző utasításokat, hogy elvégezd a munkád. Mivel nincs ásó utasítás ezen a pályán, bombázóval kell megoldanod, de hogy tudja elérni a felrobbantandó helyet? ",
        @"Bridging gets more complicated..." = "Hídépítés komplikáltabban",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "Mégegyszer kombinálnod kell az utasításokat és bölcsen gondolkoznod. Ha nem, akkor kiköthetsz a kijárat előtti gödörben, tehát gondolkozz hogy tudnád elkerülni. ",
        @"If too high, your Pingu will die..." = "Ha túl magas, a Pingu meg fog halni...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "A csapatmunka a megoldás kulcsa ezen a pályán. Mivel nincs elég szálló utasításod, így egy párat előre kell küldeni, hogy előkészítse az utat a többiek számára. ",
        @"Learn to use the bridge" = "Híd építésének a megtanulása",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "Ha nincs ugró a kezed ügyében és nagy lyukakat kell áthidalni, a hídépítő igen hasznos lehet. Egy ideig eltart, amíg megépül, de utána az ugróval ellentétben a többi Pingu is át tud rata menni, hogy elérje a célt. ",
        @"Three solutions, it's up to you" = "Három megöldás, rajtad a döntés",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Most hogy ismered az összes utasítást, itt az idő egy kis gyakorlásra. Ezt a pályát legalább háromféle képpen meg lehet oldani. Hogy melyiket választod, az csak rajtad múlik. ",
        @"Climb, Climber, climb... and build a bridge" = "Mászni, mászó, mászni... aztán építs egy hidat",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "Utoljára hozzáférést kapsz egy új utasításhoz. A mászó segítségével a Pingu föl tud mászni függőleges falakra, így el tud érni olyan dolgokat, amit más módszerrel nem lehet. ",
        @"Entrance high, Exit low" = "Bejárat magasan, kijárat alacsonyan",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Ha nincs elég szállód hagy az összes Pingut a célba juttasd, más megoldást kell találnod, hogy levezesd őket. Az előző pályákon már mindent megtanultál, ami ennek a pályának a teljesítéséhez kell, úgyhogy nem okozhat sok problémát. ",
        @"One must prepare, the rest must follow" = "Egynek elő kell készítenie, a többinek meg követni",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "Néha vannak olyan esetek, mikor nincs blokkoló a kéznél a Pinguk kordában tartásához. Ilyenkor más megoldást kell találnod hogy egy helyen tartsd őket, még egy Pingu előkészíti az utat. ",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "Az első két pályával ellentétben, ezen a pályán két utasítás is elérhető. A dolgod most is egyszerű: a bal oldalon válassz ki egy utasítást, majd kattnts egy Pingura. Ha jól csinálod, elérik a kijáratot, és nem fognak sokan meghalni. ",
        @"Dig, bash and other problems" = "Kétféle ásás, meg egyéb problémák",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Ahogy egyre több pályát teljesítesz, úgy lessznek egyre bonyolultabbak, de ne ijjedj meg, ez még mindig könyű. Csak használd a cuccokat, melyeket az előző pályákon megtanultál, és nem lehet sok gondod. Ha azt hiszed, hogy olyan szituációba kerültél, ahonnan nincs visszaút, kattints duplán az armageddon gombra a jobb alsó sarokban. ",
        @"Solid ground can block the path" = "Szilárd talaj megakadályozhatja az utat",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "Ahogy már az előző pályákon megtanultad, a Pinguk szinte minden talajon keresztül tudják magukat ásni, de van egy anyag amelyen nem: az acél. Ezek a régiók sötétszürkével vannak a térképen jelölve, és nem lehet elpusztítani őket, így egy másik utat kell keresned. ",
        @"One jump to catch them all" = "Egy ugrás hogy elkapd az összeset",
        @"The pingus have found themselves lost on their journey.  What is this mysterious place?  Smiling pumpkins, giant candlesticks, and some boiling soup below... what wizardry is this? Now, facing a deadly abyss right in front of them it's your job to save them. Can you save them from a terrible fate?" = "A Pinguk elveszve találták magukat az utazásuk során. Mi ez a titokzatos hely? Vigyorgó tökök, hatalmas gyertyák, és némi forró leves alul... milyen varázslat ez? Most egy halálos szakadékkal állnak szemben, és a te dolgod hogy megmentsd őket. Meg tudod menteni őket ettől a szörnyű sorstól?",
        @"One Thousand and One Jumps" = "Ezer és egy ugrás",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "A magasan és messze levő kijárat egy normál Pingu nem érheti el, mit lehet tenni? Lehet hogy az ugró segít nekik megmenekülni, vagy ez csak egyszerűen elkerülhetetlen halálukat fogja lassítani? A te dolgod hogy ezt kitaláld, de elég ügyes vagy hogy megmentsd az összeset?",
        @"Boom Boom" = "Boom Boom",
        @"You've mastered the last challenge and now face the next. Their path to salvation seems to be cursed, but by whom? There is no time to think about it, since the next deadly challenge already awaits the Pingus. Two mighty roots block the way, but without a basher at hand to bash them away, sacrifice might be the only option..." = "Megoldottad az előző kihívást, és már rögtön itt is a másik. A megmenekülés felé vezető út átkozottnak tűnik, de ki által? Most azonben nincs idő ezen gondolkodni, hiszen a következő halálos kihívás már várja a Pingukat. Kettő titokzatos gyökér elállja az utat, de mivel nincs vízszintes ásó, így csak robbanttással, és néhány Pingu feláldozásával lehet megoldani...",
        @"Full Circle" = "Teljes kör",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "A kijárat közel van, mégis távol. Egy lépés a rossz irányba, és a Pingunak vége. Valamit tenned kell ennek megakadályozása ellen, de lessz elég időd? Sietned kell, és nem engedhetsz meg magadnak semmilyen hibát. A Pinguk számítanak rád!",
        @"Bridgers Nightmare" = "Hídépítők rémálma",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "Ki rakta ezt a hatalmas falat ide? Ez a szörnyű blokád elválasztja a Pingukat a kijárattól. A fal elpusztítása lehetetlennek tűnik, de lehet hogy a hídéptő segít? De tudnak a Pinguk ilyen magas hidat építeni, hogy a csoportot elvezesse a kijárathoz? Vagy megint valaki gonoszul játszadozik veled?\n\nA megoldás most is a te benned van... a szürkeállományod a megoldás kulcsa, tehát ne hagyd magad becsapni és eltéríteni a jó útról!",
        @"Locked up by the witch" = "Bezárva a boszorkány által",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "Ez egy börtön? Körbezárva szilárd falakkal mindenhonnan, úgy tűnik, nics út a menekülésre. Vagy mégis? a jobb oldalon a fal elég gyengének tűnik. Lehet hogy ezen az úton lehet megszökni? Vagy ez csak egy hamis út, ami a Pinguk végzetét okozza majd?\n\nEz egy veszélyes utazás, de meg kell tenned, hogy megtaláld az utvonalat, melyen kihozhatot őket szabadba, sokadszorra.",
        @"Splatterfest" = "Sárfesztivál",
        @"This is by far the deepest pit the Pingus have yet encountered. Building a bridge across it seems obvious but that won't help since the exit is deep down in the pit itself. Pingus who try to go down the pit will just end up splattered all over the ground. You have two groups of Pingus at your disposal, can you make them work together to reach even an exit this well hidden?" = "Ez messze a legmélyebb gödör amivel a Pinguk idáig találkoztak. Hidat építeni fölé egyszerűnek tűnhet, de mégis lehetetlen. A kijárat mélyen van, a gödörben, amely Pinguk megpróbálnak lemenni, azok egyszerűen szétloccsannak.. meg tudod oldani, hogy együttműködjenek, és elérjék a jól elrejtett kijáratot?",
        @"Staircase Maintenance" = "Lépcsőház felújítás",
        @"It seems we are up again against a mighty wall, and it is blocking the exit! But wait, some good soul has built a staircase around it. It seems, however, that the poor fool's efforts didn't last long, as the staircase is destroyed and full of holes. Can you fix it and make it over the wall? Yet of course you know that the right solution might not be the obvious one. But your Pingus are almost free, and they trust in your skill to guide them to safety once more. Succeed and you will have freed them once and for all from whatever evildoer that placed them in this nightmare... at least for this year." = "Úgy tűnik ismét egy titokzatos fallal vagyunk szemben, ami elállja a kijáratot! De várjunk csak, valami jólélek épített egy lépcsőházat köré. De szegény jólélek munkája nem tartott sokáig, a lépcsőház el lett pusztítva, és tele van lyukakkal. Meg tudod csinálni, és át tudsz jutni a falon? De ahogy tudhatod, a kézenfekvő megoldás nem mindig a jó megoldás. De most a Pinguid szinte teljesen szabadok, és megbíznak a képességeidben, hogy elvezeted őket a kijárathoz, mégegyszer. Ha sikerül, végleg megmented ettől az ördögi gonosztevő dolgaitól, amit ebbe a rémálomba rakott.. legalábbis erre az évre.",
        @"Tutorial Island" = "Oktatói Sziget",
        @"Learn the basics" = "Az alapok megtanulása",
        @"The Journey Begins" = "Az Utazás Elkezdődik",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Hosszú ideig, a Pinguk boldogan éltek békében a Délisarkon a többi állattal. Minden egyensúlyban volt, és úgy látszott semmi sem tudja megtörni a békét. A Pinguk boldogan éltek és úgy tűnt, soha nem ér véget.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "De egy nap, a dolgok szépen lassan elkezdtek változni: az ég sötétebb lett, és az időjárás melegebb lett. Először azt hitték, ez csak az időjárás normál változása, de a dolgok egyre rosszabbak és rosszabbak lettek minden évvel.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "A hó elkezdett olvadni, és néhány helyen az étel megszerzése problémás volt. Néhány állat megprobálta elhagyni a régiót, egy hidegebb helyet keresve, de a Pinguk tudták, ez nem segít - nekik kell valamit tenni érte.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Tehát az idősek tanácsa összegyűlt, hogy eldöntsék mi legyen. Úgy döntöttek, egy expedíciót küldenek a Föld körül, hogy megtudják a fölmelegedés okát. Az expedíció többszázas létszáma a Délisark legbátrabb Pingujaiból áll.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "És ők téged választottak hogy irányítsd őket a Föld körüli utazásuk alatt. Mivel az utazás veszélyes és hosszú lessz, az első cél Mogorok szigete, másnéven az Oktatói sziget. Az idősebbek szerint mindig is ez a sziget volt az expedíciók kiinduló állomása.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "A szigeten sok rész van, mely ideális a Pinguk kiképzésére. A Pinguk megtanulhatjá, hogyan építsenek hidat, másszanak, ássanak és még sok más képességet, amire a hosszú és veszélyes utazásuk alatt szükség lessz.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "Amíg itt vagy, gyakorolhatod a képességeidet és a Pinguk irányítását. Ezen kívül még megismerheted a Pinguk képességeit, hogy a mesterük lehess, mivel erre szükség lessz a Föld körüli utazásuk során.",
        @"The Journey Continues" = "Az Utazás Folytatódik",
        @"Now after you and the Pingus have learned the basics and practiced a bit it is time to move on and begin the journey into the world. Since the ice floe with which the Pingus traveled to the Tutorial Island isn't going to hold on the whole way into the warmer climates the Pingus have to find something else to guide them on their journey." = "Most hogy te és a Pinguk megtanulták az alapokat, és gyakoroltak is egy kicsit, itt az idő hogy tovább menve elkezdjék a Föld körüli utazásukat. Mivel az úszó jégtáblák, melyekkel a Pinguk a szigetre utaztak, nem lessz elég az egész utazásuk alatt, mivel a melegebb részeken elolvadnak, így valami más ezközt kelett keresniük amivel tovább utazhatnak.",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "De ahogy az idősebbek mondták, az Oktatói sziget nem csak egy hely a gyakorásra, hanem a kiindulási pont a világ többi részébe. Némi keresés után a Pinguk megértették ennek a jelentését, és megtalálták a nagy fát a sziget végén ami elég fát adott ahhoz hogy tutajt építsenek belőle.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Tehát a Pinguk kivágták a fát, és készítettek néhány nagy tutajt, amelyben mindannyian elfértek. Miután bepakoltak még egy csomó eleséget, felkészültek hogy elinduljon az utazás, elhagyják a jól ismert földjüket, és belépjenek a Föld ismeretlen részeire.",
        @"Desert" = "Sivatag",
        @"Halloween 2007" = "Halloween 2007",
        @"Trapped at All Hallows Eve" = "Elfogva Halloween éjszakáján",
        @"Pac-Man" = "Pac-Man",
        @"Trapped in a video game" = "Csapdába esve egy videojátékban",
        @"Merry Christmas and a Happy New Year" = "Kellemes Karácsonyt és Boldog Új Évet",
    ],
]
