        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Kiengedve: %3d/%d   Kint: %3d   Megmentve: %3d/%d",
        @"Angel" = "Angyal",
        @"Basher" = "Vízszintes ásó",
        @"Blocker" = "Blokkoló",
        @"Boarder" = "Gördeszkás",
        @"Bomber" = "Bombázó",
