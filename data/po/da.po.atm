:pingus.po [
    lang = "da",
    texts = [
        @"Object:" = "Objekt:",
        @"Nothing selected" = "Intet er markeret",
        @"Transparent" = "Gennemsigtig",
        @"Solid" = "Solid",
        @"Ground" = "Jord",
        @"Bridge" = "Bro",
        @"Water" = "Vand",
        @"Lava" = "Lava",
