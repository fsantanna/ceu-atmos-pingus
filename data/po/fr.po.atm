:pingus.po [
    lang = "fr",
    texts = [
        @"Object:" = "Objet :",
        @"Nothing selected" = "Aucune sélection",
        @"Transparent" = "Transparent",
        @"Solid" = "Solide",
        @"Ground" = "Sol",
        @"Bridge" = "Pont",
        @"Water" = "Eau",
        @"Lava" = "Lave",
        @"Remove" = "Retirer",
        @"Direction:" = "Direction :",
        @"Left" = "Gauche",
        @"Misc" = "Divers",
        @"Right" = "Droite",
        @"ReleaseRate:" = "Taux de libération :",
        @"Para-X:" = "Sync-X :",
        @"Para-Y:" = "Sync-Y :",
        @"Scroll-X:" = "Défilement-X :",
        @"Scroll-Y:" = "Défilement-Y :",
        @"Owner Id:" = "Id du propriétaire :",
        @"Z-Pos:" = "Pos-Z :",
        @"Color:" = "Couleur :",
        @"Small Stars:" = "Petites étoiles :",
        @"Middle Stars:" = "Étoiles moyennes :",
        @"Large Stars:" = "Grandes étoiles :",
        @"Repeat:" = "Répéter :",
        @"Id:" = "Id :",
        @"Target Id:" = "Id cible:",
        @"Height:" = "Hauteur :",
        @"Object: [Group]" = "Objet : [Groupe]",
        @"Group not supported" = "Groupe non pris en charge",
        @"Object: " = "Objet : ",
        @"New level" = "Nouveau niveau",
        @"Open level..." = "Ouvrir un niveau...",
        @"Save level..." = "Enregistrer ce niveau...",
        @"Save level as..." = "Enregistrer ce niveau sous...",
        @"Play level..." = "Jouer à ce niveau",
        @"Configure actions" = "Configurer les actions",
        @"Configure level" = "Configurer le niveau",
        @"Display object properties" = "Afficher les propriétés de l'objet",
        @"Show object insertion window" = "Afficher la fenêtre d'insertion d'objets",
        @"Show minimap" = "Afficher la minicarte",
        @"Duplicate the selected objects" = "Dupliquer les éléments sélectionnés",
        @"Delete the selected objects" = "Supprimer les objets sélectionnés",
        @"Raise object to top" = "Mettre l'objet au premier plan",
        @"Raise object" = "Avancer l'objet",
        @"Lower object" = "Reculer l'objet",
        @"Lower object to bottom" = "Mettre l'objet en arrière plan",
        @"Flip object horizontally" = "Retourner l'objet horizontalement",
        @"Flip object vertically" = "Retourner l'objet verticalement",
        @"Rotate object -90 degree" = "Tourner l'objet de -90 degrés",
        @"Rotate object 90 degree" = "Tourner l'objet de 90 degrés",
        @"Display help" = "Afficher l'aide",
        @"Exit" = "Sortie",
        @"Datadir" = "Répertoire de données",
        @"Userdir" = "Répertoire d'utilisateur",
        @"Open" = "Ouvrir",
        @"Save" = "Enregistrer",
        @"Cancel" = "Annuler",
        @"Filename:" = "Nom du fichier :",
        @"Pathname:" = "Chemin :",
        @"Open a level" = "Ouvrir un niveau",
        @"Save your level" = "Enregistrer votre niveau",
        @"== Editor Help ==" = "== Aide de l'éditeur ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Tout sélectionner\nEffacer la sélection\nAvancer les objets\nReculer les objets\nMettre les objets au premier plan\nMettre les objets en arrière plan\nRotation de 90 degrés\nRotation de 270 degrés\nAssocier les objets sélectionnés\nDissocier les objets sélectionnés\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Retourner l'objet horizontalement\nRetourner l'objet verticalement\nEffacer tous les objets marqués\nDéplacer les objets d'un pixel\nDéplacer les objets de 32 pixels\nBasculer la couleur de l'arrière plan\nAugmenter/réduire la répétition\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Vous devriez nommer les fichiers de vos niveaux de façon systématique, par exemple en fonction de leur nom, leur numéro et de votre pseudo :\n\n     <nomduniveau><numéro>-<créateur>.pingus\n\nAinsi, si vous créez un second niveau sur le thème de la pierre, appelez le : pierre2-votrenom.pingus\n\nSi vous souhaitez que vos créations soient inclues dans le jeu,  envoyez les par mail à :\n\n     pingus-devel@nongnu.org\n\nSeuls les niveaux publiés sous la licence GPL sont autorisés dans le jeu. L'éditeur insère automatiquement\nune référence à la GPL. Si vous souhaitez utiliser une autre licence, vous devez changer cette référence.\n",
        @"Replace" = "Remplacer",
        @"Entrance" = "Entrée",
        @"Groundpiece (ground)" = "Élément de sol (sol)",
        @"Groundpiece (solid)" = "Élément de sol (solide)",
        @"Groundpiece (bridge)" = "Élément de sol (pont)",
        @"Groundpiece (transparent)" = "Élément de sol (transparent)",
        @"Groundpiece (remove)" = "Élément de sol (supprimer)",
        @"Hotspot" = "Décors",
        @"Background" = "Arrière-plan",
        @"Liquid" = "Liquide",
        @"Trap" = "Piège",
        @"Weather" = "Climat",
        @"Special Object" = "Objet Spécial",
        @"Prefab Object" = "Objet préfabriqué",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Relachés :%3d/%-3d  Sortis :%3d Sauvés :%3d/%-3d",
        @"Angel" = "Ange",
        @"Basher" = "Défonçeur",
        @"Blocker" = "Bloqueur",
        @"Boarder" = "Planchiste",
        @"Bomber" = "Démolisseur",
        @"Bridger" = "Charpentier",
        @"Climber" = "Grimpeur",
        @"Digger" = "Foreur",
        @"Drown" = "Noyé",
        @"Exiter" = "Sorteur",
        @"Faller" = "Tombeur",
        @"Floater" = "Planeur",
        @"Jumper" = "Sauteur",
        @"Laserkill" = "Brûlé au laser",
        @"Miner" = "Mineur",
        @"Slider" = "Glisseur",
        @"Smashed" = "Écrasé",
        @"Splashed" = "Éclaboussé",
        @"Superman" = "Superman",
        @"Teleported" = "Téléporté",
        @"Waiter" = "Patienteur",
        @"Walker" = "Marcheur",
        @"skip" = "passer",
        @"Play" = "Jouer",
        @"Back" = "Retour",
        @"Number of Pingus: " = "Nombre de Pingus : ",
        @"Number to Save: " = "Nombre de Pingus à sauver : ",
        @"Time: " = "Temps : ",
        @"Author: " = "Auteur : ",
        @"Close" = "Fermer",
        @"Fullscreen" = "Plein écran",
        @"Mouse Grab" = "Capture de souris",
        @"Software Cursor" = "Curseur logiciel",
        @"Autoscrolling" = "Défilement automatique",
        @"Drag&Drop Scrolling" = "Défilement glisser-déposé",
        @"Print FPS" = "Afficher le nombre d'images par seconde",
        @"Resolution:" = "Résolution :",
        @"Renderer:" = "Moteur de rendu :",
        @"Language:" = "Langue :",
        @"Master Volume:" = "Volume principal :",
        @"Sound Volume:" = "Volume du son :",
        @"Music Volume:" = "Volume de la musique :",
        @"Option Menu" = "Menu des options",
        @"Some options require a restart of the game to take effect." = "Certaines options nécessitent que vous redémarriez le jeu pour prendre effet.",
        @"Story" = "Scénario",
        @"..:: Start the game ::.." = "..:: Débute la partie ::..",
        @"Editor" = "Éditeur",
        @"..:: Create your own levels ::.." = "..:: Créez vos niveaux ::..",
        @"Options" = "Options",
        @"..:: Configure the game ::.." = "..:: Configurer le jeu ::..",
        @"Levelsets" = "Autres niveaux",
        @"..:: Play User Built levels ::.." = "..:: Démarre un niveau personnel ::..",
        @"..:: Bye, bye ::.." = "..:: Au revoir ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: capture la souris  ::  F10: compteur IPS  ::  F11: plein écran  ::   F12: capture d'écran ::..",
        @"Give up" = "Abandonner",
        @"Retry" = "Essayez de nouveau",
        @"Success!" = "Réussite !",
        @"Failure!" = "Échec !",
        @"Perfect! You saved everyone possible - great!" = "Parfait ! Vous avez sauvé tout le monde, super!",
        @"No-one got killed, pretty good work." = "Aucune victime, très bon travail",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Vous avez sauvé juste ce qui était nécessaire - vous avez réussi,\nmais vous pouvez peut être faire mieux ?",
        @"Not everybody was saved, but still good work!" = "Tous n'ont pu être sauvés, mais c'est quand même du bon travail !",
        @"What can I say, you made it - congratulations!" = "Que puis-je dire, vous avez réussi, félicitations !",
        @"You killed everybody, not good." = "Vous les avez tous tués, ce n'est pas très bon.",
        @"No-one got saved - I know you can do better." = "Aucun n'a été sauvé, je sais que vous pouvez faire mieux.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Vous n'en avez pas sauvé suffisamment, mais vous en avez tout de même sauvé quelques uns.\nLa prochaine fois vous devriez faire mieux.",
        @"Only one more and you would have made it - try again!" = "Seulement un de plus et vous auriez réussi, réessayez !",
        @"Only a handful more and you would have made it - try again!" = "Seulement une poignée de plus et vous auriez réussi, réessayez !",
        @"Better luck next time!" = "Plus de chance la prochaine fois !",
        @"Saved: " = "Sauvés : ",
        @"Died: " = "Perdus : ",
        @"Time left: " = "Temps restant : ",
        @"Under Construction" = "En construction",
        @"Untested, unpolished and broken levels" = "Niveaux non testés, non finalisés et incomplets",
        @"Solved:" = "Résolus :",
        @"levels" = "niveaux",
        @"???" = "???",
        @"Show Ending?" = "Afficher l'épilogue ?",
        @"Leave?" = "Quitter ?",
        @"[OPTIONS]... [FILE]" = "[OPTIONS]... [FICHIER]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Pingus est un jeu de réflexion où vous devez guider une troupe de petits manchots de part le monde.",
        @"General Options:" = "Options générales :",
        @"Displays this help" = "Afficher l'aide",
        @"Print version number and exit" = "Affiche le numéro de version et quitter",
        @"Enable info level log output" = "Activer l'écriture du journal de niveau informatif",
        @"Enable debug level log output" = "Activer l'écriture du journal de niveau debug",
        @"Disable all log output" = "Désactiver toute écriture du journal",
        @"Display Options:" = "Options d'affichage :",
        @"Start in Window Mode" = "Démarrer en mode fenêtre",
        @"Start in Fullscreen" = "Démarrer en mode plein-écran",
        @"Use the given renderer (default: sdl)" = "Utiliser le moteur de rendu donné (par défaut : sdl)",
        @"Set the window resolution for pingus (default: 800x600)" = "Choisir la résolution de la fenêtre de pingus (par défaut : 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Choisir la résolution utilisée en plein écran (par défaut : 800x600)",
        @"Enable software cursor" = "Activer le curseur logiciel",
        @"Game Options:" = "Options de jeu :",
        @"Disable automatic scrolling" = "Désactiver le défilement automatique",
        @"Enable drag'n drop scrolling" = "Activer le défilement glisser-déposer",
        @"Sound Options:" = "Son :",
        @"Disable sound" = "Désactiver le son",
        @"Disable music" = "Désactiver la musique",
        @"Select language to use with Pingus" = "Sélectionner la langue à utiliser avec Pingus",
        @"List all available languages" = "Afficher la liste des langues disponibles",
        @"Loads the level editor" = "..:: Démarrer l'éditeur de niveau ::..",
        @"Directory Options:" = "Options du répertoire :",
        @"DIR" = "REPERTOIRE",
        @"Load game datafiles from DIR" = "Charger les fichiers de données du jeu depuis REPERTOIRE",
        @"Load config files and store savegames in DIR" = "Charger les fichiers de configuration et les sauvegardes stockées dans REPERTOIRE",
        @"Load game modifications from DIR" = "Charger les modifications du jeu depuis REPERTOIRE",
        @"Don't read ~/.pingus/config" = "Ignorer ~/.pingus/config",
        @"FILE" = "FICHIER",
        @"Read config options from FILE" = "Lire les options de configuration de FICHIER",
        @"Uses the controller given in FILE" = "Utiliser le controller spécifié dans FICHIER",
        @"Debug Options:" = "Options de débogage :",
        @"Enables some special features for developers" = "Active des fonctionnalités pour les développeurs",
        @"Set the game speed (0=fastest, >0=slower)" = "Détermine la vitesse du jeu (0 → le plus rapide, > 0 → plus lent)",
        @"Set the desired game framerate (frames per second)" = "Modifier la fréquence d'affichage du jeu (images par seconde)",
        @"Set the size of the map tiles (default: 32)" = "Détermine la taille des section (tiles) de la carte (par défaut: 32)",
        @"Pingus: Out of memory!" = "Pingus: mémoire insuffisante",
        @"Pingus: Standard exception caught!:\n" = "Pingus: Exception standard interceptée!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: Sortie (throw) inconnue interceptée!",
        @"unlimited" = "illimité",
        @"Screenshot: Saving screenshot to: " = "Capture d'écran : Sauvegarde de la capture sous : ",
        @"Screenshot: Screenshot is done." = "Capture d'écran : La capture est terminée.",
        @"Screenshot: Couldn't write file: " = "Capture d'écran : Impossible d'écrire le fichier : ",
        @"If the way is blocked, bash away" = "Si la route est bloquée, défonce le mur !",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "De manière analogue au foreur que vous avez connu dans les niveaux précédents, il existe une action qui permet aux Pingus de creuser horizontalement, au contraire du forage vertical du foreur. Cette nouvelle action est appelée Défonçeur. ",
        @"Sacrifice a few and save the rest" = "Sacrifie quelques-uns pour sauver les autres",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Parfois, quand aucune autre action n'est disponible, vous ne pouvez que dynamiter votre chemin au travers du sol. Les Pingus peuvent y parvenir en s'auto-détruisant. Cela les tuera, mais c'est parfois nécessaire pour sauver le reste de la bande. ",
        @"Learning to dig" = "Apprendre à creuser",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "C'est votre première mission. Comme toujours, c'est assez facile. Il vous suffit d'ordonner à un Pingu de forer un trou dans le sol afin qu'ils puissent tous atteindre la sortie. Pour ce faire, cliquez simplement sur un Pingu. ",
        @"Float or Die" = "Planer ou mourir",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "Félicitation pour votre première mission ! Maintenant, passons à la suivante. Cette fois, vous allez devoir équiper vos Pingus avec une petite hélice, afin qu'ils puissent atterrir en douceur sur le sol. Si les Pingus tombent de trop haut, ils ne pourront survivre à la chute, alors soyez vigilant ! ",
        @"Jump for joy" = "Saute de joie",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "Parfois, un Pingu a besoin d'atteindre une plateforme qui est éloignée et inaccessible par la marche. C'est alors que l'action Sauteur devient utile : elle permet à un Pingu de faire un petit bond et lui permet d'atteindrela plateforme. ",
        @"Miner's heaven" = "Paradis des mineurs",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "Voici une nouvelle action de forage, cette fois en diagonale. Elle permet à un Pingu de creuser le sol en diagonale, créant ainsi une voie que pourront emprunter les autres Pingus. Cette action se nomme Mineur. ",
        @"Panic Island (float/bash)" = "Île de la Panique (planeur/défonçeur)",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Alors que les niveaux précédents ne demandaient pas trop d'actions rapides, celui-ci est un peu plus difficile. Les Pingus sortent de deux entrées en parallèle et vous devez coordonner les deux groupes intelligemment. ",
        @"Jump'n Bump... and Bash..." = "Saute, rebondis ... et défonce...",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "C'est encore une fois la panique. Les Pingus ne sortirons pas très rapidement, mais puisque comme ils se retournent en rentrant dans les murs, vous allez rapidement avoir de mal à tous les coordonner. Puisque vous n'avez qu'à en sauver 5, cela devrait être réalisable, mais si vous êtes en difficulté, utilisez le mode pause ('p') pour avoir une vue d'ensemble. ",
        @"Two groups in parallel, coordinate wisely" = "Deux groupes en parallèle, coordination essentielle",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Vous avez deux groupes à diriger cette fois, ne paniquez pas, puisque ce niveau vous donne suffisament de temps pour réfléchir à vos actions. Pas plus de conseils cette fois, mais bonne chance ! ",
        @"Block'a Rock" = "Bloque la route",
        @"Once again it's time to combine the things you have learned in your previous levels. Blast your way free and make sure you also keep the rest of the Pingus under control. The Blocker action will be helpful." = "Une fois de plus, il est temps de combiner ce que vous avez appris dans les niveaux précédents. Dégagez votre chemin et faites en sorte de garder le reste de vos Pingus sous contrôle. L'action du Bloqueur sera utile.",
        @"Climb, Climber,... Boom!" = "Plus haut, Plus haut, ... Boum !",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Comme vous l'avez sûrement compris auparavant, vous avez souvent a combiner différentes actions pour accomplir le travail. Étant donné l'absence de Foreurs dans ce niveau, le Démolisseur doit entrer en scène. Mais comment peut-il atteindre l'endroit à dynamiter ? ",
        @"Bridging gets more complicated..." = "La construction de pont devient complexe...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "Encore une fois, vous avez à combiner des action avec précaution et intelligence, sans quoi vous allez terminer votre course dans le trou avant la sortie, cherchez donc un moyen d'éviter cela. ",
        @"If too high, your Pingu will die..." = "De trop haut, les Pingus en morceaux...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "Le travail d'équipe est la clef du succès cette fois. Vous n'avez pas suffisamment de planeurs pour atteindre la sortie, alors n'en n'envoyez que quelques uns préparer la route pour les autres. ",
        @"Learn to use the bridge" = "Apprenez à utiliser le pont",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "S'il vous n'avez pas de Sauteur a portée de main et qu'un grand trou doit être franchi, un pont peut être très utile. Il prend un certain temps à construire, mais contrairement à l'action Sauteur, il permet aux Pingus suivants d'atteindre l'autre côté. ",
        @"Three solutions, it's up to you" = "Trois solutions, c'est à vous de choisir",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Maintenant que vous avez fait connaissance avec toutes les actions, il est temps de les pratiquer. Il y a au moins trois manière de résoudre ce niveau, choisissez celle que vous voulez. ",
        @"Climb, Climber, climb... and build a bridge" = "Grimpe, Grimpeur, grimpe... et construit un pont",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "Une fois de plus, vous avez accès à une nouvelle action. L'action Grimpeur permet à un Pingu d'escalader un mur droit et ainsi d'atteindre des endroits inaccessibles autrement. ",
        @"Entrance high, Exit low" = "Entrée haute, Sortie basse",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Si vous n'avez pas assez de planeurs pour faire descendre tous les Pingus vers la sortie, vous allez devoir trouver des voies de contournement. Tout ce qui est nécessaire ici vous a été appris dans les niveaux précédents. Celui-ci ce ne devrait donc pas vous poser de problèmes. ",
        @"One must prepare, the rest must follow" = "Un fait le travail, les autres suivent",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "Parfois, vous n'avez pas de Bloqueur sous la main pour coordonner vos Pingus et vous devez trouver d'autres façons de les garder sous contrôle, pendant qu'un seul d'entre eux prépare la route pour les autres. ",
        @"Dig and float, just don't fall and smash" = "Creuser et planer, et ne pas tomber et s'écraser",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "Contrairement au deux premiers niveaux, vous avez deux actions disponible dans celui-ci. Votre tâche est également simple :  sélectionnez une action depuis le panneau de gauche et appliquez la sur les Pingus afin qu'ils puissent atteindre la sortie. Assurez-vous que peu d'entre eux meurent. ",
        @"Dig, bash and other problems" = "Creuse, défonce et d'autres problèmes",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Plus vous finirez de niveaux, plus ils seront difficiles, mais, pas de panique, celui-ci est encore assez facile. Utilisez simplement ce que vous avez appris auparavant et vous ne devriez pas avoir de problèmes. Si vous croyez avoir atteint un stade où vous ne pouvez plus réussir le niveau, double-cliquez sur le bouton Armageddon dans le coin inférieur droit. ",
        @"Solid ground can block the path" = "L'acier bloque le passage",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "Comme vous l'avez appris dans les niveaux précédants, vos Pingus peuvent creuser pratiquement tous les sols, mais il y a une chose qu'ils ne peuvent percer : le métal. Ces régions sont marquées de gris foncé sur la carte du niveau et ne peuvent être détruites, alors contournez-les. ",
        @"One jump to catch them all" = "Un saut pour les attraper tous",
        @"The pingus have found themselves lost on their journey.  What is this mysterious place?  Smiling pumpkins, giant candlesticks, and some boiling soup below... what wizardry is this? Now, facing a deadly abyss right in front of them it's your job to save them. Can you save them from a terrible fate?" = "Les Pingus se sont perdus au cours de leur voyage. Quel est cet endroit mystérieux ? Des citrouilles souriantes, des candélabres géants et de la soupe qui bout... quelle est cette sorcellerie ? Maintenant, face à un abîme mortel, c'est à vous de les sauver. Pouvez-vous les arracher à leur terrible destinée ?",
        @"One Thousand and One Jumps" = "Mille et un sauts",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "Comment faire avec une sortie si haute et hors de portée d'un Pingu normal ? Un Sauteur pourrait-il les secourir ? Ou retardera-t-il seulement leur inéluctable échec ? À vous de le déterminer, mais serez-vous assez bon pour tous les sauver ?",
        @"Boom Boom" = "Boum boum",
        @"You've mastered the last challenge and now face the next. Their path to salvation seems to be cursed, but by whom? There is no time to think about it, since the next deadly challenge already awaits the Pingus. Two mighty roots block the way, but without a basher at hand to bash them away, sacrifice might be the only option..." = "Vous avez réussi le défi précédent, voici le suivant. Le chemin du salut semble piégé, mais par qui ? Pas le temps d'y réfléchir, car la prochaine épreuve mortelle attend déjà les Pingus. Deux puissantes racines bloquent le passage, mais sans Défonçeur pour les détruire, il va falloir sacrifier des Pingus...",
        @"Full Circle" = "Cercle complet",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "La sortie est proche, mais hors de portée. Un pas de travers et les Pingus seront condamnés. Vous devez faire quelque chose pour les aider, mais avez-vous assez de temps ? Vous devez faire vite et sans faute. Les Pingus comptent sur vous !",
        @"Bridgers Nightmare" = "Cauchemard de charpentier",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "Qui a mis ce mur monstrueux ici ? Ce terrible obstacle sépare vos Pingus de la sortie. Détruire cet horrible édifice semble être impossible... mais les charpentiers pourront peut-être faire quelque chose ? Peuvent-ils construire leurs ponts suffisamment haut pour, une fois de plus, mener le groupe sain et sauf à la sortie ? À moins que quelqu'un soit en train de vous jouer un mauvais tour ?\n\nEncore une fois, tout repose sur vous... Votre matière grise est la clé de la réussite des Pingus, alors ne vous laissez pas intimider et ne vous écartez pas du droit chemin.",
        @"Locked up by the witch" = "Verrouillé par la sorcière",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "Est-ce une prison ? Bloqué de partout par des murs solides, il ne semble pas y avoir d'issue. Aucun salut ne semble possible.\nMais, attendez ... le mur de droite semble plus fragile... Peut-être est-ce un moyen de s'échapper ? À moins que ce ne soit un piège qui mènera les Pingus à leur perte ?\n\nC'est un voyage risqué, mais vous devez absolument trouver le moyen pour les libérer... encore une fois.",
        @"Splatterfest" = "Film d'horreur",
        @"This is by far the deepest pit the Pingus have yet encountered. Building a bridge across it seems obvious but that won't help since the exit is deep down in the pit itself. Pingus who try to go down the pit will just end up splattered all over the ground. You have two groups of Pingus at your disposal, can you make them work together to reach even an exit this well hidden?" = "C'est de loin le trou le plus profond que les Pingus aient jamais rencontré. Construire un pont par dessus semble évident, mais cela ne servirait à rien car la sortie se trouve en fait au fond du trou. Les Pingus qui essaieront d'y descendre finiront écrasés sur le sol. Vous avez deux groupes de Pingus à disposition, parviendrez-vous à les faire coopérer pour atteindre une sortie aussi isolée ?",
        @"Staircase Maintenance" = "Maintenance des escaliers",
        @"It seems we are up again against a mighty wall, and it is blocking the exit! But wait, some good soul has built a staircase around it. It seems, however, that the poor fool's efforts didn't last long, as the staircase is destroyed and full of holes. Can you fix it and make it over the wall? Yet of course you know that the right solution might not be the obvious one. But your Pingus are almost free, and they trust in your skill to guide them to safety once more. Succeed and you will have freed them once and for all from whatever evildoer that placed them in this nightmare... at least for this year." = "Il semble que nous soyons à nouveau au pied d'un mur imposant et que celui-ci nous bloque la sortie ! Mais attendez, une bonne âme a construit un escalier tout autour. Cependant, les efforts du pauvre bougre n'ont visiblement pas duré car l'escalier est détruit et plein de trous. Parviendrez-vous à le réparer et à passer au dessus du mur ? Bien sûr, vous savez dorénavant que la solution n'est pas forcément la plus évidente... Mais vos Pingus sont presque libres, et ils ont confiance en vos compétences de guide pour les mettre à l'abri une fois de plus. Si vous réussissez, vous les aurez libéré une bonne fois pour toutes des gredins qui les ont entraîné dans ce cauchemar... du moins pour cette année.",
        @"Down Into The Cave" = "Descente dans la Grotte",
        @"The exit is far below and the pingus are separated from it by quite a distance. The path down is riddled with gulfs, so jumping and bridging will be the primary tool to get down there. But be careful, the last few steps require some extra cleverness." = "La sortie est loin en dessous et les pingus ont une grande distance à parcourir. Le chemin vers le bas est criblé de gouffres donc sauter et construire des ponts vont être les principales actions pour arriver au but. Mais soyez prudent, les derniers pas demandent une attention supplémentaire.",
        @"Round and Round" = "Tourner en rond",
        @"Trapped in an eternal loop one brave pingu has to break out and go on a journey in search for the exit, but he mustn't be too happy once he found it, as there is still one last challenge he must solve before being allowed to enter it, otherwise all his friends might perish." = "Enfermé dans une boucle éternelle, un brave pingu doit sortir et voyager en quête de la sortie, mais il ne doit pas être trop heureux une fois qu'il l'a trouvée, il lui reste un défi surmonter pour pouvoir y entrer, autrement tous ses amis doivent périr.",
        @"Red Herring Cave" = "La grotte du hareng rouge",
        @"The exit is right above the pingus heads, with a few friendly arrows pointing the way. With jumpers around the solution should be obvious. But wait, can anything you find in a dark cave be trusted or is there some more going on which might slip your view? Thinking outside the box might be required." = "La sortie est juste au dessus de la tête des pingus, quelques flèches montrent la chemin à suivre. Avec des Sauteurs la solution devrait être évidente. Mais attendez, est-ce que vous pouvez faire confiance à n'importe quoi dans une grotte sombre ou y a t-il quelque chose d'autre pourrait vous jouer des tours ? Penser de manière non conventionnelle peut être nécessaire.",
        @"Group Coordination" = "Coordination de groupe",
        @"Three groups are on their way to the exit, one of them trapped right above it, but locked into a box. None of them can make it alone, coordinate them wisely and everybody should be able to make it safely to the exit. " = "Trois groupes sont en route vers la sortie, un d'eux est emprisonné juste au dessus de la sortie mais enfermé dans une boîte. Aucun d'entre eux ne peut s'en sortir tout seul, coordonnez les avec sagesse et tout le monde devrait pouvoir rejoindre la sortie sain et sauf. ",
        @"Traps, Dangers and other Problems" = "Pièges, Dangers et autres Problèmes",
        @"The path to the exit lays below, shimmering through the planks. But the fall is too high, deadly for sure. Can one pingu alone make it's way through the dangerous traps and secure the path to the exit?" = "Le chemin vers la sortie est en dessous, miroitant à travers les planches. Mais la chute est trop élevée, mortelle à coup sûr. Un pingu peut-il se frayer seul un passage à travers les dangereux pièges et sécuriser le chemin vers la sortie?",
        @"Reach that Switch" = "Atteindre cet interrupteur",
        @"The path to the exit is straight, flat and simple, but wait a solid door blocking the way? How can the pingus open it? Is that a switch there on the hill to the right? Might that be the solution to opening the door and freeing the pingus? But how can they reach that switch?" = "Le chemin vers la sortie est tout droit, plat et simple, mais attendez, une porte solide bloque le chemin ? Comment les pingus peuvent-ils l'ouvrir ? Est-ce un interrupteur, là, sur la colline à droite ? Peut être qu'il s'agit de la solution pour ouvrir la porte et libérer les pingus ? Mais comment atteindre cet interrupteur ?",
        @"The Collapsed Column" = "La Colonne Effondrée",
        @"High up above the green slime the pingus are moving from column to column, getting closer to the exit with each step, but wait, there is a second group of pingus, they are stuck. The column next to them has collapsed making getting to the exit impossible. Can you find a way around the abyss?" = "Bien au dessus du  slime vert , les pingus se déplacent de colonne en colonne, s'approchant de la sortie à chaque pas, mais attendez, il y a un deuxième groupe de pingus qui est bloqué. La colonne à côté d'eux s'est effondrée rendant la sortie impossible. Pouvez-vous trouvez un moyen de contourner l'abîme ?",
        @"Island of Doom" = "L'île du Châtiment",
        @"The pingus are released close together, but split up by a solid metal column with seemingly no way to join them back up. The journey will be dangerous and some height has be crossed with the exit hidden below. With some cleverness it should be possible to join those two groups back together." = "Les Pingus arrivent proches les uns des autres, mais séparés par une solide colonne de métal qui donne l'impression qu'il est impossible de les faire se rejoindre. Le voyage sera périlleux et passera à travers les hauteurs au dessus de la sortie. Avec de l'ingéniosité, il devrait être possible de faire se rejoindre les deux groupes.",
        @"Tower of Death" = "La Tour de la Mort",
        @"The pingus are at the top of the tower, with no stairway around. The exit is deep down, hidden at the foot of the tower. How shall they make it down all that height with no floaters sight? A few well placed diggers should be enough to get the job done, but wait, no, their direction isn't quite right. You have to give them directions or it will be their doom." = "Les pingus sont au sommet de la tour, sans aucun escalier à proximité. La sortie est tout en bas, cachée au pied de la tour. Comment vont-ils descendre sans flotteur en vue ? Quelques creuseurs bien placés devraient faire l'affaire, mais attendez, non, leur direction n'est pas assez bonne. Il va vous falloir leur donner des directions ou bien ils recevront leur châtiment.",
        @"The Ones" = "Les Élus",
        @"This is the last stage the pingus have to pass during this Halloween. Two oddly familiar column are in the way. What do they mean? The two groups of pingus have to work together to make it down the columns to the exit far below." = "C'est le dernier niveau que les pingus doivent passer durant cet Halloween. Deux tours bizarrement familières sont sur le passage. Que veulent-elles dire ? Les deux groupes de pingus doivent travailler ensemble pour descendre les colonnes jusqu'à la sortie loin en bas.",
        @"Down the valley and up again" = "Descente dans la vallée et remontée",
        @"There is a large valley between the entrance and the exit. No bridge will be long enough to cross the valley, but can you find a way back up once you lead the Pingus down into the valley?" = "Une grande vallée se trouve entre l'entrée et la sortie. Aucun pont ne sera assez long pour traverser la vallée, mais pourrez vous trouver un chemin une fois que vous aurez conduit les Pingus au fond de la vallée ?",
        @"Entering the pyramid" = "Entrée dans la pyramide",
        @"After their long and dangerous journey through the desert the Pingus finally reach the large pyramid, but there is still a pedestal blocking their way." = "Après leur long et dangereux voyage à travers le désert, les Pingus ont finalement atteint la grande pyramide, mais il reste un piédestal qui leur bloque le chemin.",
        @"The window room" = "La salle fenêtrée",
        @"After the Pingus have entered the pyramid, they reach a large room with a large window. The only problem they have is that the entrance to the room is much too high to survive the landing. Can you help them?" = "Après que les Pingus soient entrés dans la pyramide, ils ont atteint une grande pièce avec une large fenêtre. Le seul problème qu'ils ont est que l'entrée de la pièce est bien trop haute pour survivre à l'atterrissage. Pouvez-vous les aider ?",
        @"Grand Hall" = "Grande Galerie",
        @"The pingus have found themselves in the grand hall, a hall full of wonder and treasures. The exit however is high up and won't be easy to reach. Guide the pingus around the hall and maybe you will find a way." = "Les pingus se retrouvent dans la grande galerie, une galerie pleine de merveilles et trésors. La sortie par contre est tout en haut et ne sera pas facile à atteindre. Guidez les pingus à travers la galerie et peut-être que vous trouverez un chemin.",
        @"Pass the pedestal" = "Passer le piédestal",
        @"A large pedestal is blocking the way to the exit and there aren't enough bashers available to dig it away. Can you find a way to make it past the pedestal?" = "Un grand piédestal bloque le chemin vers la sortie et il n'y a pas assez de défonçeurs pour le creuser. Pouvez-vous trouver un chemin de l'autre côté du piédestal ?",
        @"The excavation of the pyramid" = "La fouille de la pyramide",
        @"The excavations are open to reach the pyramid for his redeeming content. Some excavations, however, is best done with two competitors. Who comes first?" = "Les fouilles sont ouvertes pour dénicher les trésors de la pyramide. Cependant, certaines fouilles sont plus efficaces lorsqu'elles sont réalisées par 2 équipes adverses. Qui sera le premier ?",
        @"Catch them at the half way point" = "Attrapez-les à mi-chemin",
        @"The Pingus are separated from the exit by large abyss. A simple bridge won't be enough to catch them safely, unless of course you find the right place to put it. Can you uncover that spot?" = "Une large abysse sépare les Pingus de la sortie. Un simple pont ne sera pas suffisant pour les amener sains et saufs, à moins, bien sûr, que vous trouviez le bon endroit pour le placer. Pourrez-vous trouver cet endroit ?",
        @"Claustrophobia" = "Claustrophobie",
        @"Hidden deep below the pyramid the pingus come across a small underground room, but unfortunatley a large tree root blocks their path..." = "Caché profondément sous la pyramide, les pingus traversent une petite salle souterraine, mais malheureusement une grosse racine bloque leur chemin...",
        @"A bit to the right a bit to left" = "Un peu à droite, un peu à gauche",
        @"Only the most audacious Pingus will be allowed to continue." = "Seuls les Pingus les plus audacieux pourront continuer.",
        @"25 Pingus free and 25 in the box" = "25 Pingus libres et 25 dans la boîte",
        @"Okay for the Bridger but what can I do with Digger? You should save at least one Pingu trapped in the box above the exit." = "D'accord pour le Charpentier mais que faire avec le Foreur ? Vous devez sauver au moins un Pingu enfermé dans la boîte au dessus de la sortie.",
        @"Tunnel Time" = "C'est l'heure de creuser",
        @"Dig a tunnel and you might make it to the exit. Digger and miners and stuff have to work together." = "Creusez un tunnel et vous pourrez peut être atteindre la sortie. Les foreurs, mineurs et autres doivent travailler ensemble.",
        @"Crawlspace" = "Vide sanitaire",
        @"The path to the exit is blocked and many small tunnels lead the way, but be careful some of those lead to certain death. Or is there something you can do about that and create a save passage for all the Pingus and lead them safely to the exit?" = "Le chemin vers la sortie est bloqué et beaucoup de petits tunnels y mènent, mais soyez prudent car certain d'entre eux mènent à une mort certaine. Y a-t-il quelque chose que vous pouvez faire et créer un passage sûr pour tous les Pingus qui les mènera sains et saufs jusqu'à la sortie ?",
        @"The Roof" = "Le toit",
        @"Sometimes the roofs are not good for refuge, sometimes it should be demolished! But be careful if you aren't precise enough, you might lead the Pingus straight to certain death." = "Parfois les toits ne sont pas un bon refuge, parfois ils doivent être démolis ! Soyez prudent si vous n'êtes pas assez précis, vous pourriez envoyer les Pingus vers une mort certaine.",
        @"Pingus Jones and the Last Exit" = "Pingu Jones et la Dernière Sortie",
        @"Dr. Jones' notebook:\n\n  (1) the breath of God: only the penitent pingus will pass;\n  (2) the word of God... in reverse;\n  (3) the path of God: leap from the head of something like a cat." = "Carnet du Dr. Jones :\n\n  (1) le souffle de Dieu : seuls les pingus pénitents passeront ;\n  (2) le mot de Dieu.. en sens inverse ;\n  (3) le chemin de Dieu : bondir de la tête de quelque chose comme un chat.",
        @"Near can mean far" = "Proche peut signifier loin",
        @"What do you do when you're going in the wrong direction ? Simple: walk into a wall. But it is easier said than done..." = "Que faites-vous quand vous allez dans la mauvaise direction ? C'est simple :  vous foncez dans un mur. Mais c'est plus facile à dire qu'à faire...",
        @"Trapped Underground" = "Coincés sous terre",
        @"The penguins escaped the mad scientist, but now they were trapped deep underground. They had no food or water, so they had to move fast." = "Les manchots ont échappé au savant fou, mais maintenant ils sont coincés profondément sous terre. Ils n'ont ni nourriture ni eau, alors ils vont devoir faire vite.",
        @"Experimentation" = "Expérimentation",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Un savant fou a capturé les manchots et fait des expériences sur eux. Comment les manchots peuvent-ils échapper à la guillotine ?",
        @"Hall of Illusion" = "Le hall des Illusions",
        @"The penguins stopped and stood in indecision. What was real and what was not? Flame lanced from above and a guillotine glittered in the distance. Almost all penguins must survive." = "Les manchots s'arrêtèrent et restèrent indécis. Qu'est-ce qui était vrai et qu'est-ce qui ne l'était pas ? Une flamme lancée depuis le dessus, et une guillotine les maintiennent à distance. Presque tous les manchots doivent survivre.",
        @"The Lava Pit" = "La fosse de lave",
        @"The penguins had defeated the mad scientist, and were walking away from his destroyed laboratory when a huge hole opened under their feet. The penguins fell into an underground cave and the only way out was across the lava pit. Luckily, it seemed someone had left some helpful signs." = "Les manchots avaient vaincu le savant fou et s'éloignaient de son laboratoire détruit lorsqu'un trou béant s'ouvrit sous leurs pieds. Les manchots tombèrent dans une grotte souterraine et la seule sortie était de l'autre côté d'une fosse remplie de lave. Par chance, quelqu'un a laissé des panneaux très utiles.",
        @"At least the experiments are over..." = "Au moins, les expériences sont terminées...",
        @"The good news was that the mad scientist had tired of his experiments, the bad news was that now he was dumping them down a pit. A single floatation device was all the penguins had. Save as many as possible." = "La bonne nouvelle était que le savant fou s'était lassé de ses expériences, mais la mauvaise c'était qu'il était maintenant en train de les jeter dans une fosse. Tout ce que les manchots avaient, c'était une machine à flotter. Sauvez-en autant que possible.",
        @"Ghosting" = "Fantômes",
        @"The penguins came to a long pass. Acid bubbled underneath and it seemed a climber or two were needed.  Hint: slider can be used to stop the miner ability." = "Les manchots arrivèrent dans une grande passe. De l'acide bouillonnait en dessous et il semblait qu'un ou deux grimpeurs étaient nécessaires. Indice : vous pouvez utiliser le glisseur pour arrêter le mineur.",
        @"The Final (and suprisingly easy) Challenge" = "La dernière (et étonnamment facile) épreuve",
        @"The penguins had reached the end of the island. In the water was a long tree, perfect for the penguin's needs. Their journey was almost over." = "Les manchots ont atteint le bout de l'île. Il y avait dans l'eau un grand arbre, parfait pour les besoins des manchots. Leur voyage était presque terminé.",
        @"Revenge is sweet" = "La vengeance est douce",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down." = "Les manchots s'étaient échappés du savant fou mais maintenant ils voulaient leur revanche. Ils avaient l'intention de détruire les structures de soutien, détruisant le laboratoire du mal.",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down. They had to move fast though, because the mad scientist would detect and recapture them if they weren't fast enough." = "Les manchots s'étaient échappés du savant fou mais maintenant ils voulaient leur revanche. Ils avaient l'intention de détruire les structures de soutien, afin que s'effondre le laboratoire maléfique. Ils devront se déplacer vite car le savant fou les repérera et les capturera à nouveau s'ils ne sont pas assez rapides.",
        @"Winter Wonderland" = "L'hiver des merveilles",
        @"After getting past the lava pit, the penguins walked and walked until they reached a snowed in exit. That would be relatively easy to tunnel through but how would it be possible to tunnel through solid metal?" = "Après avoir franchi la fosse de lave, les manchots marchèrent, encore et encore, jusqu'à atteindre une sortie bouchée. Il serait facile de creuser un tunnel pour passer, mais comment creuser à travers du métal ?",
        @"The Journey Goes On" = "Le voyage continue",
        @"And so the penguins continued on their journey, drawing ever closer to the North Pole. They had escaped the guillotine, defeated the mad scientist and got a new boat. And so this chapter in their voyage was over, but there would be other obstacles. Nothing  would stop the determined penguins from reaching their goal." = "Et ainsi les manchots poursuivirent leur voyage, se rapprochant sans cesse du Pôle Nord. Ils avaient échappé à la guillotine, vaincu le savant fou et récupéré un nouveau bateau. Ainsi se termine ce chapitre de leur voyage, mais il y aura d'autres obstacles. Rien ne peux arrêter des manchots déterminés à atteindre leur but.",
        @"Think fast (literally)" = "Pensez vite (littéralement)",
        @"This would be simple but for one thing, there are no blockers. All the penguins must survive." = "Cela aurait pu être simple, s'il n'y avait un petit détail : il n'y a pas de bloqueurs. Tous les manchots doivent survivre.",
        @"Shipwrecked" = "Naufrage",
        @"The penguins were sailing along happily on their makeshift boat until suddenly an island appeared. The penguins were drawn towards it and crashed, destroying their boat. Now they must find their way across this strange island." = "Les manchots naviguaient joyeusement sur leur embarcation de fortune quand soudain apparu une île. Les manchots furent attirés vers elle et s'y écrasèrent, détruisant leur bateau. Maintenant ils doivent trouver leur chemin à travers cette étrange île.",
        @"Escape from Aliens" = "Échappez-vous des aliens",
        @"Aliens invade our starship blocking entrance to the teleporter. Your crew is well trained, like you they don't panic." = "Des aliens envahissent notre vaisseau spatial, bloquant l'accès au téléporteur. Votre équipage est bien entraîné et, comme vous, ils ne paniquent pas.",
        @"Escape from Aliens 2" = "Échappez-vous des aliens 2",
        @"Aliens are now closest making your escape harder. You must dig it up." = "Les aliens se rapprochent, rendant votre fuite plus difficile. Il va falloir creuser.",
        @"Alien's nest" = "Le nid des aliens",
        @"Pingus invade the nest. Take care of jaws. What's the matrix above?" = "Les Pingus envahissent le nid. Prenez garde aux mâchoires. Qu'est-ce que la matrice au dessus ?",
        @"Matrix of the death" = "La matrice de la mort",
        @"Take a piece of paper. Now pingus have to enter the matrix of the death. This is a maze, bad ways are protect by jaws." = "Prenez une feuille de papier. Maintenant, les Pingus doivent entrer dans la matrice de la mort. C'est un labyrinthe, les mauvais chemins sont protégés par des mâchoires.",
        @"Spy's pingus in the matrix of the death" = "Les espions Pingus dans la matrice de la mort",
        @"Spy's pingus have marked the location of jaws in the matrix of the death. Many died to gain that information :..( Perhaps this help. Perhaps..." = "Les espions Pingus ont marqué les emplacements des mâchoires dans la matrice de la mort. Beaucoup sont morts pour obtenir ces informations... (Peut-être que cela vous aidera. Peut-être...)",
        @"Fourth dimension" = "La quatrième dimension",
        @"The defenses of the aliens get stronger. Now you have to jump in the fourth dimension to win!" = "Les défenses des aliens deviennent plus fortes. Maintenant vous devez sauter dans la quatrième dimension pour gagner !",
        @"Set your watches" = "Sélectionnez un climat",
        @"Cooperation in space." = "Coopération dans l'espace.",
        @"Lost in Space" = "Perdus dans l'espace",
        @"We don't know where we are but we don't leave anybody behind." = "Nous ne savons pas où nous sommes mais nous ne laisserons personne derrière nous.",
        @"Outside In" = "Le dehors du dedans",
        @"Can you help the pingus escape without getting their flippers wet?" = "Pouvez-vous aider les Pingus à s'échapper sans qu'ils se mouillent les palmes ?",
        @"Endless Loop" = "Boucle infinie",
        @"To the right and to the left the Pingus will face certain death and you have to save 50. Can you help them get out of this mess?" = "A droite et à gauche les Pingus affronteront une mort certaine, et vous devez en sauver 50. Pouvez-vous les aider à se sortir de ce pétrin ?",
        @"Up up in the space" = "Là haut dans l'espace",
        @"What good is a pick in space? Certainly not to go to the stars." = "À quoi sert une pioche dans l'espace ? Certainement pas à atteindre les étoiles.",
        @"Jump" = "Saut",
        @"All Pingus need is to jump.... Hint: While pausing (press P key) you still can control Pingus. " = "Tout ce que les Pingus doivent faire est sauter.... Astuce : En mode pause (appuyez sur la touche P) vous pouvez toujours contrôler les Pingus. ",
        @"Factory" = "Usine",
        @"Finally you reached the factory. Watch out as there are many dangers. Use bombers to destroy the basement of the factory. Good luck!" = "Vous avez enfin atteint l'usine. Faites attention, car elle est pleine de dangers. Utilisez les démolisseurs pour détruire les fondations de l'usine. Bonne chance !",
        @"Going back home" = "Retour à la maison",
        @"Your mission is over. Pingus can go back home, but be careful!" = "Votre mission est terminée. Les Pingus peuvent rentrer chez eux, mais faites attention !",
        @"Bonus track" = "Niveau bonus",
        @"Pingus are at home, but after the climate change living on the South Pole became more dangerous. There is one more mission for you." = "Les Pingus sont chez eux mais, avec le changement climatique, la vie au Pôle Sud est devenue bien plus dangereuse. Voilà une mission supplémentaire pour vous.",
        @"Falling down" = "Chute",
        @"Pingus intelligence reported that a huge factory located in the subtropical zone might be a reason of a climate change. They decided to go there and shut down the factories. This will be a long and dangerous expedition. Pingus and you will have to face many difficulties on your way. As the ice is melting, at first you have to build some bridges and watch out for the cliff." = "Les renseignements Pingus ont fait un rapport sur une immense usine situé dans la zone subtropicale qui devrait être la raison du changement climatique. Ils décidèrent d'y aller et d'arrêter les usines. Ce sera une expédition longue et dangereuse. Les Pingus et vous allez rencontrer de nombreuses difficultés sur votre chemin. Comme la glace est en train de fondre, tout d'abord vous devez construire quelques ponts et faire attention à la falaise.",
        @"Destination North" = "Destination Nord",
        @"For now, Pingus are leaving South Pole and moving North. You have to help them!" = "Désormais, les Pingus quittent le pôle sud et s'en vont vers le nord. Vous devez les aider !",
        @"The Cave" = "La Grotte",
        @"Pingus on their way came across a huge cave. You have to lead them through. Remember that sometimes there is more than one way out. Hint: To 'unlock' blockers you can use bashers and jumpers." = "Sur leur chemin, les Pingus découvrirent une immense grotte. Vous devez les aider à la traverser. Souvenez-vous qu'il y a parfois plus d'une solution. Conseil : Pour « débloquer » les bloqueurs, vous pouvez utiliser les défonçeurs ou les sauteurs.",
        @"Difficulties on the way" = "Des problèmes en chemin",
        @"It looks you have encountered serious difficulties. But don't panic, Pingus are waiting for your orders, they count on you so don't fail! Hint: Miners, diggers and bashers are very important here!" = "Il semble que vous rencontriez quelques difficultés. Mais ne paniquez pas, les Pingus attendent vos ordres, ils comptent sur vous alors vous ne pouvez pas échouer ! Conseil : les mineurs, foreurs et défonçeurs sont très importants ici !",
        @"Four ways out" = "Les quatre chemins",
        @"It's getting warmer but Pingus are bravely moving North. This time it will be much easier. There are at least four ways out. Could you find them?" = "Il fait plus chaud mais les Pingus se déplacent avec bravoure vers le Nord. Cette fois ce sera beaucoup plus facile. Il y a au moins quatre chemins possible. Pouvez-vous les trouver ?",
        @"Egypt - So easy" = "Égypte - Trop facile",
        @"Pingus reached Egypt. Looks easy, but is it really so easy? Try it out." = "Les Pingus ont atteint l'Égypte. Cela semble facile, mais est-ce vraiment si facile ? À vous d'essayer.",
        @"Egypt - Oasis" = "Égypte - Oasis",
        @"Last time it was easy. Now it will be a little bit harder. Pingus are entering oasis. Watch out for the water." = "La dernière fois c'était facile. Maintenant cela va être un peu plus dur. Les Pingus sont en train de rentrer dans une oasis. Méfiez-vous de l'eau.",
        @"Egypt - The Maze" = "Égypte - Le labyrinthe",
        @"You came across a maze. Can you find the way out? Think twice before digging." = "Vous voilà en face d'un labyrinthe. Parviendrez-vous à trouver le chemin de la sortie ? Réfléchissez-y à deux fois avant de creuser.",
        @"Egypt - Pyramids" = "Égypte - Les Pyramides",
        @"The maze led you to the big pyramids. Now you have 4 minutes to escape. Hurry up!" = "Le labyrinthe vous a conduit aux grandes pyramides. Maintenant vous avez 4 minutes pour vous échapper. Dépêchez-vous !",
        @"Bomb and Double Catch" = "Bombe et double capture",
        @"Here you might have some time to relax. The path isn't complicated and a bit of bombing and catching of Pingus should bring you to the end without much trouble, but don't relax to much, your resources are limited, so be careful when using them." = "Ici vous pourriez voir du temps pour vous reposer. Le chemin n'est pas compliqué et quelques largages et saisies de Pingus devraient vous mener à la fin sans trop de soucis, mais ne vous reposer pas trop, car vos ressources sont limitées, donc attention à bien les utiliser.",
        @"Up, Up and Away" = "En haut, en haut et dehors",
        @"The exit is in a weird spot here, straight above. A bridge won't get you there, but your toolset allows an alternative way. Can you figure it out?" = "La sortie se trouve à un endroit étrange, juste au dessus. Un pont ne vous permet pas de l'atteindre, mais votre boîte à outils vous permet d'utiliser une voie alternative. La trouverez-vous ?",
        @"If only penguins could fly" = "Si seulement les manchots pouvaient voler",
        @"Bridges are kind of rare around here, so don't waste any. That aside, you shouldn't have to much trouble here, everything to do here you should have learned, but you might have to use all that knowledge at once." = "Les pont sont rares dans cette région, ne les gâchez pas. Mis à part ceci, vous ne devriez pas avoir de problèmes ici, vous avez déjà appris tout ce dont vous avez besoin ici, mais vous devrez probablement utiliser toute cette connaissance.",
        @"Stairway to Heaven" = "L'escalier du Paradis",
        @"Here things start to get a little complicated. Getting up to the exit is hard enough with a single Pingu, but with all of them? Impossible! But wait, who says they have to come the same way?" = "Ici les choses commencent à se compliquer. Atteindre la sortie avec un seul Pingu est déjà difficile, mais pour tout le groupe ? Impossible ! Mais attendez, qui a dit qu'il devaient tous emprunter le même chemin ?",
        @"Misdirection Everywhere" = "Mauvaises directions partout",
        @"The last level for this Xmas. Looks a little complicated, right? Don't worry with all you have learned so far, you should be able to even solve this.\n\nGood Luck & a Merry Xmas 2011" = "Le dernier niveau de ce Noël. Il a l'air compliqué, n'est-ce pas ? Ne vous inquiétez pas, avec tout ce que vous avez appris jusqu'à présent, vous devriez être capable de résoudre celui-ci.\n\nBonne chance et un Joyeux Noël 2011",
        @"The Big Jump" = "Le Grand Saut",
        @"No Way to Stop" = "Impossible de s'arrêter",
        @"Here you don't have much time to waste. The path to the exit is clear and straight, but you don't have the time to prepare it. Can you find a way to leap ahead?" = "Ici vous n'avez pas de temps à perdre. Le chemin vers la sortie est évident et droit, mais vous n'avez pas le temps de le préparer. Pouvez-vous trouver un moyen de bondir en avant ?",
        @"Ice Block Blockage" = "Blocage de Blocs de Glace",
        @"What's this? A gigantic ice block straight in the path? Where did that come from? No time wondering about things like that. The Pingus need to get to the exit and it's your job to find a way around the block." = "Qu'est-ce ? Un gigantesque bloc de glace est sur le chemin ? D'où vient-il ? Pas le temps de se poser des questions. Les Pingus doivent rejoindre la sortie et c'est votre travail de trouver un moyen de contourner le bloc.",
        @"The Impossible Bridge" = "Le Pont Impossible",
        @"Two groups of Pingus separated by a deep byss, joining them by a bridge seems impossible, but wise coordination of the two groups and a brave leap should let you make it to the exit." = "Deux groupes de Pingus sont séparés par une abysse profonde. Les faire se rejoindre à l'aide d'un pont semble impossible mais une sage coordination des deux groupes et un bond courageux devrait vous permettre d'atteindre la sortie.",
        @"Spiraling Away" = "Partir en Spirale",
        @"The exit is straight below, but the path is blocked by solid steel with no way through. But the Pingus have a versatile toolset at hand, can you use it to find a way around and make it to the exit?" = "La sortie est juste en face, mais le chemin est bloqué par du métal solide impossible à traverser. Mais les Pingus ont des outils versatiles à disposition, pouvez-vous les utiliser pour trouver un détour et les amener à la sortie ?",
        @"Tutorial Island" = "Île des Apprentissages",
        @"Learn the basics" = "Apprenez les bases",
        @"Watch Ending" = "Fin du Visionnage",
        @"Watch Intro" = "Voir l'intro",
        @"The Journey Begins" = "L'aventure commence",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Depuis très longtemps, les Pingus vivaient en paix au Pôle Sud enr\ncompagnie tous les autres animaux. Tout était en harmonie et rienr\nne semblait pouvoir perturber cet équilibre. Les Pingus étaient heureuxr\net cela semblait devoir durer éternellement.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Pourtant, un jour, les choses se mirent à changer : le ciel devint\nplus sombre et la terre se réchauffa peu à peu. Au début, ils\npensèrent qu'il ne s'agissait que d'une variation normale du climat\nplanétaire, mais les choses semblèrent s'aggraver d'année en année.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "La neige se mit à fondre par endroits et la nourriture commença à se faire\nrare. D'autres animaux essayèrent de quitter la région pour des endroits\nplus frais, mais les Pingus savaient que ce ne serait d'aucun secours,\net qu'ils devaient faire quelque chose face à ce problème.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Conseil des Anciens se rassembla donc pour décider de ce qu'ils allaient\nfaire. Ils décidèrent d'envoyer une expédition parcourir le monde pour\ntrouver la cause de ce réchauffement. Le groupe était constitué de centaines\nde Pingus parmi les plus braves du Pôle Sud.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "De plus, ils vous ont choisi afin de les mener dans cette aventure\nautour du monde. Puisque cette aventure va être périlleuse et très\ndifficile, votre première étape se situe sur l'Île de Mogorok,\nmieux connue sous le nom de l'Île des Apprentissages. D'après les\nAnciens, cette île a toujours été la première étape des Pingus envoyés\nà travers le monde.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "Cette île se compose de nombreuses régions, idéales pour l'entraînement\ndes facultés des Pingus. Les Pingus peuvent s'excercer à construire\ndes ponts, a grimper, a creuser et tous les autres talents dont ils\nauront besoin dans long et dangereux voyage.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "Là, vous pourrez vous exercer à commander et à diriger les Pingus.\nVous pourrez également vous familiariser avec toutes les capacités des\nPingus et apprendre à les maîtriser, car elles vous seront nécessaires dans\ncette aventure autour du monde.",
        @"Now that you and the Pingus have arrived at Tutorial Island it is time to take command and begin your mission.\n\nGood Luck!" = "Maintenant que vous et les Pingus êtes arrivés sur l'Île des Apprentissages, il est l'heure de prendre les commandes et commencer votre mission.\n\nBonne chance !",
        @"The Journey Continues" = "L'Aventure Continue",
        @"Now after you and the Pingus have learned the basics and practiced a bit it is time to move on and begin the journey into the world. Since the ice floe with which the Pingus traveled to the Tutorial Island isn't going to hold on the whole way into the warmer climates the Pingus have to find something else to guide them on their journey." = "Maintenant que vous et les Pingus avez appris les bases et\npratiqué un peu, le moment est venu de débuter votre aventure dans\nle monde. Comme le glacier sur lequel vous aviez voyagé jusqu'à\nl'Ile des Apprentissages ne tiendra pas le coup dans les régions\nchaudes, les Pingus doivent trouver quelque chose d'autre pour les\nguider dans leur périple.",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "Mais, comme l'avaient dit les Sages, l'Île des Apprentissages est non seulement un moyen de s'entraîner, mais également le pointr\nd'entrée dans le monde. Après quelques recherches, les Pingus découvrirent la signification de ces paroles, et découvrirent quer\nl'immense arbre au bout de l'île donnait assez de bois pour construire un radeau.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Alors les Pingus se mirent à la tâche et contruisirent de\ngrands radeaux, suffisamment pour les transporter tous. Après avoir\nfait le plein de provisions, ils étaient finalement prêts à débuter\nleur voyage et à quitter leur terres familières pour entrer dans\nles zones inconnues du monde.",
        @"So the Pingus sit on their raft, worrying about what's to come and where to go, while floating into the sunset.\n\nTo be continued..." = "Les Pingus s'assirent sur leur radeau, s'inquiétant pour leur futur et leur destination, tout en naviguant dans le crépuscule.\n\nÀ suivre ...",
        @"Alien by Josh Dye" = "Alien par Josh Dye",
        @"Escape from alien" = "Échappez aux aliens",
        @"Crystal" = "Cristal",
        @"Crystaline sparkling full of danger" = "Eau pétillante cristalline et pleine de dangers",
        @"Desert" = "Désert",
        @"Getting hot outside..." = "La température monte dehors...",
        @"Factory Campaign" = "La campagne de l'usine",
        @"Pingus expedition" = "L'expédition des Pingus",
        @"Halloween 2011" = "Halloween 2011",
        @"Going Underground" = "On va au sous-sol",
        @"Halloween 2007" = "Halloween 2007",
        @"Trapped at All Hallows Eve" = "Coincés à Halloween",
        @"Hellmouth" = "La bouche de l'enfer",
        @"A cave full of slime..." = "Une grotte pleine de slime...",
        @"Jungle" = "Jungle",
        @"Island of Mystery" = "L'île aux mystères",
        @"Marooned on an Uncharted Isle [by Lachlan McCubbin]" = "Naufragés sur une île inconnue [par Lachlan McCubbin]",
        @"Pac-Man" = "Pac-Man",
        @"Trapped in a video game" = "Piégés dans un jeu vidéo",
        @"Xmas 2011" = "Noël 2011",
        @"Merry Christmas and a Happy New Year" = "Joyeux Noël et bonne année",
    ],
]
