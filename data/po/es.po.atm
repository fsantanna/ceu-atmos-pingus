:pingus.po [
    lang = "es",
    texts = [
        @"Object:" = "Objeto:",
        @"Nothing selected" = "No hay nada seleccionado",
        @"Transparent" = "Transparente",
        @"Solid" = "Sólido",
        @"Ground" = "Suelo",
        @"Bridge" = "Puente",
        @"Water" = "Agua",
        @"Lava" = "Lava",
        @"Remove" = "Eliminar",
        @"Direction:" = "Dirección:",
        @"Left" = "Izquierda",
        @"Misc" = "Varios",
        @"Right" = "Derecha",
        @"ReleaseRate:" = "Ratio de liberación:",
        @"Para-X:" = "Para-X:",
        @"Para-Y:" = "Para-Y:",
        @"Scroll-X:" = "Deslizamiento-X",
        @"Scroll-Y:" = "Deslizamiento-Y:",
        @"Owner Id:" = "Id propietario:",
        @"Z-Pos:" = "Posición Z",
        @"Color:" = "Color:",
        @"Small Stars:" = "Estrellas pequeñas:",
        @"Middle Stars:" = "Estrellas medianas:",
        @"Large Stars:" = "Estrellas grandes:",
        @"Repeat:" = "Repetición:",
        @"Id:" = "Id:",
        @"Target Id:" = "Id de destino:",
        @"Height:" = "Altura:",
        @"Object: [Group]" = "Objeto: [Grupo]",
        @"Group not supported" = "Grupo no permitido",
        @"Object: " = "Objeto: ",
        @"New level" = "Nuevo nivel",
        @"Open level..." = "Abrir nivel...",
        @"Save level..." = "Guardar nivel...",
        @"Save level as..." = "Guardar nivel como...",
        @"Play level..." = "Jugar nivel...",
        @"Configure actions" = "Configurar acciones",
        @"Configure level" = "Configurar el nivel",
        @"Display object properties" = "Mostrar las propiedades del objeto",
        @"Show object insertion window" = "Mostrar ventana de inserción de objetos",
        @"Show minimap" = "Mostrar minimapa",
        @"Duplicate the selected objects" = "Duplicar los objetos seleccionados",
        @"Delete the selected objects" = "Borrar los objetos seleccionados",
        @"Raise object to top" = "Elevar el objeto al primer plano",
        @"Raise object" = "Elevar objeto",
        @"Lower object" = "Bajar objeto",
        @"Lower object to bottom" = "Bajar objeto al fondo",
        @"Flip object horizontally" = "Invertir objeto horizontalmente",
        @"Flip object vertically" = "Invertir objeto verticalmente",
        @"Rotate object -90 degree" = "Rotar el objeto -90 grados",
        @"Rotate object 90 degree" = "Rotar el objeto 90 grados",
        @"Display help" = "Mostrar la ayuda",
        @"Exit" = "Salir",
        @"Datadir" = "Directorio de datos",
        @"Userdir" = "Directorio de usuario",
        @"Open" = "Abrir",
        @"Save" = "Guardar",
        @"Cancel" = "Cancelar",
        @"Filename:" = "Nombre del archivo:",
        @"Pathname:" = "Nombre de la ruta:",
        @"Open a level" = "Abrir un nivel",
        @"Save your level" = "Guarda tu nivel",
        @"== Editor Help ==" = "== Ayuda del editor ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Seleccionar todo\nLimpiar la selección\nElevar objetos\nBajar objetos\nGirar 90 grados\nGirar 270 grados\nAgrupar los objetos seleccionados\nDesagrupar los objetos seleccionados\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Invertir el objeto horizontalmente\nInvertir el objeto verticalmente\nBorrar todos los objetos marcados\nMover los objetos un píxel\nMover los objetos 32 píxeles\nCambiar el color de fondo\nIncrementar/disminuir la repetición\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Deberías nombrar tus ficheros de forma sistemática, p.e. por su tema, su número y tu alias:\n\n<nombre><número>.<creador>.pingus\n\nDe forma que si creas tu segundo nivel con un tema de piedras, llámalo: piedras2-tunombre.pingus\n\nCuando hayas creado un nivel y lo quieras incluir en el juego manda un correo a:\n\npingus-devel@nongnu.org\n\nSólo los niveles publicados bajo la GPL están permitidos en el juego. El editor inserta automáticamente una referencia a la GPL, si quieres tener tu nivel bajo una licencia diferente deberás cambiar dicha referencia.\n",
        @"Replace" = "Reemplazar",
        @"Entrance" = "Entrada",
        @"Groundpiece (ground)" = "Suelo (terreno)",
        @"Groundpiece (solid)" = "Suelo (sólido)",
        @"Groundpiece (bridge)" = "Suelo (puente)",
        @"Groundpiece (transparent)" = "Suelo (trasparente)",
        @"Groundpiece (remove)" = "Suelo (borrar)",
        @"Hotspot" = "Punto caliente",
        @"Background" = "Fondo",
        @"Liquid" = "Líquido",
        @"Trap" = "Trampa",
        @"Weather" = "Clima",
        @"Special Object" = "Objeto especial",
        @"Prefab Object" = "Objeto prefabricado",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Liberados:%3d/%d  Fuera:%3d Salvados:%3d/%d",
        @"Angel" = "Ángel",
        @"Basher" = "Excavador",
        @"Blocker" = "Bloqueador",
        @"Boarder" = "Surfista",
        @"Bomber" = "Bombardero",
        @"Bridger" = "Ingeniero",
        @"Climber" = "Escalador",
        @"Digger" = "Perforador",
        @"Drown" = "Ahogado",
        @"Exiter" = "Salvado",
        @"Faller" = "En caída",
        @"Floater" = "Flotador",
        @"Jumper" = "Saltador",
        @"Laserkill" = "Láser",
        @"Miner" = "Minero",
        @"Slider" = "Deslizador",
        @"Smashed" = "Aplastado",
        @"Splashed" = "Estrellado",
        @"Superman" = "Superman",
        @"Teleported" = "Teletransportado",
        @"Waiter" = "Esperando",
        @"Walker" = "Caminante",
        @"skip" = "saltar",
        @"Play" = "Jugar",
        @"Back" = "Volver",
        @"Number of Pingus: " = "Número de pingus: ",
        @"Number to Save: " = "Número a salvar: ",
        @"Time: " = "Tiempo: ",
        @"Author: " = "Autor/a: ",
        @"Close" = "Cerrar",
        @"Fullscreen" = "Pantalla completa",
        @"Mouse Grab" = "Capturar el ratón",
        @"Software Cursor" = "Cursor por software",
        @"Autoscrolling" = "Autodesplazamiento",
        @"Drag&Drop Scrolling" = "Desplazar arrastrando",
        @"Print FPS" = "Muestra los FPS",
        @"Resolution:" = "Resolución:",
        @"Renderer:" = "Renderizador:",
        @"Language:" = "Idioma:",
        @"Master Volume:" = "Volumen maestro:",
        @"Sound Volume:" = "Volumen de sonido:",
        @"Music Volume:" = "Volumen de música:",
        @"Option Menu" = "Menú de opciones",
        @"Some options require a restart of the game to take effect." = "Algunas opciones requieren un reinicio del juego para surtir efecto",
        @"Story" = "Historia",
        @"..:: Start the game ::.." = "..:: Iniciar el juego ::..",
        @"Editor" = "Editor",
        @"..:: Create your own levels ::.." = "..:: Crea tus propios niveles ::..",
        @"Options" = "Opciones",
        @"..:: Configure the game ::.." = "..:: Configurar el juego ::..",
        @"Levelsets" = "Niveles",
        @"..:: Play User Built levels ::.." = "..:: Juga a niveles creados por los usuarios ::..",
        @"..:: Bye, bye ::.." = "..:: ¡Adiós! ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: capturar ratón :: F10: FPS  :: F11: pantalla completa :: F12: capturar pantalla ::..",
        @"Give up" = "Abandonar",
        @"Retry" = "Reintentar",
        @"Success!" = "¡Lo has logrado!",
        @"Failure!" = "¡Has fracasado!",
        @"Perfect! You saved everyone possible - great!" = "¡Perfecto! Has salvado a todos - ¡bien!",
        @"No-one got killed, pretty good work." = "No ha muerto nadie, muy buen trabajo.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Has salvado exactamente los que necesitabas - lo conseguiste, pero...\n¿quizá podrías hacerlo mejor?",
        @"Not everybody was saved, but still good work!" = "No los has salvado a todos, pero aun así ¡buen trabajo!",
        @"What can I say, you made it - congratulations!" = "Qué puedo decir, lo has conseguido - ¡felicidades!",
        @"You killed everybody, not good." = "Los has matado a todos, eso no es bueno.",
        @"No-one got saved - I know you can do better." = "No salvaste ni uno - sé que puedes hacerlo mejor.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "No salvaste los suficientes, pero has salvado a unos pocos.\nLa próxima vez lo harás mejor.",
        @"Only one more and you would have made it - try again!" = "Sólo uno más y lo habrías conseguido - ¡inténtalo de nuevo!",
        @"Only a handful more and you would have made it - try again!" = "Sólo unos pocos más y lo habrías conseguido - ¡inténtalo de nuevo!",
        @"Better luck next time!" = "¡Más suerte la próxima vez!",
        @"Saved: " = "Salvados: ",
        @"Died: " = "Muertos: ",
        @"Time left: " = "Tiempo restante: ",
        @"Under Construction" = "En construcción",
        @"Untested, unpolished and broken levels" = "Niveles no probados, poco pulidos y rotos",
        @"Solved:" = "Resueltos:",
        @"levels" = "niveles",
        @"???" = "???",
        @"Show Ending?" = "¿Mostrar el final?",
        @"Leave?" = "¿Abandonar?",
        @"[OPTIONS]... [FILE]" = "[OPCIONES]... [FICHERO]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Pingus es un juego de rompecabezas en el que debes guiar a un puñado de pequeños pingüinos alrededor del mundo.",
        @"General Options:" = "Opciones generales:",
        @"Displays this help" = "Muestra esta ayuda",
        @"Print version number and exit" = "Mostrar el número de versión y salir",
        @"Enable info level log output" = "Activar el nivel de información del registro",
        @"Enable debug level log output" = "Activar el nivel de depuración del registro",
        @"Disable all log output" = "Desactivar el registro",
        @"Display Options:" = "Opciones de pantalla:",
        @"Start in Window Mode" = "Inicia en ventana",
        @"Start in Fullscreen" = "Inicia en pantalla completa",
        @"Use the given renderer (default: sdl)" = "Usa el renderizador indicado (por defecto: sdl)",
        @"Set the window resolution for pingus (default: 800x600)" = "Establece la resolución del juego (por defecto: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Establece la resolución utilizada en el modo de pantalla completa (por defecto: 800x600)",
        @"Enable software cursor" = "Activa el cursor por software",
        @"Game Options:" = "Opciones de juego:",
        @"Disable automatic scrolling" = "Desactivar desplazamiento automático",
        @"Enable drag'n drop scrolling" = "Activar desplazamiento arrastrando",
        @"Sound Options:" = "Opciones de sonido:",
        @"Disable sound" = "Desactivar sonido",
        @"Disable music" = "Desactivar la música",
        @"Select language to use with Pingus" = "Selecciona el idioma del juego",
        @"List all available languages" = "Lista todos los idiomas disponibles",
        @"Loads the level editor" = "Carga el editor de niveles",
        @"Directory Options:" = "Opciones de directorio:",
        @"DIR" = "DIRECTORIO",
        @"Load game datafiles from DIR" = "Cargar los archivos de datos del juego desde DIRECTORIO",
        @"Load config files and store savegames in DIR" = "Cargar los ficheros de configuración y guardar las partidas en DIRECTORIO",
        @"Load game modifications from DIR" = "Cargar las modificaciones del juego desde DIRECTORIO",
        @"Don't read ~/.pingus/config" = "No leer ~/.pingus/config",
        @"FILE" = "ARCHIVO",
        @"Read config options from FILE" = "Leer las opciones de configuración desde FICHERO",
        @"Uses the controller given in FILE" = "Usa el controlador indicado en ARCHIVO",
        @"Debug Options:" = "Opciones de depuración:",
        @"Enables some special features for developers" = "Activa algunas características especiales para los desarrolladores",
        @"Set the game speed (0=fastest, >0=slower)" = "Establece la velocidad del juego (0=la más rápida, >0=más lenta)",
        @"Set the desired game framerate (frames per second)" = "Establecer la tasa de fotogramas deseada (fotogramas por segundo)",
        @"Set the size of the map tiles (default: 32)" = "Establece el tamaño de los mosaicos del mapa (por defecto: 32)",
        @"Pingus: Out of memory!" = "Pingus: ¡Memoria insuficiente!",
        @"Pingus: Standard exception caught!:\n" = "Pingus: ¡Interceptada excepción estándar!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: ¡Interceptada excepción desconocida!",
        @"unlimited" = "ilimitado",
        @"Screenshot: Saving screenshot to: " = "Captura de pantalla: guardando captura en: ",
        @"Screenshot: Screenshot is done." = "Captura de pantalla: captura realizada.",
        @"Screenshot: Couldn't write file: " = "Captura de pantalla: no se ha podido grabar el archivo: ",
        @"If the way is blocked, bash away" = "Si el camino está bloqueado, excava",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "Similar al perforador que has visto en anteriores niveles, hay una habilidad que permite a los pingus cavar horizontalmente, en vez de verticalmente como el perforador. Esta nueva habilidad se llama excavar. ",
        @"Sacrifice a few and save the rest" = "Sacrifica a unos cuantos y salva al resto",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "A veces no hay otras habilidades disponibles, así que tendrás que abrirte camino recurriendo a explosivos. Los pingus pueden hacer esto autodestruyéndose. Esto les matará, pero a veces es necesario sacrificar a unos cuantos para salvar al resto. ",
        @"Learning to dig" = "Aprendiendo a perforar",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Esta es tu primera misión. Como siempre, es bastante fácil. Todo lo que tienes que hacer es darle a cada pingu la orden de cavar un agujero en el suelo para que puedan llegar a la salida. Esto se puede conseguir simplemente haciendo clic sobre un pingu. ",
        @"Float or Die" = "Flota o muere",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "¡Bien hecho en tu primera misión! Esta vez necesitarás equipar a tus pingus con un pequeño propulsor. De este modo podrán flotar suavemente hasta el suelo. Si los pingus caen desde mucha altura no sobrevivirán al impacto ¡así que mantén los ojos abiertos! ",
        @"Jump for joy" = "Saltar por placer",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "A veces un pingu necesita alcanzar una plataforma lejana, pero no puede llegar andando. Entonces es cuando el saltador viene de perlas, ya que permite al pingu efectuar un pequeño salto y así alcanzar la plataforma. ",
        @"Miner's heaven" = "El paraíso de los mineros",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "Una nueva acción entra en escena - otra acción para cavar, en este caso en diagonal. Permite a un pingu excavar diagonalmente a través del suelo, creando así un camino para los demás pingus. La acción se llama minero. ",
        @"Panic Island (float/bash)" = "La isla del pánico(flota/excava)",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Mientras los niveles previos no han requerido muchos reflejos por tu parte, este se vuelve más complicado. Los pingus vienen de dos entradas en paralelo, y es tu trabajo coordinar los dos grupos sabiamente. ",
        @"Jump'n Bump... and Bash..." = "Salta y bota... y excava...",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "Es la hora del pánico otra vez. Los pingus no saldrán muy rápido, pero te costará coordinarlos a todos ya que al salir chocan contra un muro y se dan la vuelta. Como sólo tienes que rescatar a 5, es factible, pero si pierdes el control puedes pausar el juego (tecla 'p') para examinar la situación antes de seguir. ",
        @"Two groups in parallel, coordinate wisely" = "Dos grupos en paralelo, coordínalos sabiamente",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Ahora tienes que coordinar a dos grupos simultáneamente. No te preocupes, porque éste nivel te da tiempo suficiente para pensar lo que vas a hacer. No más consejos esta vez, ¡pero buena suerte! ",
        @"Block'a Rock" = "Bloquea la roca.",
        @"Once again it's time to combine the things you have learned in your previous levels. Blast your way free and make sure you also keep the rest of the Pingus under control. The Blocker action will be helpful." = "Una vez más es la hora de combinar las cosas que has aprendido en los niveles anteriores. Perfora hasta liberar el camino y asegúrate de que también mantienes al resto de pingus bajo control. El bloqueador te será útil.",
        @"Climb, Climber,... Boom!" = "Escala, escalador,... ¡Boom!",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Como ya debes haber deducido de otros niveles, a veces tienes que combinar distintas habilidades para conseguir tu objetivo. Debido a la falta de un perforador en este nivel, el bombardero necesita aparecer. ¿Pero cómo puede alcanzar el lugar para explotar? ",
        @"Bridging gets more complicated..." = "Los puentes se complican...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "Una vez más tienes que combinar tus acciones con cuidadosa y sabiamente. Si no, puedes acabar en la fosa que hay justo delante de la salida, así que piensa como evitarlo. ",
        @"If too high, your Pingu will die..." = "Tu pingu morirá si cae desde demasiada altura...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "El trabajo en equipo es la forma de alcanzar la salida esta vez. Si no tienes suficientes flotadores para alcanzar la salida, envía unos cuantos y haz que preparen el camino para los demás. ",
        @"Learn to use the bridge" = "Aprende a usar el puente",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "Si no tienes saltadores a mano y necesitas superar un gran agujero, un puente puede ser de mucha ayuda. Toma algo de tiempo construirlo, pero, al contrario que el saltador, esta habilidad permite que los pingus que lo siguen puedan llegar también al otro extremo. ",
        @"Three solutions, it's up to you" = "Tres soluciones, tú eliges",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Ahora que ya has aprendido todas las habilidades, es hora de practicar un poco más. Este nivel te permite al menos tres formas distintas de solucionarlo. Tú eliges cuál. ",
        @"Climb, Climber, climb... and build a bridge" = "Escala, escalador, escala... y construye un puente",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "De nuevo tienes acceso a una nueva habilidad. La acción escalar permite a un pingu trepar por los muros, de forma que pueda llegar a sitios que pueden ser demasiado altos para alcanzarlos por otros medios. ",
        @"Entrance high, Exit low" = "Entrada alta, salida baja",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Si no tienes suficientes flotadores para bajar a todos los pingus hasta la salida, tienes que encontrar otras formas de llevarles allí. Ya deberías haber aprendido el resto todo lo que necesitas saber para este nivel en los anteriores, así que no tendrías que tener muchos problemas con este. ",
        @"One must prepare, the rest must follow" = "Uno debe preparar, el resto le debe seguir",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "A veces hay situaciones en las que no tienes un bloqueador a mano para coordinar a tus pingus. Tendrás que encontrar otras formas de mantenerlos bajo control mientras uno de ellos prepara el camino para el resto. ",
        @"Dig and float, just don't fall and smash" = "Perfora y flota, procura no caer y aplastarte",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "Al contrario que en los dos primeros niveles, ahora tienes dos habilidades disponibles. Tu trabajo vuelve a ser sencillo: selecciona una habilidad en el panel de la izquierda y aplícala a los pingus para que puedan llegar a la salida. Asegúrate de que no mueran demasiados. ",
        @"Dig, bash and other problems" = "Perforar, excavar y otros problemas",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Cuantos más niveles superes, más difíciles se volverán. Pero no temas, porque este es aún es bastante fácil. Usa lo que has aprendido en anteriores niveles y no tendrás muchos problemas. Si crees que has llegado a un punto en el que no hay solución, pulsa dos veces el botón del Apocalipsis abajo a la derecha e inténtalo de nuevo. ",
        @"Solid ground can block the path" = "El terreno duro puede bloquear el camino",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "Como ya has visto, tus pingus pueden excavar casi cualquier tipo de terreno, pero hay un material que no pueden penetrar: el acero. Estas regiones se muestran en el mapa en color gris oscuro y no pueden ser destruidas, así que deberás encontrar alguna forma de sortearlas. ",
        @"One jump to catch them all" = "Un salto para cogerlos a todos",
        @"The pingus have found themselves lost on their journey.  What is this mysterious place?  Smiling pumpkins, giant candlesticks, and some boiling soup below... what wizardry is this? Now, facing a deadly abyss right in front of them it's your job to save them. Can you save them from a terrible fate?" = "Los pingus se han perdido en su viaje. ¿Qué es este misterioso lugar? Calabazas sonrientes, palmatorias gigantes y un poco de sopa hirviente más abajo... ¿qué clase de brujería es esta? Ahora, enfrentados a un abismo mortal justo delante de ellos, es tu tarea salvarles. ¿Puedes librarles de su terrible destino?",
        @"One Thousand and One Jumps" = "Mil y un saltos",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "Con la salida tan alta y fuera del alcance de un pingu normal, ¿qué opciones hay? ¿Quizás pueda rescatarles un saltador? ¿O sólo conseguirá retrasar su inevitable destino? Es tu tarea descubrirlo, pero ¿eres lo suficientemente bueno como para salvarlos a todos?",
        @"Boom Boom" = "Boom Boom",
        @"You've mastered the last challenge and now face the next. Their path to salvation seems to be cursed, but by whom? There is no time to think about it, since the next deadly challenge already awaits the Pingus. Two mighty roots block the way, but without a basher at hand to bash them away, sacrifice might be the only option..." = "Has sido capaz de superar el último desafío y ahora te enfrentas al próximo. Su camino a la salvación parece maldito, pero ¿por quién? No hay tiempo para pensar en ello, pues el siguiente desafío mortal ya espera a los pingus. Hay dos raíces gigantescas que bloquean el paso, pero cuando sin ningún excavador a mano para perforarlas el sacrificio parece la única opción...",
        @"Full Circle" = "El circulo se cierra",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "La salida está tan cerca y a la vez tan inalcanzable. Un paso en la dirección equivocada, y los pingus se precipitárn hacia un horrible destino. Debes hacer algo para ayudarles, pero ¿hay suficiente tiempo? Tendrás que darte prisa, y no te puedes permitir ningún error. ¡Los pingus cuentan contigo!",
        @"Bridgers Nightmare" = "La pesadilla de los ingenieros",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "¿Quién ha puesto esta pared tan monstruosa aquí? Este terrible bloque separa a tus pingus de la salida. Parece imposible destruir esta horrible construcción, pero quizás un ingeniero pueda acudir al rescate. ¿Pueden construir sus puentes lo bastante altos para guiar al grupo una vez más hasta la salida de forma segura? ¿O alguien está jugando malvados trucos mentales contigo?\n\nDe nuevo la solución la eliges tú... la clave para el éxito de los pingus es tu materia gris, así que no permitas que te confundan y te lleven por un camino equivocado.",
        @"Locked up by the witch" = "Encerrados por la bruja",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "¿Es esto una prisión? Atrapados por sólidas paredes por todos lados, no parece haber forma de escapar. La salvación parece imposible. Pero espera... la pared de la derecha parece débil... ¿puede esto ser una vía de escape? ¿O es un falso camino que llevará a los pingus a su perdición?\n\nEste es un viaje peligroso, pero tendrás que hacerlo para descubrir como llevarlos a todos de nuevo hacia la libertad.",
        @"Splatterfest" = "Festival de caídas",
        @"This is by far the deepest pit the Pingus have yet encountered. Building a bridge across it seems obvious but that won't help since the exit is deep down in the pit itself. Pingus who try to go down the pit will just end up splattered all over the ground. You have two groups of Pingus at your disposal, can you make them work together to reach even an exit this well hidden?" = "Este es, de lejos, el pozo más profundo que los pingus jamás han encontrado. Construir un puente para cruzarlo parece obvio, pero eso no funcionará ya que la salida se encuentra abajo, en el propio agujero Los pingus que intenten bajar sólo conseguirán estrellarse contra el suelo. Tienes dos grupos de pingus a tu disposición... ¿puedes hacer que trabajen juntos para llegar incluso a una salida tan bien escondida?",
        @"Staircase Maintenance" = "Mantenimiento de la escalera",
        @"It seems we are up again against a mighty wall, and it is blocking the exit! But wait, some good soul has built a staircase around it. It seems, however, that the poor fool's efforts didn't last long, as the staircase is destroyed and full of holes. Can you fix it and make it over the wall? Yet of course you know that the right solution might not be the obvious one. But your Pingus are almost free, and they trust in your skill to guide them to safety once more. Succeed and you will have freed them once and for all from whatever evildoer that placed them in this nightmare... at least for this year." = "Parece que de nuevo tenemos que enfrentarnos a una tremenda pared, ¡y está bloqueando la salida! Pero espera: algún alma caritativa ha construido unas escaleras alrededor de la misma. Parece, sin embargo, que los esfuerzos del pobre diablo no duraron mucho, porque la escalera está destruida y llena de agujeros. ¿Puedes arreglarla y superar la pared? Aunque claro, tú ya sabes que la solución obvia podría no ser la correcta. Pero tus pingus ya son casi libres, y confían en tu habilidad para que les salves una vez más. Si tienes éxito les habrás liberado de una vez por todas del malhechor que les ha puesto en esta pesadilla... al menos por este año.",
        @"Down Into The Cave" = "Dentro de la cueva",
        @"The exit is far below and the pingus are separated from it by quite a distance. The path down is riddled with gulfs, so jumping and bridging will be the primary tool to get down there. But be careful, the last few steps require some extra cleverness." = "La salida está muy abajo, y los pingus están separados de la misma por una distancia considerable. El camino hacia abajo está plagado de abismos, así que saltar y hacer puentes serán las principales herramientas para llegar hasta allí. Pero ten cuidado, los últimos pasos requieren una dosis extra de inteligencia.",
        @"Round and Round" = "Vuelta y vuelta",
        @"Trapped in an eternal loop one brave pingu has to break out and go on a journey in search for the exit, but he mustn't be too happy once he found it, as there is still one last challenge he must solve before being allowed to enter it, otherwise all his friends might perish." = "Atrapados en un bucle sin fin, un pingu debe salir y embarcarse en un viaje en busca de la salida. Pero que no se alegre mucho cuando la encuentre, pues todavía hay un último reto que deberá solventar antes de que la entrada le sea permitida. En caso contrario, sus amigos perecerán.",
        @"Red Herring Cave" = "La cueva del arenque rojo",
        @"The exit is right above the pingus heads, with a few friendly arrows pointing the way. With jumpers around the solution should be obvious. But wait, can anything you find in a dark cave be trusted or is there some more going on which might slip your view? Thinking outside the box might be required." = "La salida se encuentra justo encima de las cabezas de los pingus, con unas pocas flechas amistosas señalando el camino. Teniendo saltadores a mano la solución debería ser obvia. Pero espera, ¿puedes confiar en cualquier cosa que encuentres en una cueva oscura, o hay algo más que pueda despistarte? Pensar de forma diferente podría ser necesario.",
        @"Group Coordination" = "Coordinación del grupo",
        @"Three groups are on their way to the exit, one of them trapped right above it, but locked into a box. None of them can make it alone, coordinate them wisely and everybody should be able to make it safely to the exit. " = "Tres grupos se dirigen hacia la salida, uno de ellos atrapado justo encima de ella, pero encerrados en una caja. Ninguno de ellos puede llegar solo. Coordínalos con sabiduría y todo el mundo debería ser capaz de llegar sano y salvo a la salida. ",
        @"Traps, Dangers and other Problems" = "Trampas, peligros y otros problemas",
        @"The path to the exit lays below, shimmering through the planks. But the fall is too high, deadly for sure. Can one pingu alone make it's way through the dangerous traps and secure the path to the exit?" = "El camino hasta la salida se extiende debajo, brillando a través de los tablones. Pero la caída es demasiado alta, mortal de necesidad. ¿Puede un solo pingu atravesar las peligrosas trampas y asegurar un camino hasta la salida?",
        @"Reach that Switch" = "Alcanza ese interruptor",
        @"The path to the exit is straight, flat and simple, but wait a solid door blocking the way? How can the pingus open it? Is that a switch there on the hill to the right? Might that be the solution to opening the door and freeing the pingus? But how can they reach that switch?" = "El camino hasta la salida es recto, plano y simple. Pero espera, ¿una puerta sólida bloqueando el paso? ¿Cómo pueden los pingus abrirla? ¿Eso que hay allí a la derecha de la colina es un interruptor? ¿Podría ser la solución para abrir la puerta y liberar a los pingus? ¿Pero cómo llegar hasta él?",
        @"The Collapsed Column" = "La columna desmoronada",
        @"High up above the green slime the pingus are moving from column to column, getting closer to the exit with each step, but wait, there is a second group of pingus, they are stuck. The column next to them has collapsed making getting to the exit impossible. Can you find a way around the abyss?" = "Muy por encima del cieno verde los pingus se mueven de columna en columna, acercándose a la salida a cada paso. Pero espera, hay un segundo grupo de pingus. Están atascados. La columna que hay a su lado se ha derrumbado, haciendo que sea imposible llegar hasta la salida. ¿Puedes encontrar una forma de sortear el abismo?",
        @"Island of Doom" = "La isla de la fatalidad",
        @"The pingus are released close together, but split up by a solid metal column with seemingly no way to join them back up. The journey will be dangerous and some height has be crossed with the exit hidden below. With some cleverness it should be possible to join those two groups back together." = "Los pingus son liberados muy juntos, pero separados por una columna de metal sólido sin forma aparente de volver a juntarlos. El viaje será peligroso y cierta altura debe ser cruzada con la salida escondida debajo. Con un poco de ingenio debería ser posible volver a unir los dos grupos.",
        @"Tower of Death" = "La torre de la muerte",
        @"The pingus are at the top of the tower, with no stairway around. The exit is deep down, hidden at the foot of the tower. How shall they make it down all that height with no floaters sight? A few well placed diggers should be enough to get the job done, but wait, no, their direction isn't quite right. You have to give them directions or it will be their doom." = "Los pingus se encuentran en lo alto de la torre, sin ninguna escalera a su alrededor. La salida está muy abajo, escondida al pie de la torre. ¿Cómo podrán bajar toda esta altura sin ningún flotador a la vista? Unos pocos perforadores deberían ser suficientes para conseguirlo. Pero espera... no, su dirección no es del todo correcta. Tienes que darles indicaciones, o será su perdición.",
        @"The Ones" = "Los Elegidos",
        @"This is the last stage the pingus have to pass during this Halloween. Two oddly familiar column are in the way. What do they mean? The two groups of pingus have to work together to make it down the columns to the exit far below." = "Esta es la última etapa que los pingus deben superar este Halloween. Dos columnas extrañamente familiares están en el camino. ¿Qué significan? Los dos grupos de pingus deben trabajar juntos para bajar por ellas hasta llegar a la salida.",
        @"Down the valley and up again" = "Bajando por el valle, y subiendo de nuevo",
        @"There is a large valley between the entrance and the exit. No bridge will be long enough to cross the valley, but can you find a way back up once you lead the Pingus down into the valley?" = "Hay un gran valle entre la entrada y la salida. Ningún puente será lo bastante largo para cruzarlo, pero... ¿puedes encontrar la forma de volver a subir una vez que hayas guiado a tus pingus dentro del valle?",
        @"Entering the pyramid" = "Entrando en la pirámide",
        @"After their long and dangerous journey through the desert the Pingus finally reach the large pyramid, but there is still a pedestal blocking their way." = "Después de su largo y peligroso viaje por el desierto los pingus llegan finalmente a la gran pirámide. Pero aún hay un pedestal bloqueando el camino.",
        @"The window room" = "La habitación de la ventana",
        @"After the Pingus have entered the pyramid, they reach a large room with a large window. The only problem they have is that the entrance to the room is much too high to survive the landing. Can you help them?" = "Después de entrar en la pirámide, los pingus llegan a una gran habitación con una gran ventana. El único problema que tienen es que la entrada de la habitación está demasiado arriba como para sobrevivir al aterrizaje. ¿Puedes ayudarles?",
        @"Grand Hall" = "El gran salón",
        @"The pingus have found themselves in the grand hall, a hall full of wonder and treasures. The exit however is high up and won't be easy to reach. Guide the pingus around the hall and maybe you will find a way." = "Los pingus se han encontrado con el gran salón, una habitación llena de maravillas y tesoros. La salida, sin embargo, está arriba, y no será fácil llegar. Guía a los pingus por la sala y quizás encuentres la forma.",
        @"Pass the pedestal" = "Pasa el pedestal",
        @"A large pedestal is blocking the way to the exit and there aren't enough bashers available to dig it away. Can you find a way to make it past the pedestal?" = "Un gran pedestal está bloqueando el camino hacia la salida y no hay suficientes excavadores disponibles para hacer un agujero. ¿Puedes encontrar una forma alternativa de superarlo?",
        @"The excavation of the pyramid" = "La excavación de la pirámide",
        @"The excavations are open to reach the pyramid for his redeeming content. Some excavations, however, is best done with two competitors. Who comes first?" = "Las excavaciones están abiertas para llegar a la pirámide a por su contenido redentor. Algunas excavaciones, sin embargo, es mejor hacerlas con dos competidores. ¿Quién va primero?",
        @"Catch them at the half way point" = "Atrápalos a medio camino",
        @"The Pingus are separated from the exit by large abyss. A simple bridge won't be enough to catch them safely, unless of course you find the right place to put it. Can you uncover that spot?" = "Los pingus están separados de la salida por un gran abismo. Un simple puente no bastará para atraparlos sin peligro. A no ser, claro está, que encuentres el lugar adecuado para ponerlo. ¿Sabrás encontrar ese punto?",
        @"Claustrophobia" = "Claustrofobia",
        @"Hidden deep below the pyramid the pingus come across a small underground room, but unfortunatley a large tree root blocks their path..." = "Escondida en el rincón más profundo de la pirámide, los pingus descubren una pequeña habitación subterránea. Pero lamentablemente una gran raíz de árbol les bloquea el camino...",
        @"A bit to the right a bit to left" = "Un poquito a la derecha, un poquito a la izquierda",
        @"Only the most audacious Pingus will be allowed to continue." = "Sólo a los pingus más audaces se les permitirá continuar.",
        @"25 Pingus free and 25 in the box" = "25 pingus libres y 25 en la caja",
        @"Okay for the Bridger but what can I do with Digger? You should save at least one Pingu trapped in the box above the exit." = "El ingeniero vale, ¿pero de qué me sirve el perforador? Deberías salvar al menos uno de los pingus atrapados en la caja que hay encima de la salida.",
        @"Tunnel Time" = "Hora de hacer túneles",
        @"Dig a tunnel and you might make it to the exit. Digger and miners and stuff have to work together." = "Cava un túnel y puede que llegues hasta la salida. Perforadores y mineros y similares deben trabajar juntos.",
        @"Crawlspace" = "Espacio confinado",
        @"The path to the exit is blocked and many small tunnels lead the way, but be careful some of those lead to certain death. Or is there something you can do about that and create a save passage for all the Pingus and lead them safely to the exit?" = "El camino hasta la salida está bloqueado y muchos pequeños túneles indican el camino. Pero ten cuidado, algunos conducen a una muerte segura. ¿O hay algo que puedas hacer al respecto para crear un pasillo seguro para todos los pingus y guiarlos sanos y salvos hacia la salida?",
        @"The Roof" = "El tejado",
        @"Sometimes the roofs are not good for refuge, sometimes it should be demolished! But be careful if you aren't precise enough, you might lead the Pingus straight to certain death." = "A veces los tejados no son buenos para refugiarse. ¡A veces deben ser demolidos! Pero ten cuidado. Si no eres lo bastante preciso, podrías llevar a tus pingus a una muerte segura.",
        @"Pingus Jones and the Last Exit" = "Pingus Jones y la última salida",
        @"Dr. Jones' notebook:\n\n  (1) the breath of God: only the penitent pingus will pass;\n  (2) the word of God... in reverse;\n  (3) the path of God: leap from the head of something like a cat." = "Libro de notas del doctor Jones:\n\n  (1) el aliento de Dios: sólo los pingus penitentes pasarán\n  (2) la palabra de Dios... al revés\n  (3) el camino de Dios: salta desde la cabeza de algo, \n        por ejemplo un gato",
        @"Near can mean far" = "Cerca puede significar lejos",
        @"What do you do when you're going in the wrong direction ? Simple: walk into a wall. But it is easier said than done..." = "¿Qué haces cuando vas en la dirección equivocada? Simple: chocar contra una pared. Pero es más fácil de decir que de hacer...",
        @"Trapped Underground" = "Atrapados bajo tierra",
        @"The penguins escaped the mad scientist, but now they were trapped deep underground. They had no food or water, so they had to move fast." = "Los pingüinos han escapado del científico loco, pero ahora están atrapados bajo tierra. No tienen comida ni agua, así que se tienen que mover rápido.",
        @"Experimentation" = "Experimentación",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Un científico loco ha capturado a los pingüinos y está experimentando con ellos. ¿Cómo pueden los pingüinos escapar a la guillotina?",
        @"Hall of Illusion" = "La sala de la ilusión",
        @"The penguins stopped and stood in indecision. What was real and what was not? Flame lanced from above and a guillotine glittered in the distance. Almost all penguins must survive." = "Los pingüinos se detuvieron indecisos. ¿Qué era real y qué no? Llamas brotaban desde arriba y una guillotina resplandecía a lo lejos. Casi todos los pingüinos deben sobrevivir.",
        @"The Lava Pit" = "El pozo de lava",
        @"The penguins had defeated the mad scientist, and were walking away from his destroyed laboratory when a huge hole opened under their feet. The penguins fell into an underground cave and the only way out was across the lava pit. Luckily, it seemed someone had left some helpful signs." = "Los pingüinos habían vencido al científico loco y estaban saliendo de su destruido laboratorio cuando un enorme agujero se abrió bajo sus pies. Los pingüinos cayeron a una cueva subterránea cuya única salida era a través del pozo de lava. Por suerte, parece que alguien dejó algunas señales útiles.",
        @"At least the experiments are over..." = "Por lo menos los experimentos terminaron...",
        @"The good news was that the mad scientist had tired of his experiments, the bad news was that now he was dumping them down a pit. A single floatation device was all the penguins had. Save as many as possible." = "La buena noticia es que el científico loco se había cansado de sus experimentos, la mala noticia es que ahora los estaba tirando por un agujero. Un solo dispositivo de flotación es todo lo que tenían los pingus. Salva a tantos como puedas.",
        @"Ghosting" = "Ghosting",
        @"The penguins came to a long pass. Acid bubbled underneath and it seemed a climber or two were needed.  Hint: slider can be used to stop the miner ability." = "Los pingus llegaron a un gran desfiladero. Ácido burbujeaba debajo, y parecía que un escalador o dos eran necesarios. Pista: el deslizador se puede usar para detener al minero.",
        @"The Final (and suprisingly easy) Challenge" = "El último (y sorprendentemente fácil) desafío",
        @"The penguins had reached the end of the island. In the water was a long tree, perfect for the penguin's needs. Their journey was almost over." = "Los pingüinos habían llegado al final de la isla. En el agua había un árbol largo, perfecto para las necesidades de los pingüinos. El viaje casi había concluido.",
        @"Revenge is sweet" = "La venganza es dulce",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down." = "Los pingüinos se habían escapado del científico loco pero ahora querían venganza. Pretendían destruir las estructuras de soporte, provocando que el malvado laboratorio se derrumbara.",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down. They had to move fast though, because the mad scientist would detect and recapture them if they weren't fast enough." = "Los pingüinos se habían escapado del científico loco pero ahora querían venganza. Pretendían destruir las estructuras de soporte, provocando que el malvado laboratorio se derrumbara. Pero tenían que moverse rápido, porque el científico loco los detectaría y volvería a capturarlos si no lo eran.",
        @"Winter Wonderland" = "Invierno en el país de las maravillas",
        @"After getting past the lava pit, the penguins walked and walked until they reached a snowed in exit. That would be relatively easy to tunnel through but how would it be possible to tunnel through solid metal?" = "Después de cruzar el pozo de lava, los pingüinos caminaron y caminaron hasta llegar a una salida nevada. Eso sería relativamente fácil de excavar, pero ¿cómo sería posible hacer un túnel a través de metal sólido?",
        @"The Journey Goes On" = "El viaje continúa",
        @"And so the penguins continued on their journey, drawing ever closer to the North Pole. They had escaped the guillotine, defeated the mad scientist and got a new boat. And so this chapter in their voyage was over, but there would be other obstacles. Nothing  would stop the determined penguins from reaching their goal." = "Y así los pingüinos continuaron con su viaje, acercándose cada vez más al Polo Norte. Habían escapado de la guillotina, derrotado al científico loco, y conseguido un nuevo bote. Y así terminaba este capítulo en su viaje, pero habrá otros obstáculos. Nada detendrá a los decididos pingüinos hasta que alcancen su objetivo.",
        @"Think fast (literally)" = "Piensa rápido (literalmente)",
        @"This would be simple but for one thing, there are no blockers. All the penguins must survive." = "Esto sería sencillo si no fuera por una cosa: no hay bloqueadores. Todos los pingüinos deben sobrevivir.",
        @"Shipwrecked" = "Náufragos",
        @"The penguins were sailing along happily on their makeshift boat until suddenly an island appeared. The penguins were drawn towards it and crashed, destroying their boat. Now they must find their way across this strange island." = "Los pingus estaban navegando felizmente en su improvisado bote hasta que, de repente, una isla apareció. Los pingüinos fueron arrastrados contra ella y se estrellaron, destruyendo su bote. Ahora deben encontrar la forma de atravesar esta extraña isla.",
        @"Escape from Aliens" = "Huída de los alienígenas",
        @"Aliens invade our starship blocking entrance to the teleporter. Your crew is well trained, like you they don't panic." = "Los alienígenas invaden nuestra nave bloqueando la entrada al teletransportador. Tu tripulación está bien entrenada, y al igual que tú no se deja dominar por el pánico.",
        @"Escape from Aliens 2" = "Huida de los alienígenas 2",
        @"Aliens are now closest making your escape harder. You must dig it up." = "Los alienígenas están ahora más cerca, dificultando tu huida. Te la tendrás que excavar.",
        @"Alien's nest" = "El nido alienígena",
        @"Pingus invade the nest. Take care of jaws. What's the matrix above?" = "Pingus invade el nido. Cuidado con las garras. ¿Cuál es la matriz de arriba?",
        @"Matrix of the death" = "La matriz de la muerte",
        @"Take a piece of paper. Now pingus have to enter the matrix of the death. This is a maze, bad ways are protect by jaws." = "Toma un pedazo de papel. Ahora pingus debe entrar a la matriz de la muerte. Esto es un laberinto, los malos caminos están protegidos por garras.",
        @"Spy's pingus in the matrix of the death" = "Pingus espías en la matriz de la muerte",
        @"Spy's pingus have marked the location of jaws in the matrix of the death. Many died to gain that information :..( Perhaps this help. Perhaps..." = "Los pingüinos de los espías han marcado las ubicaciones de las garras en la matriz de la muerte. Muchos han muerto para obtener esta informacion :..( Tal vez esto ayude. Tal vez...",
        @"Fourth dimension" = "Cuarta dimensión",
        @"The defenses of the aliens get stronger. Now you have to jump in the fourth dimension to win!" = "Las defensas de los alienígenas se refuerzan. ¡Ahora tienes que saltar a la cuarta dimensión para ganar!",
        @"Set your watches" = "Sincronizad vuestros relojes",
        @"Cooperation in space." = "Cooperación en el espacio.",
        @"Lost in Space" = "Perdidos en el espacio",
        @"We don't know where we are but we don't leave anybody behind." = "No sabemos dónde estamos, pero no dejamos a nadie atrás.",
        @"Outside In" = "De afuera a dentro",
        @"Can you help the pingus escape without getting their flippers wet?" = "¿Puedes ayudar a los pingus a escapar sin mojarse las aletas?",
        @"Endless Loop" = "Bucle infinito",
        @"To the right and to the left the Pingus will face certain death and you have to save 50. Can you help them get out of this mess?" = "A derecha e izquierda los pingus se enfrentan a una muerte segura, y debes salvar 50. ¿Puedes ayudarlos a salir de este lío?",
        @"Up up in the space" = "Arriba arriba en el espacio",
        @"What good is a pick in space? Certainly not to go to the stars." = "¿De qué sirve un pico en el espacio? Ciertamente no para ir a las estrellas.",
        @"Jump" = "Salta",
        @"All Pingus need is to jump.... Hint: While pausing (press P key) you still can control Pingus. " = "Todos lo que los pingus necesitan hacer es saltar... Pista: mientras estás en pausa (tecla P) puedes seguir controlando los pingus. ",
        @"Factory" = "Fábrica",
        @"Finally you reached the factory. Watch out as there are many dangers. Use bombers to destroy the basement of the factory. Good luck!" = "Finalmente has llegado a la fábrica. Vigila, pues hay muchos peligros. Utiliza bombarderos para destruir los cimientos. ¡Buena suerte!",
        @"Going back home" = "Volviendo a casa",
        @"Your mission is over. Pingus can go back home, but be careful!" = "Tu misión ha terminado. Los pingus pueden volver a casa, ¡pero ten cuidado!",
        @"Bonus track" = "Misión extra",
        @"Pingus are at home, but after the climate change living on the South Pole became more dangerous. There is one more mission for you." = "Los pingus están en casa, pero después del cambio climático vivir en el Polo Sur se ha vuelto más peligroso. Hay una misión más para ti.",
        @"Falling down" = "Cayendo",
        @"Pingus intelligence reported that a huge factory located in the subtropical zone might be a reason of a climate change. They decided to go there and shut down the factories. This will be a long and dangerous expedition. Pingus and you will have to face many difficulties on your way. As the ice is melting, at first you have to build some bridges and watch out for the cliff." = "El servicio de inteligencia de los pingus informa de que una inmensa fábrica situada en la zona subtropical podría ser uno de los motivos del cambio climático. Han decidido ir allí y detenerla. Esta será una expedición larga y peligrosa. Los pingus y tú deberéis afrontar numerosas dificultades en vuestro camino. Puesto que el hielo se derrite, primero tendréis que construir algunos puentes y vigilar con el precipicio.",
        @"Destination North" = "Destino norte",
        @"For now, Pingus are leaving South Pole and moving North. You have to help them!" = "De momento, los pingus están abandonando el Polo Sur y viajando hacia el norte. ¡Tienes que ayudarles!",
        @"The Cave" = "La cueva",
        @"Pingus on their way came across a huge cave. You have to lead them through. Remember that sometimes there is more than one way out. Hint: To 'unlock' blockers you can use bashers and jumpers." = "Los pingus se toparon con una cueva en su camino. Tienes que guiarlos a través de ella. Recuerda que a veces hay más de una salida. Pista: para \x22desbloquear\x22 a los bloqueadores puedes usar excavadores y saltadores.",
        @"Difficulties on the way" = "Dificultades en el camino",
        @"It looks you have encountered serious difficulties. But don't panic, Pingus are waiting for your orders, they count on you so don't fail! Hint: Miners, diggers and bashers are very important here!" = "Parece que te has topado con serias dificultades. Pero que no cunda el pánico, los pingus están esperando tus órdenes. Cuentan contigo, ¡así que no falles! Pista: ¡mineros, perforadores y excavadores son muy importantes aquí!",
        @"Four ways out" = "Cuatro posibles salidas",
        @"It's getting warmer but Pingus are bravely moving North. This time it will be much easier. There are at least four ways out. Could you find them?" = "Hace más calor, pero los pingus viajan valerosamente hacia el norte. Esta vez será mucho más fácil. Hay al menos cuatro salidas. ¿Podrás encontrarlas?",
        @"Egypt - So easy" = "Egipto - Muy fácil",
        @"Pingus reached Egypt. Looks easy, but is it really so easy? Try it out." = "Los pingus han llegado a Egipto. Parece fácil, ¿pero lo es realmente? Pruébalo.",
        @"Egypt - Oasis" = "Egipto - Oasis",
        @"Last time it was easy. Now it will be a little bit harder. Pingus are entering oasis. Watch out for the water." = "La última vez fue fácil. Ahora será un poco más difícil. Los pingus están entrando en el oasis. Cuidado con el agua.",
        @"Egypt - The Maze" = "Egipto - El laberinto",
        @"You came across a maze. Can you find the way out? Think twice before digging." = "Has llegado a un laberinto. ¿Puedes encontrar la salida? Piénsalo dos veces antes de perforar.",
        @"Egypt - Pyramids" = "Egipto - Pirámides",
        @"The maze led you to the big pyramids. Now you have 4 minutes to escape. Hurry up!" = "El laberinto te ha llevado hasta las grandes pirámides. Ahora tienes 4 minutos para escapar. ¡De prisa!",
        @"Bomb and Double Catch" = "Bombardea y atrapa por partida doble",
        @"Here you might have some time to relax. The path isn't complicated and a bit of bombing and catching of Pingus should bring you to the end without much trouble, but don't relax to much, your resources are limited, so be careful when using them." = "Aquí te puedes tomar un tiempo para relajarte. El camino no es complicado, y un poco de bombardeo y atrapar a los pingus debería llevarte al final sin muchos problemas. Pero no te relajes demasiado. Tus recursos son limitados, así que ten cuidado cuando los uses.",
        @"Up, Up and Away" = "Arriba, arriba y afuera",
        @"The exit is in a weird spot here, straight above. A bridge won't get you there, but your toolset allows an alternative way. Can you figure it out?" = "La salida se encuentra en un punto extraño esta vez, justo encima. Un puente no te llevará hasta allí, pero tus herramientas te permiten un camino alternativo. ¿Puedes descubrirlo?",
        @"If only penguins could fly" = "Si los pingüinos pudiesen volar",
        @"Bridges are kind of rare around here, so don't waste any. That aside, you shouldn't have to much trouble here, everything to do here you should have learned, but you might have to use all that knowledge at once." = "Los puentes son un poco escasos por aquí, así que no malgastes ninguno. Aparte de eso, no deberías tener muchos problemas. Todo lo que hay que hacer ya deberías haberlo aprendido, pero puede que tengas que usar todo ese conocimiento a la vez.",
        @"Stairway to Heaven" = "Escalera al cielo",
        @"Here things start to get a little complicated. Getting up to the exit is hard enough with a single Pingu, but with all of them? Impossible! But wait, who says they have to come the same way?" = "Aquí la cosa empieza a complicarse un poco. Llegar hasta la salida ya es lo bastante difícil con un sólo pingu, ¿pero con todos? ¡Imposible! Pero espera, ¿quién dice que tienen que ir por el mismo camino?",
        @"Misdirection Everywhere" = "Confusión por todas partes",
        @"The last level for this Xmas. Looks a little complicated, right? Don't worry with all you have learned so far, you should be able to even solve this.\n\nGood Luck & a Merry Xmas 2011" = "El último nivel para estas navidades. Parece un poco complicado, ¿verdad? No temas, con todo lo que has aprendido hasta ahora deberías ser capaz de resolver incluso esto.\n\nBuena suerte y feliz Navidad 2011",
        @"The Big Jump" = "El gran salto",
        @"No Way to Stop" = "No hay forma de parar",
        @"Here you don't have much time to waste. The path to the exit is clear and straight, but you don't have the time to prepare it. Can you find a way to leap ahead?" = "Aquí no tienes mucho tiempo que perder. El camino hasta la salida está despejado y recto, pero no tienes tiempo para prepararlo. ¿Puedes encontrar la forma de avanzar rápidamente?",
        @"Ice Block Blockage" = "Bloqueo por bloque de hielo",
        @"What's this? A gigantic ice block straight in the path? Where did that come from? No time wondering about things like that. The Pingus need to get to the exit and it's your job to find a way around the block." = "¿Qué es esto? ¿Un enorme bloque de hielo en mitad del camino? ¿De dónde ha salido? No hay tiempo para hacerse esta clase de preguntas. Los pingus necesitan llegar hasta la salida y es tu trabajo encontrar una forma de sortearlo.",
        @"The Impossible Bridge" = "El puente imposible",
        @"Two groups of Pingus separated by a deep byss, joining them by a bridge seems impossible, but wise coordination of the two groups and a brave leap should let you make it to the exit." = "Dos grupos de pingus separados por una profunda sima. Juntarlos mediante un puente parece imposible, pero una acertada coordinación de ambos grupos y un salto valiente deberían permitirte alcanzar la salida.",
        @"Spiraling Away" = "Huyendo en espiral",
        @"The exit is straight below, but the path is blocked by solid steel with no way through. But the Pingus have a versatile toolset at hand, can you use it to find a way around and make it to the exit?" = "La salida está justo debajo, pero el camino está bloqueado por acero sólido sin posibilidad de atravesarlo. Pero los pingus tienen un conjunto de herramientas versátil. ¿Puedes usarlo para encontrar un camino alternativo y llegar a la salida?",
        @"Tutorial Island" = "Isla Tutorial",
        @"Learn the basics" = "Aprende lo básico",
        @"Watch Ending" = "Ver el final",
        @"Watch Intro" = "Ver la introducción",
        @"The Journey Begins" = "Comienza el viaje",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Durante mucho tiempo los pingus han vivido felices y en paz en el Polo Sur junto a los demás animales. Todo estaba en equilibrio y parecía que nada iba a perturbar su paz. Los pingus eran felices y parecía que eso nunca iba a terminar.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Pero un día las cosas empezaron a cambiar lentamente: el cielo se oscureció y la tierra se calentó. Al principio pensaron que sería sólo una fluctuación normal en el clima del mundo, pero las cosas parecían ir a peor año tras año.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "La nieve empezó a derretirse en algunas zonas, y la comida empezó a escasear. Otros animales intentaron dejar la región buscando sitios más fríos, pero los pingus sabían que esto no ayudaría: sabían que tenían que hacer algo.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Así que el consejo de venerables ancianos se reunió para decidir lo que tenían que hacer. Decidieron enviar una expedición alrededor del mundo para encontrar la causa de este calentamiento. La expedición consistía de cientos de los pingus más valientes del Polo Sur.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "Y te eligieron a ti para liderarlos en su viaje alrededor del mundo. Dado que el viaje será peligroso y difícil, tu primer objetivo es la Isla de Mogorok, conocida también como Isla Tutorial. Según los venerables ancianos, esta isla siempre ha sido la primera parada de los pingus que eran enviados a explorar el mundo.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "La isla está consiste de varias zonas que son ideales para enseñar a los pingus sus habilidades. Los pingus pueden aprender a construir puentes, escalar, cavar y usar muchos otros talentos que necesitarán en su largo y peligroso viaje.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "Mientras estés allí, podrás practicar tus habilidades dirigiendo y guiando a los pingus. También podrás familiarizarte con todas las habilidades de las que disponen los pingus y aprender a dominarlas, ya que las necesitarás todas en tu viaje alrededor mundo.",
        @"Now that you and the Pingus have arrived at Tutorial Island it is time to take command and begin your mission.\n\nGood Luck!" = "Ahora que tú y los pingus habéis llegado a la Isla Tutorial es hora de tomar el mando y empezar tu misión.\n\n¡Buena suerte!",
        @"The Journey Continues" = "El viaje continúa",
        @"Now after you and the Pingus have learned the basics and practiced a bit it is time to move on and begin the journey into the world. Since the ice floe with which the Pingus traveled to the Tutorial Island isn't going to hold on the whole way into the warmer climates the Pingus have to find something else to guide them on their journey." = "Ahora que los pingus y tú habéis aprendido los fundamentos y practicado un poco, es hora de continuar y empezar el viaje por el mundo. Puesto que el témpano de hielo en el que viajaron los pingus a la Isla Tutorial no aguantará todo el camino hasta climas más cálidos, los pingus tienen que encontrar otra cosa que les guíe en su viaje.",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "Pero como dijeron los venerables ancianos, la Isla Tutorial no sólo ofrece una forma de practicar, sino que además es un punto de partida para adentrarse en el mundo. Tras investigar un poco, los pingus descubrieron el significado de esto, y encontraron un árbol gigante al final de la isla que les proporcionó madera para construir una balsa.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Así que los pingus salieron y construyeron unas grandes balsas, suficientes para transportarlos a todos. Después de empaquetar algunas provisiones se prepararon para empezar su aventura y abandonar su tierra natal y adentrarse en las tierras desconocidas del mundo.",
        @"So the Pingus sit on their raft, worrying about what's to come and where to go, while floating into the sunset.\n\nTo be continued..." = "Así que los pingus van sentados en su balsa, preocupados por lo que vendrá y adonde irán, mientras flotan bajo el sol poniente.\n\nContinuará...",
        @"Alien by Josh Dye" = "Alienígena por Josh Dye",
        @"Escape from alien" = "Huida del alienígena",
        @"Crystal" = "Cristal",
        @"Crystaline sparkling full of danger" = "Cristalino brillante lleno de peligros",
        @"Desert" = "Desierto",
        @"Getting hot outside..." = "Hace calor ahí fuera...",
        @"Factory Campaign" = "Campaña de la fábrica",
        @"Pingus expedition" = "Expedición de pingus",
        @"Halloween 2011" = "Halloween 2011",
        @"Going Underground" = "Bajo tierra",
        @"Halloween 2007" = "Halloween 2007",
        @"Trapped at All Hallows Eve" = "Atrapados en la víspera de Halloween",
        @"Hellmouth" = "La boca del infierno",
        @"A cave full of slime..." = "Una cueva llena de lodo",
        @"Jungle" = "Jungla",
        @"Island of Mystery" = "La isla del misterio",
        @"Marooned on an Uncharted Isle [by Lachlan McCubbin]" = "Aislados en una isla inexplorada [por Lachlan McCubbin]",
        @"Pac-Man" = "Pac-Man",
        @"Trapped in a video game" = "Atrapados en un videojuego",
        @"Xmas 2011" = "Navidad 2011",
        @"Merry Christmas and a Happy New Year" = "Feliz Navidad y próspero año nuevo",
    ],
]
