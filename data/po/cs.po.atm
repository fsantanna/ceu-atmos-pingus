:pingus.po [
    lang = "cs",
    texts = [
        @"Object:" = "Objekt:",
        @"Nothing selected" = "Prázdný výběr",
        @"Transparent" = "Průhledné",
        @"Solid" = "Pevné podloží",
        @"Ground" = "Zemina",
        @"Bridge" = "Most",
        @"Water" = "Voda",
        @"Lava" = "Láva",
        @"Remove" = "Odstranit",
        @"Direction:" = "Směr:",
        @"Left" = "Vlevo",
        @"Misc" = "Ostatní",
        @"Right" = "Vpravo",
        @"ReleaseRate:" = "Rychlost vypouštění:",
        @"Para-X:" = "Para-X:",
        @"Para-Y:" = "Para-Y:",
        @"Scroll-X:" = "Posun-X:",
        @"Scroll-Y:" = "Posun-Y:",
        @"Owner Id:" = "Id vlastníka:",
        @"Z-Pos:" = "Z-Poz:",
        @"Color:" = "Barva:",
        @"Small Stars:" = "Malé hvězdy:",
        @"Middle Stars:" = "Střední hvězdy:",
        @"Large Stars:" = "Velké hvězdy:",
        @"Repeat:" = "Opakování:",
        @"Id:" = "Id:",
        @"Target Id:" = "Id cíle:",
        @"Height:" = "Výška:",
        @"Object: [Group]" = "Objekt: [Skupina]",
        @"Group not supported" = "Skupina není podporována",
        @"Object: " = "Objekt: ",
        @"New level" = "Nová úroveň",
        @"Open level..." = "Otevřít úroveň...",
        @"Save level..." = "Uložit úroveň...",
        @"Save level as..." = "Uložit úroveň jako...",
        @"Play level..." = "Hrát úroveň...",
        @"Configure actions" = "Nastavit akce",
        @"Configure level" = "Nastavit úroveň",
        @"Display object properties" = "Zobrazit vlastnosti objektu",
        @"Show object insertion window" = "Zobrazit okno pro vkládání objektů",
        @"Show minimap" = "Ukázat minimapu",
        @"Duplicate the selected objects" = "Duplikovat vybrané objekty",
        @"Delete the selected objects" = "Vymazat vybrané objekty",
        @"Raise object to top" = "Zdvihnout objekt navrch",
        @"Raise object" = "Zdvihnout objekt",
        @"Lower object" = "Zatlačit objekt",
        @"Lower object to bottom" = "Zatlačit objekt dospod",
        @"Flip object horizontally" = "Překlopit objekt horizontálně",
        @"Flip object vertically" = "Překlopit objet vertikálně",
        @"Rotate object -90 degree" = "Otočit objekt o -90 stupňů",
        @"Rotate object 90 degree" = "Otočit objekt o 90 stupňů",
        @"Display help" = "Zobrazit nápovědu",
        @"Exit" = "Konec",
        @"Datadir" = "Datový adresář",
        @"Userdir" = "Uživatelský adresář",
        @"Open" = "Otevřít",
        @"Save" = "Uložit",
        @"Cancel" = "Zrušit",
        @"Filename:" = "Jméno souboru:",
        @"Pathname:" = "Cesta:",
        @"Open a level" = "Otevřít úroveň",
        @"Save your level" = "Uložit úroveň",
        @"== Editor Help ==" = "== Nápověda editoru ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Vybrat vše\nZrušit výběr\nVyzdvihnout objekty\nZatlačit objekty\nVyzdvihnout objekty na povrch\nZatlačit objekty dospod\nOtočit o 90 stupňů\nOtočit o 270 stupňů\nSeskupit vybrané objekty\nZrušit seskupení výběru\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Převrátit objekt horizontálně\nPřevrátit objekt vertikálně\nSmazat všechny označené objekty\nPosunout objekty o jeden pixel\nPosunout objekty o 32 pixelů\nPřepnout barvu pozadí\nZvýšit/snížit opakování\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Můžete své levely pojmenovávat systematicky, například podle jejich jména, čísla a vašeho jména:\n\n     <nazevLevelu><číslo>-<autor>.pingus\n\nTakže pokud jste vytvořili svůj druhý level s kameným (stone) vzhledem, pojmenujte ho: stone2-vašeJmeno.pingus\n\nPokud jste vytvořili level a chcete ho přidat do hry, pošlete ho na emailovou adresu:\n\n     pingus-devel@nongnu.org\n\nPouze levely publikované pod GPL licencí budou přidány do hry. Editor automaticky přidá odkaz \nna GPL licenci. Pokud chcete svůj level pod jinou licencí, musíte změnit tento odkaz.\n",
        @"Replace" = "Zaměnit",
        @"Entrance" = "Vchod",
        @"Groundpiece (ground)" = "Povrch (zemina)",
        @"Groundpiece (solid)" = "Povrch (pevné podloží)",
        @"Groundpiece (bridge)" = "Povrch (most)",
        @"Groundpiece (transparent)" = "Povrch (průhledný)",
        @"Groundpiece (remove)" = "Povrch (odstraňovač)",
        @"Hotspot" = "Hotspot",
        @"Background" = "Pozadí",
        @"Liquid" = "Tekutina",
        @"Trap" = "Past",
        @"Weather" = "Počasí",
        @"Special Object" = "Zvláštní objekt",
        @"Prefab Object" = "Polotovar",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Vysláno:%3d/%d   Venku:%3d   Doma:%3d/%d",
        @"Angel" = "Anděl",
        @"Basher" = "Tunelář",
        @"Blocker" = "Hlídač",
        @"Boarder" = "Skejťák",
        @"Bomber" = "Bombík",
        @"Bridger" = "Mostař",
        @"Climber" = "Horolezec",
        @"Digger" = "Kopáč",
        @"Drown" = "Utonulý",
        @"Exiter" = "Odcházející",
        @"Faller" = "Padající",
        @"Floater" = "Parašutista",
        @"Jumper" = "Skokan",
        @"Laserkill" = "Zabitý laserem",
        @"Miner" = "Horník",
        @"Slider" = "Kluzák",
        @"Smashed" = "Rozdrcený",
        @"Splashed" = "Spláchnutý",
        @"Superman" = "Superman",
        @"Teleported" = "Teleportující se",
        @"Waiter" = "Čekající",
        @"Walker" = "Chodec",
        @"skip" = "přeskočit",
        @"Play" = "Hrát",
        @"Back" = "Zpět",
        @"Number of Pingus: " = "Počet pingů: ",
        @"Number to Save: " = "Nutno zachránit: ",
        @"Time: " = "Čas: ",
        @"Author: " = "Autor: ",
        @"Close" = "Zavřít",
        @"Fullscreen" = "Celá obrazovka",
        @"Mouse Grab" = "Uchopit myš",
        @"Software Cursor" = "Softwarový kurzor",
        @"Autoscrolling" = "Automatický posuv",
        @"Drag&Drop Scrolling" = "Posouvání chytni a pusť",
        @"Print FPS" = "Vypisovat FPS",
        @"Resolution:" = "Rozlišení:",
        @"Renderer:" = "Vykreslovač:",
        @"Language:" = "Jazyk:",
        @"Master Volume:" = "Celková hlasitost:",
        @"Sound Volume:" = "Hlasitost zvuků:",
        @"Music Volume:" = "Hlasitost hudby:",
        @"Option Menu" = "Menu nastavení",
        @"Some options require a restart of the game to take effect." = "Některá nastavení se projeví až po restartu hry.",
        @"Story" = "Příběh",
        @"..:: Start the game ::.." = "..:: Spustit hru ::..",
        @"Editor" = "Editor",
        @"..:: Create your own levels ::.." = "..:: Vytvořit vlastní úroveň ::..",
        @"Options" = "Nastavení",
        @"..:: Configure the game ::.." = "..:: Nakonfigurovat hru ::..",
        @"Levelsets" = "Sady úrovní",
        @"..:: Play User Built levels ::.." = "..:: Spustit úroveň od uživatelů ::..",
        @"..:: Bye, bye ::.." = "..:: Na shledanou ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: uchopit myš :: F10: počítadlo fps :: F11: přes celou obrazovku :: F12: sejmout obrazovku ::..",
        @"Give up" = "Vzdát se",
        @"Retry" = "Znovu",
        @"Success!" = "Uspěl jsi!",
        @"Failure!" = "Neuspěl jsi!",
        @"Perfect! You saved everyone possible - great!" = "Skvělé! Zachránil jsi úplně všechny - výborně!",
        @"No-one got killed, pretty good work." = "Nikdo nezemřel, to byla dobrá práce.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Zachránil jsi jen ty, které jsi musel.\nSice jsi to zvládl, ale nemohlo to být lepší?",
        @"Not everybody was saved, but still good work!" = "Nezachránil jsi všechny, ale i tak je to dobré!",
        @"What can I say, you made it - congratulations!" = "Co mohu více říci - povedlo se ti to, gratuluji!",
        @"You killed everybody, not good." = "Všechny jsi zabil. To byl hodně špatný výkon.",
        @"No-one got saved - I know you can do better." = "Nikoho jsi nezachránil. Vím, že to umíš i lépe.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Nezachránil jsi dostatek pingů, ale bylo jich alespoň pár.\nPříště bys měl být lepší.",
        @"Only one more and you would have made it - try again!" = "Ještě jeden a mohl jsi uspět. Zkus to znovu!",
        @"Only a handful more and you would have made it - try again!" = "Jen několik dalších a bylo by to v pořádku. Zkus to ještě jednou!",
        @"Better luck next time!" = "Příště ti přeju více štěstí!",
        @"Saved: " = "Zachráněno: ",
        @"Died: " = "Zesnulo: ",
        @"Time left: " = "Zbývající čas: ",
        @"Under Construction" = "Připravuje se",
        @"Untested, unpolished and broken levels" = "Neotestované, nevyladěné a rozbité úrovně",
        @"Solved:" = "Vyřešeno:",
        @"levels" = "úrovní",
        @"???" = "???",
        @"Show Ending?" = "Ukázat konec?",
        @"Leave?" = "Opustit?",
        @"[OPTIONS]... [FILE]" = "[VOLBY]... [SOUBOR]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Pingus je logická hra, ve které je tvým úkolem provázet skupinku malých tučnáků na cestě kolem světa.",
        @"General Options:" = "Všeobecná nastavení:",
        @"Displays this help" = "Zobrazí tuto nápovědu",
        @"Print version number and exit" = "Vypíše číslo verze a ukončí.",
        @"Enable info level log output" = "Zapnout logování v režimu info",
        @"Enable debug level log output" = "Zapnout logování v režimu debug",
        @"Disable all log output" = "Vypnout logování",
        @"Display Options:" = "Nastavení zobrazení:",
        @"Start in Window Mode" = "Spustí v okně.",
        @"Start in Fullscreen" = "Spustí přes celou obrazovku.",
        @"Set the window resolution for pingus (default: 800x600)" = "Nastaví rozlišení okna hry. (výchozí: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Nastaví rozlišení v celoobrazovkovém režimu. (výchozí: 800x600)",
        @"Enable software cursor" = "Zapne softwarový kursor.",
        @"Game Options:" = "Nastavení hry:",
        @"Disable automatic scrolling" = "Vypne automatický posuv.",
        @"Enable drag'n drop scrolling" = "Zapne posuv metodou chytni a pusť.",
        @"Sound Options:" = "Nastavení zvuku:",
        @"Disable sound" = "Vypne zvuk.",
        @"Disable music" = "Vypne hudbu.",
        @"Select language to use with Pingus" = "Vybere jazyk pro hru.",
        @"List all available languages" = "Vypíše všechny dostupné jazyky.",
        @"Loads the level editor" = "Spustí editor úrovní.",
        @"Directory Options:" = "Nastavení cest:",
        @"DIR" = "ADRESÁŘ",
        @"Load game datafiles from DIR" = "Načte data hry z ADRESÁŘE.",
        @"Load config files and store savegames in DIR" = "Načte konfigurační soubory a uložené hry z ADRESÁŘE.",
        @"Load game modifications from DIR" = "Načte modifikace hry z ADRESÁŘE.",
        @"Don't read ~/.pingus/config" = "Zakáže načtení ~/.pingus/config.",
        @"FILE" = "SOUBOR",
        @"Read config options from FILE" = "Načte konfigurační volby ze SOUBORU.",
        @"Uses the controller given in FILE" = "Použije ovladač ze zadaného SOUBORU.",
        @"Debug Options:" = "Debugovací nastavení:",
        @"Enables some special features for developers" = "Zapne některé vlastnosti určené pro vývojáře.",
        @"Set the game speed (0=fastest, >0=slower)" = "Nastaví rychlost hry. (0 = nejrychlejší, >0 = pomalejší)",
        @"Set the desired game framerate (frames per second)" = "Nastaví požadovanou snímkovou rychlost hry (FPS).",
        @"Set the size of the map tiles (default: 32)" = "Nastaví velikost dílku mapy. (výchozí: 32)",
        @"Pingus: Out of memory!" = "Pingus: Došla paměť!",
        @"Pingus: Standard exception caught!:\n" = "Pingus: Odchycena standardní výjimka!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: Odchyceno neznámé throw!",
        @"unlimited" = "neomezený",
        @"Screenshot: Saving screenshot to: " = "Screenshot: Ukládám screenshot do: ",
        @"Screenshot: Screenshot is done." = "Screenshot: Screenshot je hotový.",
        @"Screenshot: Couldn't write file: " = "Screenshot: Nemohu zapsat do souboru: ",
        @"If the way is blocked, bash away" = "Když nevede cesta dál, tak ji prohrabej",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "Podobně jako kopání, které už znáš z minulých úrovní, existuje také možnost vodorovného hrabání. Pingové pak nekopou jámu pod sebou, ale prohrabávají se rovně ve směru chůze. ",
        @"Sacrifice a few and save the rest" = "Pár obětuj a zachraň ostatní",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Občas, když nemáš jinou vhodnou akci k dispozici, musíš si uvolnit cestu skrz zemi výbuchem. Pingové to ale umí udělat jen tak, že se při tom sami zničí. I když je to zabíjí, tak je někdy nutné několik z nich obětovat, abys zachránil ostatní. ",
        @"Learning to dig" = "Výuka kopání",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Toto je tvůj první úkol a bude celkem jednoduchý. Všechno, co budeš muset udělat, je dát pingovi příkaz k vykopání jámy do země, aby se vytvořila cesta k východu. To uděláš prostě tak, že na nějakého pinga klikneš. ",
        @"Float or Die" = "Leť, nebo zemřeš",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "V první misi jsi dopadl dobře, takže se teď podíváme na další. Tentokrát budeš muset své svěřence vybavit malou vrtulkou, aby se mohli pomalu a bezpečně snést z útesu na zem. Když totiž pingové spadnou z příliš velké výšky, tak nepřežijí. Takže na ně dávej dobrý pozor! ",
        @"Jump for joy" = "Skákání je legrace",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "Někdy potřebuješ pinga dovést na plošinu, která je sice jen kousek od něj, ale nelze na ni dojít. Pak přijde vhod skákání, které umožní pingovi kousek poskočit a dostat se tak na kýžené místo. ",
        @"Miner's heaven" = "Ráj horníků",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "A další akce se dostává na výsluní a opět se jedná o kopání do země, tentokrát šikmo. Hornictví umožní pingům hloubit šikmé chodby, kterými pak mohou ostatní projít. ",
        @"Panic Island (float/bash)" = "Panika na ostrově",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Zatímco předchozí úrovně po tobě nevyžadovaly moc rychlých reakcí, tak ta následující je trochu náročnější. Pingové vycházejí ze dvou vchodů najednou a je jen na tobě obě skupiny uhlídat. ",
        @"Jump'n Bump... and Bash..." = "Skákání a hrabání...",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "Je na čase si dělat starosti. Pingové sice nebudou přicházet příliš rychle, ale protože se u zdí otáčejí, tak brzo vznikne nepřehledná situace, kdy je už nebudeš stíhat ovládat. Naštěstí jich potřebuješ do domečku dostat jen 5, tak to snad zvládneš. Když ti to bude dělat problémy, můžeš používat pauzu (P). ",
        @"Two groups in parallel, coordinate wisely" = "Dvě skupiny najednou - rozumě je veď",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Máš na starosti dvě skupiny, takže je budeš muset zvládnout najednou. Nemusíš se obávat, máš dostatek času na promyšlení svých plánů. Více ti už napovídat nebudu. Hodně štěstí! ",
        @"Block'a Rock" = "Koukni a blokni",
        @"Once again it's time to combine the things you have learned in your previous levels. Blast your way free and make sure you also keep the rest of the Pingus under control. The Blocker action will be helpful." = "A máme tu znovu příležitost zkombinovat znalosti, které jsi doposud získal. Uvolni si cestu k cíli a zároveň dávej pozor i na ostatní pingy. Pomůže ti nová akce - hlídač blokující cestu.",
        @"Climb, Climber,... Boom!" = "Šplhej horolezče,... Bum!",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Jak jsi už určitě pochopil z předchozích úrovní, často je potřeba skloubit více různých činností dohromady, aby se dosáhlo potřebného cíle. Protože momentálně nemáš k dispozici žádného kopáče, tak budeš muset použít bombera. Jak se ale dostat na místo odpalu? ",
        @"Bridging gets more complicated..." = "Mosty se začínají komplikovat...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "Opět bys měl pečlivě a mazaně zkombinovat všechny schopnosti dohromady, jinak skončíš v pasti kousek před cílem. Takže zapřemýšlej, jak se tomu vyhnout. ",
        @"If too high, your Pingu will die..." = "Pingové nepřežijí pád z velké výšky...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "Týmová práce je tou pravou cestou k cíli. Protože nemáš dostatek vrtulek pro všechny, vyšli nejprve několik pingů, aby ostatním připravili cestu. ",
        @"Learn to use the bridge" = "Nauč se stavět mosty",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "Když není po ruce skokan a je potřeba překonat nějakou propast, tak můžeš postavit most. Stavba sice zabere nějaký ten čas, ale zato budou moci všichni ostatní pohodlně přejít, což bys se samotným skokanem nedokázal. ",
        @"Three solutions, it's up to you" = "Tři řešení - zvol si, které chceš",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Teď, když ses naučil všechny schopnosti, nastává čas, aby ses více procvičil. Tyto úkoly mají nejméně tři různá řešení a je jen na tobě, které si vybereš. ",
        @"Climb, Climber, climb... and build a bridge" = "Šplhej horolezče, šplhej... a postav most",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "Zase tu máme novou schopnost - horolezectví. Pingu, který se stane horolezcem, umí vyšplhat na kolmé zdi a dostane se tak na místa, kam by se jinak nikdo nedostal. ",
        @"Entrance high, Exit low" = "Vchod nahoře, východ dole",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Když nemáš dostatek vrtulek, abys dostal všechny pingy bezpečně dolů, budeš muset vymyslet jiný způsob. Vše, co potřebuješ, ses už naučil v předchozích úrovních, takže to pro tebe nebude žádný zvláštní problém. ",
        @"One must prepare, the rest must follow" = "Jeden připraví, ostatní ho následují",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "Čas od času se dostaneš do situace, kdy žádný hlídač není k dispozici. Měl bys vymyslet nějaký jiný způsob, jak pingy udržet pod kontrolou, než někdo připraví cestu. ",
        @"Dig and float, just don't fall and smash" = "Kopej a skákej, hlavně ale nespadni",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "Na rozdíl od předchozích dvou úrovní budeš mít tentokrát k dispozici dvě schopnosti. Tvůj úkol bude, jako obvykle, velmi snadný - vybereš schopnost na levém panelu a použiješ ji na pinga, aby vytvořil cestu k cíli. Jen si dej pozor, aby ti mnoho svěřenců nezemřelo. ",
        @"Dig, bash and other problems" = "Kopání, hrabání a další problémy",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Čím více úrovní zvládneš, tím těžší tě budou čekat. Ale neboj se, následující je ještě celkem jednoduchá. Prostě použij vše, co ses zatím naučil a nebudeš mít potíže. Když se dostaneš do bezvýchodné situace, dvojklikni na tlačítko Armagedon vpravo dole. ",
        @"Solid ground can block the path" = "Pevné podloží může omezit cestu",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "Už dříve ses naučil, že se pingové dokáží prokopat skrze jakýkoliv druh zeminy. Tady se ale v zemi nacházejí kovové předměty, které prokopat nejdou. Tyto věci jsou na mapce vyznačeny tmavě šedou barvou a nemohou být nijak zničeny. Musíš je obejít. ",
        @"One jump to catch them all" = "Jeden skok všechny zachrání",
        @"The pingus have found themselves lost on their journey.  What is this mysterious place?  Smiling pumpkins, giant candlesticks, and some boiling soup below... what wizardry is this? Now, facing a deadly abyss right in front of them it's your job to save them. Can you save them from a terrible fate?" = "Pingové se ztratili na své cestě. Co je tohle za tajemné místo? Smějící se tykve, obrovská cukrátka a nějaká vroucí polévka pod nohama... co je tohle za magii? Teď tváří ke smrtelné propasti před nimy je tvým úkolem je zachránit. Dokážeš je spasit před děsivým osudem?",
        @"One Thousand and One Jumps" = "Tisíc a jeden skok",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "Jaké máme možnosti, když je východ tak vysoko a daleko z dosahu normalních pingů? Možná by je zachránil skokan? Nebo jen zpomalí jejich nevyhnutelný zánik? Zjistit to je už na tobě. Ale jsi tak dobrý, abys je zachránil všechny?",
        @"Boom Boom" = "Bum bum",
        @"You've mastered the last challenge and now face the next. Their path to salvation seems to be cursed, but by whom? There is no time to think about it, since the next deadly challenge already awaits the Pingus. Two mighty roots block the way, but without a basher at hand to bash them away, sacrifice might be the only option..." = "Jakmile jsi zvládnul poslední výzvy, hned čelíš další. Jejich cesta za spásou se zdá prokletá, ale kým? Teď o tom není čas přemýšlet, protože další smrtelná výzva už na pingy čeká. V cestě stojí dva mohutné kořeny, ale bez tuneláře, který by prošel skrz, by jedinou moností mohlo být sebeobětování...",
        @"Full Circle" = "Kolem dokola",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "I když je východ tak blízko, přesto je mimo dosah. Jeden krok špatným směrem a pingové propadnou ošklivé skáze. Musíš jim nějak pomoci, budeš na to mít dost času? Musíš si pospíšit a nesmíš připustit jedinou chybu. Pingové na tebe spoléhají!",
        @"Bridgers Nightmare" = "Noční můra mostařů",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "Kdo tu postavil tu ohromnou zeď? Ta ošklivá překážka odděluje tvé pingy od východu. Destrukce této ošklivé konstrukce vypadá nemožně, ale možná přijde na pomoc mostař? Mohou postavit své mosty dost vysoko, aby přivedli skupinu bezpečně k východu? Nebo si někdo ošklivě zahrává s tvou myslí?\n\nJako vždy je řešení na tobě... tvá šedá hmota mozková je klíčem k úspěchu pingů, takže se nenech zmást a svést ze správné cesty.",
        @"Locked up by the witch" = "V zajetí čarodějky",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "Jsme snad ve vězení? Všude kolem překáží pevné zdivo, nikde žádný náznak možnosti uniknout. Spása se zdá nemožná. Ale moment... ta stěna napravo vypadá chatrně... možná je to úniková cesta? A nebo je to falešná cesta vedoucí do záhuby?\n\nBude to riskantní výlet, ale musíš ho podstoupit, abys zjistil, jak je opět všechny dovést za svobodou.",
        @"Splatterfest" = "Rozplácávaná",
        @"This is by far the deepest pit the Pingus have yet encountered. Building a bridge across it seems obvious but that won't help since the exit is deep down in the pit itself. Pingus who try to go down the pit will just end up splattered all over the ground. You have two groups of Pingus at your disposal, can you make them work together to reach even an exit this well hidden?" = "Tohle je ta nejhlubší propast, na kterou pingové doposud narazili. Postavení mostu se zdá samozřejmé, ale nám nepomůže, protože východ je hluboko na dně propasti samé. Pingové, kteří se pokusí seskočit, skončí rozplácnutí po dně. Máš k dospozici dvě skupiny pingů, dokážeš je zkoordinovat, aby společně dospěli i k takhle důkladně schovanému východu?",
        @"Staircase Maintenance" = "Údržba schodiště",
        @"It seems we are up again against a mighty wall, and it is blocking the exit! But wait, some good soul has built a staircase around it. It seems, however, that the poor fool's efforts didn't last long, as the staircase is destroyed and full of holes. Can you fix it and make it over the wall? Yet of course you know that the right solution might not be the obvious one. But your Pingus are almost free, and they trust in your skill to guide them to safety once more. Succeed and you will have freed them once and for all from whatever evildoer that placed them in this nightmare... at least for this year." = "Vypadá to, že opět budeme čelit mohutné zdi, která nám stojí v cestě! Ale počkat, nějaká dobrá duše nám postavila schodiště kolem ní. Bohužel se ale zdá, že snaha ubohého blázna nevydržela dlouho, schodiště je poničené a je v něm mnoho děr. Dokážeš ho opravit a dostat se přes zeď? Avšak jistě víš, že správné řešení nemusí být na první pohled očividné. Ale tví pingové jsou už skoro volní a důvěřují tvým schopnostem je opět dovést do bezpečí. Uspěješ-li, nadobro je osvobodíš je z moci toho zlosyna, který je uvrhnul do této noční můry... tedy alespoň pro letošní rok.",
        @"Down Into The Cave" = "Hluboko do jeskyně",
        @"Round and Round" = "Dokolečka dokola",
        @"Red Herring Cave" = "Jeskyně plná falší",
        @"Group Coordination" = "Koordinace skupin",
        @"Traps, Dangers and other Problems" = "Pasti, nebezpečí a další problémy",
        @"Reach that Switch" = "Dosáhnout tak na spínač",
        @"The Collapsed Column" = "Zřícený sloup",
        @"Island of Doom" = "Ostrov zkázy",
        @"Tower of Death" = "Věž smrti",
        @"The Ones" = "Jedničky",
        @"Down the valley and up again" = "Dolů do údolí a pak zase ven",
        @"There is a large valley between the entrance and the exit. No bridge will be long enough to cross the valley, but can you find a way back up once you lead the Pingus down into the valley?" = "Mezi vchodem a východem se rozprostírá velké údolí. Žádný most nebude dost dlouhý, aby údolí překonal. Dokážeš ale najít cestu zpátky nahoru, jakmile s pingy sestoupíš do údolí?",
        @"Entering the pyramid" = "Vstupujeme do pyramidy",
        @"After their long and dangerous journey through the desert the Pingus finally reach the large pyramid, but there is still a pedestal blocking their way." = "Po dlouhé a nebezpečné cestě skrz poušť pingové konečně dorazili k velké pyramidě. Stojí jim však v cestě velký piedestál.",
        @"The window room" = "Okenní sál",
        @"Grand Hall" = "Velká síň",
        @"The pingus have found themselves in the grand hall, a hall full of wonder and treasures. The exit however is high up and won't be easy to reach. Guide the pingus around the hall and maybe you will find a way." = "Pingové se ocitli ve velké síni plné zázraků a pokladů. Východ je ale vysoko a nebude snadné na něj dosáhnout. Proveď pingy okolo síně a třeba najdeš cestu.",
        @"Pass the pedestal" = "Překonání piedestálu",
        @"The excavation of the pyramid" = "Vykopávky u pyramid",
        @"The excavations are open to reach the pyramid for his redeeming content. Some excavations, however, is best done with two competitors. Who comes first?" = "Vykopávky jsou otevřené a tak poskytují přístup k pyramidě a obsahu ukrytému uvnitř. Některé vykopávky se ale nejlépe dělají se dvěma soupeři. Kdo dojde první?",
        @"Catch them at the half way point" = "Zachyť je v půli",
        @"Claustrophobia" = "Klaustrofóbie",
        @"Hidden deep below the pyramid the pingus come across a small underground room, but unfortunatley a large tree root blocks their path..." = "Ukrytí hluboko pod pyramidou narazili pingové na malou podzemní místnost, ale naneštěstí jim v cestě překáží obrovský kořen stromu...",
        @"A bit to the right a bit to left" = "Trošku doprava a trošku doleva",
        @"Only the most audacious Pingus will be allowed to continue." = "Jen ti nejodvážnější pingové budou moci pokračovat.",
        @"25 Pingus free and 25 in the box" = "25 pingů volných a 25 v krabici",
        @"Tunnel Time" = "Čas na tunel",
        @"Dig a tunnel and you might make it to the exit. Digger and miners and stuff have to work together." = "Vykopej tunel a pak se ti možná podaří dosáhnout východu. Kopáči, horníci a hmota musejí pracovat společně.",
        @"Crawlspace" = "Průlez",
        @"The Roof" = "Střecha",
        @"Sometimes the roofs are not good for refuge, sometimes it should be demolished! But be careful if you aren't precise enough, you might lead the Pingus straight to certain death." = "Střechy někdy nejsou vhodné úkryty, občas je potřeba je zbourat! Ale buď opatrný, pokud nebudeš dostatečně precizní, mohl bys pingy přivést přímo k jisté smrti.",
        @"Pingus Jones and the Last Exit" = "Pingus Jones a poslední východ",
        @"Dr. Jones' notebook:\n\n  (1) the breath of God: only the penitent pingus will pass;\n  (2) the word of God... in reverse;\n  (3) the path of God: leap from the head of something like a cat." = "Zápisník Dr. Jonese:\n  (1) boží dech: jen kajícní pingové projdou;\n  (2) slovo boží... po zpátku;\n  (3) cesta boží: seskočit z hlavy něčeho jako kočka.",
        @"Near can mean far" = "Blízko je někdy daleko",
        @"Trapped Underground" = "Podzemní past",
        @"The penguins escaped the mad scientist, but now they were trapped deep underground. They had no food or water, so they had to move fast." = "Tučnáci sice unikli šílenému vědci, ale teď jsou uvěznění hluboko pod zemí. A protože nemají žádnou vodu ani potraviny, musejí si pospíšit.",
        @"Experimentation" = "Experimentování",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Šílený vědec zajal tučnáčky a teď na nich provádí experimenty. Jak mohou tučnáci uniknout gilotině?",
        @"Hall of Illusion" = "Síň iluzí",
        @"The Lava Pit" = "Lávová jáma",
        @"The penguins had defeated the mad scientist, and were walking away from his destroyed laboratory when a huge hole opened under their feet. The penguins fell into an underground cave and the only way out was across the lava pit. Luckily, it seemed someone had left some helpful signs." = "Tučnáci se ubránili před šíleným vědcem a odcházeli z jeho zničené laboratoře, když se náhle země rozestoupila pod jejich nohama. Tučnáci spadli do podzemní jeskyně, ze které vedla jediná cesta ven přes lávovou propast. Naštěstí to vypadá, že tu někdo zanechal nápomocné cedule.",
        @"At least the experiments are over..." = "Alespoň je už konec s experimenty...",
        @"The good news was that the mad scientist had tired of his experiments, the bad news was that now he was dumping them down a pit. A single floatation device was all the penguins had. Save as many as possible." = "Dobrá zpráva je, že se šílený vědec svými experimenty unavil, špatná, že se jich teď zbavil spláchnutímdo jámy. Pingové měli jen jediné padací zařízení. Zachraň jich tolik, kolik bude možné.",
        @"Ghosting" = "Duchaření",
        @"The penguins came to a long pass. Acid bubbled underneath and it seemed a climber or two were needed.  Hint: slider can be used to stop the miner ability." = "Tučnáci přišli k dlouhému průsmyku. Kiselina bublá pod nimy a vypadá to, že jeden či dva horolezci se budou hodit. Nápověda: kluzákem můžeš přerušit práci horníka.",
        @"The Final (and suprisingly easy) Challenge" = "Poslední (a překvapivě snadná) výzva",
        @"The penguins had reached the end of the island. In the water was a long tree, perfect for the penguin's needs. Their journey was almost over." = "Tučnáci dorazili na okraj ostrova. Ve vodě byl dlouhý strom, který perfektně poslouží jejich potřebám. Jejich pouť je téměř u konce.",
        @"Revenge is sweet" = "Pomsta bude sladká",
        @"Winter Wonderland" = "Zimní říše divů",
        @"After getting past the lava pit, the penguins walked and walked until they reached a snowed in exit. That would be relatively easy to tunnel through but how would it be possible to tunnel through solid metal?" = "Po té, co se vypořádali s lávovou propastí, tučnáci šli a šli, až objevili zasněžený východ. Bylo by snadné prokopat tunel skrz, ale půjde to i skrz pevný kov?",
        @"The Journey Goes On" = "Výprava pokračuje",
        @"And so the penguins continued on their journey, drawing ever closer to the North Pole. They had escaped the guillotine, defeated the mad scientist and got a new boat. And so this chapter in their voyage was over, but there would be other obstacles. Nothing  would stop the determined penguins from reaching their goal." = "A protože tučnáci stále pokračovali na své pouti, přibližovali se stále více  k severnímu pólu. Vyvázli z pod gilotiny, ubránili se čšílenému vědci a postavili novou loď. A i když byla tato kapitola jejich výpravy uzavřená, čekají je ještě překážky. Nic ale cílevědomé tučnáky nezastaví před dosažením jejich cíle.",
        @"Think fast (literally)" = "Mysli rychle (doslova)",
        @"This would be simple but for one thing, there are no blockers. All the penguins must survive." = "Tohle by bylo lehké, jenže tu nemáme žádné hlídače. A všichni pingové musejí přežít.",
        @"Shipwrecked" = "Vrak lodi",
        @"Escape from Aliens" = "Útěk od mimozemšťanů",
        @"Escape from Aliens 2" = "Útěk od mimozemšťanů 2",
        @"Aliens are now closest making your escape harder. You must dig it up." = "Mimozemšťané jsou nyní blízko, což ztěžuje tvůj útěk. Musíš kopat nahoru.",
        @"Alien's nest" = "Mimozemské hnízdo",
        @"Matrix of the death" = "Matrice smrti",
        @"Take a piece of paper. Now pingus have to enter the matrix of the death. This is a maze, bad ways are protect by jaws." = "Vezmi si list papíru. Pingové mají vstoupit do matrice smrti. Je to bludiště a špatné cesty jsou chráněny tesáky.",
        @"Spy's pingus in the matrix of the death" = "Špioni v matrici smrti",
        @"Spy's pingus have marked the location of jaws in the matrix of the death. Many died to gain that information :..( Perhaps this help. Perhaps..." = "Špioni označili oblast tesáků v matrici smrti. Mnoho jich zemřelo, aby získali tuto informaci :..( Snad to pomůže. Snad...",
        @"Fourth dimension" = "Čtvrtý rozměr",
        @"Set your watches" = "Seřiďme si hodinky",
        @"Cooperation in space." = "Spolupráce ve vesmíru",
        @"Lost in Space" = "Ztraceni ve vesmíru",
        @"We don't know where we are but we don't leave anybody behind." = "Nevíme, kde se nacházíme, ale nikoho tu nenecháme na pospas.",
        @"Outside In" = "Naruby",
        @"Can you help the pingus escape without getting their flippers wet?" = "Dokážeš pomoci pingům utéci, aniž by si namočili křidélka?",
        @"Endless Loop" = "Nekonečná smyčka",
        @"Up up in the space" = "Vzhůru do vesmíru",
        @"What good is a pick in space? Certainly not to go to the stars." = "K čemu je dobrý krumpáč ve vesmíru? Určitě ne k cestě ke hvězdám.",
        @"Jump" = "Skok",
        @"All Pingus need is to jump.... Hint: While pausing (press P key) you still can control Pingus. " = "Jediné, co pingové potřebují, jsou skoky... Nápověda: Když máš zapauzováno (stisk klávesy P), můžeš stále ovládat pingy. ",
        @"Factory" = "Továrna",
        @"Finally you reached the factory. Watch out as there are many dangers. Use bombers to destroy the basement of the factory. Good luck!" = "Konečně jsi dosáhnul továrny. Dávej si pozor, hrozí tu mnoho nebezpečí. Použij bombíky ke zničení základů továrny. Hodně štěstí!",
        @"Going back home" = "Cesta zpátky domů",
        @"Your mission is over. Pingus can go back home, but be careful!" = "Tvá mise skončila, pingové se vracejí zpátky domů, ale buď opatrný!",
        @"Bonus track" = "Bonusový úkol",
        @"Pingus are at home, but after the climate change living on the South Pole became more dangerous. There is one more mission for you." = "Pingové jsou doma, ale po klimatických změnách se život na jižním pólu stal nebezpečnějším. Čeká na tebe ještě jedna mise.",
        @"Falling down" = "Volný pád",
        @"Destination North" = "Směr sever",
        @"For now, Pingus are leaving South Pole and moving North. You have to help them!" = "Pingové opouštějí jižní pól a přesunují se směrem na sever. Musíš jim pomoci!",
        @"Pingus on their way came across a huge cave. You have to lead them through. Remember that sometimes there is more than one way out. Hint: To 'unlock' blockers you can use bashers and jumpers." = "Na své cestě pingové narazili na velkou jeskyni. Musíš je provést skrz ni. Nezapomeň, že někdy tu bývá více než jedna cesta ven. Nápověda: Hlídače můžeš odblokovat použitím tunelářů a skokanů.",
        @"Difficulties on the way" = "Obtíže na cestě",
        @"It looks you have encountered serious difficulties. But don't panic, Pingus are waiting for your orders, they count on you so don't fail! Hint: Miners, diggers and bashers are very important here!" = "Vypadá to, že jsi spadnul do pěkné kaše. Ale nepropadej panice, pingové čekají na tvé rozkazy, spoléhají na tebe, tak je nezklam! Nápověda: Horníci, kopáči a tuneláři tu hrají velmi důležitou roli!",
        @"Four ways out" = "Čtyři cesty ven",
        @"Egypt - So easy" = "Egypt - Tak snadné",
        @"Egypt - Oasis" = "Egypt - Oáza",
        @"Egypt - The Maze" = "Egypt - Bludiště",
        @"You came across a maze. Can you find the way out? Think twice before digging." = "Vstopil jsi do bludiště. Dokážeš najít cestu ven? Radeji se zamysli, než začneš kopat.",
        @"Tutorial Island" = "Výukový ostrov",
        @"Learn the basics" = "Nauč se základy",
        @"Watch Ending" = "Ukázat konec",
        @"Watch Intro" = "Ukázat intro",
        @"The Journey Begins" = "Výprava začíná",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Po dlouhý čas žili pingové štastně a spokojeně na severním pólu spolu s ostatníma zvířátkama. Všechno bylo v rovnováze a vůbec to nevypadalo, že by něco mohlo ten klid narušit. Pingové byli štastní a zdálo se, že tomu bude už navždy.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Ale jednoho dne se začala situace pozvolna měnit - obloha se zamračila a Země se začala oteplovat. Nejdříve to vypadalo jen jako běžné výkyvy světového podnebí, jenže se situce rok od roku zhoršovala.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "Sníh pomalu tál a mizel, a v několika oblastech se objevily problémy se sháněním potravy. Ostatní zvířátka odešla pryč hledat chladnější oblasti. Pingové ale věděli, že to pranic nepomůže, že musí něco podniknout, aby zkáze zabránili.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Takže se sešel kruh nejstarších, aby rozhodl, co dělat. Nakonec se rozhodli vyslat výpravu kolem světa, která by našla příčinu oteplování. Expedici tvořily stovky nejstatečnějších pingů z celého jižního pólu.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "A ty jsi byl vybrán, abys je vedl na této pouti kolem světa. Protože cesta bude obtížná a nebezpečná, vaší první zastávkou bude ostrov Mogorok, též známý jako výukový ostrov. Podle starších byl ostrov vždy první metou výprav, které do světa směřovaly.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "Na ostrově se nachází spousta oblastí, které jsou ideální k trénování schopností pingů. Pingové si tu mohou zdokonalit své schopnosti stavění mostů, lezení, hrabání a další schopnosti, které určitě budou cestou potřebovat.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "Ty si zase procvičíš velitelské umění. Měl byses seznámit se všemi schopnostmi, kterými pingové oplývají. Musíš je opravdu dokonale zvládnout, protože je všechny budeš cestou potřebovat.",
        @"Now that you and the Pingus have arrived at Tutorial Island it is time to take command and begin your mission.\n\nGood Luck!" = "Nyní, když jsi se svou partou dorazil na Výukový ostrov, je čas převzít velení a pustit se do své mise.\n\nHodně štěstí!",
        @"The Journey Continues" = "Výprava pokračuje",
        @"Now after you and the Pingus have learned the basics and practiced a bit it is time to move on and begin the journey into the world. Since the ice floe with which the Pingus traveled to the Tutorial Island isn't going to hold on the whole way into the warmer climates the Pingus have to find something else to guide them on their journey." = "Nyní, když ses už naučili základy a všechny je dobře zvládl, je čas pokročit v cestě. Protože kra, na které pingové připluli na výukový ostrov nemůže nést posádku po celou cestu do teplejších krajin, pingové musí najít jiný dopravní prostředek.",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "Rada nejstarších řekla, že výukový ostrov neposkytuje jen možnost výcviku, ale je také výchozím bodem v cestě do světa. Po krátkém hledání pingové pochopili význam sdělení - velký strom na konci ostrova dá kvalitní dřevo pro konstrukci vorů.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Takže pingové postavili několik velkých vorů, dostatek, aby se mohli všichni přepravit. Ještě sehnali dostatečné zásoby potravin a byli konečně připraveni opustit známou zemi a vydat se na svou pouť do neznámých oblatí světa.",
        @"So the Pingus sit on their raft, worrying about what's to come and where to go, while floating into the sunset.\n\nTo be continued..." = "Jak tak seděli na svých vorech, přemýšleli, co je čeká a a kam se vypraví, odplouvali do západu slunce.\n\nBude mít pokračování...",
        @"Desert" = "Poušť",
        @"Getting hot outside..." = "Moci se tak schladit...",
        @"Factory Campaign" = "Kampaň v továrně",
        @"Pingus expedition" = "Výprava pingů",
        @"Halloween 2011" = "Halloween 2011",
        @"Going Underground" = "Výprava do podzemí",
        @"Halloween 2007" = "Halloween 2007",
        @"Trapped at All Hallows Eve" = "Léčka v předvečer všech svatých",
        @"Island of Mystery" = "Tajemný ostrov",
    ],
]
