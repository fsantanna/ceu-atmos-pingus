        @"Target Id:" = "Hedef kimlik:",
        @"Height:" = "Yükseklik:",
        @"Object: [Group]" = "Nesne: [Group]",
        @"Group not supported" = "Grup desteklenmiyor",
        @"Object: " = "Nesne: ",
        @"New level" = "Yeni Bölüm",
        @"Open level..." = "Bölümü aç...",
        @"Save level..." = "Bölümü kaydet...",
        @"Save level as..." = "Bölümü farklı kaydet...",
        @"Play level..." = "Bölüm oyna...",
        @"Configure actions" = "Eylemleri yapılandır",
        @"Configure level" = "Bölümü yapılandır...",
        @"Display object properties" = "Nesne özelliklerini göster",
        @"Show object insertion window" = "Nesne yerleştirme penceresini göster",
        @"Show minimap" = "Küçük haritayı göster",
        @"Duplicate the selected objects" = "Seçili nesneleri çoğalt",
        @"Delete the selected objects" = "Seçili nesneleri sil",
        @"Raise object to top" = "Nesneyi en üste götür",
        @"Raise object" = "Nesneyi yukarı götür",
        @"Lower object" = "Nesneyi alta götür",
        @"Lower object to bottom" = "Nesneyi en alta götür",
        @"Flip object horizontally" = "Nesneyi yatay döndür",
        @"Flip object vertically" = "Nesneyi dikey döndür",
        @"Rotate object -90 degree" = "Nesneyi -90 derece döndür",
        @"Rotate object 90 degree" = "Nesneyi 90 derece döndür",
        @"Display help" = "Yardımı görüntüle",
        @"Exit" = "Çıkış",
        @"Datadir" = "Veri dizini",
        @"Userdir" = "Kullanıcı dizini",
        @"Open" = "Aç",
        @"Save" = "Kaydet",
        @"Cancel" = "Vazgeç",
        @"Filename:" = "Dosya Adı:",
        @"Pathname:" = "Yol adı:",
        @"Open a level" = "Bölüm aç",
        @"Save your level" = "Bölümü kaydet",
        @"== Editor Help ==" = "== Düzenleyici Yardımı ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Tümünü seç\nSeçimi temizle\nNesneleri yükselt\nNesneleri alçalt\nNesneleri en üste yükselt\nNesneleri en alta indir\n90 derece çevir\n270 derece çevir\nSeçilen nesneleri grupla\nSeçilen nesneleri ayır\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Nesneyi yatay çevir\nNesneyi dikey çevir\nTüm işaretli nesneleri sil\nNesneleri bir piksel taşı\nNesneleri 32 piksel taşı\nArkaplan rengini değiştir\nTekrarı yükselt/alçalt\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Bölüm dosyalarını sistematik olarak adlandırmalısın. Örn: temasına, numarasına ve takma adına göre:\n\n     <bölümadı><sayı>-<oluşturan>.pingus\n\nMesela, ikinci bölümünü bir kaya temasıyla oluşturduysan şöyle adlandır: kaya2-adın.pingus\n\nBölüm oluşturduğunda oyuna eklenmesini istersen şu adrese e-posta gönder:\n\n     pingus-devel@nongnu.org\n\nSadece GPL altında yayınlanan bölümler oyunda kullanılacak. Düzenleyici, otomatik olarak GPL'ye bir referans ekleyecektir. Eğer başka bir lisans kullanmak istersen bu referansı değiştirmen gerekir.\n",
        @"Replace" = "Değiştir",
        @"Entrance" = "Giriş",
        @"Groundpiece (ground)" = "Döşeme (yer)",
        @"Groundpiece (solid)" = "Döşeme (yekpare)",
        @"Groundpiece (bridge)" = "Döşeme (köprü)",
        @"Groundpiece (transparent)" = "Döşeme (şeffaf)",
        @"Groundpiece (remove)" = "Döşeme (kaldır)",
        @"Hotspot" = "Eğlence Yeri",
        @"Background" = "Arkaplan",
        @"Liquid" = "Sıvı",
        @"Trap" = "Tuzak",
        @"Weather" = "Hava",
        @"Special Object" = "Özel Nesne",
        @"Prefab Object" = "Prefab Nesnesi",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Çıkan:%3d/%d Dışarıda:%3d Kurtarılan:%3d/%d",
        @"Angel" = "Melek",
        @"Basher" = "Delici",
        @"Blocker" = "Durdurucu",
        @"Boarder" = "Boarder",
        @"Bomber" = "Bombacı",
        @"Bridger" = "Köprücü",
        @"Climber" = "Tırmanıcı",
        @"Digger" = "Kazıcı",
        @"Drown" = "Drown",
        @"Exiter" = "Bölüm hazırla",
        @"Faller" = "Düşen",
        @"Floater" = "Süzülen",
        @"Jumper" = "Zıplayan",
        @"Laserkill" = "Lazer atışı",
        @"Miner" = "Madenci",
        @"Slider" = "Kaydırıcı",
        @"Smashed" = "Ezildi",
        @"Splashed" = "Suya düştü",
        @"Superman" = "Süpermen",
        @"Teleported" = "Işınlanacaksınız",
        @"Waiter" = "Bekleyici",
        @"Walker" = "Yürüyen",
        @"skip" = "atla",
        @"Play" = "Oyna",
        @"Back" = "Geri",
        @"Number of Pingus: " = "Pingu sayısı: ",
        @"Number to Save: " = "Kurtarılacak Pingu Sayısı ",
        @"Time: " = "Süre: ",
        @"Author: " = "Yapımcı: ",
        @"Close" = "Kapat",
        @"Fullscreen" = "Tam ekran",
        @"Mouse Grab" = "Fare Yakalaması",
        @"Software Cursor" = "Yazılım İmleci",
        @"Autoscrolling" = "Otomatik kaydırma",
        @"Drag&Drop Scrolling" = "Sürükle&Bırak Kaydırması",
        @"Print FPS" = "FPS'yi Yazdır",
        @"Resolution:" = "Çözünürlük:",
        @"Renderer:" = "Çevirici:",
        @"Language:" = "Dil:",
        @"Master Volume:" = "Ana Ses Seviyesi:",
        @"Sound Volume:" = "Ses Seviyesi:",
        @"Music Volume:" = "Müzik Ses Seviyesi:",
        @"Option Menu" = "Seçenek Menüsü",
        @"Some options require a restart of the game to take effect." = "Bazı seçeneklerin etkin olması için oyun yeniden başlatılmalıdır.",
        @"Story" = "Öykü",
        @"..:: Start the game ::.." = "..:: Oyunu başlat ::..",
        @"Editor" = "Düzenleyici",
        @"..:: Create your own levels ::.." = "..:: Kendi bölümlerini oluştur ::..",
        @"Options" = "Seçenekler",
        @"..:: Configure the game ::.." = "..:: Oyunu yapılandır ::..",
        @"Levelsets" = "Bölüm setleri",
        @"..:: Play User Built levels ::.." = "..:: Kullanıcılar Tarafından Hazırlanan Bölümleri Oyna ::..",
        @"..:: Bye, bye ::.." = "..:: Güle güle... ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: imleci yakala   ::   F10: fps sayacı   ::   F11: tam eklran   ::   F12: ekran görüntüsü ::..",
        @"Give up" = "Pes Et",
        @"Retry" = "Tekrar dene",
        @"Success!" = "Aferin!",
        @"Failure!" = "Başaramadın!",
        @"Perfect! You saved everyone possible - great!" = "Mükemmel! Herkesi kurtardın galiba.",
        @"No-one got killed, pretty good work." = "Kimse ölmedi, oldukça iyi iş.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Tam gerektiği kadar Pingu kurtardın, geçer not, ama\nbelki daha iyisini yapabilisin, hı?",
        @"Not everybody was saved, but still good work!" = "Herkesi kurtaramadın, ama yine de iyi iş çıkardın!",
        @"What can I say, you made it - congratulations!" = "Ne diyebilirim, yaptın, aferin!",
        @"You killed everybody, not good." = "Herkesi öldürdun. Hiç hoş degil.",
        @"No-one got saved - I know you can do better." = "Hiç kimseyi kurtaramadın, daha iyisini yapabileceğinden eminim.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Yeterince kurtaramadın, ama yine de birkaçı kurtuldu, bir\ndahakine daha dikkatli ol.",
        @"Only one more and you would have made it - try again!" = "Sadece bir tane daha ve bölümü tamamlamayı başaracaktın - tekrar dene!",
        @"Only a handful more and you would have made it - try again!" = "Birkaç tane daha kurtarsan olacaktı, tekrar dene!",
        @"Better luck next time!" = "Bir dahaki oyunda iyi şanslar!",
        @"Saved: " = "Kurtarılan: ",
        @"Died: " = "Ölen: ",
        @"Time left: " = "Kalan zaman: ",
        @"Under Construction" = "Yapım Aşamasında",
        @"Untested, unpolished and broken levels" = "Testedilmemiş, düzeltilmemiş ve bozuk bölümler",
        @"Solved:" = "Çözülen:",
        @"levels" = "bölüm",
        @"???" = "???",
        @"Show Ending?" = "Bitişi Göster?",
        @"Leave?" = "Çık?",
        @"[OPTIONS]... [FILE]" = "[SEÇENEKLER]... [DOSYA]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Pingu oyunu dünyadaki bir sürü pengene rehberlik ederek oynanan bir oyundur.",
        @"General Options:" = "Genel Seçenekler:",
        @"Displays this help" = "Bu yardım ekranını göster",
        @"Print version number and exit" = "Sürüm numarasını yazdır ve çık",
        @"Enable info level log output" = "Bilgi seviyesinde günlük çıktısını aç",
        @"Enable debug level log output" = "Hata çözme seviyesinde günlük çıktısını aç",
        @"Disable all log output" = "Tüm günlük çıktısını kapat",
        @"Display Options:" = "Görüntü Seçenekleri:",
        @"Start in Window Mode" = "Pencerede başlat",
        @"Start in Fullscreen" = "Tam Ekranda Başlat",
        @"Use the given renderer (default: sdl)" = "Belirtilen çeviriciyi kullan (varsayılan: sdl)",
        @"Set the window resolution for pingus (default: 800x600)" = "Pingus için pencere çözünürlüğünü ayarlayın (varsayılan: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Tam ekranda kullanılacak çözünürlüğü seçin (varsayılan: 800x600)",
        @"Enable software cursor" = "Yazılım imlecini etkinleştir",
        @"Game Options:" = "Oyun Seçenekleri:",
        @"Disable automatic scrolling" = "Otomatik kaydırmayı pasifleştir",
        @"Enable drag'n drop scrolling" = "Sürükle bırak kaydırmayı etkinleştir",
        @"Sound Options:" = "Ses Seçenekleri:",
        @"Disable sound" = "Sesi Kapat",
        @"Disable music" = "Müziği Kapat",
        @"Select language to use with Pingus" = "Oyunda kullanılacak dili seçin",
        @"List all available languages" = "Kullanılabilir tüm dilleri listele",
        @"Loads the level editor" = "Bölüm düzenleyiciyi yükler",
        @"Directory Options:" = "Dizin Seçenekleri:",
        @"DIR" = "DİZİN",
        @"Load game datafiles from DIR" = "DİZİNDEN oyun veri dosyalarını yükle",
        @"Load config files and store savegames in DIR" = "Yapılandırma dosyalarını yükle ve kayıtlı oyunları DİZİNE kaydet",
        @"Load game modifications from DIR" = "Oyun değişikliklerini DİZİNDEN yükle",
        @"Don't read ~/.pingus/config" = "~/.pingus/config dosyasını okuma",
        @"FILE" = "DOSYA",
        @"Read config options from FILE" = "Yapılandırma seçeneklerini DOSYA'dan yükle",
        @"Uses the controller given in FILE" = "DOSYA da verilen denetleyiciyi kullanır",
        @"Debug Options:" = "Hata Çözme Seçenekleri:",
        @"Enables some special features for developers" = "Geliştiriciler için bazı özellikleri etkinleştirir",
        @"Set the game speed (0=fastest, >0=slower)" = "Oyun hızını ayarla (0=en hızlı, >0=daha yavaş)",
        @"Set the desired game framerate (frames per second)" = "İstenen çerçeve oranını ayarlayın (saniyedeki kare sayısı)",
        @"Set the size of the map tiles (default: 32)" = "Döşeme boyutunu ayarla (öntanımlı: 32)",
        @"Pingus: Out of memory!" = "Pingus: Bellek yetersiz!",
        @"Pingus: Standard exception caught!:\n" = "Pingus: Standart bir istisna yakalandı!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: Bilinmeyen aykırı durum yakalandı!",
        @"unlimited" = "sınırsız",
        @"Screenshot: Saving screenshot to: " = "Ekran görüntüsü: Ekran görüntüsü şuraya kaydediliyor: ",
        @"Screenshot: Screenshot is done." = "Screenshot: Ekran görüntüsü kaydedildi.",
        @"Screenshot: Couldn't write file: " = "Screenshot: Dosyaya yazılamıyor: ",
        @"If the way is blocked, bash away" = "Eğer yol kapalıysa, kır ve devam et",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "Daha önceki bölümlerden bildiğin Kazma eylemine benzer, ama yön olarak dikey kazma eyleminin tam tersine Pinguların yatay olarak kazmasına olanak sağlayan yeni bir yetenek daha öğreniyorlar. Bu yeni yeteneğe Delme diyoruz. ",
        @"Sacrifice a few and save the rest" = "Bir kaç tanesini feda et ve gerisini kurtar",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Bazen hiç başka bir eylem yapmak mümkün olmayabilir, bu yüzden zemin üzerinden bombalayarak yol açmalısınız. Pingular bunu kendilerini imha ederek yaparlar. Bu onları yokedecektir, ama geri kalanını kurtarmak için bazen bir kaç taneyi feda etmek gereklidir. ",
        @"Learning to dig" = "Kazmayı öğreniyoruz",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Bu senin ilk görevin. Her zamanki gibi oldukça kolay. Tek yapman gereken Pingulardan birine yere delik açmasını söyleyerek çıkışa gitmelerini sağlamak. Bunu bir Pingunun üzerine tıklayarak basitçe yapabilirsin. ",
        @"Float or Die" = "Havada Süzül ya da Öl",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "İlk görevinde iyi iş çıkarttın! Şimdi diğerine başlayalım. Bu sefer Pinguna uygun bir pervane giydirmelisin, böylelikle havadan toprağa hafifçe süzülebilirler. Eğer Pingular çok uzağa düşerlerse sağ kurtulamayabilirler, bu yüzden gözünü dört aç! ",
        @"Jump for joy" = "Eğlenmek için zıpla",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "Bazen Pingunun yürüyerek ulaşılmayan bir o kadar da uzakta olan bir platforma ulaşması gerekir. Bu durumda Sıçrama yeteneği çok işe yarar - Pingunun ufak bir sıçrama yaparak platforma ulaşmasını sağlar. ",
        @"Miner's heaven" = "Madenciler cenneti",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "Yeni bir yetenek öğreniyoruz - başka bir kazma eylemi, bu kez çarpraz bir tane. Bu Pingunun aşağı doğru yol oluşturmasını, ve takip eden Pingular için bir yol oluşturmasını sağlar. Bu yetenek Madencilik olarak adlandırılır. ",
        @"Panic Island (float/bash)" = "Panik Adası (uç/del)",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Önceki bölümler çok daha çabuk hareket etmeni gerektirmese de bu bölüm biraz daha zorlaşıyor. Pingular iki delikten çıkıyor ve görevin akıllıca bu iki grubu koordine etmek. ",
        @"Jump'n Bump... and Bash..." = "Zıpla Çarp... ve Del...",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "Tekrar panik zamanı. Pingular çok hızlı dışarı çıkmayacaklar, ancak duvara çarptıklarında geriye dönecekleri için bir süre sonra hepsini koordine etmek biraz sorun olacak. Başarmak için 5 tane kurtarman yeterli, ancak yine de başarısız olursan tekrar durumu kontrol etmek için duraklama-modunu ('p')  kullanabilirsin. ",
        @"Two groups in parallel, coordinate wisely" = "Paralel iki grup, dikkatli düzenleyin",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Bu sefer koordine etmen gereken iki grup var. Bu bölüm hareketlerini düşünmek için yeterli zaman verdiğinden paniğe gerek yok.  Bu kez daha fazla ipucu yok, ama iyi şanslar! ",
        @"Block'a Rock" = "Kaya Bloğu",
        @"Once again it's time to combine the things you have learned in your previous levels. Blast your way free and make sure you also keep the rest of the Pingus under control. The Blocker action will be helpful." = "Bir kez daha önceki bölümlerde öğrendiğin şeyleri birleştirmenin sırası geldi. Yolunu açık tut ve Pinguların diğerlerinin de kontrol altında olduğundan emin ol. Engelleyici işlemi yardımcı olacak.",
        @"Climb, Climber,... Boom!" = "Penjanje, pentranje,... Bum!",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Kao sto si do sada mogao ukapirati iz prethodnih nivoa cesto moras da kombinujes razlicite akcije da bi obavio zadatak. Zbog nedostatka akcije Kopanja na ovom nivou Samoubica mora da obavi posao. Pitanje je kako ga dovesti da mesta za eksploziju? ",
        @"Bridging gets more complicated..." = "Mostogradnja se komplikuje...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "Jos jednom se akcije moraju mudro i pazljivo kombinovati, jer bi bez toga zacas zavrsili u rupi pre izlaza, zato smisli kako da to izbegnes. ",
        @"If too high, your Pingu will die..." = "Ko visoko leti, nisko pada...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "Ovog puta je potreban timski rad da bi se doslo do izlaza. Nema dovoljno Padobranaca da bi svi dosli do izlaza, tako da je potrebno poslati nekoliko njih, koji moraju pripremiti stazu za ostale. ",
        @"Learn to use the bridge" = "Nauci da koristis most",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "Ako nema na raspolaganju Skakaca a treba preci preko velike rupe, onda je most vrlo korisna stvar. Potrebno je malo vremena da se most izgradi, ali svi Pingusi koji slede mogu da ga koriste, za razliku o skakanja. ",
        @"Three solutions, it's up to you" = "Üç çözüm var, birisini seçmek sana kalmış",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Artık tüm yetenekleri öğrendin, artık biraz pratik zamanı. Bu bölümü en az üç yolla çözebilirsin. Hangisini tercih edeceğiniz sana kalmış. ",
        @"Climb, Climber, climb... and build a bridge" = "Tırman, Pingu, tırman... ve bir köprü yap",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "Bir kere daha yeni bir yetenek öğrendiniz. Dağcı yeteneği bir Pingunun düz duvarlara tırmanabilmesini, böylece diğer yollarla erişmesi için çok yüksekte olan şeylere uzanabilmesini sağlar. ",
        @"Entrance high, Exit low" = "Giriş üstte, Çıkış altta",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Tüm Pinguları aşağıdaki çıkışa getirmek için yeterli süzülen pingun yoksa - onlara rehberlik edecek farklı yollar bulmalısın. Bu bölüm için ihtiyacın olan herşeyi önceki bölümlerle öğrenmiş olmalısın, bu yüzden bu çok da problem olmamalı. ",
        @"One must prepare, the rest must follow" = "Birini hazırlamak gerekir, geri kalanlar takip etmelidir",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "Bazen Pinguları koordine etmek için elinizin altında bloke edici Pingu olmayabilir. Bir tanesi geri kalan Pingular için yol açarken diğerlerini kontrol etmek için farklı yollar bulmalısınız. ",
        @"Dig and float, just don't fall and smash" = "Kaz ve uç, düşme ve çarpma",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "İlk iki seviyeden farklı olarak, iki tane yeni yetenek öğreniyoruz. Yapman gereken gene basit: soldaki panelden bir eylem seç ve bunu Pinguya uygula böylece çıkışa ulaşabileceklerler. Çok fazla Pingunun hayatını kaybetmesine izin verme. ",
        @"Dig, bash and other problems" = "Kazma, delme ve diğer sorunlar",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Daha fazla bölüm ilerledikçe, oyun gittikçe daha zorlaşacak, ama paniğe gerek yok, bu bölümde olduğu gibi hala kolay. Sadece önceki bölümlerden öğrendiklerini uygula ve bu senin için çok problem olmamalı. Eğer bir yerden itibaren artık bölümü çözemeyeceğin bir durumla karşılaştığını düşünüyorsan, sağda altta patlama düğmesini tıkla. ",
        @"Solid ground can block the path" = "Cvrsto zemljiste moze blokirati put",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "I ranijim nivoima smo naucili da Pingusi mogu prakticno kopati kroz bilo koje zemljiste, ali postoji nesto sto ne mogu prokopati. To su celicni objekti. Oni su oznaceni tamno sivom bojom na mapi nivoa i ne mogu biti unisteni, vec treba pronaci nacin da se zaobidju. ",
        @"One jump to catch them all" = "Bir sıçrama ile hepsini yakala",
        @"The pingus have found themselves lost on their journey.  What is this mysterious place?  Smiling pumpkins, giant candlesticks, and some boiling soup below... what wizardry is this? Now, facing a deadly abyss right in front of them it's your job to save them. Can you save them from a terrible fate?" = "Pingular yolculuklarında kendilerini kaybolmuş olarak buldular. Bu gizemli yer de neresi? Gülümseyen kabaklar, büyük şamdanlar ve aşağıda biraz kaynar çorba... bu nasıl bir sihirbazlıktır? Şimdi önlerinde ölümcül bir uçurum varken görevin onları kurtarmak. Onları bu korkunç felaketten kurtarabilir misin?",
        @"One Thousand and One Jumps" = "Bin Bir Zıplama",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "Normal bir Pingu için bu kadar yukarı çıkmakla ve uzağa ulaşmakla, mevcut seçenekler neler? Belki bir zıplayıcı onları kurtarabilir? Ya da kaçınılmaz ölümlerini yavaşlatacak mı? Bunu bulmak senin görevin, fakat hepsini kurtaracak kadar iyi misin?",
        @"Boom Boom" = "Güm Güm",
        @"You've mastered the last challenge and now face the next. Their path to salvation seems to be cursed, but by whom? There is no time to think about it, since the next deadly challenge already awaits the Pingus. Two mighty roots block the way, but without a basher at hand to bash them away, sacrifice might be the only option..." = "Son macerada uzmanlaştın ve şimdi sonrakiyle yüzleş. Kurtuluş yolları lanetlenmiş gibi duruyor, fakat bunu kim yaptı? Sonraki ölümcül macera Pinguları beklediği için düşünmeye zaman yok. İki zorlu kök yolu engelliyor ancak onları yıkacak bir delici olmadan, tek problem fedakarlık olacak.",
        @"Full Circle" = "Tam Yuvarlak",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "Çıkış çok yakın ama hala erişilemeyecek bir yerde. Yanlış yönde atılacak bir adım Pinguları korkunç bir sona sürükleyebilir. Onlara yardım etmek için bir şeyler yapmalısın, fakat yeterli zaman var mı? Acele etmeli ve bir hataya izin vermemelisin. Pingular sana güveniyor!",
        @"Bridgers Nightmare" = "Köprücünün Karabasanı",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "Bu kocaman duvarı buraya kim koymuş? Bu kocaman blok Pingular ile çıkış arasında bir engel olarak duruyor. Bu oldukça büyük yapının yıkımı imkansız gibi görünüyor, ama belki köprücü sizi kurtarabilir mi? Grubu yol açarken bir kez daha güvenli bir şekilde çıkışa ulaştıran yeterince yüksek köprüler üretebilirler mi? Ya da birisi size kötü bir oyun mu oynuyor?\n\nBir kez daha çözüm düşünmenden geçiyor... beyninin merkezindeki gri yapı Pinguların başarısının anahtarı, bu yüzden aklının karışmasına ve yanlış yola sapmasına izin verme.",
        @"Locked up by the witch" = "Cadı tarafından kilitlenmiş",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "Bu bir hapishane mi? Dört tarafı sağlam duvarlarla çevrilmiş, kaçış için bir yol görünmüyor. Kurtulmak imkansız görünüyor.Ama bekleyin... sağdaki duvar zayıf görünüyor... belki bu bir kaçış yoludur? Ya da pinguları kaçınılmaz sona sürükleyecek sahte bir yol?\n\nBu riskli bir yolculuk ama Pinguları bir kere daha özgürlüğe kavuşturmak için bu yolculuğu yapmalısınız.",
        @"Splatterfest" = "Su çarpma şenliği",
        @"This is by far the deepest pit the Pingus have yet encountered. Building a bridge across it seems obvious but that won't help since the exit is deep down in the pit itself. Pingus who try to go down the pit will just end up splattered all over the ground. You have two groups of Pingus at your disposal, can you make them work together to reach even an exit this well hidden?" = "Burası, Pinguların şimdiye kadar karşılaştığı en derin kuyu. Bir köprü yapmak çözecek gibi görünüyor ancak çıkış çukurun dibinde olduğundan yardımcı olmayacak. Aşağı inmeye çalışan Pingular yerde paramparça olacaklar. Emrinde iki grup Pingu var. Birlikte çalışmalarını ve bu kadar iyi gizlenmiş bir çıkışa ulaşmalarını sağlayabilecek misin?",
        @"Staircase Maintenance" = "Merdiven Bakımı",
        @"It seems we are up again against a mighty wall, and it is blocking the exit! But wait, some good soul has built a staircase around it. It seems, however, that the poor fool's efforts didn't last long, as the staircase is destroyed and full of holes. Can you fix it and make it over the wall? Yet of course you know that the right solution might not be the obvious one. But your Pingus are almost free, and they trust in your skill to guide them to safety once more. Succeed and you will have freed them once and for all from whatever evildoer that placed them in this nightmare... at least for this year." = "Görünüşe göre güçlü bir duvarla tekrar karşı karşıyayız ve çıkış yolunu kapatıyor! Ama bekle, bazı iyi kişiler etrafında bir merdiven yapmışlar. Ancak görünüşe göre, zavallıların girişimleri başarılı olmamış, çünkü merdiven tahrip olmuş ve delik deşik. Bunu düzeltebilir ve duvarın üzerinden geçmesini sağlayabilir misin? Yine tabi doğru çözüm ilk planda doğru görünen olmayabilir.  Ama Pingular neredeyse özgürlüklerine kavuşmak üzere, ve senin onlara rehberlik etmedeki becerine bir kez daha güveniyorlar. Bunu başar böylece onları içine düştükleri zor durumdan  bir kez daha kurtarmış olacaksın... en azından bu yıl için.",
        @"Down Into The Cave" = "Mağaranın Dibine",
        @"The exit is far below and the pingus are separated from it by quite a distance. The path down is riddled with gulfs, so jumping and bridging will be the primary tool to get down there. But be careful, the last few steps require some extra cleverness." = "Çıkış çok aşağıda ve Pingular oldukça uzak bir noktada ayrılar. Aşağıdaki yol körfezlerle delinmiş bu yüzden zıplamak ve köprü yapmak aşağı inmek için birincil araç olacak. Fakat dikkatli ol; son adımlar daha çok zekilik gerektiriyor.",
        @"Round and Round" = "Dön ve Dön",
        @"Trapped in an eternal loop one brave pingu has to break out and go on a journey in search for the exit, but he mustn't be too happy once he found it, as there is still one last challenge he must solve before being allowed to enter it, otherwise all his friends might perish." = "Sonsuz bir döngüde tutuklu kalmış bir cesur Pingu, çıkışı arayacak bir yola çıkmak zorunda; fakat bulduğunda çok mutlu olmamalı. Çünkü çıkışa girmesine izin verilmesi için son bir mücadele daha vermeli. Aksi takdirde tüm arkadaşları yok olacak.",
        @"Red Herring Cave" = "Kırmızı Ringa Mağarası",
        @"The exit is right above the pingus heads, with a few friendly arrows pointing the way. With jumpers around the solution should be obvious. But wait, can anything you find in a dark cave be trusted or is there some more going on which might slip your view? Thinking outside the box might be required." = "Çıkış, birkaç dostça okun yolu gösterdiği Pinguların başının üzerinde. Zıplayıcılar çözecek gibi görünüyor. Ama dur, karanlık bir mağarada bulacağın herhangi bir şeye bu kadar güvenilir mi orada yoksa görünümünü yanıltacak daha fazla şey olabilir mi? Farklı bir açıdan bakmak gerekebilir.",
        @"Group Coordination" = "Grup Uyumu",
        @"Three groups are on their way to the exit, one of them trapped right above it, but locked into a box. None of them can make it alone, coordinate them wisely and everybody should be able to make it safely to the exit. " = "Üç grup çıkış yolunda. Gruplardan biri tam üstünde bir kutuda kilitlenip tuzağa düşürüldü. Hiçbiri tek başına kurtulamaz. Zekice uyumlu çalışmalarını sağla ve böylece herkes çıkışa güvenle ulaşabilsin. ",
        @"Traps, Dangers and other Problems" = "Tuzaklar, Tehlikeler ve Diğer Problemler",
        @"The path to the exit lays below, shimmering through the planks. But the fall is too high, deadly for sure. Can one pingu alone make it's way through the dangerous traps and secure the path to the exit?" = "Çıkış yolu aşağıda; tahtalara doğru ışıldıyor. Fakat düşmek için çok yüksek; hatta ölümcül. Tek bir Pingu tehlikeli tuzaklara doğru gidip çıkışa güvenlice ulaşabilir mi?",
        @"Reach that Switch" = "Şu Düğmeye Ulaş",
        @"The path to the exit is straight, flat and simple, but wait a solid door blocking the way? How can the pingus open it? Is that a switch there on the hill to the right? Might that be the solution to opening the door and freeing the pingus? But how can they reach that switch?" = "Çıkış ileride, dümdüz; düz ve basit. Fakat bekle! Bir sert kapı yolu engelliyor mu? Pingular bu kapıyı nasıl açabilir? Yoksa yokuşun sağındaki bir düğme mi? Bu düğme kapıyı açmanın ve Pinguları özgür bırakmanın yolu olabilir mi? Fakat bu düğmeye nasıl ulaşabilirler?",
        @"The Collapsed Column" = "Yıkılmış Sütun",
        @"High up above the green slime the pingus are moving from column to column, getting closer to the exit with each step, but wait, there is a second group of pingus, they are stuck. The column next to them has collapsed making getting to the exit impossible. Can you find a way around the abyss?" = "Yeşil balçığın yukarısında Pingular sütundan sütuna yürüyüp, her adımda çıkışa yaklaşıyorlar. Fakat dur! İkinci grup Pingu var ve sıkışmışlar. Yanlarındaki sütun devrilmiş ve çıkmalarını imkansız yapmış. Bu uçurum çevresinde bir yol bulabilir misin?",
        @"Island of Doom" = "Ölüm Adası",
        @"The pingus are released close together, but split up by a solid metal column with seemingly no way to join them back up. The journey will be dangerous and some height has be crossed with the exit hidden below. With some cleverness it should be possible to join those two groups back together." = "Pingular birlikte olmak için salındılar fakat tekrar birleşmelerini engelleyecek metal bir sütun ile ayrıldılar. Macera tehlikeli olacak ve bazı yükseklikler aşağıdaki gizli çıkışlarla aşılmalı. Biraz zeki düşünce ile iki grubu tekrar birleştirmek mümkün olmalı.",
        @"Tower of Death" = "Ölüm Kulesi",
        @"The pingus are at the top of the tower, with no stairway around. The exit is deep down, hidden at the foot of the tower. How shall they make it down all that height with no floaters sight? A few well placed diggers should be enough to get the job done, but wait, no, their direction isn't quite right. You have to give them directions or it will be their doom." = "Pingular kulenin tepesindeler ancak çevresinde bir merdiven yok. Çıkış altta, kulenin dibinde gizli. Bu yükseklikten görünüşte hiçbir uçurucu olmadan nasıl inecekler? İyi yerleştirilmiş kazıcılar işi yapmak için yeterli olmalı fakat bekle! Yönleri tam doğru değil. Yönleri göstermelisin yoksa kendi sonları olacak.",
        @"The Ones" = "Bir(ler)",
        @"This is the last stage the pingus have to pass during this Halloween. Two oddly familiar column are in the way. What do they mean? The two groups of pingus have to work together to make it down the columns to the exit far below." = "Bu, Pinguların Cadılar Bayramı sırasında geçmeleri gereken son aşama. İki garip biçimde tanıdık sütunlar yine karşıda. Ne demek istiyorlar? Pinguların iki grubu birlikte çalışmalı ve sütunlardan aşağısındaki çıkışa gitmeliler.",
        @"Down the valley and up again" = "Vadide iniş ve tekrar çıkış",
        @"There is a large valley between the entrance and the exit. No bridge will be long enough to cross the valley, but can you find a way back up once you lead the Pingus down into the valley?" = "Giriş ve çıkış arasında büyük bir vadi var. Vadiyi geçmek için hiçbir köprü yeterli uzunlukta olmayacak, fakat Pinguları aşağı indirmeye yardım ettikten sonra yukarı çıkmaları için bir yol bulabilir misin?",
        @"Entering the pyramid" = "Piramite giriş",
        @"After their long and dangerous journey through the desert the Pingus finally reach the large pyramid, but there is still a pedestal blocking their way." = "Çölde uzun ve tehlikeli maceralarından sonra, Pingular sonunda büyük piramite ulaşırlar. Fakat hala önlerinde bir sütun temeli duruyor.",
        @"The window room" = "Pencere odası",
        @"After the Pingus have entered the pyramid, they reach a large room with a large window. The only problem they have is that the entrance to the room is much too high to survive the landing. Can you help them?" = "Pingular piramite girdikten sonra büyük pencereli, büyük bir odaya ulaşırlar. Yaşadıkları tek problem; odanın, inişte hayatta bırakmayacak kadar yüksek bir girişi olması. Yardım edebilir misin?",
        @"Grand Hall" = "Büyük Koridor",
        @"The pingus have found themselves in the grand hall, a hall full of wonder and treasures. The exit however is high up and won't be easy to reach. Guide the pingus around the hall and maybe you will find a way." = "Pingular kendilerini kocaman bir salon buldular... Harikalar ve hazinelerle dolu bir salon. Ne yazık ki çıkış yukarıda ve kolay ulaşılabilir olmayacak. Pingulara rehberlik et ve belki bir yol bulursun.",
        @"Pass the pedestal" = "Temeli geç",
        @"A large pedestal is blocking the way to the exit and there aren't enough bashers available to dig it away. Can you find a way to make it past the pedestal?" = "Büyük bir sütun temeli çıkış yolunu engelliyor ve kazmak için yeterli delici yok. Geçmelerini sağlayacak bir yol bulabilir misin?",
        @"The excavation of the pyramid" = "Piramitte kazı",
        @"The excavations are open to reach the pyramid for his redeeming content. Some excavations, however, is best done with two competitors. Who comes first?" = "Kazılar piramitin kurtarıcı içeriğine ulaşmak için yapılabilir. Ancak bazı kazılar ne yazık ki iki rakiple en iyi şekilde yapılır. Kim ilk gelecek?",
        @"Catch them at the half way point" = "Hepsini yarı yolda yakala",
        @"The Pingus are separated from the exit by large abyss. A simple bridge won't be enough to catch them safely, unless of course you find the right place to put it. Can you uncover that spot?" = "Pingular çıkıştan büyük bir uçurum ile ayrılmışlar. Basit bir köprü güvenle yakalanmaları için yeterli olmayacak. Ta ki koyacak doğru bir yer buluncaya kadar. Bu noktayı bulabilir misin?",
        @"Claustrophobia" = "Kapalı yer korkusu",
        @"Hidden deep below the pyramid the pingus come across a small underground room, but unfortunatley a large tree root blocks their path..." = "Piramitin gizli derinliğinde Pingular küçük bir yeraltı odasıyla karşılaşırlar, fakat büyük bir ağaç kökü yollarını kapatır...",
        @"A bit to the right a bit to left" = "Biraz sağa biraz sola",
        @"Only the most audacious Pingus will be allowed to continue." = "Sadece en cesur Pingular devam edebilecek.",
        @"25 Pingus free and 25 in the box" = "25 Pingu özgür ve 25 Pingu kutuda",
        @"Okay for the Bridger but what can I do with Digger? You should save at least one Pingu trapped in the box above the exit." = "Köprücü tamam fakat Kazıcıyla ne yapabilirim? Çıkış üzerindeki kutuda tuzağa düşürülmüş Pingulardan en az birini kurtarman gerek.",
        @"Tunnel Time" = "Tünel Zamanı",
        @"Dig a tunnel and you might make it to the exit. Digger and miners and stuff have to work together." = "Bir tünel kaz ve belki çıkışı bulabilirsin. Kazıcı, mayıncılar ve diğerleri birlikte çalışmalı.",
        @"Crawlspace" = "Eğilme boşluğu",
        @"The path to the exit is blocked and many small tunnels lead the way, but be careful some of those lead to certain death. Or is there something you can do about that and create a save passage for all the Pingus and lead them safely to the exit?" = "Çıkış yolu engelli ve bazı küçük tüneller yolu gösteriyor fakat bazıları da ölüme götürüyor, dikkatli ol. Ya da bununla yapabileceğin bir şey var ve Pinguların tamamı güvenlice çıkışa götürülebilir mi?",
        @"The Roof" = "Çatı",
        @"Sometimes the roofs are not good for refuge, sometimes it should be demolished! But be careful if you aren't precise enough, you might lead the Pingus straight to certain death." = "Bazen çatılar sığınmak için iyi değildir ve yıkılmaları gerekebilir! Fakat dikkatli ol. Eğer yeterince kusursuz yapamazsan Pinguları doğrudan ölüme sürükleyebilirsin.",
        @"Pingus Jones and the Last Exit" = "Pingu Jones ve Son Çıkış",
        @"Dr. Jones' notebook:\n\n  (1) the breath of God: only the penitent pingus will pass;\n  (2) the word of God... in reverse;\n  (3) the path of God: leap from the head of something like a cat." = "Dr. Jones'un defterinden:\n\n  (1) Tanrının nefesi: sadece pişman olan Pingu geçecek;\n  (2) Tanrının sözü... tam tersine;\n  (3) Tanrının yolu: bir şeyin başından kedi gibi sıçra.",
        @"Near can mean far" = "Yakın uzak olabilir",
        @"What do you do when you're going in the wrong direction ? Simple: walk into a wall. But it is easier said than done..." = "Yanlış yöne gidiyorsan yaparsın? Basit: duvara doğru yürü. Fakat söylemesi kolay tabii...",
        @"Trapped Underground" = "Yer Altında Kapana Kısılmış",
        @"The penguins escaped the mad scientist, but now they were trapped deep underground. They had no food or water, so they had to move fast." = "Penguenler çılgın biliminsanından kaçtılar ancak şimdi de yerin altında kapana kısıldılar. Su ve yiyecek olmadığından hızlı hareket etmeliler.",
        @"Experimentation" = "Deney",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Çılgın bir biliminsanı penguenleri yakaladı ve üzerlerinde deney yapıyor. Penguenler giyotinden nasıl kaçabilirler?",
        @"Hall of Illusion" = "Göz Yanılması Odası",
        @"The penguins stopped and stood in indecision. What was real and what was not? Flame lanced from above and a guillotine glittered in the distance. Almost all penguins must survive." = "Penguenler durdu ve kararsızlıkla bekliyorlar. Ne gerçek, ne sahte? Alev yukarıdan mızrak gibi ve uzakta parıldayan bir giyotin. Neredeyse tüm penguenler hayatta kalmalı.",
        @"The Lava Pit" = "Lav Çukuru",
        @"The penguins had defeated the mad scientist, and were walking away from his destroyed laboratory when a huge hole opened under their feet. The penguins fell into an underground cave and the only way out was across the lava pit. Luckily, it seemed someone had left some helpful signs." = "Penguenler çılgın biliminsanını yendiler ve ayaklarının altında koca bir çukur açıldığında yıkılmış laboratuvarından uzaklaşıyorlardı. Penguenler yeraltı mağarasına düştüler ve tek çıkış lav çukurundan. İyi ki biri yardımcı işaretler bırakmış.",
        @"At least the experiments are over..." = "En azından deneyler bitti...",
        @"The good news was that the mad scientist had tired of his experiments, the bad news was that now he was dumping them down a pit. A single floatation device was all the penguins had. Save as many as possible." = "İyi haber: Çılgın biliminsanı deneylerinden sıkıldı. Kötü haber: Tüm penguenleri bir çukura atıyor. Tüm penguenlerin sahip olduğu tek şey bir tek uçma aygıtı. Kurtarabildiğin kadar kurtar.",
        @"Ghosting" = "Gölgelenme",
        @"The penguins came to a long pass. Acid bubbled underneath and it seemed a climber or two were needed.  Hint: slider can be used to stop the miner ability." = "Penguenler uzun bir geçişe geldiler. Altlarında asit damlıyor ve görünüyor ki bir veya iki tırmanıcı gerekli. İpucu: Kaydırıcıyı kullanarak madenci özelliğini durdurabilirsin.",
        @"The Final (and suprisingly easy) Challenge" = "Son (ve inanılmaz basit) Mücadele",
        @"The penguins had reached the end of the island. In the water was a long tree, perfect for the penguin's needs. Their journey was almost over." = "Penguenler adanın sonuna ulaştılar. Suda, penguenlerin ihtiyacı için mükemmel bir uzun ağaç vardı. Maceraları neredeyse bitti.",
        @"Revenge is sweet" = "İntikam tatlıdır",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down." = "Penguenler çılgın biliminsanından kaçtılar fakat şimdi intikam peşindeler. Amaçları düşman laboratuvarını yıkmak üzere destek yapılarını yok etmek.",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down. They had to move fast though, because the mad scientist would detect and recapture them if they weren't fast enough." = "Penguenler çılgın biliminsanından kaçtılar fakat şimdi intikam peşindeler. Amaçları düşman laboratuvarını yıkmak üzere destek yapılarını yok etmek. Hızlı hareket etmeliler çünkü çılgın bilimadamı, yeterince hızlı olmazlarsa bulup tekrar yakalayabilir.",
        @"Winter Wonderland" = "Kış Harikası",
        @"After getting past the lava pit, the penguins walked and walked until they reached a snowed in exit. That would be relatively easy to tunnel through but how would it be possible to tunnel through solid metal?" = "Lav çukurundan geçildikten sonra, penguenler çıkıştaki kara kadar yürüdüler. Geçilmesi kolay bir tünel olabilirdi ancak sert metalli bir tünelden nasıl geçilebilir?",
        @"The Journey Goes On" = "Macera Devam Ediyor",
        @"And so the penguins continued on their journey, drawing ever closer to the North Pole. They had escaped the guillotine, defeated the mad scientist and got a new boat. And so this chapter in their voyage was over, but there would be other obstacles. Nothing  would stop the determined penguins from reaching their goal." = "Ve penguenler Kuzey Kutbu'na yaklaşırken maceralarına devam ettiler. Giyotinden kaçtılar, çılgın bilimadamını yendiler ve yeni bir sandalları oldu. Aslında bu bölümde maceraları bitmişti fakat diğer engeller de olabilir. Hiçbir şey azimli penguenlerin hedeflerine ulaşmalarını engelleyemez.",
        @"Think fast (literally)" = "Hızlı düşün (harfi harfine)",
        @"This would be simple but for one thing, there are no blockers. All the penguins must survive." = "Bu basit olabilirdi fakat bir şeyle: Engelleyiciler yok iken. Tüm penguenler kurtulmalı.",
        @"Shipwrecked" = "Gemi Kazası",
        @"The penguins were sailing along happily on their makeshift boat until suddenly an island appeared. The penguins were drawn towards it and crashed, destroying their boat. Now they must find their way across this strange island." = "Penguenler, aniden bir ada görününceye kadar mutlu bir şekilde kendi gecici sandallarında yelken açmışlardı. Adaya sürüklenip çarptılar ve sandalları parçalandı. Şimdi bu garip adadan kurtulmak için yol bulmalılar.",
        @"Escape from Aliens" = "Yaratıklardan Kaç",
        @"Aliens invade our starship blocking entrance to the teleporter. Your crew is well trained, like you they don't panic." = "Yaratıklar ışınlayıcının girişini engelleyerek uzay gemimizi ele geçirdiler. Tayfan senin gibi iyi eğitimli ve panik yapmıyorlar.",
        @"Escape from Aliens 2" = "Yaratıklardan Kaç 2",
        @"Aliens are now closest making your escape harder. You must dig it up." = "Yaratıklar kaçışını daha zor yapacak şekilde çok yakındalar. Kazmalısın.",
        @"Alien's nest" = "Yaratığın yuvası",
        @"Pingus invade the nest. Take care of jaws. What's the matrix above?" = "Pingular yuvayı ele geçirdi. Jaws'a dikkat et. Yukarıdaki matris de nesi?",
        @"Matrix of the death" = "Ölüm Matrisi",
        @"Take a piece of paper. Now pingus have to enter the matrix of the death. This is a maze, bad ways are protect by jaws." = "Bir kağıt al. Şimdi pingular ölüm matrisine girmek zorundalar. Bu bir labirent... Kötü yollar jaws tarafından korunuyor.",
        @"Spy's pingus in the matrix of the death" = "Casus pingular, ölüm matrisinde",
        @"Spy's pingus have marked the location of jaws in the matrix of the death. Many died to gain that information :..( Perhaps this help. Perhaps..." = "Casus pingular ölüm matrisindeki jaws'ın yerini tespit ettiler. Çoğu bu bilgi için hayatlarını verdi :..( Belki bu yardımcı olur, belki...",
        @"Fourth dimension" = "Dördüncü boyut",
        @"The defenses of the aliens get stronger. Now you have to jump in the fourth dimension to win!" = "Yaratıkların savunması gittikçe güçleniyor. Kazanmak için artık dördüncü boyuta zıplamalısın!",
        @"Set your watches" = "Saatlerini ayarla",
        @"Cooperation in space." = "Uzayda işbirliği",
        @"Lost in Space" = "Uzayda Kayıp",
        @"We don't know where we are but we don't leave anybody behind." = "Nerede olduğumuzu bilmiyoruz, fakat arkada kimseyi bırakmayız.",
        @"Outside In" = "Açık Havada",
        @"Can you help the pingus escape without getting their flippers wet?" = "Pinguların terlikleri ıslanmadan kaçmalarına yardım edebilir misin?",
        @"Endless Loop" = "Bitmez Döngü",
        @"To the right and to the left the Pingus will face certain death and you have to save 50. Can you help them get out of this mess?" = "Sağa ya da sola Pingular kesin ölümle yüzleşecek ve 50 tane kurtarmalısın. Bu kötü durumdan çıkmalarına yardım edebilir misin?",
        @"Up up in the space" = "Uzayda yukarı, yukarı",
        @"What good is a pick in space? Certainly not to go to the stars." = "Uzaydaki iyi seçim nedir? Tabii ki yıldızlara gitmemek.",
        @"Jump" = "Zıpla",
        @"All Pingus need is to jump.... Hint: While pausing (press P key) you still can control Pingus. " = "Tüm Pingulara gerekli olan şey zıplamak.... İpucu: Oyun duruyorken (P tuşuna bas) bile Pinguları kontrol edebilirsin. ",
        @"Factory" = "Fabrika",
        @"Finally you reached the factory. Watch out as there are many dangers. Use bombers to destroy the basement of the factory. Good luck!" = "Sonunda fabrikaya ulaştın. Çok fazla tehlike olduğundan dikkatli ol. Fabrikanın bodrum katını yoketmek için bombacıları kullan. İyi şanlslar!",
        @"Going back home" = "Eve dönüş",
        @"Your mission is over. Pingus can go back home, but be careful!" = "Görevin bitti. Pingular eve dönebilir fakat dikkatli ol!",
        @"Bonus track" = "Bonus iz",
        @"Pingus are at home, but after the climate change living on the South Pole became more dangerous. There is one more mission for you." = "Pingular evde fakat iklim değişikliğinden sonra Güney Kutbu'nda yaşamak daha tehlikeli olmaya başladı. Senin için bir görev daha var.",
        @"Falling down" = "Aşağı düşüş",
        @"Pingus intelligence reported that a huge factory located in the subtropical zone might be a reason of a climate change. They decided to go there and shut down the factories. This will be a long and dangerous expedition. Pingus and you will have to face many difficulties on your way. As the ice is melting, at first you have to build some bridges and watch out for the cliff." = "Pinguların zekaları iklim değişikliğinin sebebi olabilecek bir tropik bölgede yer alan büyük bir fabrika olabileceğini doğruladı. Oraya gitmeye ve fabrikaları kapatmaya karar verdiler. Bu uzun ve tehlikeli bir macera olacak. Pingular ve sen yol boyunca çok sayıda zorlukla karşılaşmak zorunda kalacaksın. Buz eridiği için, ilk olarak, köprü yapman ve uçurumlara dikkat etmen gerekecek.",
        @"Destination North" = "Hedef Kuzey",
        @"For now, Pingus are leaving South Pole and moving North. You have to help them!" = "Şimdilik, Pingular Güney Kutbu'ndan ayrılıyor ve Kuzey'e gidiyorlar. Onlara yardım etmelisin!",
        @"The Cave" = "Mağara",
        @"Pingus on their way came across a huge cave. You have to lead them through. Remember that sometimes there is more than one way out. Hint: To 'unlock' blockers you can use bashers and jumpers." = "Pingular yolda kocaman bir mağara ile karşılaştılar. Onlara öncülük etmelisin. Unutma, bazen birden fazla çıkış var. İpucu: Engelleyicilerin 'kilidini açmak' için delici ve zıplayıcıları kullanabilirsin.",
        @"Difficulties on the way" = "Yoldaki zorluklar",
        @"It looks you have encountered serious difficulties. But don't panic, Pingus are waiting for your orders, they count on you so don't fail! Hint: Miners, diggers and bashers are very important here!" = "Ciddi zorluklarla karşılaşmış gibi görünüyorsun. Fakat panik yapma, Pingular emirlerini bekliyor. Sana uyacaklar, böylece başarısız olmazsın! İpucu: Mayıncılar, kazıcılar ve deliciler burada çok önemli!",
        @"Four ways out" = "Dört çıkış var",
        @"It's getting warmer but Pingus are bravely moving North. This time it will be much easier. There are at least four ways out. Could you find them?" = "Sıcak olmaya başladı ancak Pingular Kuzey'e cesurca gidiyorlar. Bu kez daha kolay olacak. En azından dört çıkış var. Çıkışları bulabilir misin?",
        @"Egypt - So easy" = "Mısır - Çok kolay",
        @"Pingus reached Egypt. Looks easy, but is it really so easy? Try it out." = "Pingular Mısır'a ulaştı. Kolay görünüyor, fakat gerçekten öyle mi? Dene.",
        @"Egypt - Oasis" = "Mısır - Vaha",
        @"Last time it was easy. Now it will be a little bit harder. Pingus are entering oasis. Watch out for the water." = "Geçenki kolaydı, şimdi biraz daha zor olacak. Pingular vahaya giriyorlar. Suya dikkat et.",
        @"Egypt - The Maze" = "Mısır - Labirent",
        @"You came across a maze. Can you find the way out? Think twice before digging." = "Bir labirentle karşılaştın. Çıkışı bulabilir misin? Kazmadan önce iki kez düşün.",
        @"Egypt - Pyramids" = "Mısır - Piramitlar",
        @"The maze led you to the big pyramids. Now you have 4 minutes to escape. Hurry up!" = "Labirent seni büyük piramitlere götürdü. Kaçmak için 4 dakikan var. Acele et!",
        @"Bomb and Double Catch" = "Bomba ve Çifte Yakalama",
        @"Here you might have some time to relax. The path isn't complicated and a bit of bombing and catching of Pingus should bring you to the end without much trouble, but don't relax to much, your resources are limited, so be careful when using them." = "Burada biraz rahatlamak için zamanın olabilir. Yol karmaşık değil ve biraz bomba ve Pinguları yakalamak çok fazla sorun olmadan seni sona götürmeli. Fakat çok dinlenme, kaynakların sınırlı; bu yüzden kullanırken dikkat et.",
        @"Up, Up and Away" = "Yukarı, Yukarı ve Dışarı",
        @"The exit is in a weird spot here, straight above. A bridge won't get you there, but your toolset allows an alternative way. Can you figure it out?" = "Çıkış burada garip bir noktata: Dümdüz yukarıda. Bir köprü seni oraya götüremez ancak araç setinde alternatif yol için araçlar var. Bulabilir misin?",
        @"If only penguins could fly" = "Keşke penguenler uçabilseydi",
        @"Bridges are kind of rare around here, so don't waste any. That aside, you shouldn't have to much trouble here, everything to do here you should have learned, but you might have to use all that knowledge at once." = "Köprüler burada nadir bulunan türler, bu yüzden boşa harcama. Bunun dışında burada çok fazla sorunla karşılaşmaman gerek. Burada yapman gereken her şeuy öğrendilerini kullanmak. Fakat tüm bilgini aynı anda kullanman gerekebilir.",
        @"Stairway to Heaven" = "Cennete Merdiven",
        @"Here things start to get a little complicated. Getting up to the exit is hard enough with a single Pingu, but with all of them? Impossible! But wait, who says they have to come the same way?" = "Burada bazı şeyler daha karmaşık olmaya başlıyor. Çıkışa gitmek bir Pingu için bile zor iken, tümü için? İmkansız! Fakat bekle, kim hepsinin aynı yerden geleceğini söyledi?",
        @"Misdirection Everywhere" = "Her Yer Yanlış Yön",
        @"The last level for this Xmas. Looks a little complicated, right? Don't worry with all you have learned so far, you should be able to even solve this.\n\nGood Luck & a Merry Xmas 2011" = "Bu yeni yıl için son bölüm. Biraz karmaşık görünüyor, değil mi? Merak etme, buraya kadar öğrendiğin her şeyle bunu bile çözebilmelisin.\n\nİyi Şanslar & Mutlu Yıllar 2011",
        @"The Big Jump" = "Uzun Atlama",
        @"No Way to Stop" = "Durmak İmkansız",
        @"Here you don't have much time to waste. The path to the exit is clear and straight, but you don't have the time to prepare it. Can you find a way to leap ahead?" = "Burada boşa harcanacak çok zamanın yok. Çıkış yolu açık ve düz; ancak hazırlanmak için zamanın yok. İleri sıçramak için bir yol bulabilir misin?",
        @"Ice Block Blockage" = "Buz Bloğu Engeli",
        @"What's this? A gigantic ice block straight in the path? Where did that come from? No time wondering about things like that. The Pingus need to get to the exit and it's your job to find a way around the block." = "Bu da ne? Devasa bir buz bloğu yolun önünde mi? Nereden geldi? Bunları düşünmek için zaman yok. Pingular çıkışa gitmeli ve bloğun çevresinde bir yol bulmak da senin görevin.",
        @"The Impossible Bridge" = "İmkansız Köprü",
        @"Two groups of Pingus separated by a deep byss, joining them by a bridge seems impossible, but wise coordination of the two groups and a brave leap should let you make it to the exit." = "İki grup Pingu, derin bir uçurumla ayrılmış ve bir köprüyle birleştirmek imkansız görünüyor. Ancak iki grubun akıllıca uyumları ve cesurca bir zıplama çıkışa gitmeni sağlamalı.",
        @"Spiraling Away" = "Sarmal Çıkış",
        @"The exit is straight below, but the path is blocked by solid steel with no way through. But the Pingus have a versatile toolset at hand, can you use it to find a way around and make it to the exit?" = "Çıkış tam aşağıda, ancak içinden geçilemez bir sert çelikle yol kapanmış. Fakat Pinguların ellerinde çok amaçlı aygıtları var. Çevresinde bir yol arayıp çıkmalarını sağlayabilir misin?",
        @"Tutorial Island" = "Eğitim Adası",
        @"Learn the basics" = "Temelleri öğreniyoruz",
        @"Watch Ending" = "Sonu İzle",
        @"Watch Intro" = "Tanıtımı İzle",
        @"The Journey Begins" = "Yolculuk Başlıyor",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Uzun uzun yıllardır, Pingular diğer hayvanlarla birlikte Güney Kutbu üzerinde barış ve mutluluk içinde yaşadılar. Her şey çok güzel gidiyordu ve onların huzurunu bozacak hiç bir şey görünmüyordu. Pingular mutluydular ve bu sonsuza kadar devam edecek gibi görünüyordu.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Ama sonra bir gün, işler yavaşça değişmeye başladı: gökyüzü kararmaya ve dünya daha sıcak olmaya başladı. Önceleri bunun sadece dünyanın ikliminde normal bir dalgalanma olduğunu düşündüler, ama her şey yıldan yıla daha kötüye gidiyor gibiydi.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "Bazı bölgelerde karlar erimeye başladı ve yiyecek sorun haline geldi. Diğer hayvanlar daha soğuk yerler aramak için bölgeyi terk etmeye çalıştılar ama Pingular bunun yardımcı olmayacağını biilyorlardı: onlar bu konuda bir şeyler yapmak zorunda olduklarını biliyorlardı.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Bu yüzden en yaşlılardan oluşan bir grup bu konu hakkında ne yapacağına karar vermek için bir araya geldi. Bu ısınmanın nedenini bulabilmek için dünya çapında bir yolculuğa çıkmaya karar verdiler. Bu yolculuğa Güney Kutbundaki yüzlerce cesur Pingu katılıyordu.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "Ve dünya üzerindeki yolculuklarında kendilerine önderlik etmeniz için seni seçtiler. Yolculuk tehlikeli ve zor olacağından, ilk hedefin Eğitim Adası olarak da bilinen Mogorok Adası. Yaşlıların anlattıklarına göre bu ada her zaman dünyaya gönderilen pinguların ilk durakları olmuştu.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "Ada Pingulara yeteneklerini öğretmek için ideal bir sürü alandan oluşmaktadır. Pingular köprü yapmayı, tırmanmayı, çarpmayı uzun ve tehlikeli yolculuklarında ihtiyaç duyacakları daha bir sürü yeteneği öğrenebilirler.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "Oradayken Pinguları yönlendirme ve kontrol etme yeteneklerinizi geliştirebilirsiniz. Ayrıca Pinguların yeteneklerine aşinalık kazanabilir ve bu yetenekleri iyice öğrenebilirsiniz, bu yeteneklerin hepsine dünyaya olan yolculuğunuzda ihtiyacınız olacak.",
        @"Now that you and the Pingus have arrived at Tutorial Island it is time to take command and begin your mission.\n\nGood Luck!" = "Artık sen ve Pingular Eğitim Adası'nda ve artık komutayı alıp görevlere başlamanın zamanı geldi.\n\nİyi Şanslar!",
        @"The Journey Continues" = "Yolculuk Devam Ediyor",
        @"Now after you and the Pingus have learned the basics and practiced a bit it is time to move on and begin the journey into the world. Since the ice floe with which the Pingus traveled to the Tutorial Island isn't going to hold on the whole way into the warmer climates the Pingus have to find something else to guide them on their journey." = "Şimdi sen ve Pingular temelleri öğrendiniz ve bir parça pratik yaptınız şimdi harekete geçip dünyaya olan yolculuğa başlamanın tam sırası. Pinguların Eğitim Adasına giderken kullandıkları buz parçası sıcak iklimlere giden tüm yolda dayanamayıp eriyeceği için Pingular onlara seyahatlerinde kılavuz edecek başka bir şey bulmalılar.",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "Fakat yaşlıların söylediği gibi, Eğitim Adası sadece pratik yapmak için iyi bir yol değil aynı zamanda dünya içine giden yolda başlangıç noktasıdır. Biraz arama yaptıktan sonra Pingular bunun anlamını keşfettiler, ve adanın sonunda kendilerine sal yapmak için odun sağlayan büyük ağacı buldular.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Böylece Pingular işe koyuldular ve hepsini birden taşıyabilecek geniş sallar yaptılar. Bir parça yolluk hazırladıktan sonra tanıdık topraklarını bırakıp dünyanın bilinmeyen taraflarına doğru yolculuklarına başlamaya hazırdılar.",
        @"So the Pingus sit on their raft, worrying about what's to come and where to go, while floating into the sunset.\n\nTo be continued..." = "Ve Pingular, gün batımında yüzen botlarında, ne geleceği ve vereye gitmeleri gerektiği hakkında endişelenirlerken, otururlar.\n\nDevam edecek...",
        @"Alien by Josh Dye" = "Josh Dye tarafından Yaratık",
        @"Escape from alien" = "Yaratıktan kaç",
        @"Crystal" = "Kristal",
        @"Crystaline sparkling full of danger" = "Tehlikeyle parıldayan kristal",
        @"Desert" = "Çöl",
        @"Getting hot outside..." = "Dışarıda sıcaklamak...",
        @"Factory Campaign" = "Fabrika Mücadelesi",
        @"Pingus expedition" = "Pingus macerası",
        @"Halloween 2011" = "Cadılar Bayramı 2011",
        @"Going Underground" = "Yeraltına Gidiş",
        @"Halloween 2007" = "Cadılar Bayramı 2007",
        @"Trapped at All Hallows Eve" = "Cadılar Bayramında Tuzaktalar",
        @"Hellmouth" = "Cehennem Ağzı",
        @"A cave full of slime..." = "Balçıkla dolu bir mağara...",
        @"Jungle" = "Orman",
        @"Island of Mystery" = "Gizem Adası",
        @"Marooned on an Uncharted Isle [by Lachlan McCubbin]" = "Meçhul Bir Adada Mahsur Kalanlar [Lachlan McCubbin tarafından]",
        @"Pac-Man" = "Pac-Man",
        @"Trapped in a video game" = "Bir video oyununda tuzağa düşenler",
        @"Xmas 2011" = "Yeni Yıl 2011",
        @"Merry Christmas and a Happy New Year" = "Mutlu Yıllar",
    ],
]
