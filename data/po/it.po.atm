:pingus.po [
    lang = "it",
    texts = [
        @"Object:" = "Oggetto:",
        @"Nothing selected" = "Nulla di selezionato",
        @"Transparent" = "Trasparente",
        @"Solid" = "Solido",
        @"Ground" = "Terreno",
        @"Bridge" = "Ponte",
        @"Water" = "Acqua",
        @"Lava" = "Lava",
        @"Remove" = "Rimuovi",
        @"Direction:" = "Direzione:",
        @"Left" = "Sinistra",
        @"Misc" = "Varie",
        @"Right" = "Destra",
        @"ReleaseRate:" = "Tasso di rilascio:",
        @"Para-X:" = "Para-X:",
        @"Para-Y:" = "Para-Y:",
        @"Scroll-X:" = "Scorrimento-X:",
        @"Scroll-Y:" = "Scorrimento-Y:",
        @"Owner Id:" = "Id del proprietario:",
        @"Z-Pos:" = "Z-Pos:",
        @"Color:" = "Colore:",
        @"Small Stars:" = "Stelle piccole:",
        @"Middle Stars:" = "Stelle medie:",
        @"Large Stars:" = "Stelle grandi:",
        @"Repeat:" = "Ripeti:",
        @"Id:" = "Id:",
        @"Target Id:" = "Id obbiettivo:",
        @"Height:" = "Altezza:",
        @"Object: [Group]" = "Oggetto: [Gruppo]",
        @"Group not supported" = "Gruppo non supportato",
        @"Object: " = "Oggetto: ",
        @"New level" = "Nuovo livello",
        @"Open level..." = "Apri livello...",
        @"Save level..." = "Salva livello...",
        @"Save level as..." = "Salva livello come...",
        @"Play level..." = "Gioca livello...",
        @"Configure actions" = "Configura azioni",
        @"Configure level" = "Configura livello",
        @"Display object properties" = "Visualizza le proprietà dell'oggetto",
        @"Show object insertion window" = "Visualizza la finestra di inserimento oggetto",
        @"Show minimap" = "Mostra mini mappa",
        @"Duplicate the selected objects" = "Duplica gli oggetti selezionati",
        @"Delete the selected objects" = "Elimina gli oggetti selezionati",
        @"Raise object to top" = "Solleva l'oggetto in cima",
        @"Raise object" = "Solleva l'oggetto",
        @"Lower object" = "Abbassa l'oggetto",
        @"Lower object to bottom" = "Abbassa l'oggetto sul fondo",
        @"Flip object horizontally" = "Rifletti orizzontalmente l'oggetto",
        @"Flip object vertically" = "Rifletti verticalmente l'oggetto",
        @"Rotate object -90 degree" = "Ruota l'oggetto -90 gradi",
        @"Rotate object 90 degree" = "Ruota l'oggetto 90 gradi",
        @"Display help" = "Mostra la guida",
        @"Exit" = "Esci",
        @"Datadir" = "Cartella dati",
        @"Userdir" = "Cartella utente",
        @"Open" = "Apri",
        @"Save" = "Salva",
        @"Cancel" = "Annulla",
        @"Filename:" = "Nome del file:",
        @"Pathname:" = "Percorso:",
        @"Open a level" = "Apri un livello",
        @"Save your level" = "Salva il tuo livello",
        @"Author:" = "Autore:",
        @"Levelname:" = "Nome del livello:",
        @"Description:" = "Descrizione:",
        @"Pingus Count:" = "Numero di Pingus:",
        @"Pingus to Save:" = "Pingus da salvare:",
        @"Time:" = "Tempo:",
        @"Width:" = "Larghezza:",
        @"Music:" = "Musica:",
        @"== Editor Help ==" = "== Aiuto dell'Editor ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Seleziona tutto\nPulisci la selezione\nSolleva oggetti\nAbbassa oggetti\nSolleva oggetti in cima\nAbbassa oggetti in fondo\nRuota di 90 gradi\nRuota di 270 gradi\nRaggruppa gli oggetti selezionati\nSepara gli oggetti selezionati\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Capovolgi oggetto orizzontalmente\nCapovolgi oggetto verticalmente\nElimina tutti gli oggetti selezionati\nSposta gli oggetti di un pixel\nSposta gli oggetti di 32 pixel\nAlterna il colore di fondo\nAumenta/diminuisce ripetizione\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Dovresti dare un nomefile ai tuoi livelli sistematicamente, ad esempio per tema, numero progressivo ed avatar:\n\n     <nomeLivello><numero>-<creatore>.pingus\n\nCosì se crei un secondo livello con un tema a pietre, lo chiamerai: pietre2-tuoNome.pingus\n\nQuando hai creato un livello e vuoi che venga incluso nel gioco mandalo via email a:\n\n     pingus-devel@nongnu.org\n\nSolo i livelli pubblicati sotto GPL sono consentiti nel gioco. L'editor inserisce automaticamente il riferimento \nalla GPL, se vuoi avere un livello sotto una licenza differente, devi cambiare il riferimento.\n",
        @"Replace" = "Sostituisci",
        @"Entrance" = "Entrata",
        @"Groundpiece (ground)" = "Suolo (terreno)",
        @"Groundpiece (solid)" = "Suolo (solido)",
        @"Groundpiece (bridge)" = "Suolo (ponte)",
        @"Groundpiece (transparent)" = "Suolo (trasparente)",
        @"Groundpiece (remove)" = "Suolo (rimuovi)",
        @"Hotspot" = "Punto caldo",
        @"Background" = "Sfondo",
        @"Liquid" = "Liquido",
        @"Trap" = "Trappola",
        @"Weather" = "Clima",
        @"Special Object" = "Oggetto speciale",
        @"Prefab Object" = "Oggetti Prefabbricati",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Rilasciati:%3d/%d  Fuori:%3d Salvati:%3d/%d",
        @"Angel" = "Angelo",
        @"Basher" = "Sfondamuri",
        @"Blocker" = "Ostacolo",
        @"Boarder" = "Skater",
        @"Bomber" = "Bombarolo",
        @"Bridger" = "Pontiere",
        @"Climber" = "Scalatore",
        @"Digger" = "Scavatore",
        @"Drown" = "Annegato",
        @"Exiter" = "In uscita",
        @"Faller" = "In caduta",
        @"Floater" = "Paracadutista",
        @"Jumper" = "Saltatore",
        @"Laserkill" = "Laserkill",
        @"Miner" = "Minatore",
        @"Slider" = "Slider",
        @"Smashed" = "Schiacciato",
        @"Splashed" = "Tuffato",
        @"Superman" = "Superman",
        @"Teleported" = "Teletrasportato",
        @"Waiter" = "In attesa",
        @"Walker" = "Pedone",
        @"skip" = "salta",
        @"Play" = "Gioca",
        @"Back" = "Indietro",
        @"Number of Pingus: " = "Pingus totali: ",
        @"Number to Save: " = "Pingus da salvare: ",
        @"Time: " = "Tempo: ",
        @"Author: " = "Autore: ",
        @"Close" = "Chiudi",
        @"Fullscreen" = "Schermo intero",
        @"Mouse Grab" = "Cattura mouse",
        @"Software Cursor" = "Cursore software",
        @"Autoscrolling" = "Scorrimento automatico",
        @"Drag&Drop Scrolling" = "Scorrimento Drag&Drop",
        @"Print FPS" = "Stampa FPS",
        @"Resolution:" = "Risoluzione:",
        @"Renderer:" = "Renderer:",
        @"Language:" = "Lingua:",
        @"Master Volume:" = "Volume principale:",
        @"Sound Volume:" = "Volume effetti:",
        @"Music Volume:" = "Volume musica:",
        @"Option Menu" = "Menu opzioni",
        @"Some options require a restart of the game to take effect." = "Alcune opzioni richiedono il riavvio del gioco per avere effetto.",
        @"Story" = "Trama",
        @"..:: Start the game ::.." = "..:: Inizia il gioco ::..",
        @"Editor" = "Crea livelli",
        @"..:: Create your own levels ::.." = "..:: Crea un tuo livello ::..",
        @"Options" = "Opzioni",
        @"..:: Configure the game ::.." = "..:: Configura il gioco ::..",
        @"Levelsets" = "Altri livelli",
        @"..:: Play User Built levels ::.." = "..:: Gioca livelli creati dagli utenti ::..",
        @"..:: Bye, bye ::.." = "..:: Ciao ciao! ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: cattura mouse :: F10: conta fps :: F11: schermo intero :: F12: salva schermata ::..",
        @"Give up" = "Rinuncia",
        @"Retry" = "Riprova",
        @"Success!" = "Successo!",
        @"Failure!" = "Fallimento!",
        @"Perfect! You saved everyone possible - great!" = "Perfetto! Hai salvato tutti, sei grande!",
        @"No-one got killed, pretty good work." = "Nessuna vittima, bel lavoro.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Hai salvato giusto il necessario; ce l'hai fatta, ma non\npotresti migliorarti?",
        @"Not everybody was saved, but still good work!" = "Non tutti si sono salvati, ma rimane un buon lavoro!",
        @"What can I say, you made it - congratulations!" = "Cosa dovrei dire... ce l'hai fatta, congratulazioni!",
        @"You killed everybody, not good." = "Hai ucciso tutti, non va bene.",
        @"No-one got saved - I know you can do better." = "Non si è salvato nessuno, so che puoi far di meglio.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Ne hai salvati alcuni, ma non abbastanza...\nLa prossima volta puoi fare di meglio.",
        @"Only one more and you would have made it - try again!" = "Uno in più e ce l'avresti fatta, prova ancora!",
        @"Only a handful more and you would have made it - try again!" = "Qualcuno in più e ce l'avresti fatta, prova ancora!",
        @"Better luck next time!" = "Riprova, sarai più fortunato!",
        @"Saved: " = "Salvati: ",
        @"Died: " = "Morti: ",
        @"Time left: " = "Tempo rimasto: ",
        @"Under Construction" = "In costruzione",
        @"Untested, unpolished and broken levels" = "Livelli non testati, rozzi e rotti",
        @"Solved:" = "Risolto:",
        @"levels" = "livelli",
        @"???" = "???",
        @"Show Ending?" = "Mostra conclusione?",
        @"Leave?" = "Esci?",
        @"[OPTIONS]... [FILE]" = "[OPZIONI]... [LIVELLO]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Pingus è un gioco puzzle nel quale bisogna guidare un mucchio di piccoli Pingus per il mondo.",
        @"General Options:" = "Opzioni generali:",
        @"Displays this help" = "Mostra questa guida",
        @"Print version number and exit" = "Stampa il numero di versione ed esce",
        @"Enable info level log output" = "Abilita l'output del log a livello info",
        @"Enable debug level log output" = "Abilita l'output del log a livello debug",
        @"Disable all log output" = "Disattiva tutti gli output del log",
        @"Display Options:" = "Opzioni visualizzazione:",
        @"Start in Window Mode" = "Inizia in modalità finestra",
        @"Start in Fullscreen" = "Inizia in modalità schermo intero",
        @"Use the given renderer (default: sdl)" = "Usa il renderer fornito (predefinito: sdl)",
        @"Set the window resolution for pingus (default: 800x600)" = "Imposta la risoluzione della finestra di Pingus (predefinita: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Imposta la risoluzione utilizzata nella modalità a pieno schermo (predefinita: 800x600)",
        @"Enable software cursor" = "Attiva il cursore software",
        @"Game Options:" = "Opzioni di gioco:",
        @"Disable automatic scrolling" = "Disattiva lo scorrimento automatico",
        @"Enable drag'n drop scrolling" = "Attiva lo scorrimento drag'n drop",
        @"Sound Options:" = "Opzioni suono:",
        @"Disable sound" = "Disattiva il suono",
        @"Disable music" = "Disattiva la musica",
        @"Select language to use with Pingus" = "Seleziona la lingua da utilizzare con Pingus",
        @"List all available languages" = "Elenca tutte le lingue disponibili",
        @"Loads the level editor" = "Carica l'editor dei livelli",
        @"Directory Options:" = "Opzioni cartelle:",
        @"DIR" = "CARTELLA",
        @"Load game datafiles from DIR" = "Carica i file di dati del gioco dalla CARTELLA",
        @"Load config files and store savegames in DIR" = "Carica i file di configurazione e deposita i salvataggi del gioco nella CARTELLA",
        @"Load game modifications from DIR" = "Carica modifiche al gioco dalla CARTELLA",
        @"Don't read ~/.pingus/config" = "Ignora ~/.pingus/config",
        @"FILE" = "FILE",
        @"Read config options from FILE" = "Leggi le opzioni di configurazione dal FILE",
        @"Uses the controller given in FILE" = "Usa il controller specificato in FILE",
        @"Debug Options:" = "Opzioni di debug:",
        @"Enables some special features for developers" = "Attiva alcune funzionalità speciali per i programmatori",
        @"Set the game speed (0=fastest, >0=slower)" = "Imposta la velocità del gioco (0=più veloce, >0=più lento)",
        @"Set the desired game framerate (frames per second)" = "Imposta il numero di frame per secondo desiderato per il gioco",
        @"Set the size of the map tiles (default: 32)" = "Imposta la dimensione dei segmenti di mappa (predefinito: 32)",
        @"Pingus: Out of memory!" = "Pingus: memoria insufficiente!",
        @"Pingus: Standard exception caught!:\n" = "Pingus: intercettata eccezione standard!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: intercettato throw sconosciuto!",
        @"unlimited" = "illimitato",
        @"Screenshot: Saving screenshot to: " = "Salva schermata: salva schermata in: ",
        @"Screenshot: Screenshot is done." = "Salva schermata: salvataggio effettuato.",
        @"Screenshot: Couldn't write file: " = "Salva schermata: impossibile scrivere il file: ",
        @"If the way is blocked, bash away" = "Se la strada è bloccata, sfonda i muri",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "Un po' come lo \x22Scavatore\x22 che hai visto nei livelli precedenti, esiste un'abilità che permette ai Pingus di scavare orizzontalmente, invece che verticalmente come nello \x22Scavatore\x22. Questa nuova abilità è detta \x22Sfondamuri\x22. ",
        @"Sacrifice a few and save the rest" = "Sacrificane alcuni, ma salva gli altri",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Certe volte non c'è altra scelta, bisogna scavare il terreno con l'esplosivo. I Pingus possono farlo solo suicidandosi. In questo modo ovviamente muoiono, ma certe volte è necessario sacrificarne alcuni per salvare gli altri. ",
        @"Learning to dig" = "Impara a scavare",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Questa è la tua prima missione. Come sempre, è abbastanza facile. Tutto ciò che devi fare è ordinare ad un Pingus di scavare un buco nel terreno, in modo che possano arrivare all'uscita. Puoi farlo semplicemente facendo clic su un Pingus. ",
        @"Float or Die" = "Fluttua o muori",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "Ben fatto nella prima missione! Ecco la prossima: stavolta devi equipaggiare i Pingus con una piccola elica; in questo modo potranno rallentare le cadute svolazzando. Infatti se i Pingus cadono da molto in alto, non sopravvivono all'impatto: perciò stai attento! ",
        @"Jump for joy" = "Salti di gioia",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "Certe volte un Pingus ha bisogno di raggiungere una piattaforma lontana, irraggiungibile a piedi. In questi casi il \x22Saltatore\x22 diventa utile: permette al Pingus di fare piccoli salti in modo da raggiungere tale piattaforma. ",
        @"Miner's heaven" = "Il paradiso del minatore",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "Ed ecco un'altra nuova abilità che permette di scavare, questa volta in diagonale, e permette ad un Pingus di scavare diagonalmente nel terreno creando un percorso per i Pingus successivi. L'abilità si chiama \x22Minatore\x22. ",
        @"Panic Island (float/bash)" = "Isola del Panico",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Mentre i livelli precedenti non richiedevano un'azione veloce, stavolta le cose cambiano. I Pingus vengono fuori da due entrate parallele ed il tuo lavoro consiste nel coordinare saggiamente i due gruppi. ",
        @"Jump'n Bump... and Bash..." = "Salta e sbatti... e scava...",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "È ancora panico. I Pingus non verranno fuori molto velocemente, ma appena toccheranno i muri avrai qualche problema a coordinarli. Dato che devi salvarne solo 5 la cosa è fattibile, ma se ti trovi in difficoltà puoi fermarti e fare una pausa usando il tasto 'p'. ",
        @"Two groups in parallel, coordinate wisely" = "Due gruppi in parallelo, necessaria coordinazione",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Questa volta hai due gruppi da coordinare. Niente panico, in questo livello hai abbastanza tempo per ragionare con calma. Ma ora basta con gli aiuti: buona fortuna! ",
        @"Block'a Rock" = "Blocca la via",
        @"Once again it's time to combine the things you have learned in your previous levels. Blast your way free and make sure you also keep the rest of the Pingus under control. The Blocker action will be helpful." = "È di nuovo il momento di usare quanto appreso nei livelli precedenti. Scavati una strada, ma cerca di mantenere gli altri Pingus sotto controllo. L'abilità \x22Ostacolo\x22 sarà d'aiuto.",
        @"Climb, Climber,... Boom!" = "Sali, arrampicati... Boom!",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Come avrai intuito nei livelli precedenti, spesso dovrai usare abilità differenti per svolgere il tuo lavoro. In questo livello manca l'abilità \x22Scavatore\x22: basterebbe mettere una bomba, ma come si fa a raggiungere il posto giusto? ",
        @"Bridging gets more complicated..." = "La costruzione di ponti si complica...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "Ancora una volta devi usare accuratamente abilità differenti. Se non lo fai potresti finire nel buco vicino all'uscita, perciò pensa a come evitarlo. ",
        @"If too high, your Pingu will die..." = "Troppo in alto, il Pingus morirà...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "Serve il lavoro di squadra per uscire, stavolta. Non hai abbastanza \x22Paracadutisti\x22 per raggiungere l'uscita, perciò mandane alcuni a preparare la strada per gli altri. ",
        @"Learn to use the bridge" = "Impara ad usare i ponti",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "Se non hai \x22Saltatori\x22 sottomano e devi attraversare un grosso buco, un ponte è quello che ci vuole. Ci vuole un po' a costruirlo, ma in compenso tutti gli altri Pingus potranno usarlo. ",
        @"Three solutions, it's up to you" = "Tre soluzioni, scegline una",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Adesso che hai appreso tutte le abilità è il momento di allenarsi un po'. Ci sono almeno tre modi per risolvere questo livello. Sta a te scegliere. ",
        @"Climb, Climber, climb... and build a bridge" = "Sali, arrampicati, sali... e fai un ponte",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "Anche stavolta hai una nuova abilità a disposizione. \x22Arrampicatore\x22 ti permette di scalare i muri verticali, permettendo ai Pingus di raggiungere cose che altrimenti sarebbero troppo in alto. ",
        @"Entrance high, Exit low" = "Entrata in alto, uscita in basso",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Se non hai abbastanza \x22Paracadutisti\x22 per portare tutti i Pingus all'uscita, devi trovare un altro modo per farlo. Hai tutte le conoscenze necessarie, quelle che hai appreso nei livelli precedenti, perciò non dovrebbe essere un problema per te. ",
        @"One must prepare, the rest must follow" = "Uno prepara, gli altri seguono",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "In questo caso non hai un \x22Ostacolo\x22 per coordinare i Pingus. Dovrai trovare un altro modo per tenerli sotto controllo, mentre uno di loro prepara la strada per gli altri. ",
        @"Dig and float, just don't fall and smash" = "Scava e fluttua, ma attento a non cadere spiaccicandoti",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "Diversamente dai primi due livelli, avrai due abilità a disposizione. Il tuo lavoro è facile: scegli un'abilità dal pannello a sinistra e applicala ai Pingus in modo che tutti possano raggiungere l'uscita. Attento non farne morire troppi. ",
        @"Dig, bash and other problems" = "Scavare, sfondare ed altri problemi",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Più livelli superi, più difficile diventa il successo. Ma non preoccuparti, perché questo è ancora abbastanza facile. Usa ciò che hai imparato nei livelli precedenti e non avrai problemi. Se pensi di non essere in grado di completare il livello, fai un doppio clic sul pulsante \x22Armageddon\x22 in basso a destra. ",
        @"Solid ground can block the path" = "Il terreno duro può bloccare il cammino",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "Come avrai appreso nei livelli precedenti, i Pingus possono scavare attraverso quasi tutti i terreni, ma c'è un materiale che non si può attraversare: l'acciaio. Queste zone sono rappresentate in grigio scuro sulla mappa e non possono essere distrutte, perciò dovrai trovare un modo per evitarle. ",
        @"One jump to catch them all" = "Un salto per prenderli tutti",
        @"The pingus have found themselves lost on their journey.  What is this mysterious place?  Smiling pumpkins, giant candlesticks, and some boiling soup below... what wizardry is this? Now, facing a deadly abyss right in front of them it's your job to save them. Can you save them from a terrible fate?" = "I Pingus si sono persi nel loro viaggio. Cosa è questo posto misterioso? Zucche sorridenti, candelieri giganti, e sotto qualche zuppa bollente... che magia è questa? Ora, ti trovi di fronte al tuo lavoro, salvarli da un abisso mortale. Potrai salvarli da un terribile destino?",
        @"One Thousand and One Jumps" = "Mille ed un salto",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "Con l'uscita così alta e lontana da raggiungere per i normali Pingus, quali possibilità ci sono? Forse un ponticello può salvarli? O semplicemente sarà una lenta ed inevitabile morte? È il tuo lavoro scoprirlo, ma sei abbastanza bravo per salvarli tutti?",
        @"Boom Boom" = "Bum bum",
        @"You've mastered the last challenge and now face the next. Their path to salvation seems to be cursed, but by whom? There is no time to think about it, since the next deadly challenge already awaits the Pingus. Two mighty roots block the way, but without a basher at hand to bash them away, sacrifice might be the only option..." = "Hai padroneggiato nell'ultima sfida e ora affronti la prossima. La loro via di salvezza sembra essere maledetta, ma da chi? Non c'è tempo per pensarci, dato che la prossima sfida mortale attende già i Pingus. Due possenti radici bloccano la strada, ma senza uno \x22Sfondamuri\x22 a portata di mano per forarle, un sacrificio potrebbe essere l'unica opzione...",
        @"Full Circle" = "Cerchio completo",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "L'uscita è così vicina, ma fuori portata. Un passo nella direzione sbagliata e i Pingus cadranno con un terribile destino. Si deve fare qualcosa per aiutarli, ma c'è abbastanza tempo? Devi fare in fretta e non puoi concederti errori. I Pingus contano su di te!",
        @"Bridgers Nightmare" = "Incubo dei \x22Pontieri\x22",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "Chi ha piazzato questo muro mostruoso qui? Questo terribile blocco separa i tuoi Pingus dall'uscita. La distruzione di questa terribile costruzione sembra impossibile, ma forse i \x22Pontieri\x22 possono venirci in soccorso? Potranno costruire i loro ponti abbastanza in alto da guidare il gruppo ancora una volta in salvo nell'uscita? O è qualcuno che gioca brutti scherzi alla tua mente?\n\nAncora una volta vieni chiamato a cercare una soluzione... la tua materia grigia è la chiave per il successo dei Pingus, così non confonderti e non farti fuorviare dalla retta via.",
        @"Locked up by the witch" = "Bloccato dalla strega",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "Si tratta di una prigione? Bloccato da solide mura tutto intorno, non sembra esserci via di fuga. La salvezza sembra impossibile. Ma aspetta... il muro a destra sembra debole... forse questo è un modo per fuggire? O è un percorso falso che porterà alla tomba dei Pingus?\n\nQuesto è un viaggio rischioso, ma si deve intraprendere per scoprire come portarli tutti alla libertà, ancora una volta.",
        @"Splatterfest" = "Festa splatter",
        @"This is by far the deepest pit the Pingus have yet encountered. Building a bridge across it seems obvious but that won't help since the exit is deep down in the pit itself. Pingus who try to go down the pit will just end up splattered all over the ground. You have two groups of Pingus at your disposal, can you make them work together to reach even an exit this well hidden?" = "Questa è di gran lunga la più profonda buca che i Pingus abbiano incontrato. Costruire un ponte per attraversarla sembra ovvio, ma non aiuterà poiché l'uscita è sul fondo della buca. I Pingus che cercheranno di andare giù nella fossa finiranno tutti spiaccicati a terra. Hai due gruppi di Pingus a tua disposizione, puoi fare in modo che lavorino insieme per raggiungere l'uscita anche se è ben nascosta?",
        @"Staircase Maintenance" = "Manutenzione della scala",
        @"It seems we are up again against a mighty wall, and it is blocking the exit! But wait, some good soul has built a staircase around it. It seems, however, that the poor fool's efforts didn't last long, as the staircase is destroyed and full of holes. Can you fix it and make it over the wall? Yet of course you know that the right solution might not be the obvious one. But your Pingus are almost free, and they trust in your skill to guide them to safety once more. Succeed and you will have freed them once and for all from whatever evildoer that placed them in this nightmare... at least for this year." = "Sembra che siamo di nuovo di fronte ad un possente muro, e che stia bloccando l'uscita! Ma aspetta, qualche buon'anima gli ha costruito una scala attorno. Sembra, tuttavia, che gli sforzi del povero gonzo non sono durati a lungo, la scalinata è distrutta e piena di buchi. Si può risolvere il problema e fargli superare il muro? Ma naturalmente si sa che la giusta soluzione potrebbe non essere quella evidente. Ma i tuoi Pingus sono quasi liberi, e hanno fiducia nella tua abilità di guidarli verso la salvezza, un'altra volta. Impegnati e li avrai liberati una volta per tutte dal Malandrino che li ha condotti in questo incubo... almeno per quest'anno.",
        @"Down Into The Cave" = "Giù nella cava",
        @"The exit is far below and the pingus are separated from it by quite a distance. The path down is riddled with gulfs, so jumping and bridging will be the primary tool to get down there. But be careful, the last few steps require some extra cleverness." = "L'uscita è lontana là in basso ed i Pingus ne sono separati da una certa distanza. Il percorso sotto è pieno di golfi, così saltare e creare ponti sarà lo strumento principale per andare laggiù. Ma stai attento, gli ultimi pochi passi richiedono un po' di ingegnosità.",
        @"Round and Round" = "Giringiro",
        @"Trapped in an eternal loop one brave pingu has to break out and go on a journey in search for the exit, but he mustn't be too happy once he found it, as there is still one last challenge he must solve before being allowed to enter it, otherwise all his friends might perish." = "Intrappolato in un anello eterno un Pingus coraggioso deve uscire e partire per un viaggio alla ricerca dell'uscita, ma non deve essere troppo felice di averla trovata, c'è ancora un'ultima sfida che deve risolvere prima che gli sia consentito di entrarci, altrimenti tutti i suoi amici potrebbero perire.",
        @"Red Herring Cave" = "Cava della falsa pista",
        @"The exit is right above the pingus heads, with a few friendly arrows pointing the way. With jumpers around the solution should be obvious. But wait, can anything you find in a dark cave be trusted or is there some more going on which might slip your view? Thinking outside the box might be required." = "L'uscita è proprio sopra le teste dei Pingus, con alcune frecce amichevoli che indicano la strada. Con i \x22Saltatore\x22 in giro la soluzione dovrebbe essere ovvia. Ma aspetta, puoi fidarti di ogni cosa che trovi in una scura caverna o c'è qualcosa altro che potrebbe farti cambiare il tuo punto di vista? Potrebbe essere necessario pensare fuori dagli schemi.",
        @"Group Coordination" = "Coordinamento di gruppo",
        @"Three groups are on their way to the exit, one of them trapped right above it, but locked into a box. None of them can make it alone, coordinate them wisely and everybody should be able to make it safely to the exit. " = "Tre gruppi sono sulla propria strada verso l'uscita, uno di loro vi è intrappolato giusto sopra, ma bloccato in una scatola. Nessuno di loro può fare da solo, coordinali saggiamente e ognuno dovrebbe riuscire a raggiungere in sicurezza l'uscita. ",
        @"Traps, Dangers and other Problems" = "Trappole, pericoli e altri problemi",
        @"The path to the exit lays below, shimmering through the planks. But the fall is too high, deadly for sure. Can one pingu alone make it's way through the dangerous traps and secure the path to the exit?" = "Il percorso verso l'uscita si snoda qui sotto, luccicando tra le tavole. Ma la caduta è troppo alta, mortale di sicuro. Potrà un Pingus da solo fare questo percorso attraverso le pericolose trappole e rendere sicuro il percorso verso l'uscita?",
        @"Reach that Switch" = "Raggiungi l'interruttore",
        @"The path to the exit is straight, flat and simple, but wait a solid door blocking the way? How can the pingus open it? Is that a switch there on the hill to the right? Might that be the solution to opening the door and freeing the pingus? But how can they reach that switch?" = "Il percorso verso l'uscita è diritto, piano e semplice, ma aspetta una solida porta blocca la via? Come potranno i Pingus aprirla? È un interruttore quello lì sulla collina a destra? Potrebbe essere la soluzione all'apertura della porta e liberare i Pingus? Ma come potranno raggiungere l'interruttore?",
        @"The Collapsed Column" = "La colonna crollata",
        @"High up above the green slime the pingus are moving from column to column, getting closer to the exit with each step, but wait, there is a second group of pingus, they are stuck. The column next to them has collapsed making getting to the exit impossible. Can you find a way around the abyss?" = "In alto sopra la melma verde i Pingus si stanno muovendo da una colonna all'altra, avvicinandosi all'uscita ad ogni passo, ma aspetta, vi è un secondo gruppo di Pingus, sono bloccati. La colonna accanto a loro è crollata rendendo impossibile arrivare all'uscita. Riesci a trovare un modo per aggirare l'abisso?",
        @"Island of Doom" = "Isola del destino",
        @"The pingus are released close together, but split up by a solid metal column with seemingly no way to join them back up. The journey will be dangerous and some height has be crossed with the exit hidden below. With some cleverness it should be possible to join those two groups back together." = "I Pingus vengono rilasciati ravvicinati, ma divisi da una colonna di solido metallo con apparentemente nessun modo per ricongiungersi. Il viaggio sarà pericoloso e qualche altezza sarà superarata con l'uscita nascosta sotto. Con qualche astuzia, dovrebbe essere possibile unire questi due gruppi nuovamente insieme.",
        @"Tower of Death" = "Torre della morte",
        @"The pingus are at the top of the tower, with no stairway around. The exit is deep down, hidden at the foot of the tower. How shall they make it down all that height with no floaters sight? A few well placed diggers should be enough to get the job done, but wait, no, their direction isn't quite right. You have to give them directions or it will be their doom." = "I Pingus sono in cima alla torre, senza scale attorno. L'uscita è in fondo, nascosta ai piedi della torre. Come faranno a scendere da così in alto senza \x22Paracadutisti\x22 in vista? Alcuni \x22Scavatori\x22 ben piazzati dovrebbero essere abbastanza per portare a termine il lavoro, ma aspetta, no, la direzione non è quella corretta. Devi dargli la giusta direzione altrimenti sarà la loro rovina.",
        @"The Ones" = "Gli uni",
        @"This is the last stage the pingus have to pass during this Halloween. Two oddly familiar column are in the way. What do they mean? The two groups of pingus have to work together to make it down the columns to the exit far below." = "Questa è l'ultima tappa che i Pingus devono affrontare durante questo Halloween. Due colonne stranamente familiari sono sulla via. Cosa significano? I due gruppi di Pingus devono lavorare insieme per andare oltre le colonne molto più giù verso l'uscita.",
        @"Down the valley and up again" = "Giù nella valle e su di nuovo",
        @"There is a large valley between the entrance and the exit. No bridge will be long enough to cross the valley, but can you find a way back up once you lead the Pingus down into the valley?" = "C'è un'ampia valle tra l'ingresso e l'uscita. Nessun ponte sarà abbastanza a lungo per attraversare la valle, ma potrai trovare un modo per tornare su dopo aver con condotto i Pingus giù nella valle?",
        @"Entering the pyramid" = "Entrando nella piramide",
        @"After their long and dangerous journey through the desert the Pingus finally reach the large pyramid, but there is still a pedestal blocking their way." = "Dopo il loro lungo e pericoloso viaggio attraverso il deserto i Pingus finalmente raggiungono la grande piramide, ma qui c'è un piedistallo che blocca la loro strada.",
        @"The window room" = "La stanza della finestra",
        @"After the Pingus have entered the pyramid, they reach a large room with a large window. The only problem they have is that the entrance to the room is much too high to survive the landing. Can you help them?" = "I Pingus dopo essere entrati nella piramide, hanno raggiunto una grande camera con una grande finestra. L'unico problema che hanno è che l'entrata alla camera è troppo alta per sopravvivere all'atterraggio. Puoi aiutarli?",
        @"Grand Hall" = "Grande sala",
        @"The pingus have found themselves in the grand hall, a hall full of wonder and treasures. The exit however is high up and won't be easy to reach. Guide the pingus around the hall and maybe you will find a way." = "I Pingus si sono trovati in una grande stanza, una stanza piena di meraviglie e tesori. L'uscita tuttavia è in alto e non sarà facile da raggiungere. Guida i Pingus attorno alla stanza e può darsi che troverai la via.",
        @"Pass the pedestal" = "Passa la colonna",
        @"A large pedestal is blocking the way to the exit and there aren't enough bashers available to dig it away. Can you find a way to make it past the pedestal?" = "Un largo piedistallo sta bloccando la via verso l'uscita e non ci sono abbastanza \x22Scavatori\x22 disponibili per scavare una via di fuga. Riuscirai a creare un passaggio attraverso il piedistallo?",
        @"The excavation of the pyramid" = "Gli scavi della piramide",
        @"The excavations are open to reach the pyramid for his redeeming content. Some excavations, however, is best done with two competitors. Who comes first?" = "Sono aperti gli scavi per raggiungere la piramide per il suo salvifico contenuto. Certi scavi però è meglio farli con due concorrenti. Chi arriverà primo?",
        @"Catch them at the half way point" = "Prendili a metà strada",
        @"The Pingus are separated from the exit by large abyss. A simple bridge won't be enough to catch them safely, unless of course you find the right place to put it. Can you uncover that spot?" = "I Pingus sono separati dall'uscita da un grande abisso. Un semplice ponte non sarà abbastanza per tirarli in salvo, a meno che tu non scopra il giusto posto per metterlo. Riuscirai a scoprire questo posto?",
        @"Claustrophobia" = "Claustrofobia",
        @"Hidden deep below the pyramid the pingus come across a small underground room, but unfortunatley a large tree root blocks their path..." = "Nascosto profondamente sotto la piramide i Pingus incontrano una piccola stanza sotterranea, ma sfortunatamente tre grandi radici bloccano il loro percorso...",
        @"A bit to the right a bit to left" = "Uno po' a destra un po' a sinistra",
        @"Only the most audacious Pingus will be allowed to continue." = "Solo ai più arditi sarà consentito proseguire.",
        @"25 Pingus free and 25 in the box" = "25 Pingus liberi e 25 Pingus in scatola",
        @"Okay for the Bridger but what can I do with Digger? You should save at least one Pingu trapped in the box above the exit." = "Va bene per i \x22Pontieri\x22 ma cosa potrai fare con gli \x22Scavatori\x22? Dovresti salvare almeno un Pingus intrappolato nella scatola sopra l'uscita.",
        @"Tunnel Time" = "Tempo di gallerie",
        @"Dig a tunnel and you might make it to the exit. Digger and miners and stuff have to work together." = "Scava una galleria e potresti ottenere l'uscita. \x22Scavatori\x22 e \x22Minatori\x22 e gli altri devono lavorare insieme.",
        @"Crawlspace" = "Angusto",
        @"The path to the exit is blocked and many small tunnels lead the way, but be careful some of those lead to certain death. Or is there something you can do about that and create a save passage for all the Pingus and lead them safely to the exit?" = "Il percorso verso l'uscita è bloccato e molti piccoli tunnel conducono alla via, ma presta attenzione alcuni di questi conducono a morte certa. C'è qualcosa che tu possa fare per creare un sicuro passaggio per tutti i Pingus e condurli in sicurezza all'uscita?",
        @"The Roof" = "La Tettoia",
        @"Sometimes the roofs are not good for refuge, sometimes it should be demolished! But be careful if you aren't precise enough, you might lead the Pingus straight to certain death." = "Non sempre le tettoie non vanno bene per rifugiarsi, a volte andrebbero abbattute! Ma stai attento se non sei abbastanza preciso porterai i Pingus a morte certa.",
        @"Pingus Jones and the Last Exit" = "Pingus Jone e l'ultima uscita",
        @"Dr. Jones' notebook:\n\n  (1) the breath of God: only the penitent pingus will pass;\n  (2) the word of God... in reverse;\n  (3) the path of God: leap from the head of something like a cat." = "Dal taccuino del Dott. Jones:\n\n  (1) il respiro di Dio: solo il Pingus penitente passerà;\n  (2) la parola di Dio... in senso inverso;\n  (3) il percorso di Dio: balzo dalla testa di qualcosa come un gatto.",
        @"Near can mean far" = "Il prossimo può significare molto",
        @"What do you do when you're going in the wrong direction ? Simple: walk into a wall. But it is easier said than done..." = "Che cosa fai quando stai andando nella direzione sbagliata? Semplice: camminare sul muro. Ma è più facile dirsi che a farsi...",
        @"Trapped Underground" = "Intrappolati sottoterra",
        @"The penguins escaped the mad scientist, but now they were trapped deep underground. They had no food or water, so they had to move fast." = "I Pingus sono scappati dallo scienziato pazzo, ma ora sono intrappolati nelle profondità della terra. Non hanno ne cibo ne acqua, così devono muoversi velocemente.",
        @"Experimentation" = "Sperimentazione",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Uno scienziato pazzo ha catturato i Pingus e sta facendo degli esperimenti con loro. Come i Pingus possono sfuggire alla ghigliottina?",
        @"Hall of Illusion" = "Sala delle illusioni",
        @"The penguins stopped and stood in indecision. What was real and what was not? Flame lanced from above and a guillotine glittered in the distance. Almost all penguins must survive." = "I Pingus si sono fermati e sono indecisi.  Cosa era reale e cosa no? Fiamme dall'alto e una ghigliottina brillava in lontananza. Quasi tutti i Pingus devono sopravvivere.",
        @"The Lava Pit" = "Il pozzo di lava",
        @"The penguins had defeated the mad scientist, and were walking away from his destroyed laboratory when a huge hole opened under their feet. The penguins fell into an underground cave and the only way out was across the lava pit. Luckily, it seemed someone had left some helpful signs." = "I Pingus avevano sconfitto lo scienziato pazzo ed stavano andando via dal suo laboratorio distrutto quando un enorme buco si aprì sotto i loro piedi. I Pingus caddero in una grotta sotterranea e l'unica via d'uscita era attraverso una buca di lava. Fortunatamente, sembrava che qualcuno avesse lasciato indicazioni utili.",
        @"At least the experiments are over..." = "Almeno gli esperimenti sono finiti...",
        @"The good news was that the mad scientist had tired of his experiments, the bad news was that now he was dumping them down a pit. A single floatation device was all the penguins had. Save as many as possible." = "La buona notizia è che lo scienziato pazzo è stanco dei suoi esperimenti, la cattiva è che ora li sta buttando tutti in una buca. Un solo dispositivo di planata per tutti i Pingus. Salvane il più possibile.",
        @"Ghosting" = "Dissolvenza",
        @"The penguins came to a long pass. Acid bubbled underneath and it seemed a climber or two were needed.  Hint: slider can be used to stop the miner ability." = "I Pingus sono arrivati in un lungo passaggio. Sotto acido gorgogliante e sembra che siano necessari uno \x22Scalatore\x22 o due. Suggerimento: lo \x22Slider\x22 è utilizzabile per fermare l'abilità \x22Minatore\x22.",
        @"The Final (and suprisingly easy) Challenge" = "La sfida finale (sorprendentemente facile)",
        @"The penguins had reached the end of the island. In the water was a long tree, perfect for the penguin's needs. Their journey was almost over." = "I Pingus avevano raggiunto la fine dell'isola. In acqua c'era un lungo albero, perfetto per le esigenze dei Pingus. Il viaggio era quasi finito.",
        @"Revenge is sweet" = "La vendetta è dolce",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down." = "I Pingus sono sfuggiti allo scienziato pazzo, ma ora vogliono vendetta. Intendono distruggere le strutture di sostegno, facendo schiantare il laboratorio del diavolo.",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down. They had to move fast though, because the mad scientist would detect and recapture them if they weren't fast enough." = "I Pingus scappati dallo scienziato pazzo ora vogliono vendetta. Hanno intenzione di distruggere le strutture di supporto, facendo crollare il laboratorio del male. Devono fare in fretta, perché lo scienziato pazzo potrebbe rilevarli e catturarli nuovamente se non fanno abbastanza in fretta.",
        @"Winter Wonderland" = "Meraviglioso inverno",
        @"After getting past the lava pit, the penguins walked and walked until they reached a snowed in exit. That would be relatively easy to tunnel through but how would it be possible to tunnel through solid metal?" = "Dopo aver passato il pozzo di lava, i Pingus camminarono e camminarono fino a quando raggiunsero un'uscita bloccata dalla neve. Sarebbe relativamente semplice scavare una galleria per attraversarla ma come potrebbe essere possibile scavare una galleria attraverso il solido metallo?",
        @"The Journey Goes On" = "L'Avventura inizia",
        @"And so the penguins continued on their journey, drawing ever closer to the North Pole. They had escaped the guillotine, defeated the mad scientist and got a new boat. And so this chapter in their voyage was over, but there would be other obstacles. Nothing  would stop the determined penguins from reaching their goal." = "E così i Pingus continuarono il loro viaggio, avvicinandosi sempre di più al Polo Nord. Erano scappati dalla ghigliottina, avevano sconfitto lo scienziato pazzo e avevano recuparto una nuova barca. E così questo capitolo nella loro navigazione era finito, ma ci potrebbero essere altri ostacoli. Nulla che possa fermare i determinati Pingus dal raggiungere il proprio scopo.",
        @"Think fast (literally)" = "Pensa veloce (letteralmente)",
        @"This would be simple but for one thing, there are no blockers. All the penguins must survive." = "Questo sarebbe semplice, ma per prima cosa, non hai a disposizione l'abilità \x22Ostacolo\x22. Tutti i Pingus devono sopravvivere.",
        @"Shipwrecked" = "Naufragio",
        @"The penguins were sailing along happily on their makeshift boat until suddenly an island appeared. The penguins were drawn towards it and crashed, destroying their boat. Now they must find their way across this strange island." = "I Pingus hanno veleggiato a lungo felicemente sulla loro barca fino a quando, improvvisamente, è apparsa un'isola. I Pingus sono stati attirati verso di essa e si sono schiantati, distruggendo la loro barca. Ora devono trovare la loro via attraverso questa strana isola.",
        @"Escape from Aliens" = "Fuga dagli alieni",
        @"Aliens invade our starship blocking entrance to the teleporter. Your crew is well trained, like you they don't panic." = "Gli alieni hanno invaso la nostra nave spaziale bloccando l'entrata al teletrasporto. L'equipaggio è ben addestrato, come voi non andranno in panico.",
        @"Escape from Aliens 2" = "Fuga dagli alieni 2",
        @"Aliens are now closest making your escape harder. You must dig it up." = "Gli alieni sono ora più vicini rendendo più difficile la fuga. Bisogna scavare adesso.",
        @"Alien's nest" = "Nido degli alieni",
        @"Pingus invade the nest. Take care of jaws. What's the matrix above?" = "I Pingus invadono il nido. Proteggiti dalle mascelle. Di che matrice si tratta?",
        @"Matrix of the death" = "Matrice della morte",
        @"Take a piece of paper. Now pingus have to enter the matrix of the death. This is a maze, bad ways are protect by jaws." = "Prendi un pezzo di carta. Ora i Pingus devono entrare nella matrice della morte. Questo è un labirinto, le vie sfavorevole sono protette da mascelle.",
        @"Spy's pingus in the matrix of the death" = "Le spie dei Pingus nella matrice della morte",
        @"Spy's pingus have marked the location of jaws in the matrix of the death. Many died to gain that information :..( Perhaps this help. Perhaps..." = "Le spie Pingus hanno segnato la posizione delle mascelle nel Matrix della morte. Molti sono morti per ottenere questa informazione :..( Forse questo aiuterà. forse...",
        @"Fourth dimension" = "Quarta dimensione",
        @"The defenses of the aliens get stronger. Now you have to jump in the fourth dimension to win!" = "Le difese degli alieni diventano più forti. Ora devi passare nella quarta dimensione per vincere!",
        @"Set your watches" = "Sincronizziamo gli orologi",
        @"Cooperation in space." = "Cooperazione nello spazio.",
        @"Lost in Space" = "Persi nello Spazio",
        @"We don't know where we are but we don't leave anybody behind." = "Non sappiamo dove siamo ma non lasciamo indietro nessuno.",
        @"Outside In" = "Fuori dentro",
        @"Can you help the pingus escape without getting their flippers wet?" = "Potrai aiutare i Pingus a fuggire senza che si bagnino le pinne?",
        @"Endless Loop" = "Anello senza fine",
        @"To the right and to the left the Pingus will face certain death and you have to save 50. Can you help them get out of this mess?" = "A sinistra ed a destra i Pingus hanno morte certa e 50 sono da salvare! Potrai aiutarli ad uscire da questo pasticcio?",
        @"Up up in the space" = "Su su nello spazio",
        @"What good is a pick in space? Certainly not to go to the stars." = "A che serve un piccone nello spazio? Certamente non ad andare verso le stelle.",
        @"Jump" = "Salta",
        @"All Pingus need is to jump.... Hint: While pausing (press P key) you still can control Pingus. " = "Tutti i Pingus devono satare.... Suggerimento: Mentre sei in pausa (premi il tasto p) puoi controllare i Piungus. ",
        @"Factory" = "Industria",
        @"Finally you reached the factory. Watch out as there are many dangers. Use bombers to destroy the basement of the factory. Good luck!" = "Finalmente hai raggiunto l'industria. Fai attenzione ci sono molti pericoli. Usa i \x22Bombarolo\x22 per distruggere il basamento della fabbrica. Buona fortuna!",
        @"Going back home" = "Ritorno a casa",
        @"Your mission is over. Pingus can go back home, but be careful!" = "La tua missione è terminata. I Pingus possono tornare a casa, ma stando attenti!",
        @"Bonus track" = "Traccia premio",
        @"Pingus are at home, but after the climate change living on the South Pole became more dangerous. There is one more mission for you." = "I Pingus sono a casa, ma dopo i cambiamenti climatici vivere al Polo Sud è diventato più pericoloso. C'è una missione in più per te.",
        @"Falling down" = "Cadendo giù",
        @"Pingus intelligence reported that a huge factory located in the subtropical zone might be a reason of a climate change. They decided to go there and shut down the factories. This will be a long and dangerous expedition. Pingus and you will have to face many difficulties on your way. As the ice is melting, at first you have to build some bridges and watch out for the cliff." = "L'intelligence Pingus ha riferito che una grande fabbrica situata nella zona subtropicale potrebbe essere una delle ragioni del cambiamento climatico. Si è deciso di andare lì e di chiudere la fabbrica. Questa sarà una lunga e pericolosa missione. I Pingus e tu vi troverete di fronte a molte difficoltà sul vostro cammino. Dato che il ghiaccio si stà sciogliendo, in un primo momento sarà necessario costruire ponti e prestare attenzione alla scogliera.",
        @"Destination North" = "Destinazione Nord",
        @"For now, Pingus are leaving South Pole and moving North. You have to help them!" = "Ora i Pingus stanno lasciando il polo sud per raggiungere il nord. Devi aiutarli!",
        @"The Cave" = "La cava",
        @"Pingus on their way came across a huge cave. You have to lead them through. Remember that sometimes there is more than one way out. Hint: To 'unlock' blockers you can use bashers and jumpers." = "I Pingus sulla loro strada si sono imbattuti in una grotta enorme. Devi condurli attraverso. Ricorda che a volte c'è più di una via d'uscita. Suggerimento: per 'sbloccare' l'abilità \x22Ostacolo\x22 puoi usare l'abilità \x22Scavatore\x22 e quella \x22Saltatore\x22",
        @"Difficulties on the way" = "Difficoltà di percorso",
        @"It looks you have encountered serious difficulties. But don't panic, Pingus are waiting for your orders, they count on you so don't fail! Hint: Miners, diggers and bashers are very important here!" = "Sembra che tu abbia incontrato serie difficoltà. Ma niente panico, i Pingus stanno attendendo i tuoi ordini, contano su di te per non fallire! Suggerimento: \x22Minatori\x22, \x22Scavatori\x22 e \x22Sfondamuri\x22 sono veramente importati qui!",
        @"Four ways out" = "Quattro vie di fuga",
        @"It's getting warmer but Pingus are bravely moving North. This time it will be much easier. There are at least four ways out. Could you find them?" = "Sta facendo più caldo ma i Pingus stanno coraggiosamente spostandosi a nord. Questa volta sarà più facile. Ci sono almeno quattro vie di fuga. Potrai trovarle?",
        @"Egypt - So easy" = "Egitto - Così facile",
        @"Pingus reached Egypt. Looks easy, but is it really so easy? Try it out." = "I Pingus hanno raggiunto l'Egitto. Sembra facile, ma è veramente così facile? Prova.",
        @"Egypt - Oasis" = "Egitto - Oasi",
        @"Last time it was easy. Now it will be a little bit harder. Pingus are entering oasis. Watch out for the water." = "L'ultima volta è stato facile. Ora sarà un po' più difficile. I Pingus stanno entrando in un'oasi. Attenzione all'acqua.",
        @"Egypt - The Maze" = "Egitto - Il labirinto",
        @"You came across a maze. Can you find the way out? Think twice before digging." = "Vi siete imbattuti in un labirinto. Riuscirai a trovare il modo di uscirne? Pensaci due volte prima di scavare.",
        @"Egypt - Pyramids" = "Egitto - Piramidi",
        @"The maze led you to the big pyramids. Now you have 4 minutes to escape. Hurry up!" = "Il labirinto ti ha portato alle grandi piramidi. Ora hai 4 minuti per fuggire. Sbrigati!",
        @"Bomb and Double Catch" = "Bomba e doppia presa",
        @"Here you might have some time to relax. The path isn't complicated and a bit of bombing and catching of Pingus should bring you to the end without much trouble, but don't relax to much, your resources are limited, so be careful when using them." = "Qui potresti avere un po' di tempo per rilassarti. Il percorso non è complicato e un po' di \x22Bombaroli\x22 e prese al volo di Pingus dovrebbero portavi fino alla fine senza troppi problemi, ma non rilassarti troppo, le tue risorse sono limitate, così sii attento quando le usi.",
        @"Up, Up and Away" = "Su, su e via",
        @"The exit is in a weird spot here, straight above. A bridge won't get you there, but your toolset allows an alternative way. Can you figure it out?" = "L'uscita è in un strano punto qui, dritto sopra. Un ponte non può arrivarci, ma i tuoi strumenti ti consentono una via alternativa. Puoi immaginarti come?",
        @"If only penguins could fly" = "Se solo i Pingus potessero volare",
        @"Bridges are kind of rare around here, so don't waste any. That aside, you shouldn't have to much trouble here, everything to do here you should have learned, but you might have to use all that knowledge at once." = "I ponti sono merce rara qui attorno, così non sprecarne alcuno. A parte questo, non dovresti avere molti problemi qui, ogni cosa che farai qui dovresti averla imparata, ma potresti dover utilizzare tutto quello che hai conosciuto contemporaneamente.",
        @"Stairway to Heaven" = "Scala per il paradiso",
        @"Here things start to get a little complicated. Getting up to the exit is hard enough with a single Pingu, but with all of them? Impossible! But wait, who says they have to come the same way?" = "Qui le cose iniziano a diventare un po' complicate. Raggiungere l'uscita è abbastanza difficile con un solo Pingus, ma con tutti insieme? Impossibile! Ma aspetta, chi dice che devono venire tutti dalla stessa strada?",
        @"Misdirection Everywhere" = "Depistaggi ovunque",
        @"The last level for this Xmas. Looks a little complicated, right? Don't worry with all you have learned so far, you should be able to even solve this.\n\nGood Luck & a Merry Xmas 2011" = "L'ultimo livello per questo Natale. Sembra un po' complicato vero? Non preoccuparti con tutto quello che hai imparato sino ad ora, dovresti essere in grado di risolverlo.\n\nBuona fortuna e buon Natale 2011",
        @"The Big Jump" = "Il grande salto",
        @"No Way to Stop" = "Nessun modo di fermarsi",
        @"Here you don't have much time to waste. The path to the exit is clear and straight, but you don't have the time to prepare it. Can you find a way to leap ahead?" = "Qui non c'è molto tempo da perdere. Il percorso verso l'uscita è pulito e dritto, ma non hai tempo per prepararlo. Potrai trovere una via per fare un balzo avanti?",
        @"Ice Block Blockage" = "Bloccati da un blocco di ghiaccio",
        @"What's this? A gigantic ice block straight in the path? Where did that come from? No time wondering about things like that. The Pingus need to get to the exit and it's your job to find a way around the block." = "Cos'è questo? Un gigante blocco di ghiaccio dritto sul percorso? Da dove è venuto? Non c'è tempo per farci domande a riguardo. I Pingus hanno bisogno di raggiungere l'uscita ed il tuo lavoro è di trovare una via attorno al blocco.",
        @"The Impossible Bridge" = "Il ponte impossibile",
        @"Two groups of Pingus separated by a deep byss, joining them by a bridge seems impossible, but wise coordination of the two groups and a brave leap should let you make it to the exit." = "Due gruppi di Pingus separati da un profondo abisso, unirli con un ponte sembra impossibile, ma una saggia coordinazione dei due gruppi e un salto coraggioso potrebbero consentirti di raggiungere l'uscita.",
        @"Spiraling Away" = "Allontanarsi dalla spirale",
        @"The exit is straight below, but the path is blocked by solid steel with no way through. But the Pingus have a versatile toolset at hand, can you use it to find a way around and make it to the exit?" = "L'uscita si stende dritta qui sotto, ma il percorso è bloccato da solido acciaio senza una via per attraversarlo. Ma i Pingus hanno un gruppo di strumenti versatili a portata di mano, puoi usarli per trovare una via per aggirarlo e raggiungere l'uscita?",
        @"Tutorial Island" = "Isola Tutorial",
        @"Learn the basics" = "Impara le basi",
        @"Watch Ending" = "Mostra conclusione",
        @"Watch Intro" = "Mostra introduzione",
        @"The Journey Begins" = "L'Avventura inizia",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Per molto tempo, i Pingus hanno vissuto felicemente in pace al Polo Sud insieme a tutti gli altri animali. Tutto era in equilibrio e sembrava che nulla potesse rompere la loro pace. I Pingus erano felici e sembrava che questo non potesse mai finire.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Ma poi un giorno, le cose iniziarono lentamente a cambiare: il cielo si scurì e la terra si riscaldò. Prima, si pensò che fosse soltanto una normale fluttuazione nel clima mondiale, ma le cose sembravano peggiorare e peggioravano ogni anno.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "Fuori, in alcune aree, la neve ha iniziato a sciogliersi ed il cibo è diventato un problema. Gli altri animali hanno provato a lasciare la regione alla ricerca di aree più fredde, ma i Pingus sapevano che questo non li avrebbe aiutati: sapevano che dovevano fare qualcosa.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Così il consiglio degli anziani si riunì per decidere cosa fare. Decisero di inviare una spedizione in tutto il mondo per trovare la causa di questo riscaldamento. La spedizione era composta da centinaia dei più valorosi Pingus del Polo Sud.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "E scelsero te per guidarli nel loro viaggio intorno al mondo. Dato che il viaggio sarà pericoloso e difficile, il tuo primo obiettivo è l'Isola di Mogorok, conosciuta anche come Isola Tutorial. Secondo gli anziani, quest'isola è sempre stata la prima tappa dei Pingus in viaggio per il mondo.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "L'isola ha molte regioni, ideali per apprendere le abilità Pingus. Qui i Pingus possono esercitarsi a costruire ponti, a scavare, ad arrampicarsi ed a fare tutto quello che potrebbe servire durante il loro lungo e pericoloso viaggio.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "D'altra parte, anche tu potrai allenarti a comandare e guidare i Pingus. Potrai familiarizzare con tutte le abilità che i Pingus hanno, e magari approfondirle, dato che ti serviranno sicuramente in questa avventura intorno al mondo.",
        @"Now that you and the Pingus have arrived at Tutorial Island it is time to take command and begin your mission.\n\nGood Luck!" = "Adesso che tu ed i Pingus siete arrivati all'Isola Tutorial è venuto il momento di prendere il comando ed iniziare la missione.\n\nBuona Fortuna!",
        @"The Journey Continues" = "L'Avventura continua",
        @"Now after you and the Pingus have learned the basics and practiced a bit it is time to move on and begin the journey into the world. Since the ice floe with which the Pingus traveled to the Tutorial Island isn't going to hold on the whole way into the warmer climates the Pingus have to find something else to guide them on their journey." = "Adesso che tu ed i Pingus avete imparato le basi e vi siete allenati è tempo di muoversi ed iniziare l'avventura nel mondo. Dato che il blocco di ghiaccio che i Pingus hanno usato per arrivare all'Isola Tutorial si scioglierebbe andando verso le regioni con clima più caldo, i Pingus dovranno trovare un altro mezzo di trasporto per continuare il viaggio.",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "Ma, come dissero gli anziani, l'Isola Tutorial non è solo un modo per allenarsi, ma è anche il punto di partenza nel mondo. Dopo alcune ricerche, i Pingus scoprirono il vero significato di quelle parole: infatti il grande albero alla fine dell'isola potrebbe fornire ottimo legno per costruire una zattera.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Allora i Pingus si misero al lavoro e costruirono delle zattere, grandi abbastanza per trasportarli tutti. Dopo aver anche raccolto un po' di provviste, si prepararono finalmente a partire per il loro viaggio, lasciando la terra natìa per entrare nelle zone sconosciute del mondo.",
        @"So the Pingus sit on their raft, worrying about what's to come and where to go, while floating into the sunset.\n\nTo be continued..." = "Cosi i Pingus si sedettero nella loro zattera, preoccupandosi di quello che sarebbe successo e di dove sarebbero andati, mentre galleggiavano verso il tramonto.\n\nContinua...",
        @"Alien by Josh Dye" = "Alieni di Josh Dye",
        @"Escape from alien" = "Fuga dagli alieni",
        @"Crystal" = "Cristallo",
        @"Crystaline sparkling full of danger" = "Scintillio cristallino pieno di pericoli",
        @"Desert" = "Deserto",
        @"Getting hot outside..." = "Sta facendo caldo fuori...",
        @"Factory Campaign" = "Campagnia Industria",
        @"Pingus expedition" = "Spedizione Pingus",
        @"Halloween 2011" = "Halloween 2011",
        @"Going Underground" = "Andando sottoterra",
        @"Halloween 2007" = "Halloween 2007",
        @"Trapped at All Hallows Eve" = "Intrappolati in All Hallows Eve",
        @"Hellmouth" = "Bocca dell'inferno",
        @"A cave full of slime..." = "Una grotta piena di melma...",
        @"Jungle" = "Giungla",
        @"Island of Mystery" = "Isola del mistero",
        @"Marooned on an Uncharted Isle [by Lachlan McCubbin]" = "Abbandonati su un'isola inesplorata [by Lachlan McCubbin]",
        @"Pac-Man" = "Pac-Man",
        @"Trapped in a video game" = "Intrappolati in un videogioco",
        @"Xmas 2011" = "Natale 2011",
        @"Merry Christmas and a Happy New Year" = "Merry Christmas and a Happy New Year",
    ],
]
