        @"Option Menu" = "Nustatymų meniu",
        @"Some options require a restart of the game to take effect." = "Kai kurie nustatymai įsigalios tik paleidus žaidimą iš naujo.",
        @"Story" = "Pradžia",
        @"..:: Start the game ::.." = "..:: Pradėti žaidimą ::..",
        @"Editor" = "Kūrimo įrankis",
        @"Options" = "Nustatymai",
        @"..:: Configure the game ::.." = "..:: Žaidimo nustatymai ::..",
        @"Levelsets" = "Žaidimų serijos",
        @"..:: Bye, bye ::.." = "..:: Ate, ate ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: pelės ribojimas  ::  F10: kadrų skaitiklis  ::  F11: visame ekrane  ::  F12: nuotrauka ::..",
        @"Give up" = "Baigti",
        @"Retry" = "Bandyti vėl",
        @"Success!" = "Valio!",
        @"Failure!" = "Nepavyko!",
        @"Perfect! You saved everyone possible - great!" = "Puiku! Jūs išsaugojote visus pingvinus - nuostabu!",
        @"No-one got killed, pretty good work." = "Visi pingvinai pasiekė tikslą, puikus darbas.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Jūs išsaugojote tiksliai tiek pingvinų, kiek reikėjo - užduotis įvykdyta,\nbet gal jūs galite ir geriau?",
        @"Not everybody was saved, but still good work!" = "Ne visi pingvinai pasiekė tikslą, bet Jūs užduotį įvykdėte!",
        @"What can I say, you made it - congratulations!" = "Jūs įvykdėte užduotį - sveikinu!",
        @"You killed everybody, not good." = "Niekas nepasiekė tikslo, blogai.",
        @"No-one got saved - I know you can do better." = "Neatlikote užduoties - tikrai galite labiau pasistengti.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Per mažai pingvinų pasiekė tikslą. Galbūt\nkitą kartą Jūs vadovausite geriau?",
        @"Only one more and you would have made it - try again!" = "Padėk pasiekti tikslą dar vienam ir užduotis bus įvykdyta - bandyk vėl!",
        @"Better luck next time!" = "Sėkmingo darbo kitą kartą!",
        @"Saved: " = "Pasiekė tikslą: ",
        @"Died: " = "Nepasiekė tikslo: ",
        @"Time left: " = "Liko laiko: ",
        @"Solved:" = "Įveikta:",
        @"Leave?" = "Išeiti",
        @"General Options:" = "Bendri nustatymai",
        @"Displays this help" = "Rodyti šią pagalbą",
        @"Display Options:" = "Vaizdo nustatymai:",
        @"Start in Window Mode" = "Paleisti atskirame lange",
        @"Start in Fullscreen" = "Paleisti visame ekrane",
        @"Set the window resolution for pingus (default: 800x600)" = "Nustatyti Pingus žaidimo lango dydį (raišką, standartinė: 800x600 taškų)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Nustatyti Pingus žaidimo ekrano raišką veikiant visame ekrane (įprastai būna: 800x600 taškų)",
        @"Game Options:" = "Žaidimo nustatymai:",
        @"Disable automatic scrolling" = "Išjungti automatinį ekrano slankiojimą",
        @"Sound Options:" = "Garso nustatymai:",
        @"Disable sound" = "Išjungti garsą",
        @"Disable music" = "Išjungti muziką",
        @"Select language to use with Pingus" = "Nustatyti Pingus sąsajos kalbą",
        @"List all available languages" = "Rodyti visas galimas kalbas",
        @"Directory Options:" = "Aplankų nustatymai:",
        @"DIR" = "APLANKAS",
        @"FILE" = "FAILAS",
        @"Set the game speed (0=fastest, >0=slower)" = "Nustatyti žaidimo greitį (0=greičiausiai, >0=lėčiau)",
        @"unlimited" = "neribotas",
        @"If the way is blocked, bash away" = "Jei praėjimas užstatytas - rauskite",
        @"Sacrifice a few and save the rest" = "Keletas pasiaukos ir išgelbės visus",
        @"Learning to dig" = "Mokymasis kasti",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Tai yra pirmoji jūsų užduotis, todėl ji yra labai paprasta - tiesiog liepkite pingvinui iškasti skylę žemėje ir visi galės pasiekti išėjimą. Kairėje pusėje pasirinkite veiksmą, kurį turės atlikti pingvinas ir tuomet paspauskite ant pingvino kairiu pelės klavišu. ",
        @"Float or Die" = "Skrisk, nes užsimuši",
        @"Jump for joy" = "Šokinėk iš laimės",
        @"Miner's heaven" = "Šachtininkų rojus",
        @"Panic Island (float/bash)" = "Panikos sala (skristi ir rausti)",
        @"Two groups in parallel, coordinate wisely" = "Išmaniai vadovaukite dviem pingvinų grupėms vienu metu",
        @"Learn to use the bridge" = "Išmokite statyti tiltus",
        @"Three solutions, it's up to you" = "Trys sprendimai - rinktis Jums",
        @"Dig, bash and other problems" = "Kasimas, rausimas ir kitos problemos",
        @"Solid ground can block the path" = "Kietos uolos gali užtverti kelią",
        @"One Thousand and One Jumps" = "Tūkstantis ir vienas šuolis",
        @"Bridgers Nightmare" = "Tiltų statytojo košmaras",
        @"Down Into The Cave" = "Žemyn į urvą",
        @"Factory" = "Gamykla",
        @"The Cave" = "Ola",
        @"Egypt - So easy" = "Egiptas - bus nesunku",
        @"Pingus reached Egypt. Looks easy, but is it really so easy? Try it out." = "Pingvinai atkeliavo į Egiptą. Atrodo bus paprasta, bet ar tikrai? Pabandykite.",
        @"Egypt - Oasis" = "Egiptas - Oazė",
        @"Egypt - The Maze" = "Egiptas - Labirintas",
        @"Egypt - Pyramids" = "Egiptas - Piramidės",
        @"If only penguins could fly" = "Jeigu pingvinai galėtų skraidyti",
        @"Stairway to Heaven" = "Laiptai į dangų",
        @"The Big Jump" = "Didysis šuolis",
        @"The Impossible Bridge" = "(Ne)įmanomas tiltas",
        @"Tutorial Island" = "Mokymosi sala",
        @"Learn the basics" = "Išmokite svarbiausių dalykų",
        @"Watch Intro" = "Žiūrėti įžangą",
        @"The Journey Begins" = "Kelionė prasideda",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Ilgus šimtmečius Antarktidoje taikiai ir laimingai gyveno pingvinai bei kiti gyvūnai. Visiems visko užteko ir atrodė, kad niekas negali nutraukti šio darnaus gyvenimo. Pingvinai buvo laimingi - visi galvojo, kad puikus gyvenimas niekada nesibaigs.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Tačiau po ilgų šimtmečių kai kas pradėjo keistis: vis dažniau dangus būdavo tamsesnis nei įprastai, o oras bei vanduo - šiltesnis. Pingvinai pagalvojo, kad tai normalus pasaulinio klimato svyravimas, tačiau kasmet orai būdavo vis blogesni ir šiltesni.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "Kai kuriose vietovėse ištirpdavo vis daugiau sniego, todėl pradėjo trūkti maisto. Kiti gyvūnai bandė palikti savo įprastas teritorijas ir ieškoti šaltesnių vietovių, tačiau pingvinai žinojo, kad pabėgimas nepadės: jie suprato - reikia kažką daryti.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Taigi, vyriausieji pingvinai susirinko kartu ir galvojo ką reikia padaryti. Jie nusprendė išsiųsti ekspediciją aplink pasaulį ir surasti kas sukelia šį atšilimą. Ekspedicijoje dalyvaus šimtai stipriausių bei narsiausių pingvinų iš Pietų Ašigalio.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "Pingvinai išrinko tave, kad vadovautum jų kelionei aplink pasaulį. Kelionė bus sunki ir pavojinga, todėl pirmiausia reikia aplankyti netoliese esančią Mogorok salą, dar vadinamą „Mokymosi sala“. Anot senolių, ši sala visuomet būdavo pirmoji pingvinų stotelė, jiems keliaujant į pasaulį.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "Šioje saloje yra daug vietovių, puikiai tinkančių mokyti pingvinus įvairių gebėjimų. Pingvinai gali išmokti statyti tiltus, laipoti po uolas, rausti, kasti bei naudotis įvairiais kitais talentais, kurie jiems bus reikalingi ilgose ir pavojingose kelionėse.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "O Tau reikia išmokti vadovauti pingvinams bei susipažinti su visais jų gebėjimais, taip pat išmokti treniruoti pingvinus, kadangi kelionėje aplink pasaulį reikės visų pingvinų sugebėjimų.",
        @"The Journey Continues" = "Kelionė tęsiasi",
        @"Desert" = "Dykuma",
        @"Factory Campaign" = "Misija Fabrikas",
        @"Pingus expedition" = "Pingvinų ekspedicija",
        @"Jungle" = "Džiunglės",
        @"Xmas 2011" = "Kalėdos 2011",
        @"Merry Christmas and a Happy New Year" = "Linksmų Kalėdų bei laimingų Naujųjų Metų",
    ],
]
