:pingus.po [
    lang = "gd",
    texts = [
        @"Object:" = "Oibseact:",
        @"Nothing selected" = "Chan eil dad comharraichte",
        @"Transparent" = "So-dhrùidhteach",
        @"Solid" = "Cruaidh",
        @"Ground" = "Làr",
        @"Bridge" = "Drochaid",
        @"Water" = "Uisge",
        @"Lava" = "Làbha",
        @"Remove" = "Thoir air falbh",
        @"Direction:" = "Comhair:",
        @"Left" = "Clì",
        @"Misc" = "Measgaichte",
        @"Right" = "Deas",
        @"ReleaseRate:" = "Tric. sgaoil.",
        @"Para-X:" = "Para-X:",
        @"Para-Y:" = "Para-Y:",
        @"Scroll-X:" = "Sgroladh-X:",
        @"Scroll-Y:" = "Sgroladh-Y:",
        @"Owner Id:" = "ID cò leis:",
        @"Z-Pos:" = "Suidh-Z:",
        @"Color:" = "Dath:",
        @"Small Stars:" = "Rionnagan (beag):",
        @"Middle Stars:" = "Rionnagan (meadhanach):",
        @"Large Stars:" = "Rionnagan (mòr):",
        @"Repeat:" = "Ath-dhèanamh:",
        @"Id:" = "ID:",
        @"Target Id:" = "ID amais:",
        @"Height:" = "Àirde:",
        @"Object: [Group]" = "Oibseact: [Buidheann]",
        @"Group not supported" = "Cha tèid taic a chur ri buidheann",
        @"Object: " = "Oibseact: ",
        @"New level" = "Leibheil ùr",
        @"Open level..." = "Fosgail leibheil...",
        @"Save level..." = "Sàbhail leibheil...",
        @"Save level as..." = "Sàbhail leibheil mar...",
        @"Play level..." = "Cluich leibheil...",
        @"Configure actions" = "Rèitich gnìomhan",
        @"Configure level" = "Rèitich leibheil",
        @"Display object properties" = "Seall feartan an oibseict",
        @"Show object insertion window" = "Seall uinneag gus oibseactan a chur ris",
        @"Show minimap" = "Seall meanbh-mhapa",
        @"Duplicate the selected objects" = "Dèan lethbhreac dhe na h-oibseactan air an taghadh",
        @"Delete the selected objects" = "Sguab às dha na h-oibseactan air an taghadh",
        @"Raise object to top" = "Àrdaich oibseact gu bàrr",
        @"Raise object" = "Àrdaich oibseact",
        @"Lower object" = "Ìslich oibseact",
        @"Lower object to bottom" = "Ìslich oibseact gu bonn",
        @"Flip object horizontally" = "Flip oibseact gu còmhnard",
        @"Flip object vertically" = "Flip oibseact gu h-inghearach",
        @"Rotate object -90 degree" = "Tionndaidh an oibseact -90 puing",
        @"Rotate object 90 degree" = "Tionndaidh an oibseact 90 puing",
        @"Display help" = "Seall Cobhair",
        @"Exit" = "Fàg an-seo",
        @"Datadir" = "Pasgan dàta",
        @"Userdir" = "Pasg. cleachd.",
        @"Open" = "Fosgail",
        @"Save" = "Sàbhail",
        @"Cancel" = "Sguir dheth",
        @"Filename:" = "Faidhle:",
        @"Pathname:" = "Pasgan:",
        @"Open a level" = "Fosgail leibheil",
        @"Save your level" = "Sàbhail leibheil",
        @"== Editor Help ==" = "== Cobhair an deasaiche ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Tagh a h-uile\nFalamhaich an taghadh\nÀrdaich oibseactan\nÌslich oibseactan\nÀrdaich oibseactan gu bàrr\nÀrdaich oibseactan gu bonn\nTionndaidh 90 puing\nTionndaidh 270 puing\nBuidhnich oibseactan taghta\nNeo-bhuidhnich oibseactan taghta\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Flip oibseact gu còmhnard\nFlip oibseact gu h-inghearach\nSguab às dha gach oibseact taghta\nGluais oibseact le aon phiogsail\nGluais oibseact le 32 phiogsail\nToglaich dath a' chùlaibh\nMeudaich/Lùghdaich ath-dhèanamh\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Bu chòir do na h-ainmean a chuireas tu air na leibheilean agad a bhith rianail, 's e seo a-rèir an ùrlair,\nna h-àireimh is d' fhar-ainm:\n\n     <ainm-an-leibheil><àireamh>-<cruithear>.pingus\n\nMar sin, ma tha ùrlar cloiche air an dàrna leibheil agad, seo na chuireas tu air: clach2-d'ainm.pingus\n\nMa tha thu air leibheil a chruthachadh is ag iarraidh gun cuireadh sinn ris a' gheama e, cuir e le post-d gu:\n\n     pingus-devel@nongnu.org\n\nCha chuir sinn leibheilean ris a' gheama ach le foillseachadh fo cheadachas GPL. Cuiridh an deasaiche\niomradh air a' GPL ris gu fèin-obrachail. Ma tha thu airson ceadachas eile a chleachdadh airson an leibheil \nagad, feumaidh tu an t-iomradh seo atharrachadh.\n",
        @"Replace" = "Cuir na àite",
        @"Entrance" = "Inntrigeadh",
        @"Groundpiece (ground)" = "Pìos an làir (làr)",
        @"Groundpiece (solid)" = "Pìos an làir (cruaidh)",
        @"Groundpiece (bridge)" = "Pìos an làir (drochaid)",
        @"Groundpiece (transparent)" = "Pìos an làir (so-dhrùidhteach)",
        @"Groundpiece (remove)" = "Pìos an làir (thoir air falbh)",
        @"Hotspot" = "Àite àirid",
        @"Background" = "Cùlaibh",
        @"Liquid" = "Uisge",
        @"Trap" = "Ribe",
        @"Weather" = "Sìde",
        @"Special Object" = "Oibseact sònraichte",
        @"Prefab Object" = "Gnàth-oibseact",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Fa sgaoil: %3d/%d A-muigh: %3d Sàbhailte: %3d/%d",
        @"Angel" = "Aingeal",
        @"Basher" = "Slacair",
        @"Blocker" = "Bacadair",
        @"Boarder" = "Bòrdaiche",
        @"Bomber" = "Bomadair",
        @"Bridger" = "Drochaidiche",
        @"Climber" = "Sreapadair",
        @"Digger" = "Cladhaichear",
        @"Drown" = "Bàthadh",
        @"Exiter" = "Fàgaiche",
        @"Faller" = "A' tuiteam",
        @"Floater" = "Fleòdragan",
        @"Jumper" = "Leumadair",
        @"Laserkill" = "Murtair-Leusair",
        @"Miner" = "Mèinnear",
        @"Slider" = "Sleamhnaiche",
        @"Smashed" = "Air smùideadh",
        @"Splashed" = "Air stealladh",
        @"Superman" = "Superman",
        @"Teleported" = "Air tele-phortadh",
        @"Waiter" = "A' feitheamh",
        @"Walker" = "Coisiche",
        @"skip" = "seachnaich",
        @"Play" = "Cluich",
        @"Back" = "Air ais",
        @"Number of Pingus: " = "Àireamh nan ceann-fionn: ",
        @"Number to Save: " = "Cinn-fhionn rin sàbhaladh: ",
        @"Time: " = "ùine: ",
        @"Author: " = "Ùghdar: ",
        @"Close" = "Dùin",
        @"Fullscreen" = "Làn-sgrìn",
        @"Mouse Grab" = "Greim luchaig",
        @"Software Cursor" = "Cùrsair bathar-buig",
        @"Autoscrolling" = "Fèin-sgroladh",
        @"Drag&Drop Scrolling" = "Sgroladh slaod is leig às",
        @"Print FPS" = "Seall FPS",
        @"Resolution:" = "Breacadh-sgrìn:",
        @"Renderer:" = "Reandaraiche:",
        @"Language:" = "Cànan:",
        @"Master Volume:" = "Prìomh fhuaim:",
        @"Sound Volume:" = "Fuaim fhogharan:",
        @"Music Volume:" = "Fuaim ciùil:",
        @"Option Menu" = "Clàr-taice nan roghainnean",
        @"Some options require a restart of the game to take effect." = "Gus a h-uile roghainnean a chur an comas, ath-thòisich an geama",
        @"Story" = "Sgeulachd",
        @"..:: Start the game ::.." = "..:: Tòisich an geama ::..",
        @"Editor" = "Deasaiche",
        @"..:: Create your own levels ::.." = "..:: Cruthaich an leibheil agad fhèin ::..",
        @"Options" = "Roghainnean",
        @"..:: Configure the game ::.." = "..:: Rèitich an geama ::..",
        @"Levelsets" = "Leibheilean",
        @"..:: Play User Built levels ::.." = "..:: Cluich leibheilean aig cluicheadairean ::..",
        @"..:: Bye, bye ::.." = "..:: Mar sin leat ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: Greim luchaig   ::   F10: cunntair fps   ::   F11: làn-sgrìn   ::   F12: glacadh-sgrìn ::..",
        @"Give up" = "Gèill",
        @"Retry" = "Feuch a-rithist",
        @"Success!" = "Buaidh!",
        @"Failure!" = "Dh'fhàillig thu!",
        @"Perfect! You saved everyone possible - great!" = "Foirfe! Shàbhail thu a h-uile gin dhiubh!",
        @"No-one got killed, pretty good work." = "Cha deach gin a mharbhadh, glè mhath.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Cha do shàbhail thu ach na bha a dhìth. Rinn thu a' chùis air,\nach 's mathaid gum feuch thu ri dèanamh nas fhearr?",
        @"Not everybody was saved, but still good work!" = "Cha deach leat a h-uile gin dhiubh a shàbhaladh, ach rinn thu gu math co-dhiù!",
        @"What can I say, you made it - congratulations!" = "Dè as urrainn dhomh ràdh, rinn thu a' chùis air. Meal do naidheachd!!",
        @"You killed everybody, not good." = "Obh obh, mharbh thu a h-uile gin diubh.",
        @"No-one got saved - I know you can do better." = "Cha deach gin a shàbhaladh - 's urrainn dhut dèanamh nas fhearr gun teagamh.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Cha do shàbhail thu gu leòr, ach co-dhiù cuid dhiubh.\nNì thu nas fhearr an ath thuras le cinnt.",
        @"Only one more and you would have made it - try again!" = "Cha robh ach aon a dhìth ort - feuch ris a-rithist!",
        @"Only a handful more and you would have made it - try again!" = "Cha robh ach cuid a dhìth airson buannachd - feuch ris a-rithist!",
        @"Better luck next time!" = "Gun tèid nas fheàrr leat an ath thuras!",
        @"Saved: " = "Sàbhailte: ",
        @"Died: " = "Marbh: ",
        @"Time left: " = "Ùine air fhàgail: ",
        @"Under Construction" = "Ga thogail",
        @"Untested, unpolished and broken levels" = "Gun deuchainn, gun ghleus is leibheilean briste",
        @"Solved:" = "Air fhuasgladh:",
        @"levels" = "leibheilean",
        @"???" = "???",
        @"Show Ending?" = "Seall crìoch?",
        @"Leave?" = "Fàg",
        @"[OPTIONS]... [FILE]" = "[ROGHAINNEAN] ... [FAIDHLE]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "'S e geama tòimhseachain a tha ann am Pingus far an stiùirich thu buidheann dhe chinn-fhionn mun cuairt a' chruinne-cè.",
        @"General Options:" = "Roghainnean coitcheann:",
        @"Displays this help" = "Seall a' chobhair seo",
        @"Print version number and exit" = "Clò-bhuail àireamh an tionndaidh is fàg an-seo",
        @"Enable info level log output" = "Cuir info level log output an comas",
        @"Enable debug level log output" = "Cuir debug level log output an comas",
        @"Disable all log output" = "Cuir a h-uile log output à comas",
        @"Display Options:" = "Roghainnean an t-seallaidh:",
        @"Start in Window Mode" = "Tòisich Pingus ann an uinneag",
        @"Start in Fullscreen" = "Tòisich Pingus làn-sgrìn",
        @"Use the given renderer (default: sdl)" = "Cleachd an reandaraiche taghta (bunaiteach: sdl)",
        @"Set the window resolution for pingus (default: 800x600)" = "Suidhich dùmhlachd-bhreacaidh na h-uinneige airson Pingus (Bun-taghadh: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Suidhich dùmhlachd-bhreacaidh la làn-sgrìn airson Pingus (Bun-taghadh: 800x600)",
        @"Enable software cursor" = "Cuir cùrsair bathar-buig air",
        @"Game Options:" = "Roghainnean geama:",
        @"Disable automatic scrolling" = "Cuir fèin-sgroladh à comas",
        @"Enable drag'n drop scrolling" = "Cuir sgroladh slaod is leig às an comas",
        @"Sound Options:" = "Roghainnean fuaime:",
        @"Disable sound" = "Cuir fuaim à comas",
        @"Disable music" = "Cuir ceòl à comas",
        @"Select language to use with Pingus" = "Tagh an cànan a chleachdas tu le Pingus",
        @"List all available languages" = "Dèan liosta dhen a h-uile cànan a tha rim faighinn",
        @"Loads the level editor" = "A' luchdadh deasaiche nan leibheil",
        @"Directory Options:" = "Roghainnean a' phasgain:",
        @"DIR" = "PASGAN",
        @"Load game datafiles from DIR" = "Luchdaich faidhlichean dàta a' gheama o DIR",
        @"Load config files and store savegames in DIR" = "Luchdaich faidhlichean rèiteachaidh is sàbhail savegames ann an DIR",
        @"Load game modifications from DIR" = "Luchdaich modifications a' gheama o DIR",
        @"Don't read ~/.pingus/config" = "Na leugh ~/.pingus/config",
        @"FILE" = "FAIDHLE",
        @"Read config options from FILE" = "Leugh roghainnean rèiteachaidh o FAIDHLE",
        @"Uses the controller given in FILE" = "Cleachdaich an t-uidheam-smachd ann an FAIDHLE",
        @"Debug Options:" = "Roghainnean dì-bhugachaidh:",
        @"Enables some special features for developers" = "Cuiridh seo feartan sònraichte dha leasaichearan an comas",
        @"Set the game speed (0=fastest, >0=slower)" = "Suidhich astar a' gheama (0=as luaithe, >0=nas slaodaiche)",
        @"Set the desired game framerate (frames per second)" = "Suidhich astar frèama a' gheama (frèama san diog)",
        @"Set the size of the map tiles (default: 32)" = "Suidhich meud nan leacagan (Bun-taghadh: 32)",
        @"Pingus: Out of memory!" = "Pingus: Gun chuimhne air fhàgail",
        @"Pingus: Standard exception caught!:\n" = "Pingus: exception coitcheann air a ghlacadh!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: throw neo-aithnichte air a ghlacadh!",
        @"unlimited" = "gun chrìch",
        @"Screenshot: Saving screenshot to: " = "Glacadh-sgrìn: sàbhail dealbh an sgrìn mar: ",
        @"Screenshot: Screenshot is done." = "Glacadh-sgrìn: chaidh dealbh an sgrìn a shàbhaladh.",
        @"Screenshot: Couldn't write file: " = "Glacadh-sgrìn: cha deach am faidhle a shàbhaladh: ",
        @"If the way is blocked, bash away" = "Ma tha an t-slighe bacte, thoir slac air",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "Coltach ris a' Chladhaichear a chunnaic thu roimhe, tha gnìomh cladhaich eile ann. Co-dhiù, cha chladhaich thu gu h-inghearach ach seach gu còmhnard leis. 'S e Slacair a tha air a' ghnìomh ùr seo. ",
        @"Sacrifice a few and save the rest" = "Ìobair cuid is sàbhail an còrr",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Aig amannan, chan eil fuasgladh agad ach toll a dhèanamh san làr le boma. 'S urrainn dha cheann-fionn seo a dhèanamh ma thèid e na Bhomadair. Gheibh e bàs gu mì-fhortanach, ach sàbhailidh an ìobairt seo càch. ",
        @"Learning to dig" = "Ionnsaich cladhach",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Seo a' chiad mhisean agad. Mar as àbhaist, tha e furasta gu leòr. Cha leig thu leas ach òrdugh a thoirt dha cheann-fhionn ach an cladhaich e toll san làr gus an ruig a h-uile ceann-fionn an doras a-mach. Gus seo a dhèanamh, dèan briogadh air ceann-fionn. ",
        @"Float or Die" = "Bidh nad fhleòdragan no faigh bàs",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "Nach math a rinn thu sa chiad mhisean! Nise, tòisicheamaid leis an ath fhear. An turas seo, feumaidh tu fleòdragain a dhèanamh dhe na cinn-fhionn is uidheam itealaich beag a chur uapa ach an tuit iad gu slaodach. Ma thuiteas ceann-fionn ro ìosal, gheibh e bàs. Cùm do shùilean a-mach! ",
        @"Jump for joy" = "Leum le toileachas",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "Air amannan, feumaidh ceann-fionn àrd-ùrlar a ruigsinn a tha fad air falbh is cha ghabh e ruigsinn le coiseachd. Bidh an Leumadair feumail san t-suidheachadh seo - 's urrainn dhan cheann-fhionn leum beag a ghabhail is an àrd-ùrlar ruigsinn. ",
        @"Miner's heaven" = "Nèamh a' mhèinneir",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "Tha gnìomh eile a' togail ceann, is 's e gnìomh cladhaich a tha ann a-rithist, gu trastanach an turas seo. Leigidh e le ceann-fionn cladhach tron làr gu trastanach is slighe dhan fheadhainn às a dhèidh a chruthachadh. 'S e Mèinnear a tha air a' ghnìomh seo. ",
        @"Panic Island (float/bash)" = "Eilean na maoime (nad fhleòdragan/slac)",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Cha deach gluasadan luatha iarraidh ort sna leibheilean roimhe, ach fàsaidh e beagan nas dorra a-nis. Thig na cinn-fhionn a-mach à dà inntrigidh aig an aon àm is feumaidh tu an dà bhuidheann a cho-òrdanachadh gu cùramach. ",
        @"Jump'n Bump... and Bash..." = "Leum... is slac...",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "Tha na cinn-fhionn fo uallach a-rithist. Cha tig iad a-mach uabhasach luath, ach air sgàth 's gun till iad air cois-cheum nuair a bhuaileas iad ri balla, chan fhada gus am bi duilgheadasan agad an co-òrdanachadh. Bu chòir dhut a' chùis a dhèanamh air on nach eil agad ri sàbhaladh ach 5, ach mur eil fuasgladh eile ann, cleachd am modh stadaidh (»p«) ach am faigh thu foir-shealladh a-rithist. ",
        @"Two groups in parallel, coordinate wisely" = "Dà bhuidheann, co-òrdanaich gu glic",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Tha dà bhuidheann agad rin co-òrdanachadh a-nis. Air do shocair co-dhiù, bidh dàil smaoineachaidh gu leòr agad san leibheil seo. Chan fhaigh thu comhairle a bharrachd an turas seo, ach guma math a thèid leat! ",
        @"Block'a Rock" = "Bac is bomaich",
        @"Once again it's time to combine the things you have learned in your previous levels. Blast your way free and make sure you also keep the rest of the Pingus under control. The Blocker action will be helpful." = "Thàinig an t-àm a-rithist gus na dh'ionnsaich thu roimhe a chur ri chèile. Spreadhaich bomaichean gus am bi slighe shaor agad is dèan cinnteach gun cùm thu smachd air na cinn-fhionn eile. Bidh am Bacadair cuideachail.",
        @"Climb, Climber,... Boom!" = "Sreap, sreapadair... bùm!",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Mar a mhothaicheadh tu sna leibheilean roimhe, feumaidh tu gnìomhan eadar-dhealaichte a chur ri chèile gu tric ach an ruig thu an ceann-uidhe. On a tha Cladhaichear a dhìth ort, feumaidh tu Bomadair a chleachdadh, ach ciamar a ruigeas e an àite far a bheil e a dhìth? ",
        @"Bridging gets more complicated..." = "Fàsaidh togail dhrochaidean nas duilghe...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "Feumaidh tu na gnìomhan a chur ri chèile gu cùramach glic a-rithist, air neo thèid do ghlacadh san toll faisg air an doras a-mach. Smaoinich air ciamar a sheachnas tu seo. ",
        @"If too high, your Pingu will die..." = "Ro àrd is gheibh an ceann-fionn bàs...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "Feumaidh na cinn-fhionn obair mar sgioba an turas seo. Chan eil Fleòdragain gu leòr agad gus an doras a-mach a ruigsinn, mar sin cuir cuid dhiubh a-null gus an rathad ullachadh dha chàch. ",
        @"Learn to use the bridge" = "Ionnsaich togail dhrochaidean",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "Ma tha agad ri faighinn thairis air toll mhòr is Leumadair a dhìth ort, faodaidh Drochaid a bhith air leth feumail. Bheir e ùine tè a thogail, ach eu-coltach ris an Leumadair faodaidh an còrr dhe na cinn-fhionn a cleachdadh gus an taobh thall a ruigsinn. ",
        @"Three solutions, it's up to you" = "Trì fuasglaidhean, tha e suas riut fhèin",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "On a tha thu air a h-uile gnìomh ionnsachadh, 's e an cleachdadh a nì bòidheach! Tha air a char as lugha trì dòighean ann gus an leibheil seo fhuasgladh. Tha e suas riut fhèin dè an t-slighe a thaghas tu. ",
        @"Climb, Climber, climb... and build a bridge" = "A shreapadair, sreap... is tog drochaid",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "Seo gnìomh ùr eile dhut. Ma tha e na Shreapadair, 's urrainn do cheann-fionn ballaichean inghearach a shreap is faighinn dha dh'àiteachan àrda nach gabhadh ruigsinn air dòighean eile. ",
        @"Entrance high, Exit low" = "Inntrigeadh àrd, doras a-mach ìosal",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Mur eil Fleòdragain gu leòr agad ach am faigh a h-uile ceann-fionn sìos dhan doras a-mach, feumaidh tu dòighean eile a lorg gus an stiùireadh. Cha bhi a dhìth ort san leibheil seo ach na dh'ionnsaich thu sna leibheilean roimhe. Cha bu chòir dha a bhith na thrioblaid mhòr dhut. ",
        @"One must prepare, the rest must follow" = "Ullaichidh aonar is leanaidh an còrr",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "Aig amannan, cha bhi Bacadair faisg air làimh gus na cinn-fhionn a cho-òrdanachadh. Mar sin, feumaidh tu dòighean eile a lorg gus smachd a chumail orra fhad 's an ullaich aonan an t-slighe dha chàch. ",
        @"Dig and float, just don't fall and smash" = "Cladhach is fleòdragan, na tuit is bàsaich",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "Eu-coltach ris a' chiad dà leibheil, tha dà ghnìomh agad san leibheil seo. A-rithist, tha na dh'fheumas tu dèanamh simplidh: tagh gnìomh san leòsan chlì is dèan briogadh air na cinn-fhionn ach an ruig iad an doras a-mach. Dèan cinnteach nach fhaigh cus dhiubh bàs. ",
        @"Dig, bash and other problems" = "Cladhach, slacadh is trioblaidean eile",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Mar as adhartaiche a thèid thu, 's ann nas duilghe a thionndaidheas e. Co-dhiù, air do shocair, tha an leibheil seo reusanta furasta fhathast. Bu chòir dhut a bhith ceart gu leòr fhad 's a chleachdas tu na dh'ionnsaich thu gu ruige seo. Ma tha thu den bheachd nach gabh an leibheil fhuasgladh tuilleadh, dèan briogadh dùbailte air putan Armagedon san oisean deas gu h-ìosal. ",
        @"Solid ground can block the path" = "Faodaidh làr cruaidh a bhith san rathad",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "Mar a dh'ionnsaich thu sna leibheilean roimhe, 's urrainn dha cheann-fionn cladhach tro cha mhòr a h-uile rud. Co-dhiù, tha aon stuth ann nach fhaigh e troimhe: stàilinn. Tha dath dubh-ghlas air na raointean seo air mapa an leibheil is cha ghabh an sgrios. Mar sin, lorg slighe timcheall orra. ",
        @"One jump to catch them all" = "Chan e ach leum gus a h-uile a shàbhaladh",
        @"The pingus have found themselves lost on their journey.  What is this mysterious place?  Smiling pumpkins, giant candlesticks, and some boiling soup below... what wizardry is this? Now, facing a deadly abyss right in front of them it's your job to save them. Can you save them from a terrible fate?" = "Mhothaich na cinn-fhionn gun do chaill iad an t-slighe. Dè an t-àite neònach a tha seo? Peapagan le fiamh-ghàire orra, coinnlean ana-mhòr, is brot a' bruich fodhpa... dè an draoidheachd a tha seo? Nise gu bheil aibheis bhàsmhor romhpa, 's ann leatsa a tha an t-uallach airson an sàbhaladh. An urrainn dhut an sàbhaladh o dhàn uabhasach?",
        @"One Thousand and One Jumps" = "Leum is mìle",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "On a tha an doras a-mach cho àrd is cho fad air falbh 's nach ruig ceann-fionn àbhaisteach e, dè a ghabhas dèanamh? 'S dòcha gun sàbhail leumadair iad? Air neo nach dèan e ach dàil a chuir air a' bhàs do-sheachanta? Tha an t-uallach airson seo fhaighinn a-mach leatsa, ach a bheil thu math gu leòr gus an sàbhaladh uile?",
        @"Boom Boom" = "Bùm bùm",
        @"You've mastered the last challenge and now face the next. Their path to salvation seems to be cursed, but by whom? There is no time to think about it, since the next deadly challenge already awaits the Pingus. Two mighty roots block the way, but without a basher at hand to bash them away, sacrifice might be the only option..." = "Rinn thu a' chùis air an dùbhlan mu dheireadh is tha an t-ath fhear romhad a-nis. A rèir coltais, tha an t-slighe dhan t-sàbhaladh fo mhallachd, ach cò leis? Chan eil ùine agad gus smaoineachadh air, oir tha an t-ath dhùbhlan bàsmhor ro na cinn-fhionn mu thràth. Tha dà fhreumh neartmhor san rathad is chan eil slacair agad gus an toirt air falbh. Dh'fhaodadh ìobairt a bhith san fhuasgladh mu dheireadh...",
        @"Full Circle" = "Cearcall slàn",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "Tha an doras a-mach cho faisg, ach cha ghabh e ruigsinn. Ma ghabhas tu ceum san rathad cheàrr, fulaingidh na cinn-fhionn dàn uabhasach. Feumaidh tu rudeigin a dhèanamh gus an cuideachadh, ach a bheil ùine gu leòr agad? Greas ort is na dèan mearachd. Tha na cinn-fhionn a' crochadh ort!",
        @"Bridgers Nightmare" = "Trom-laighe an drochaidiche",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "Cò thog balla fuamhaireil an-seo? Cumaidh an cnap-starra uabhasach seo na cinn-fhionn agad air falbh on doras a-mach. Cha chreideadh tu gun gabhadh an togalach grànnda seo a sgrios, ach is dòcha gun toir na drochaidichean faochadh dhuinn? An urrainn dhaibh na drochaidean a thogail àrd gu leòr ach am faigh am buidheann dhan doras a-mach gu sàbhailte? No an e mealladh an deamhain a tha seo?\n\nA-rithist, tha am fuasgladh a' crochadh ortsa... Is d' eanchainn iuchair an t-soirbheachais dha na cinn-fhionn, mar sin dèan cinnteach nach eil bruadair nad cheann 's nach caill thu an t-slighe cheart.",
        @"Locked up by the witch" = "Air an glasadh leis a' bhana-bhuidseach",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "An e toll dubh a tha seo? Tha ballachan cruaidh mun cuairt oirnn is chan eil slighe a-mach ri faicinn. Cha shaoileadh tu gum biodh sàbhaladh ann. Ach fuirich ort... tha coltas rudeigin lag aig balla an taoibh dheis... an e fuasgladh a tha ann? Air neo mealladh a bheir bàs air na cinn-fhionn?\n\n'S e rathad cunnartach a tha seo, ach feumaidh tu a ghabhail gus faighinn a-mach ciamar bheir thu iad uile dhan t-saorsa turas eile.",
        @"Splatterfest" = "Fèis steallaidh",
        @"This is by far the deepest pit the Pingus have yet encountered. Building a bridge across it seems obvious but that won't help since the exit is deep down in the pit itself. Pingus who try to go down the pit will just end up splattered all over the ground. You have two groups of Pingus at your disposal, can you make them work together to reach even an exit this well hidden?" = "Seo an sloc as doimhne a chunnaic na cinn-fhionn roimhe riamh. Bhiodh e follaiseach drochaid a thogail dhan taobh thall, ach chan obraich seo on a tha an doras a-mach ro ìosal san t-sloc. Cha tèid cinn-fhionn a dh'fheuchas ri leum sìos ach stealladh air a bhonn. Co-dhiù, tha dà bhuidheann dhe chinn-fhionn agad. An urrainn dhut toirt orra obair còmhla ach an ruig iad doras a-mach a tha cho falaichte?",
        @"Staircase Maintenance" = "Càradh staidhrichean",
        @"It seems we are up again against a mighty wall, and it is blocking the exit! But wait, some good soul has built a staircase around it. It seems, however, that the poor fool's efforts didn't last long, as the staircase is destroyed and full of holes. Can you fix it and make it over the wall? Yet of course you know that the right solution might not be the obvious one. But your Pingus are almost free, and they trust in your skill to guide them to safety once more. Succeed and you will have freed them once and for all from whatever evildoer that placed them in this nightmare... at least for this year." = "A rèir coltais, tha sinn air beulaibh balla treun a-rithist, is bacaidh e an doras a-mach! Ach fuirich ort, thog cuideigin coibhneil staidhre. Cha do mhair a shàr-obair fada ge-tà, oir chaidh an staidhre a sgrios is i làn tuill. An urrainn dhut a càradh is faighinn thar a' bhalla? Gu nàdarra, tha fios agad nach eil am fuasgladh as fhasa an-còmhnaidh am fear ceart. Ach tha na cinn-fhionn agad cha mhòr saor is tha earbsa aca sna comasan agad gus an sàbhaladh turas eile. Ma shoirbhicheas leat, bidh iad sàbhailte on eucorach a thug an trom-laighe seo orra gu sìorraidh bràth... uill, fad bliadhna co-dhiù.",
        @"Down Into The Cave" = "Sìos dhan uaigh",
        @"The exit is far below and the pingus are separated from it by quite a distance. The path down is riddled with gulfs, so jumping and bridging will be the primary tool to get down there. But be careful, the last few steps require some extra cleverness." = "Tha an doras a-mach fada shìos is astar math eadar e is na cinn-fhionn. Tha slocan a' cnàmhadh an t-slighe, is mar sin 's e leum is drochaidean am prìomh ghnìomh agad gus faighinn shìos. Ach thoir an aire, feumaidh tu a bhith glic dha-rìribh leis na ceuman mu dheireadh.",
        @"Round and Round" = "Mun cuairt is mun cuairt",
        @"Trapped in an eternal loop one brave pingu has to break out and go on a journey in search for the exit, but he mustn't be too happy once he found it, as there is still one last challenge he must solve before being allowed to enter it, otherwise all his friends might perish." = "Glacte ann an lùb a-muigh, feumaidh ceann-fionn calma briseadh a-mach is siubhal air tòir an dorais a-mach. Chan fhaod e a bhith ro thoilichte nuair a lorgas e e on a tha aon dùbhlan eile aige ri fhuasgladh mus fhaod e dol troimhe, air neo gheibheadh a h-uile caraidean aige bàs.",
        @"Red Herring Cave" = "An uamh mheallta",
        @"The exit is right above the pingus heads, with a few friendly arrows pointing the way. With jumpers around the solution should be obvious. But wait, can anything you find in a dark cave be trusted or is there some more going on which might slip your view? Thinking outside the box might be required." = "Tha an doras a-mach dìreach os cionn nan cinn-fhionn, le saighead càirdeil no dhà a' comharrachadh na slighe. Tha e follaiseach gum faigh thu air leis na leumadairean a th' agad. Ach fuirich ort, am bu chòir dhut earbsa a chur ann an rud sam bith ann an uamh dorcha, no a bheil rudeigin neo-aithnichte falaichte o do shùil? Feumaidh tu am puicean-eich a thoirt dheth, 's dòcha.",
        @"Group Coordination" = "Co-òrdanachadh buidhne",
        @"Three groups are on their way to the exit, one of them trapped right above it, but locked into a box. None of them can make it alone, coordinate them wisely and everybody should be able to make it safely to the exit. " = "Tha trì buidhnean air an t-slighe ach aonan dhiubh glacte ann am bogsa dìreach os cionn an dorais a-mach. Cha tèid le buidheann sam bith às aonais càch, co-òrdanaich iad gu glic is bu chòir dhan a h-uile gin dhiubh faighinn a-mach gu sàbhailte. ",
        @"Traps, Dangers and other Problems" = "Ribean, cunnartan is trioblaidean eile",
        @"The path to the exit lays below, shimmering through the planks. But the fall is too high, deadly for sure. Can one pingu alone make it's way through the dangerous traps and secure the path to the exit?" = "Tha an t-slighe dhan doras a-mach fodhad is a' deàrrsadh tro na dèilean. Ach bhiodh an tuiteam ro àrd is bàsmhor gun teagamh. An urrainn dha cheann-fionn slighe a lorg tro na ribean chunnartach is an t-slighe a-mach a dhèanamh tèarainte?",
        @"Reach that Switch" = "Faigh air an t-suidse",
        @"The path to the exit is straight, flat and simple, but wait a solid door blocking the way? How can the pingus open it? Is that a switch there on the hill to the right? Might that be the solution to opening the door and freeing the pingus? But how can they reach that switch?" = "Tha an t-slighe dhan doras a-mach dìreach, rèidh is simplidh, ach fuirich ort, dè mu dheidhinn an dorais chruaidh air an rathad? Ciamar a thèid leis na cinn-fhionn fhosgladh? An e suidse a tha seo air a' chnocan taobh deas? Saoil an e am fuasgladh a th' ann gus an doras fhosgladh is na cinn-fhionn a shaorachadh? Ach ciamar a gheibh iad air an t-suidse?",
        @"The Collapsed Column" = "An colbh na sprùilleach",
        @"High up above the green slime the pingus are moving from column to column, getting closer to the exit with each step, but wait, there is a second group of pingus, they are stuck. The column next to them has collapsed making getting to the exit impossible. Can you find a way around the abyss?" = "Gu h-àrd os cionn an t-snàimh uaine, tha na cinn-fhionn a' gluasad o cholbh gu colbh, a' faighinn nas dlùithe air an doras a-mach leis gach ceum. Ach fuirich ort, tha buidheann eile dhe chinn-fhionn ann is iadsan glacte. Thuit an colbh rin taobh na sprùilleach, a' bacadh an t-slighe dhan doras a-mach. An lorg thu slighe timcheall air an aibheis?",
        @"Island of Doom" = "Eilean an damnachaidh",
        @"The pingus are released close together, but split up by a solid metal column with seemingly no way to join them back up. The journey will be dangerous and some height has be crossed with the exit hidden below. With some cleverness it should be possible to join those two groups back together." = "Tha na cinn-fhionn gan sgaoileadh faisg air a chèile, ach le colbh meatailt eadarra is a rèir coltais gun dòigh an aonachadh. Bidh an triall cunnartach is feumaidh iad dol tarsaing àirde leis an doras a-mach falaichte air bhonn. Le beagan gliocais, thèid leat an dà bhuidheann aonachadh ri chèile.",
        @"Tower of Death" = "Tùr a' bhàis",
        @"The pingus are at the top of the tower, with no stairway around. The exit is deep down, hidden at the foot of the tower. How shall they make it down all that height with no floaters sight? A few well placed diggers should be enough to get the job done, but wait, no, their direction isn't quite right. You have to give them directions or it will be their doom." = "Tha na cinn-fhionn air mullach tùir aig nach eil staidhre. Tha an doras a-mach falaichte gu domhain aig bonn an tùir. Ciamar a gheibh iad sìos às aonais fleòdragain? 'S dòcha gun dèan cladhaiche no dhà air an àite cheart a' chùis, ach fuirich ort, chan eil an comhair aca buileach ceart. Feumaidh tu an stiùireadh no gheibh iad bàs.",
        @"The Ones" = "Na colbhan",
        @"This is the last stage the pingus have to pass during this Halloween. Two oddly familiar column are in the way. What do they mean? The two groups of pingus have to work together to make it down the columns to the exit far below." = "Seo an ceum mu dheireadh a dh'fheumas na cinn-fhionn a ghabhail air an Oidhche Shamhna seo. Tha dà cholbh àraidh air an rathad is tu a' faireachdainn gun aithnicheadh tu iad. Dè as ciall dhaibh? Feumaidh an dà bhuidheann dhe chinn-fhionn obair còmhla gus faighinn sìos nan colbh is an doras a-mach fada shìos a ruigsinn.",
        @"Down the valley and up again" = "Sìos dhan ghleann is suas a-rithist",
        @"There is a large valley between the entrance and the exit. No bridge will be long enough to cross the valley, but can you find a way back up once you lead the Pingus down into the valley?" = "Tha gleann mhòr eadar an inntrigeadh is an doras a-mach. Chan eil drochaid fon ghrèin a bhiodh fada gu leòr gus faighinn thar na glinne, ach 's mathaid gum faigh thu lorg air slighe suas an dèidh nan ceann-fionn a stiùireadh sìos dhan ghleann.",
        @"Entering the pyramid" = "A-steach dhan phioramaid",
        @"After their long and dangerous journey through the desert the Pingus finally reach the large pyramid, but there is still a pedestal blocking their way." = "An dèidh triall fada is cunnartach tron fhàsach, ràinig na cinn-fhionn am pioramaid mòr mu dheireadh thall...",
        @"The window room" = "Seòmar nan uinneagan",
        @"After the Pingus have entered the pyramid, they reach a large room with a large window. The only problem they have is that the entrance to the room is much too high to survive the landing. Can you help them?" = "Chaidh na cinn-fhionn a-steach dhan phioramaid is ràinig iad seòmar mòr le uinneag mhòr. Chan eil ach aon duilgheadas aca; 's e gu bheil inntrigidh dhan t-seòmar fada ro àrd gus leum is mairsinn beò. An toir thu cuideachadh dhaibh?",
        @"Grand Hall" = "An talla mhòr",
        @"The pingus have found themselves in the grand hall, a hall full of wonder and treasures. The exit however is high up and won't be easy to reach. Guide the pingus around the hall and maybe you will find a way." = "Ràinig na cinn-fhionn am prìomh thalla a tha làn ionghnaidh is saoibhreis. Ach tha an doras a-mach glè àrd is doirbh a ruigsinn. Stiùirich na cinn-fhionn timcheall an talla ach an lorg thu slighe.",
        @"Pass the pedestal" = "Thairis air an t-sorch",
        @"A large pedestal is blocking the way to the exit and there aren't enough bashers available to dig it away. Can you find a way to make it past the pedestal?" = "Tha sorch mòr a' bacadh an rathad dhan doras a-mach is chan eil slacairean gu leòr agad gus cuidhteas fhaighinn dheth. Am faigh thu lorg air slighe timcheall air?",
        @"The excavation of the pyramid" = "An cladhach aig a' phioramaid",
        @"The excavations are open to reach the pyramid for his redeeming content. Some excavations, however, is best done with two competitors. Who comes first?" = "Tha an cladhach àrc-eòlais fosgailte gus an t-saibhreas luachmhor aig a' phioramaid a ruigsinn. Co-dhiù, aig amannan tha e nas fheàrr ma thèid dithis a' feuchainn ri chèile. Cò thig an toiseach?",
        @"Catch them at the half way point" = "Beir orra letheach slighe",
        @"The Pingus are separated from the exit by large abyss. A simple bridge won't be enough to catch them safely, unless of course you find the right place to put it. Can you uncover that spot?" = "Chaidh na cinn-fhionn a sgaradh on doras a-mach le aibheis mhòr. Cha dèan drochaid simplidh a' chùis gus beir orra gu sàbhailte. Uill, mura tog thu air an àite cheart i co-dhiù. Am faigh thu lorg air an àite seo?",
        @"Claustrophobia" = "Fuath-dùinteachd",
        @"Hidden deep below the pyramid the pingus come across a small underground room, but unfortunatley a large tree root blocks their path..." = "Gu domhain fon phioramaid, thachair na cinn-fhionn ri seòmar beag falaichte on talamh, ach gu mì-fhortanach tha freumh mòr craoibhe a' bacadh an t-slighe...",
        @"A bit to the right a bit to left" = "Beagan gu deas, beagan gu clì",
        @"Only the most audacious Pingus will be allowed to continue." = "Cha mhair ach na cinn-fhionn as calma.",
        @"25 Pingus free and 25 in the box" = "25 cinn-fhionn fa sgaoil is 25 sa bhogsa",
        @"Okay for the Bridger but what can I do with Digger? You should save at least one Pingu trapped in the box above the exit." = "Tha seo ceart gu leòr dhan drochaidiche, ach dè nì mi leis a' chladhaiche? Bu chòir dhut co-dhiù aon dhe na cinn-fhionn glacte sa bhogsa os cionn an dorais a-mach a shàbhaladh.",
        @"Tunnel Time" = "Àm an tunail",
        @"Dig a tunnel and you might make it to the exit. Digger and miners and stuff have to work together." = "Cladhaich tunail feuch an ruig thu an doras a-mach. Feumaidh na cladhaichean is na mèinnearan is an stuth obair còmhla.",
        @"Crawlspace" = "Air do chràgan is air do ghlùinean",
        @"The path to the exit is blocked and many small tunnels lead the way, but be careful some of those lead to certain death. Or is there something you can do about that and create a save passage for all the Pingus and lead them safely to the exit?" = "Tha an t-slighe dhan doras a-mach bacte is tha iomadh tunail beag nan rathaidean dhut, ach thoir an aire gun toir cuid dhiubh dhan bhàs thu. No a bheil rudeigin ann am b' urrainn dhut dèanamh an aghaidh sin is slighe sàbhailte a chruthachadh dha na cinn-fhionn ach am faigh iad a-mach?",
        @"The Roof" = "Am mullach",
        @"Sometimes the roofs are not good for refuge, sometimes it should be demolished! But be careful if you aren't precise enough, you might lead the Pingus straight to certain death." = "Aig amannan, chan e tèarmainn matha a tha sna mullaichean is feumaidh tu cuidhteas fhaighinn dhiubh! Ach thoir an aire gun obraich thu gu eagarra ach nach fhaigh na cinn-fhionn bàs.",
        @"Pingus Jones and the Last Exit" = "Pingus Jones and the Last Exit",
        @"Dr. Jones' notebook:\n\n  (1) the breath of God: only the penitent pingus will pass;\n  (2) the word of God... in reverse;\n  (3) the path of God: leap from the head of something like a cat." = "On leabhar-nòtaichean aig Dr. Jones:\n\n  (1) anail Dhè: chan fhaigh seachad ach na h-aithrich;\n  (2) facal Dhè... contrarra;\n  (3) slighe Dhè: leum o cheann aig rudeigin coltach ri cat.",
        @"Near can mean far" = "An e fad air falbh as ciall air faisg?",
        @"What do you do when you're going in the wrong direction ? Simple: walk into a wall. But it is easier said than done..." = "Dè nì thu ma tha thu a' dol air an rathad cheàrr? Furasta: Coisich ri balla. Ach, as fhasa ràdh na cur an gnìomh...",
        @"Trapped Underground" = "Glacte fon talamh",
        @"The penguins escaped the mad scientist, but now they were trapped deep underground. They had no food or water, so they had to move fast." = "Theich na cinn-fhionn on eòlaiche shaobh, ach tha iad glacte aig bonn na talmhainn a-nis. Chan eil biadh no uisge aca is feumaidh iad a bhith luath.",
        @"Experimentation" = "Deuchainnean",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Ghlac eòlaiche saobh na cinn-fhionn gus deuchainnean a dhèanamh orra. Ciamar a theicheas na cinn-fhionn on Ghuillotine?",
        @"Hall of Illusion" = "Talla nam mealladh",
        @"The penguins stopped and stood in indecision. What was real and what was not? Flame lanced from above and a guillotine glittered in the distance. Almost all penguins must survive." = "Stad na cinn-fhionn gus coimhead timcheall orra gu mì-chinnteach. Dè tha fìor is dè nach eil? Tha lasairean-teine a' sgal on mhullach is Guillotinichean a' deàrrsadh fad air falbh. Feumaidh cha mhòr a h-uile ceann-fionn mairsinn beò.",
        @"The Lava Pit" = "Sloc an làbha",
        @"The penguins had defeated the mad scientist, and were walking away from his destroyed laboratory when a huge hole opened under their feet. The penguins fell into an underground cave and the only way out was across the lava pit. Luckily, it seemed someone had left some helpful signs." = "Bha na cinn-fhionn air buaidh a thoirt air an eòlaiche shaobh is a' ruith a-mach às an deuchainn-lann aige nuair an do dh'fhosgail toll mòr fon casan. Thuit na cinn-fhionn dha uamh fon talamh is cha robh slighe a-mach ann ach thar sluic làbha. Gu fortanach, dh'fhàg cuideigin sanasan is coltas cuideachail orra.",
        @"At least the experiments are over..." = "Tha na deuchainnean seachad co-dhiù...",
        @"The good news was that the mad scientist had tired of his experiments, the bad news was that now he was dumping them down a pit. A single floatation device was all the penguins had. Save as many as possible." = "'S e an naidheachd math a bh' ann gun do dh'fhàs an t-eòlaiche saobh seachd searbh dhe na deuchainnean, ach air an làimh eile dè rinn e ach na cinn-fhionn a thilgeil sìos sloc. Cha robh ach aon fhleòdragan aig na cinn-fhionn. Sàbhail am meud as urrainn dhut.",
        @"Ghosting" = "Taibhsean",
        @"The penguins came to a long pass. Acid bubbled underneath and it seemed a climber or two were needed.  Hint: slider can be used to stop the miner ability." = "Ràinig na cinn-fhionn bealach fada. Bha searbhag a' plubadaich fodhpa is a rèir coltais bha sreapadair no dithis a dhìth orra. Gliocas: Cuiridh tu stad air a' mhèinnear le sleamhnaiche.",
        @"The Final (and suprisingly easy) Challenge" = "An dùbhlan mu dheireadh (furasta, an e?)",
        @"The penguins had reached the end of the island. In the water was a long tree, perfect for the penguin's needs. Their journey was almost over." = "Ràinig na cinn-fhionn taobh thall an eilein. Bha craobh fhada san uisge, foirfe airson feumalachdan nan ceann-fionn. Tha an triall aca cha mhòr seachad.",
        @"Revenge is sweet" = "Nach milis an dìoghaltas",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down." = "Theich na cinn-fhionn on eòlaiche shaobh, ach a-nis tha iad ri dìoghaltas. Chuir iad romhpa na structaran-taice a sgrios ach an tuit an deuchainn-lann olc.",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down. They had to move fast though, because the mad scientist would detect and recapture them if they weren't fast enough." = "Theich na cinn-fhionn on eòlaiche shaobh, ach a-nis tha iad ri dìoghaltas. Chuir iad romhpa na structaran-taice a sgrios ach an tuit an deuchainn-lann olc. Feumaidh iad gluasad gu luath co-dhiù oir aithnicheadh is ghlacadh an t-eòlaiche saobh iad a-rithist mura robh iad luath gu leòr.",
        @"Winter Wonderland" = "Saoghal mìorbhaileach a' gheamhraidh",
        @"After getting past the lava pit, the penguins walked and walked until they reached a snowed in exit. That would be relatively easy to tunnel through but how would it be possible to tunnel through solid metal?" = "An dèidh faighinn thairis air an t-sloc làbha, ruith is ruith na cinn-fhionn gus an do lorg iad doras a-mach làn sneachda. B' urrainn dhaibh tunail a dhèanamh troimhe gu furasta, ach ciamar a nì iad seo tro meatailt chruaidh?",
        @"The Journey Goes On" = "Leanaidh an triall",
        @"And so the penguins continued on their journey, drawing ever closer to the North Pole. They had escaped the guillotine, defeated the mad scientist and got a new boat. And so this chapter in their voyage was over, but there would be other obstacles. Nothing  would stop the determined penguins from reaching their goal." = "Mar sin, lean triall nan cinn-fhionn na b' fhaisge air A' Phòla a Tuath. Bha iad air teicheadh on Ghuillotine is làmh an uachdair fhaighinn air an eòlaiche shaobh is fhuair iad bàta ùr. Le seo, bha an caibideil seo dhen triall seachad, ach bhiodh cnapan-starra eile romhpa fhathast. Cha robh nì fon ghrèin a chuireadh casg air na cinn-fhionn is ruigeadh iad an ceann-uidhe aca.",
        @"Think fast (literally)" = "Smaoinich gu luath (gu litireil)",
        @"This would be simple but for one thing, there are no blockers. All the penguins must survive." = "Bhiodh seo furasta nan robh bacadairean ann. Feumaidh a h-uile ceann-fionn mairsinn beò.",
        @"Shipwrecked" = "Long-bhriseadh",
        @"The penguins were sailing along happily on their makeshift boat until suddenly an island appeared. The penguins were drawn towards it and crashed, destroying their boat. Now they must find their way across this strange island." = "Bha na cinn-fhionn a' seòladh gu toilichte air an fhath-bhàta aca gus an do nochd eilean gu h-obann. Chaidh na cinn-fhionn a tharraing dha is dh'fhulaing iad aoidion. Feumaidh iad slighe thar an eilein a lorg a-nis.",
        @"Escape from Aliens" = "Teicheadh o na h-os-talmhaichean",
        @"Aliens invade our starship blocking entrance to the teleporter. Your crew is well trained, like you they don't panic." = "Tha os-talmhaichean a' briseadh a-steach dhan t-soitheach-fhànais agad is a' bacadh inntrigeadh dhan tele-phortair. Tha do sgioba air a thrèanadh gu math mar a tha thusa is gun bhreisleach.",
        @"Escape from Aliens 2" = "Teicheadh o na h-os-talmhaichean 2",
        @"Aliens are now closest making your escape harder. You must dig it up." = "Tha na h-os-talmhaichean nas fhaisge a-nis is tha e nas dorra teicheadh. Feumaidh tu cladhach suas.",
        @"Alien's nest" = "Nead nan os-talmhaichean",
        @"Pingus invade the nest. Take care of jaws. What's the matrix above?" = "Tha na cinn-fhionn a' briseadh a-steach dhan nead. Thoir an aire air na peirceallan. Dè th' ann sa mheatraigs ud shuas?",
        @"Matrix of the death" = "Meatraigs a' bhàis",
        @"Take a piece of paper. Now pingus have to enter the matrix of the death. This is a maze, bad ways are protect by jaws." = "Gabh pìos pàipeir. Feumaidh na cinn-fhionn briseadh a-steach dha mheatraigs a' bhàis. 'S e cuartan a th' ann is thèid na droch shlighean an dìon le peirceallan.",
        @"Spy's pingus in the matrix of the death" = "Brathadairean ann am meatraigs a' bhàis",
        @"Spy's pingus have marked the location of jaws in the matrix of the death. Many died to gain that information :..( Perhaps this help. Perhaps..." = "Chomharraich brathadairean nan ceann-fionn na h-àiteachan le peirceallan ann am meatraigs a' bhàis. Dh'fhulaing grunn dhiubh am bàs gus am fiosrachadh seo a thoirt dhut :..( 'S dòcha gum bi seo na chobhair dhut. 'S dòcha...",
        @"Fourth dimension" = "An ceathramh dimeinsean",
        @"The defenses of the aliens get stronger. Now you have to jump in the fourth dimension to win!" = "Tha dìon nan os-talmhaichean a' fàs nas fheàrr. Feumaidh tu leum dhan chòigeamh dimeinsean a-nis gus buadhachadh!",
        @"Set your watches" = "Atharraichibh ur n-uaireadairean",
        @"Cooperation in space." = "Co-obrachadh san fhànas",
        @"Lost in Space" = "Caillte san fhànas",
        @"We don't know where we are but we don't leave anybody behind." = "Chan eil fios againn càite a bheil sinn, ach chan fhàg sinn duine.",
        @"Outside In" = "A-muigh a-staigh",
        @"Can you help the pingus escape without getting their flippers wet?" = "An urrainn dhut taic a thoirt dha na cinn-fhionn ach an teich iad gun fhliuchadh air an sgiathan?",
        @"Endless Loop" = "Lùb gun chrìch",
        @"To the right and to the left the Pingus will face certain death and you have to save 50. Can you help them get out of this mess?" = "Tha am bàs cinnteach a feitheamh air na cinn-fhionn gu deas is clì, ach feumaidh tu 50 dhiubh a shàbhaladh! An toir thu cuideachadh dhaibh ach am faigh tèarnadh on trioblaid seo?",
        @"Up up in the space" = "Suas, suas san fhànas",
        @"What good is a pick in space? Certainly not to go to the stars." = "Dè as math air pìoc san fhànais? Gu cinnteach, cha chleachd thu i gus siubhal dha na rionnagan.",
        @"Jump" = "Leum",
        @"All Pingus need is to jump.... Hint: While pausing (press P key) you still can control Pingus. " = "Cha leig na cinn-fhionn leas ach leum.... Gliocas: 's urrainn dhut fhathast na cinn-fhionn a' stiùireadh fhad 's a bhios an geama na stad (brùth air an iuchair P). ",
        @"Factory" = "Factaraidh",
        @"Finally you reached the factory. Watch out as there are many dangers. Use bombers to destroy the basement of the factory. Good luck!" = "Ràinig thu am factaraidh mu dheireadh thall. Thoir an aire gu bheil iomadh cunnart ann. Cleachd bomadairean gus an làr ìosal dhen fhactaraidh a sgrios. Guma math a thèid leat!",
        @"Going back home" = "Tilleadh dhachaigh",
        @"Your mission is over. Pingus can go back home, but be careful!" = "Tha am misean agad coileanta. Faodaidh na cinn-fhionn tilleadh dhachaigh, ach bi faiceallach!",
        @"Bonus track" = "Tè eile",
        @"Pingus are at home, but after the climate change living on the South Pole became more dangerous. There is one more mission for you." = "Thill na cinn-fhionn dhachaigh, ach air sàilleibh luaisgeachd na gnàth-shìde dh'fhàs a' bheatha air A' Phòla a Deas na bu chunnartaiche. Seo misean a bharrachd dhut ri choileanadh!",
        @"Falling down" = "Tuiteam sìos",
        @"Pingus intelligence reported that a huge factory located in the subtropical zone might be a reason of a climate change. They decided to go there and shut down the factories. This will be a long and dangerous expedition. Pingus and you will have to face many difficulties on your way. As the ice is melting, at first you have to build some bridges and watch out for the cliff." = "Fhuair na seirbhisean dìomhair a-mach gur dòcha gur e factaraidh san raon fo-thropaigeach adhbhar luaisgeachd na gnàth-shìde. Chuir na cinn-fhionn romhpa siubhal dhan fhactaraidh ud is a chur dheth. 'S e triall fada is cunnartach a bhios ann. Tha iomadh duilgheadas romhad is ro na cinn-fhionn air an rathad. On a tha an deigh a' leaghadh, feumaidh iad corra drochaid a thogail an toiseach is aire a thoirt air an stac.",
        @"Destination North" = "Ceann-uidhe gu tuath",
        @"For now, Pingus are leaving South Pole and moving North. You have to help them!" = "Tha na cinn-fhionn a' fàgail A' Phòla a Deas is a' siubhal gu tuath. Feumaidh tu an cuideachadh!",
        @"The Cave" = "An uamh",
        @"Pingus on their way came across a huge cave. You have to lead them through. Remember that sometimes there is more than one way out. Hint: To 'unlock' blockers you can use bashers and jumpers." = "Thachair na cinn-fhionn air uamh air an t-slighe. Feumaidh tu an stiùireadh troimhpe. Cùm d' aire air gum faod barrachd na aon slighe a-mach a bhith ann. Gliocas: 'S urrainn dhut slacair no leumadair a chleachdadh gus bacadair a \x22shaorachadh\x22.",
        @"Difficulties on the way" = "Trioblaidean air an rathad",
        @"It looks you have encountered serious difficulties. But don't panic, Pingus are waiting for your orders, they count on you so don't fail! Hint: Miners, diggers and bashers are very important here!" = "Tha trioblaid mhòr agad a rèir coltais. Ach gabh air do shocair, tha na cinn-fhionn a' feitheamh ri d' òrduighean is a' crochadh ort, chan fhad tu fàilligeadh! Gliocas: Tha mèinnearan, cladhaichean is slacairean glè chudromach an-seo!",
        @"Four ways out" = "Ceithir slighean a-mach",
        @"It's getting warmer but Pingus are bravely moving North. This time it will be much easier. There are at least four ways out. Could you find them?" = "Tha e a' fàs nas blàithe, ach tha na cinn-fhionn a' siubhal gu tuath gu calma. Bidh e mòran nas fhasa an turas seo. Tha co-dhiù ceithir dòighean ann gus faighinn a-mach. An lorg thu iad?",
        @"Egypt - So easy" = "An Èipheit - Cho furasta",
        @"Pingus reached Egypt. Looks easy, but is it really so easy? Try it out." = "Ràinig na cinn-fhionn an Èipheit. Tha coltas furasta air, ach a bheil e cho furasta sin? Feuch e.",
        @"Egypt - Oasis" = "An Èipheit - Innis-fhàsaich",
        @"Last time it was easy. Now it will be a little bit harder. Pingus are entering oasis. Watch out for the water." = "Bha an turas roimhe furasta. Co-dhiù, fàsaidh e beagan nas dorra a-nis. Tha na cinn-fhionn a' dol a-steach dhan innis-fhàsaich. Thoir an aire air an uisge.",
        @"Egypt - The Maze" = "An Èipheit - An cuartan",
        @"You came across a maze. Can you find the way out? Think twice before digging." = "Ràinig thu cuartan. An lorg thu an t-slighe a-mach? Smaoinich gu cùramach mus cladhaich thu.",
        @"Egypt - Pyramids" = "An Èipheit - Na Pioramaidean",
        @"The maze led you to the big pyramids. Now you have 4 minutes to escape. Hurry up!" = "Thug an cuartan dha na pioramaidean mòra thu. Chan eil agad ach ceithir mionaidean gus faighinn a-mach. Greas ort!",
        @"Bomb and Double Catch" = "Boma is beir",
        @"Here you might have some time to relax. The path isn't complicated and a bit of bombing and catching of Pingus should bring you to the end without much trouble, but don't relax to much, your resources are limited, so be careful when using them." = "'S dòcha gum faigh thu greis gus d' anail a leigeil an-seo. Chan eil an t-slighe toinnte is bu chòir dhut an ceann-uidhe a ruigsinn gun trioblaidean mòra le boma no dhà is beagan beirsinn. Ach thoir an aire co-dhiù, chan eil stòrasan gun chrìoch agad is feumaidh tu a bhith faiceallach nuair a chleachdas tu iad.",
        @"Up, Up and Away" = "Suas, suas is a-mach",
        @"The exit is in a weird spot here, straight above. A bridge won't get you there, but your toolset allows an alternative way. Can you figure it out?" = "Tha an doras a-muigh ann an àite neònach an-seo, dìreach os do chionn. Cha toir drochaid an-siud thu, ach tha acainnean eile agad. An lorg thu fuasgladh?",
        @"If only penguins could fly" = "Gum biodh sgiathaich aig cinn-fhionn",
        @"Bridges are kind of rare around here, so don't waste any. That aside, you shouldn't have to much trouble here, everything to do here you should have learned, but you might have to use all that knowledge at once." = "Tha drochaidean caran gann an-seo is chan fhaod thu an caitheamh. Cha bu chòir cus trioblaid a bhith agad a thuilleadh air seo. Thathar an dùil gu bheil thu air a h-uile rud a tha a dhìth ort ionnsachadh, ach is dòcha gum feum thu an t-eòlas agad uile a chleachdadh aig an aon àm.",
        @"Stairway to Heaven" = "Staidhre dhan nèamh",
        @"Here things start to get a little complicated. Getting up to the exit is hard enough with a single Pingu, but with all of them? Impossible! But wait, who says they have to come the same way?" = "Tha cùisean a' fàs nas toinnte an-seo. Tha e doirbh gu leòr an doras a-mach shuas a ruigsinn le aon cheann-fionn, ach dè mu dheidhinn a h-uile gin dhiubh? Ach fuirich ort, a bheil e riatanach gun gabh iad uile an aon slighe?",
        @"Misdirection Everywhere" = "Mealladh sa h-uile àite",
        @"The last level for this Xmas. Looks a little complicated, right? Don't worry with all you have learned so far, you should be able to even solve this.\n\nGood Luck & a Merry Xmas 2011" = "Seo an leibheil mu dheireadh na Nollaige seo. Tha coltas beagan toinnte air, nach eil? Na gabh dragh, bu chòir dhut a' chùis a dhèanamh air leis a h-uile rud a dh'ionnsaich thu.\n\nGuma math a thèid leat is Nollaig chridheil 2011 dhut!",
        @"The Big Jump" = "An leum mòr",
        @"No Way to Stop" = "Cha ghabh stad",
        @"Here you don't have much time to waste. The path to the exit is clear and straight, but you don't have the time to prepare it. Can you find a way to leap ahead?" = "Chan eil mòran ùine agad ri caitheamh an-seo. Tha an t-slighe dhan doras a-mach soilleir is dìreach, ach chan eil ùine gu leòr agad gus a h-ullachadh. An lorg thu dòigh gus leum air adhart?",
        @"Ice Block Blockage" = "Bloca deighe san rathad",
        @"What's this? A gigantic ice block straight in the path? Where did that come from? No time wondering about things like that. The Pingus need to get to the exit and it's your job to find a way around the block." = "Dè tha seo? Cùis-uamhais de bhloca deighe dìreach san rathad? Cò às a thàinig e? Chan eil ùine ann gus cnuasadh air. Feumaidh na cinn-fhionn an doras a-mach a ruigsinn is 's e an t-uallach agadsa a th' ann slighe timcheall air a' bhloca a lorg.",
        @"The Impossible Bridge" = "An drochaid do-chreidsinneach",
        @"Two groups of Pingus separated by a deep byss, joining them by a bridge seems impossible, but wise coordination of the two groups and a brave leap should let you make it to the exit." = "Tha dà bhuidheann dhe cheann-fionn air an sgaradh le aibheis. Shaoileadh tu nach gabhadh an aonachadh le drochaid, ach le co-òrdanachadh glic is leum dàna bu chòir iad faighinn a-mach.",
        @"Spiraling Away" = "Snìomh a-mach",
        @"The exit is straight below, but the path is blocked by solid steel with no way through. But the Pingus have a versatile toolset at hand, can you use it to find a way around and make it to the exit?" = "Tha an doras a-mach dìreach shìos, ach tha an t-slighe bacte le stàilinn chruaidh is gun slighe troimhe. Ach tha acainnean iol-chomasach aig na cinn-fhionn, an cleachd thu iad gus slighe timcheall air a lorg is faighinn dhan doras a-mach?",
        @"Tutorial Island" = "Eilean an oideachaidh",
        @"Learn the basics" = "Ionnsaich na sgilean bunasach",
        @"Watch Ending" = "Seall air a' chrìoch",
        @"Watch Intro" = "Seall air an sgeulachd",
        @"The Journey Begins" = "Tha an triall a' tòiseachadh",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Bho chionn fhada, bhiodh na cinn-fhionn a' fuireach gu socair sìtheil air A' Phòla a Deas còmhla ris na beathaichean eile uile. Bhiodh mèidh air a h-uile nì is cha ghabhadh e creidsinn gun rachadh an t-sìth aca a bhriseadh. Bha na cinn-fhionn toilichte is a rèir coltais cha tigeadh seo gu crìch gu bràth tuilleadh.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Ach, latha a bha seo, thòisich na cùisean air atharrachadh mean air mhean. Dh'fhàs na speuran na bu duirche is an talamh na bu bhlàithe. An toiseach, bha iad den bheachd nach e ach luaisgeachd àbhaisteach na gnàth-shìde a bha ann, ach dh'fhàs e na bu mhiosa gach bliadhna.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "Thòisich an sneachda a leaghadh an-siud 's an-seo is dh'fhàs e na bu dorra biadh a lorg. Dh'fhàg cuid dhe na h-ainmhidhean an àite an tòir raointean a bu fhuaire. Co-dhiù, bha fios aig na cinn-fhionn nach biodh seo a' cuideachadh is gun robh aca ri rudeigin a dhèanamh an aghaidh an duilgheadais seo.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Chruinnich na seanairean is seanmhairean gus co-dhùnadh a thoirt air dè a ghabhadh dèanamh. Thug iad romhpa buidheann a chur a-null air triall gus faighinn a-mach carson a bha an saoghal a' fàs na bu bhlàithe. Dh'fhalbh ceudan dhe na cinn-fhionn a bu chalma a bha air A' Phòla a Deas.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "Agus is tusa an ceann-cinnidh a thagh iad gus an stiùireadh timcheall air an t-saoghal, oir bidh an triall cunnartach is doirbh. 'S e Eilean Mhogoroc a tha sa chiad cheann-uidhe agad, air a bheil Tutorial Island (Eilean an Oideachaidh) cuideachd. A rèir an t-seanchais, 's e seo an t-eilean far an rachadh cinn-fhionn an toiseach nuair a chaidh an cur a-null dhan t-saoghal.",
        @"The island consists of many areas that are ideal to teach the Pingus their abilities. The Pingus can learn to build bridges, climb, bash and use many other talents which they will need on their long and dangerous journey." = "Tha an t-eilean dèanta dhe raointean eadar-dhealaichte a bhios foirfe gus na comasan aig na cinn-fhionn a thrèanadh. 'S urrainn dhaibh na tàlantan aca a leithid togail dhrochaidean, sreap, cladhach is eile a thrèanadh an-siud, oir bidh iad feumach orra gun teagamh air an triall fhada is doirbh a tha romhpa.",
        @"While there, you can practice your abilities in commanding and guiding the Pingus. You can also get familiar with all the abilities the Pingus provide and learn to master them, since you will need all of them on your journey around the world." = "Aig an aon àm, 's urrainn dhut fhèin trèanadh ach am bi thu comasach air na cinn-fhionn a stiùireadh is a bhith nad cheann-cinnidh. Cuideachd, gheibh thu eòlas air na comasan a bheil aig na cinn-fhionn. Gun teagamh, bidh iad uile a dhìth ort air an triall timcheall air an t-saoghal.",
        @"Now that you and the Pingus have arrived at Tutorial Island it is time to take command and begin your mission.\n\nGood Luck!" = "Nise, on a ruig thu Eilean an Oideachaidh còmhla ris na cinn-fhionn, nach gabh thu ùghdarras is nach tòisich thu leis a' mhisean agad?\n\nGuma math a thèid leat!",
        @"The Journey Continues" = "Leanaidh an triall",
        @"Now after you and the Pingus have learned the basics and practiced a bit it is time to move on and begin the journey into the world. Since the ice floe with which the Pingus traveled to the Tutorial Island isn't going to hold on the whole way into the warmer climates the Pingus have to find something else to guide them on their journey." = "Nise gu bheil thusa is na cinn-fhionn air na comasan bunasach ionnsachadh is beagan cleachdaidh fhaighinn, thàinig an t-àm gus falbh is siubhal dhan t-saoghal a-muigh. On nach mair an clàr-deighe air an do ràinig na cinn-fhionn Eilean an Oideachaidh gus an ruig iad na raointean as blàithe, feumaidh iad rudeigin eile a lorg air an siubhail iad.",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "Co-dhiù, mar a dh'innseas an seanchas dhuinn, chan ann a-mhàin gur e àite trèanaidh air leth a tha ann an Eilean an Oideachaidh, ach seach a' chiad cheum dhan t-saoghal a-muigh cuideachd. An dèidh dhaibh sireadh greis fhada, mhothaich na cinn-fhionn gun robh an fhìrinn san t-seanchais nuair a lorg iad a' chraobh mhòr ceann thall an eilein a thug maide gu leòr dhaibh gus slaod a thogail.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Agus 's e seo na rinn iad. Thug na cinn-fhionn slaodan gu leòr a bheireadh a h-uile gin diubh. An dèidh biadh a dhèanamh gus a thoirt leotha, bha iad ullaichte airson an triall aca mu dheireadh thall, is dh'fhàg iad àiteachan an eòlais gus falbh dhan aineolas.",
        @"So the Pingus sit on their raft, worrying about what's to come and where to go, while floating into the sunset.\n\nTo be continued..." = "Mar sin, tha na cinn-fhionn nan seasamh air an t-slaod, làn uallaich mun àm is mu na h-àiteachan a tha romhpa, a' siubhal a dh'ionnsaigh dol fodha na grèine.\n\nCumaidh iad orra...",
        @"Alien by Josh Dye" = "Creutairean-fànais le Josh Dye",
        @"Escape from alien" = "Teicheadh on chreutair-fhànais",
        @"Crystal" = "Criostal",
        @"Crystaline sparkling full of danger" = "Criostal lainnireach làn cunnairt",
        @"Desert" = "Am fàsach",
        @"Getting hot outside..." = "Tha e teth a-muigh...",
        @"Factory Campaign" = "Iomairt an fhactaraidh",
        @"Pingus expedition" = "Triall nan ceann-fionn",
        @"Halloween 2011" = "Oidhche Shamhna 2011",
        @"Going Underground" = "Fon talamh",
        @"Halloween 2007" = "Oidhche Shamhna 2007",
        @"Trapped at All Hallows Eve" = "Glacte air Oidhche Shamhna",
        @"Hellmouth" = "Beul na h-iutharna",
        @"A cave full of slime..." = "Uamh làn eabair",
        @"Jungle" = "Dlùth-choille",
        @"Island of Mystery" = "Eilean na dìomhaireachd",
        @"Marooned on an Uncharted Isle [by Lachlan McCubbin]" = "Air eilean uaigneach [le Lachlan McCubbin]",
        @"Pac-Man" = "Pac-Man",
        @"Trapped in a video game" = "Glacte ann an geama coimpiutair",
        @"Xmas 2011" = "Nollaig 2011",
        @"Merry Christmas and a Happy New Year" = "Nollaig chridheil is bliadhna mhath ùr",
    ],
]
