:pingus.po [
    lang = "eo",
    texts = [
        @"Object:" = "Objekto:",
        @"Nothing selected" = "Nenio estas elektita",
        @"Transparent" = "Travidebla",
        @"Solid" = "Solida",
        @"Ground" = "Tereno",
        @"Bridge" = "Ponto",
        @"Water" = "Akvo",
        @"Lava" = "Lafo",
        @"Remove" = "Forigi",
        @"Direction:" = "Direkto:",
        @"Left" = "Maldekstre",
        @"Misc" = "Diversaj",
        @"Right" = "Dekstre",
        @"Scroll-X:" = "Rulumilo-X",
        @"Scroll-Y:" = "Rulumilo-Y",
        @"Owner Id:" = "Identigo de la posedanto",
        @"Color:" = "Koloro:",
        @"Small Stars:" = "Etaj Steloj:",
        @"Middle Stars:" = "Mezaj steloj",
        @"Large Stars:" = "Largaj Steloj",
        @"Repeat:" = "Ripeti:",
        @"Id:" = "Id:",
        @"Height:" = "Alteco:",
        @"Object: [Group]" = "Objekto: [Grupa]",
        @"Group not supported" = "Grupo ne subtenata",
        @"Object: " = "Objekto: ",
        @"New level" = "Nova nivelo",
        @"Open level..." = "Malfermi nivelon...",
        @"Save level..." = "Konservi nivelon...",
        @"Save level as..." = "Konservi nivelon kiel...",
        @"Play level..." = "Ludi nivelon...",
        @"Configure actions" = "Agordi agojn",
        @"Configure level" = "Agordi nivelon",
        @"Display object properties" = "Montri objektajn proprecojn",
        @"Show object insertion window" = "Montri la fenestron de objekto aldono.",
        @"Show minimap" = "Montri mapeton",
        @"Duplicate the selected objects" = "Duobligi elektitajn objektojn",
        @"Delete the selected objects" = "Forigi elektitajn objektojn",
        @"Raise object to top" = "Suprenigi objekton al supro",
        @"Raise object" = "Suprenigi objekton",
        @"Lower object" = "Malsuprenigi objekton",
        @"Lower object to bottom" = "Malsuprenigi objekton al malsupro",
        @"Flip object horizontally" = "Ĝiri objekton horizontale",
        @"Flip object vertically" = "Ĝiri objekton vertikale",
        @"Rotate object -90 degree" = "Rotacii objekton -90 gradojn",
        @"Rotate object 90 degree" = "Rotacii objekton 90 gradojn",
        @"Display help" = "Montri helpon",
        @"Exit" = "Eliri",
        @"Open" = "Malfermi",
        @"Save" = "Konservi",
        @"Cancel" = "Nuligi",
        @"Filename:" = "Dosiernomo:",
        @"Pathname:" = "Vojnomo:",
        @"Open a level" = "Malfermi nivelon",
        @"Save your level" = "Konservi vian nivelon",
        @"== Editor Help ==" = "== Helpo por redaktoroj ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Elekti ĉiujn\nForigi elekton\nSuprenigi objektojn\nMalsuprenigi objektojn\nSuprenigi objektojn al supro\nMalsuprenigi objektojn al malsupro\nRotacii 90 gradojn\nRotacii 270 gradojn\nGrupigi elektitajn objektojn\nMalgrupigi elektitajn objektojn\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Ĝiri objekton horizontale\nĜiri objekton vertikale\nForigi markitajn objektojn\nMovi 1 rastrumero la objektojn\nMovi 32 rastrumeroj la objektojn\nBaskuligi fonan koloron\nPligrandigi/Malpligrandigi ripeton\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Vi devus nomigi vian dosieron nivelan laŭsisteme,  ekzemple,. laŭ ĝia temo, ĝia numero kaj via kromnomo:\n\n     <nivelanomo><numero>-<kreanto>.pingus\n\nDo se vi kreas vian duan nivelon kun ŝtona temo, nomigu ĝin tiel: ŝtono2-vianomo.pingus\n\nKiam vi kreu nivelon kaj vi volas ke ĝi estu aldonita en la ludo, sendu retpoŝton al:\n\n     pingus-devel@nongnu.org\n\nNur niveloj eldonitaj laŭ la GPL permesilo estas aldonataj en la ludo. La redaktoro aŭtomate aldonas referencon \nal GPL, se vi volas havi vian nivelon laŭ alia  permesilo, vi devas ŝanĝi tiun referencon.\n",
        @"Replace" = "Anstataŭigi",
        @"Entrance" = "Enirejo",
        @"Groundpiece (ground)" = "Grundpieco (grunda)",
        @"Groundpiece (solid)" = "Grundpieco (solida)",
        @"Groundpiece (bridge)" = "Grundpieco (ponta)",
        @"Groundpiece (transparent)" = "Grundpieco (travidebla)",
        @"Groundpiece (remove)" = "Grundpeco (forigi)",
        @"Hotspot" = "Retkaptejo",
        @"Background" = "Fono",
        @"Liquid" = "Likva",
        @"Trap" = "Kaptilo",
        @"Weather" = "Vetero",
        @"Special Object" = "Speciala objekto",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Liberitoj : %3d/%d   Eliratoj :%3d   Savitoj :%3d/%d",
        @"Angel" = "Anĝelo",
        @"Basher" = "Fosanto",
        @"Blocker" = "Blokanto",
        @"Bomber" = "Bombisto",
        @"Bridger" = "Pontisto",
        @"Climber" = "Grimpisto",
        @"Digger" = "Fosisto",
        @"Drown" = "Droniganto",
        @"Exiter" = "Eliranto",
        @"Faller" = "Falanto",
        @"Floater" = "Paraŝutisto",
        @"Jumper" = "Saltisto",
        @"Laserkill" = "Lasermortigo",
        @"Miner" = "Ministo",
        @"Smashed" = "Frakasita",
        @"Splashed" = "Ŝprucita",
        @"Superman" = "Superviro",
        @"Teleported" = "Teleportita",
        @"Waiter" = "Atendanto",
        @"Walker" = "Paŝanto",
        @"skip" = "ignori",
        @"Play" = "Ludi",
        @"Back" = "Malantaŭen",
        @"Number of Pingus: " = "Nombro da pingvinoj: ",
        @"Number to Save: " = "Nombro por Savi: ",
        @"Time: " = "Tempo: ",
        @"Author: " = "Aŭtoro: ",
        @"Close" = "Fermi",
        @"Fullscreen" = "Tutekrane",
        @"Software Cursor" = "Musmontrilo programaro",
        @"Resolution:" = "Distingivo:",
        @"Language:" = "Lingvo:",
        @"Sound Volume:" = "Sona volumo",
        @"Music Volume:" = "Muzika volumo",
        @"Option Menu" = "Opcia menuo",
        @"Some options require a restart of the game to take effect." = "Kelkaj opcioj bezonas restarti la ludon por plenumiĝi",
        @"Story" = "Historio",
        @"..:: Start the game ::.." = "..:: Ekludi ::..",
        @"Editor" = "Redaktilo",
        @"..:: Create your own levels ::.." = "..:: Krei vian propran nivelojn ::..",
        @"Options" = "Opcioj",
        @"..:: Configure the game ::.." = "..:: Agordi ludon ::..",
        @"Levelsets" = "Nivelujoj",
        @"..:: Play User Built levels ::.." = "..:: Ludi Uzant-konstruitajn nivelojn ::..",
        @"..:: Bye, bye ::.." = "..:: Ĝis, ĝis ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g : muse kapto :: F10 : fps nombrilo :: F11 : plenekrane :: F12 : ekrankopio ::..",
        @"Give up" = "Kapitulaci",
        @"Retry" = "Reprovi",
        @"Success!" = "Sukceso!",
        @"Failure!" = "Malsukceso!",
        @"Perfect! You saved everyone possible - great!" = "Perfekte! Vi savis ĉiueblan - bonege!",
        @"No-one got killed, pretty good work." = "Neniu estis mortigita, tre bona laboro.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Vi savis ekzakte kiom vi bezonis - vi sukcesis, sed\neble ĉu vi povas fari tion plej bone?",
        @"Not everybody was saved, but still good work!" = "Ne ĉiuj estis savataj, sed ankoraŭ estas bona laboro!",
        @"What can I say, you made it - congratulations!" = "Kion mi povas diri, vi sukcesis - gratulon!",
        @"You killed everybody, not good." = "Vi mortigis ĉiujn, nebone.",
        @"No-one got saved - I know you can do better." = "Neniu estis savita . Mi scias ke vi povas fari tion plej bone.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Vi ne savis ĉiujn, sed vi savis kelkajn. Venontfoje\nvi povus fari tion pli bone",
        @"Only one more and you would have made it - try again!" = "Nur unu pli kaj vi sukcesos . provu denove!",
        @"Better luck next time!" = "Plibona sorto venontfoje!",
        @"Saved: " = "Konservita: ",
        @"Died: " = "Mortis: ",
        @"Time left: " = "Restanta tempo: ",
        @"Under Construction" = "Konstruante",
        @"Untested, unpolished and broken levels" = "Neprovitaj, nepoluritaj kaj rompitaj niveloj",
        @"Solved:" = "Solvita:",
        @"levels" = "niveloj",
        @"???" = "???",
        @"Show Ending?" = "Ĉu montri finalon?",
        @"Leave?" = "Ĉu foriri?",
        @"[OPTIONS]... [FILE]" = "[OPCIOJ]... [DOSIERO]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Pingus estas puzla ludo kie vi bezonas gvidi amaseton da malgrandaj pingvenoj tra la mondo",
        @"General Options:" = "Ĝeneralaj opcioj:",
        @"Displays this help" = "Montri ĉi tiun helpon",
        @"Print version number and exit" = "Printi nombran version kaj eliri",
        @"Display Options:" = "Montri opciojn:",
        @"Start in Window Mode" = "Startigi en fenestra reĝimo",
        @"Start in Fullscreen" = "Komenci Plenekrane",
        @"Set the window resolution for pingus (default: 800x600)" = "Agordi la fenestran distingivon por pingu (apriore: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Agordi la distingivon uzatan en tutekrana reĝimo (apriore: 800x600)",
        @"Enable software cursor" = "Ŝalti musmontrilon",
        @"Game Options:" = "Ludaj opcioj:",
        @"Disable automatic scrolling" = "Malŝalti aŭtomatan  rulumadon",
        @"Sound Options:" = "Sonaj opcioj:",
        @"Disable sound" = "Malvalidigi sonon",
        @"Disable music" = "Malvalidigi muzikon",
        @"Select language to use with Pingus" = "Elektu lingvon por uzi kun Pingus",
        @"List all available languages" = "Listigi ĉiujn disponeblajn lingvojn",
        @"Loads the level editor" = "Ŝarĝi la nivela redaktilo",
        @"Directory Options:" = "Dosierujaj opcioj:",
        @"DIR" = "DOSIERUJO",
        @"Load game datafiles from DIR" = "Ŝarĝi ludajn dosierdatumon de DOSIERUJO",
        @"Don't read ~/.pingus/config" = "Ne legu ~/.pingus/config",
        @"FILE" = "DOSIERO",
        @"Debug Options:" = "Sencimigaj opcioj:",
        @"Set the game speed (0=fastest, >0=slower)" = "Agordi ludan rapidecon (0= Plej rapida, >0= pli malrapida)",
        @"Set the size of the map tiles (default: 32)" = "Agordu la grandecon de la mapaj kaheloj (apriore:32)",
        @"Pingus: Out of memory!" = "Pingus: Memormanko",
        @"unlimited" = "senlima",
        @"Screenshot: Saving screenshot to: " = "Ekrankopio: Konservi ekrankopion al ",
        @"Screenshot: Screenshot is done." = "Ekrankopio: Ekrankopio farita.",
        @"Screenshot: Couldn't write file: " = "Ekrankopio: ne skribeblas dosiero ",
        @"If the way is blocked, bash away" = "Se la vojo blokas, forfosu",
        @"Learning to dig" = "Lernante fosi",
        @"Float or Die" = "Flosu aŭ Mortu",
        @"Miner's heaven" = "Minista ĉielo",
        @"Panic Island (float/bash)" = "Paniko insulo",
        @"Two groups in parallel, coordinate wisely" = "Du grupoj paralelaj, kunordigi ĝin saĝe",
        @"Block'a Rock" = "Blok'a Roko",
        @"Climb, Climber,... Boom!" = "Grimpi, Grimpisto,...Boom!",
        @"If too high, your Pingu will die..." = "Se altas tro, via Pingu mortos",
        @"Learn to use the bridge" = "Lernu kiel uzi la ponton",
        @"Climb, Climber, climb... and build a bridge" = "Grimpi, Grimpisto, grimpi...kaj konstrui ponton",
        @"Entrance high, Exit low" = "Alta enirejo, Malalta elirejo",
        @"Solid ground can block the path" = "Solida grundo povas bloki la vojon",
        @"One jump to catch them all" = "Unu salto por kapti kapti ilin ĉiujn",
        @"One Thousand and One Jumps" = "Mil kaj unu saltoj",
        @"Boom Boom" = "Bum Bum",
        @"Full Circle" = "Plencirklo",
        @"Down Into The Cave" = "Malsupreniĝu al kaverno",
        @"Group Coordination" = "Grupa kunordigado",
        @"Reach that Switch" = "Atingu tiun ŝaltilon",
        @"Island of Doom" = "Insulo de la perdiĝo",
        @"Tower of Death" = "Turo de la morto",
        @"The Ones" = "La ununuraj",
        @"Entering the pyramid" = "Enirante piramidon",
        @"The window room" = "La fenestra ĉambro",
        @"Pass the pedestal" = "preterpasu la piedestalon",
        @"The excavation of the pyramid" = "La fosado de la piramido",
        @"Claustrophobia" = "Klaŭstrofobio",
        @"A bit to the right a bit to left" = "Iomete dekstren iomete maldekstren",
        @"25 Pingus free and 25 in the box" = "25 pingus liberaj kaj 25 en la skatolo",
        @"Tunnel Time" = "Tunela tempo",
        @"The Roof" = "La Tegmento",
        @"Near can mean far" = "Proksimeco povas signifi malproksimecon",
        @"Experimentation" = "eksperimentado",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Freneza sciencisto kaptis la pingvenojn kaj eksperimentas sur ili. Kiel povas la pingvenojn eskapi de la gilotino?",
        @"The Lava Pit" = "La lafa kavo",
        @"Revenge is sweet" = "Venĝo estas dolĉa",
        @"Winter Wonderland" = "Vintra Mirlando",
        @"The Journey Goes On" = "La vojo daŭrigas",
        @"Think fast (literally)" = "Pensu rapide (laŭlitere)",
        @"Escape from Aliens" = "Eskapi de la ekster-mondanoj",
        @"Escape from Aliens 2" = "Eskapi de la ekster-mondanoj 2",
        @"Aliens are now closest making your escape harder. You must dig it up." = "Ekster-mondanoj  nun estas proksimaj, ili farigas vian eskapadon malfacila. Vi devas fosi.",
        @"Alien's nest" = "Ekster-mondanaj nesto",
        @"Fourth dimension" = "Kvara dimensio",
        @"Lost in Space" = "Perdita en la spaco",
        @"Outside In" = "Ekstere ene",
        @"Endless Loop" = "Senfina buklo",
        @"Jump" = "Saltu",
        @"All Pingus need is to jump.... Hint: While pausing (press P key) you still can control Pingus. " = "Ĉio kio la pingvinoj bezonas estas salti....Sugesto: Dum paŭzado (premu P klavon) vi ankoraŭ povas kontroli Pingus. ",
        @"Factory" = "Fabriko",
        @"Going back home" = "Hejmen",
        @"Your mission is over. Pingus can go back home, but be careful!" = "Via misio finiĝis. Pingus povas iri hejmen, sed estu zorgema!",
        @"Difficulties on the way" = "Malfacilaĵoj tra la vojo",
        @"Egypt - So easy" = "Egipto - Tre facile",
        @"Egypt - Oasis" = "Egipto - Oazo",
        @"Tutorial Island" = "Instruaj insuloj",
        @"Learn the basics" = "Lernu la bazoj",
        @"The Journey Begins" = "La vojo komencas",
        @"Desert" = "Dezerto",
    ],
