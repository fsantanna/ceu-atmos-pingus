        @"Lower object to bottom" = "Laske objekti alimmaiseksi",
        @"Flip object horizontally" = "Käännä vaakasuunnassa",
        @"Flip object vertically" = "Käännä pystysuunnassa",
        @"Rotate object -90 degree" = "Käännä kohdetta -90 astetta",
        @"Rotate object 90 degree" = "Käännä kohdetta 90 astetta",
        @"Display help" = "Näytä ohje",
        @"Exit" = "Poistu",
        @"Datadir" = "Datadir",
        @"Userdir" = "Userdir",
        @"Open" = "Avaa",
        @"Save" = "Tallenna",
        @"Cancel" = "Peruuta",
        @"Filename:" = "Tiedostonimi:",
        @"Pathname:" = "Polku:",
        @"Open a level" = "Avaa kenttä",
        @"Save your level" = "Tallenna kenttä",
        @"== Editor Help ==" = "== Muokkaajan ohje ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Valitse kaikki\nTyhjennä valinta\nNosta esineitä\nLaske esineitä\nNosta esineitä alkuun\nLaske esineitä alas\nKierrä 90 astetta\nKierrä 270 astetta\nRyhmitä valitut objektit\nPura ryhmitetyt objektit\n",
        @"Replace" = "Korvaa",
        @"Entrance" = "e - Sisäänkäynti",
        @"Groundpiece (ground)" = "g - Maapala (maa)",
        @"Groundpiece (solid)" = "s - Maapala (kiinteä)",
        @"Groundpiece (bridge)" = "b - Maapala (silta)",
        @"Groundpiece (transparent)" = "n - Maapala (läpinäkyvä)",
        @"Groundpiece (remove)" = "r - Maapala ('poista')",
        @"Hotspot" = "Langaton verkkopiste",
        @"Background" = "Tausta",
        @"Liquid" = "Neste",
        @"Trap" = "Ansat",
        @"Weather" = "Sää",
        @"Special Object" = "Erityiset objektit",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Lähteneitä:%3d/%-3d   Liikkeellä:%3d   Pelastettu:%3d/%-3d",
        @"Angel" = "Enkeli",
        @"Basher" = "Murskaaja",
        @"Blocker" = "Pysäyttäjä",
