        @"Miner" = "Louhija",
        @"Slider" = "Liukuja",
        @"Smashed" = "Liiskaus",
        @"Splashed" = "Roiskaus",
        @"Superman" = "Teräsmies",
        @"Teleported" = "Teleportattu",
        @"Waiter" = "Odottaja",
        @"Walker" = "Kävelijä",
        @"skip" = "ohita",
        @"Play" = "Pelaa",
        @"Back" = "Takaisin",
        @"Number of Pingus: " = "Pingujen määrä: ",
        @"Number to Save: " = "Pelastettavien määrä: ",
        @"Time: " = "Aika: ",
        @"Author: " = "Tekijä: ",
        @"Close" = "Sulje",
        @"Fullscreen" = "Kokoruututila",
        @"Autoscrolling" = "Automaattinen vieritys",
        @"Print FPS" = "Näytä FPS",
        @"Resolution:" = "Tarkkuus:",
        @"Language:" = "Kieli:",
        @"Master Volume:" = "Pää äänenvoimakkuus:",
        @"Sound Volume:" = "Äänenvoimakkuus:",
        @"Music Volume:" = "Musiikinvoimakkuus:",
        @"Story" = "Tarina",
        @"..:: Start the game ::.." = "..:: Aloita peli ::..",
        @"Editor" = "Kenttäeditori",
        @"..:: Create your own levels ::.." = "..:: Luo omat kentät ::..",
        @"Options" = "Asetukset",
        @"..:: Configure the game ::.." = "..:: Pelin asetukset ::..",
        @"Levelsets" = "Kenttäpaketit",
        @"..:: Play User Built levels ::.." = "..:: Palaa käyttäjän rakentamilla tasoilla ::..",
        @"..:: Bye, bye ::.." = "..:: Hei hei! ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: kaappaa hiiri   ::   F10: fps-laskuri   ::   F11: kokoruutu   ::   F12: ruutukaappaus ::..",
        @"Give up" = "Luovuta",
        @"Retry" = "Yritä uudelleen",
        @"Success!" = "Onnistuit!",
        @"Failure!" = "Epäonnistuit.",
        @"Perfect! You saved everyone possible - great!" = "Täydellistä! Pelastit joka ikisen, loistavaa!",
        @"No-one got killed, pretty good work." = "Yksikään ei menehtynyt, hyvin tehty.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Pelastit tasan tarvittavan määrän - pääsit kyllä kentän läpi,\nmutta kai pystyt parempaankin?",
        @"Not everybody was saved, but still good work!" = "Ihan kaikki eivät pelastuneet, mutta hyvää työtä joka tapauksessa!",
        @"What can I say, you made it - congratulations!" = "Mitästä tässä voi sanoa... Pääsit läpi - onneksi olkoon!",
        @"You killed everybody, not good." = "Tapatit kaikki - ei hyvä, ei.",
        @"No-one got saved - I know you can do better." = "Yksikään ei selvinnyt - pystyt varmasti parempaankin.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Et pelastanut ihan tarpeeksi, mutta muutaman kuitenkin.\nEnsi kerralla paremmin, vai mitä?",
        @"Only one more and you would have made it - try again!" = "Vielä yksi lisää maaliin asti niin olisit päässyt läpi - yritä uudestaan!",
        @"Only a handful more and you would have made it - try again!" = "Vain muutama lisää maaliin asti niin olisi päässyt läpi - yritä uudestaan!",
        @"Better luck next time!" = "Parempi tuuri ensi kerralla!",
        @"Saved: " = "Pelastui: ",
        @"Died: " = "Kuoli: ",
        @"Time left: " = "Aikaa jäljellä: ",
        @"Under Construction" = "Rakenteilla",
        @"Untested, unpolished and broken levels" = "Testaamattomia, kiillottamattomia ja rikkoutuneita tasoja",
        @"Solved:" = "Ratkaistu:",
        @"levels" = "tasot:",
        @"???" = "???",
        @"Show Ending?" = "Näytä lopetus?",
        @"Leave?" = "Poistu?",
        @"[OPTIONS]... [FILE]" = "[ASETUKSET]...[TIEDOSTO]",
        @"General Options:" = "Yleisasetukset",
        @"Displays this help" = "Näytä tämä ohje",
        @"Print version number and exit" = "Tulosta versiotiedot ja poistu",
        @"Display Options:" = "Näyttöasetukset:",
        @"Start in Window Mode" = "Käynnistä ikkunassa",
        @"Start in Fullscreen" = "Käynnistä koko ruudulla",
        @"Set the window resolution for pingus (default: 800x600)" = "Aseta ikkunan resoluutio pingus-pelille (oletus: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Aseta resoluutio käyttämään kokonäytöntilaa (oletus: 800x600)",
        @"Enable software cursor" = "Ota käyttöön ohjelmallinen osoitin",
        @"Game Options:" = "Peliasetukset",
        @"Disable automatic scrolling" = "Poista automaattinen vieritys käytöstä",
        @"Sound Options:" = "Ääniasetukset:",
        @"Disable sound" = "Ei ääniä",
        @"Disable music" = "Ei musiikkia",
        @"Select language to use with Pingus" = "Valitse käytettävä kieli",
        @"List all available languages" = "Listaa kaikki käytettävissä olevat kielet",
        @"Loads the level editor" = "Lataa kenttämuokkaimen",
        @"Directory Options:" = "Hakemisto asetukset",
        @"DIR" = "HAK",
        @"Load game datafiles from DIR" = "Lataa pelitiedostot HAK",
        @"Load config files and store savegames in DIR" = "Lataa asetustiedostot ja tallennetut pelit HAK",
        @"Load game modifications from DIR" = "Lataa pelin modifikaatiot HAK",
        @"Don't read ~/.pingus/config" = "Älä lue tiedostoa ~/.pingus/config",
        @"FILE" = "TIEDOSTO",
        @"Uses the controller given in FILE" = "Käyttää TIEDOSTO:ssa annettua ohjainta",
        @"Debug Options:" = "Virheenjäljitys asetukset:",
        @"Set the game speed (0=fastest, >0=slower)" = "Aseta pelin nopeus (0=nopein, >0=hitaampi)",
        @"Set the size of the map tiles (default: 32)" = "Aseta karttaruutujen koko (oletusarvo: 32)",
        @"Pingus: Out of memory!" = "Pingus: Muisti loppu!",
        @"Pingus: Standard exception caught!:\n" = "Pingus: Standardikeskeytys!:\n",
        @"Pingus: Unknown throw caught!" = "Pingus: Tuntematon keskytys!",
        @"unlimited" = "rajaton",
        @"Screenshot: Saving screenshot to: " = "Ruutukaappaus: Tallennetaan kaappausta: ",
        @"Screenshot: Screenshot is done." = "Ruutukaappaus: Ruutukaappaus valmis.",
        @"Screenshot: Couldn't write file: " = "Ruutukaappaus: Tiedostoon ei voitu kirjoittaa: ",
        @"If the way is blocked, bash away" = "Kun tie on tukossa, murskaaja auttaa",
        @"Similar to the Digger action that you already know from previous levels, there is also an action that allows the Pingus to dig horizontally, as opposed to the vertical dig ability the Digger action provides. This new action is called Basher. " = "Kuten jo aiemmista kentistä tuttu Kaivaja, myös tällä kertaa esiteltävä Murskaaja kaivaa tunneleita. Toisin kuin Kaivaja, se kuitenkin etenee vaakasuoraan eikä alaspäin. ",
        @"Sacrifice a few and save the rest" = "Uhraa muutama ja pelasta loput",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Jos muita kaivutoimintoja ei ole kätettävissä, täytyy joskus vain räjäytellä tie selväksi. Räjäyttämisen yhteydessä pingu tietysti kuolee, mutta toisinaan on tarpeen uhrata muutama loppujen hyväksi. ",
        @"Learning to dig" = "Opettele kaivamaan",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Tässä tulee ensimmäinen tehtäväsi - ja kuten tavallista, se on vielä melko halppo. Komennat vain haluamaasi pingua kaivamaan kolon maahan niin, että kaikki pääsevät uloskäynnille. Kaivaminen hoituu yksinkertaisesti klikkaamalla pingua. ",
        @"Float or Die" = "Leiju tai kuole",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "Ykköskenttähän sujui hyvin! Tällä kertaa tehtäväsi on varustaa pingut pienillä propelleilla, joiden avulla ne leijuvat pehmeästi maahan. Pingut nimittäin liiskautuvat pudotessaan liian korkealta. Pidä siis silmät auki ja hermot kurissa! ",
        @"Jump for joy" = "Hypi riemusta",
        @"Sometimes a Pingu needs to reach a platform that is far away, but not reachable by walking. That's when the Jumper comes in handy - it allows the Pingu to make a small jump and so enables him to reach the platform. " = "Toisinaan pingun pitäisi päästä tasanteelle, joka on kaukana edessäpäin, mutta jolle ei pääse kävellen. Hyppääjä auttaa. Sen avulla pingun saa hyppäytettyä lyhyitä matkoja ylävistoon. ",
        @"Miner's heaven" = "Louhijan toiveuni",
        @"Another action hits the street - another digging action, this time a diagonal one. It allows a Pingu to dig diagonally through ground, thus creating a path for following Pingus. The action is called Miner. " = "Uusi toiminto astuu kehiin - tämä toinen kaivuutapa tuottaa suoran sijaan viiston tunnelin. Sen avulla perästä tulevat pingut pääsevät samaan aikaan sekä sivulle että alaspäin. Toiminnon nimi on Louhija. ",
        @"Panic Island (float/bash)" = "Paniikkisaari (leiju/murksaa)",
        @"While the previous levels have not required much quick action from you, this one gets a bit trickier. The Pingus are coming out of two entrances in parallel and it is your job to coordinate the two groups wisely. " = "Siinä missä edelliset kentät eivät ole vaatineet paljon työtä, tämä alkaakin olla jo vähän hankalampi. Pinguja tulee samaan aikaan kahdesta eri sisäänkäynnistä ja tehtäväsi on koordinoida ryhmiä järkevästi. ",
        @"Jump'n Bump... and Bash..." = "Hypi, pompi... murskaa...",
        @"It's panic time again. The Pingus will not come out very fast, but since they turn around when they hit walls you will soon have some trouble coordinating them all. Since you only need to save 5 it should be doable, but if all else fails use the pause-mode ('p') to get an overview again. " = "Paniikkipäivät ovat täällä taas! Vaikka pinguja tulee kohtuullisen hitaasti, ne törmäilevät seiniin ja koko lauman ohjailu muuttuu varsin pian hankalaksi. Koska uloskäynnille täytyy kuitenkin saada vain 5 pingua, kentän ratkaiseminen ei pitäisi olla lainkaan mahdotonta. Jos mikään muu ei tunnu onnistuvan, kokeile pysäyttää peli 'p'-näppäimellä tai alareunan painikkeella. ",
        @"Two groups in parallel, coordinate wisely" = "Kaksi ryhmää rinnakkain, koordinoi viisaasti",
        @"You have two groups to coordinate this time. No need to panic, since this level gives you enough time to think your actions through. No more tips this time, but good luck! " = "Tällä kertaa johdettavanasi on kaksi eri ryhmää. Ei kuitenkaan syytä paniikkiin, sillä kentän ratkaisuun on varattu aikaa yllin kyllin. Siinä tämänkertaiset vihjeet, onnea matkaan! ",
        @"Block'a Rock" = "Stop'n Roll",
        @"Climb, Climber,... Boom!" = "Kiipeä, Kiipeäjä... Pum!",
        @"As you might have already figured out from previous levels, you often have to combine different actions to get the job done. Due to the lack of a Digger action in this level the Bomber needs to jump in, but how can it reach the place to bomb? " = "Kuten ehkä jo edellisestä kentästä opitkin, eri toimintoja täytyy usein yhdistellä luovasti. Koska tästä kentästä puuttuu Kaivajia, niiden tilalla täytyy käyttää Pommittajia, mutta miten Pommittajat saa räjähtämään oikeaan aikaan? ",
        @"Bridging gets more complicated..." = "Mutkikkaampaa siltailua...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "On jälleen aika yhdistellä viisaasti eri toimintoja. Hätiköimällä voit saada aikaan kolon juuri ennen uloskäyntiä, joten mieti tarkaan mitä teet. ",
        @"If too high, your Pingu will die..." = "Liian korkea pudotus vaarantaa terveytesi...",
        @"Teamwork is the way to the exit this time. You don't have enough Floaters to reach the exit, so just send a few and let them prepare the path for the rest. " = "Tästä kentästä selviää yhteistyöllä. Koska leijujia ei ole riittävästi, kannattaa lähettää muutama pingu edeltä raivaamaan tietä ennen kuin päästää muut liikkeelle. ",
        @"Learn to use the bridge" = "Opettele rakentamaan siltoja",
        @"If no Jumper is at hand and a large hole needs to be passed, a bridge can be pretty helpful. It takes some time to build, but unlike the jumper action it allows following Pingus to reach the other end too. " = "Jos yhtään Hyppääjä ei ole käytettävissä ja edessä on iso kolo, Siltaajasta voi olla hyötyä. Sillan rakentaminen kestää hieman, mutta toisin kuin Hypääjän kanssa, sillan avulla muutkin pingut pääsevät perille. ",
        @"Three solutions, it's up to you" = "Kolme ratkaisua, valitse minkä haluat",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Nyt kun hallitset kaikki toiminnot, on aika pienen lisäharjoituksen. Tämän kentän voi ratkaista kolmella eri tavalla. Valitse itse, mitä niistä haluat kokeilla. ",
        @"Climb, Climber, climb... and build a bridge" = "Kiipeä, Kiipeäjä, kiipeä... ja rakenna sitten silta",
        @"Once again you get access to a new action. The Climber action allows a Pingu to climb up straight walls, thus allowing him to reach stuff that might be too high to reach by other means. " = "Saat taas käyttöösi uuden toiminnon. Kiipeäjän avulla pingun saa nousemaan pystysuoraa seinää pitkin ja pääsemään siten paikkoihin, joihin ei niiden korkeuden vuoksi muilla keinoin ole asiaa. ",
        @"Entrance high, Exit low" = "Sisäänkäynti ylhäällä, uloskäynti alhaalla",
        @"If you don't have enough floaters to bring all the Pingus down to the exit - you have to find other ways to guide them down. You should have learned all the stuff you need for this level in previous levels, so this shouldn't be too much of a problem for you. " = "Jos Leijujia ei riitä kaikkien pingujen saamiseksi uloskäynnille, on löydettävä muita tapoja saattaa pingut ehjänä alas. Olet jo varmasti oppinut edellisissä kentissä riittävästi tämänkin kentän ratkaisemiseen, joten suuria ongelmia tuskin on odotettavissa. ",
        @"One must prepare, the rest must follow" = "Yksi selvittää reitin, muut seuraavat perässä",
        @"Sometimes there are situations where you don't have a Blocker at hand to coordinate your Pingus. You'll have to find other ways to keep them under control while a single one prepares the path for the rest. " = "Toisinaan vastaan tulee tilanteita, joissa käytössä ei ole yhtään Pysäyttäjää, mutta sellaista tarvittaisiin. Tällöin joudut kehittelemään muita tapoja pingujen kaitsemiseen sillä välin kun yksinäinen sankari on raivaamassa tietä muille. ",
        @"Unlike the first two levels, you have two actions available in this level. Your job is again simple: select an action at the panel on the left and apply it to the Pingus so that they will be able to reach the exit. Make sure that not too many of them die. " = "Toisin kuin ensimmäisissä kentissä, tällä kertaa käytettävissäsi on kahta eri toimintoa. Tehtävä on yksinkertainen: valitse vasemman reunan valikosta haluamiasi toimintoja ja käytä niitä pinguihin, että ne pääsevät uloskäynnille. Pidä huolta, ettei liian moni kuole matkalla. ",
        @"Dig, bash and other problems" = "Kaivamista, murskausta ja muuta mukavaa",
        @"The more levels you master, the more difficult they will get, but don't panic, as this one is still pretty easy. Just use the stuff that you've learned in the previous levels and you shouldn't have many problems. If you think you've reached a situation from which you can no longer solve the level, double click the armageddon button at the lower right. " = "Mitä pidemmälle pääset, sitä vaikeammiksi kentät muuttuvat. Älä silti hätäänny, sillä tämä on vielä aika helppo. Käytä vain aiemmin oppimiasi temppuja niin se tuskin tuottaa erityisemmin ongelmia. Jos alkaa tuntua, että olet onnistunut pilaamaan ratkaisumahdollisuutesi, paina ruudun alanurkassa olevaa joukkotuhonappia ja yritä uudelleen. ",
        @"Solid ground can block the path" = "Maasto voi tukkia tien",
        @"As you have learned in earlier levels your Pingus can dig through basically any terrain, but there is one material which they can't penetrate: steel. These regions are marked dark grey on the level map and cannot be destroyed, so you must find a way around them. " = "Kuten olet jo aiemmissa kentissä oppinutkin, pingut pystyvät kaivautumaan lähes millaisen maaston läpi tahansa, mutta yhtä materiaalia ne eivät saa rikki: terästä. Teräksiset alueet on merkittu karttaan tummanharmaalla ja koska niitä ei hajotettua mitenkään, ne täytyy vain kiertää. ",
        @"One jump to catch them all" = "Yksi hyppy ja kerää ne kaikki",
        @"One Thousand and One Jumps" = "Tuhat ja yksi hyppäystä",
        @"With the exit so high above and far out of reach for a normal Pingu, what options are there? Perhaps a jumper can rescue them?  Or will he simply slow their inevitable demise? It's your job to find out, but are you good enough to save them all?" = "Ulospääsy on aivan liian korkealla normaaleille Pinguille. Mitä vaihtoehtoja enää on jäljellä? Pystyykö Hyppääjä pelastamaan heidät? Vai viivyttääkö se vain heidän väistämätöntä tuhoaan. Sinun tehtäväsi on selvittää asia. Mutta oletko tarpeeksi hyvä pelastamaan heidät kaikki?",
        @"Boom Boom" = "Pum pum",
        @"Full Circle" = "Täysi ympyrä",
        @"The exit is so close, yet out of reach. A step in the wrong direction and the Pingus will fall to a terrible fate. You must do something to help them, but is there enough time? You have to hurry and can't allow yourself any mistakes. The Pingus are counting on you!" = "Poispäässy on niin lähellä, mutta silti niin kaukana. Yksikin askel väärään suuntaan ja Pinguja odottaa karmiva kohtalo. Sinun on autettava heitä, mutta riittääkö aika? Sinun on pidettävä kiirettä etkä voi sallia itsellesi pienintäkään virhettä. Pingun luottavat sinuun!",
        @"Bridgers Nightmare" = "Siltaajan painajainen",
        @"Who placed this monstrous wall here?  This terrible blockade separates your Pingus from the exit. Destruction of its awful construction seems an impossibility, but perhaps the bridger can come to the rescue?  Can they build their bridges high enough to guide the group yet again safely to the exit? Or is somebody playing evil mind tricks with you?\n\nYet again the solution is your call... your gray matter is the key to the Pingus' success, so don't let yourself get confused and misguided from the true path." = "Kuka on asettanut tämän järkyttävän seinämän kentälle? Seinämän, joka erottaa Pingusi turvapaikasta. Sen tuhoaminen vaikuttaa mahdottomalta, mutta kenties Siltaaja voi rakentaa sillan turvapaikkaan. Voivatko he rakentaa riittävän korkean sillan joka vie Pingut turvaan, vai onko joku mielipuoli asettanut mahdottoman haasteen eteesi?\n\nJälleen kerran sinun on ratkaistava ongelma. Aivosi ovat Pingujen ainoa toivo, joten älä hämäänny äläkä eksy oikealta polulta.",
        @"Is this a prison? Blocked by solid walls all around, there doesn't seem to be a way to escape. Salvation seems impossible. But wait... the wall to the right seems weak... perhaps this is a way to escape? Or is it a false path that will lead to the Pingus' doom?\n\nThis is a risky trip, but you must take it to find out how to bring them all to freedom once again." = "Onko tämä vankila? Ulospääsy näyttää mahdottomalta aluetta ympäröivien vallien takia ja pelastus vaikuttaa mahdottomalta. Mutta hetkinen, oikealla oleva seinä vaikuttaa heikolta. Ehkäpä se on tie ulos? Tai sitten se on huijaus jonka tarkoituksena on johtaa Pingut vääjäämättömään tuhoon.\n\nEdessä on vaarallinen matka, mutta tehtäväsi on selvittää miten johdat Pingut vapauteen taas kerran.",
        @"Splatterfest" = "Roiskua",
        @"Staircase Maintenance" = "Sisäänkäynti portaikkoon",
        @"Down Into The Cave" = "Alas luolaan",
        @"Round and Round" = "Ympäri ja ympäri",
