:pingus.po [
    lang = "ru",
    texts = [
        @"Object:" = "Объект:",
        @"Nothing selected" = "Ничего не выбрано",
        @"Bridge" = "Мост",
        @"Water" = "Вода",
        @"Lava" = "Лава",
        @"Remove" = "Удалить",
        @"Direction:" = "Направление:",
        @"Left" = "Влево",
        @"Misc" = "Разное",
        @"Right" = "Вправо",
        @"Z-Pos:" = "Высота (Z):",
        @"Color:" = "Цвет:",
        @"Small Stars:" = "Малые звёзды:",
        @"Middle Stars:" = "Средние звёзды:",
        @"Large Stars:" = "Большие звёзды:",
        @"Height:" = "Высота:",
        @"Group not supported" = "Группа не поддерживается",
        @"Object: " = "Объект: ",
        @"New level" = "Новый уровень",
        @"Open level..." = "Открыть уровень...",
        @"Save level..." = "Сохранить уровень...",
        @"Save level as..." = "Сохранить уровень как...",
        @"Play level..." = "Воспроизвести уровень...",
        @"Configure actions" = "Настроить действия",
        @"Configure level" = "Настроить уровень",
        @"Display object properties" = "Показывать свойства объекта",
        @"Show object insertion window" = "Показывать окно вставки объектов",
        @"Show minimap" = "Показывать мини-карту",
        @"Duplicate the selected objects" = "Дублировать выбранные объекты",
        @"Delete the selected objects" = "Удалить выбранные объекты",
        @"Raise object to top" = "Поднять объект на самый верх",
        @"Raise object" = "Поднять объект",
        @"Lower object" = "Опустить объект",
        @"Lower object to bottom" = "Опустить объект в самый низ",
        @"Flip object horizontally" = "Перевернуть объект по горизонтали",
        @"Flip object vertically" = "Перевернуть объект по вертикали",
        @"Rotate object -90 degree" = "Повернуть объект на -90°",
        @"Rotate object 90 degree" = "Повернуть объект на 90°",
        @"Display help" = "Показать справку",
        @"Exit" = "Выход",
        @"Datadir" = "Каталог данных",
        @"Userdir" = "Каталог пользователя",
        @"Open" = "Открыть",
        @"Save" = "Сохранить",
        @"Cancel" = "Отменить",
        @"Filename:" = "Имя файла:",
        @"Open a level" = "Открыть уровень",
        @"Save your level" = "Сохранить ваш уровень",
        @"== Editor Help ==" = "== Справка по редактору ==",
        @"Select all\nClear Selection\nRaise objects\nLower objects\nRaise objects to top\nLower objects to bottom\nRotate 90 degree\nRotate 270 degree\nGroup selected objects\nUngroup selected objects\n" = "Выделить все\nОчистить выделение\nПоднять объекты\nОпустить объекты\nПоднять на самый верх\nОпустить в самый низ\nПовернуть на 90°\nПовернуть на 270°\nСгруппировать выделенные объекты\nРазгруппировать выделенные объекты\n",
        @"Flip object horizontaly\nFlip object vertically\nDelete all marked objects\nMove objects by one pixel\nMove objects by 32 pixel\nToggle background color\nIncrease/lower repeat\n" = "Перевернуть по горизонтали\nПеревернуть по вертикали\nУдалить помеченные объекты\nПереместить на 1 пиксел\nПереместить на 32 пиксела\nПереключить цвет фона\nУскорить/замедлить повтор\n",
        @"You should name your level files systematically, i.e. by their theme, their number and your nickname:\n\n     <levelname><number>-<creator>.pingus\n\nSo if you create your second level with a stone theme, call it: stone2-yourname.pingus\n\nWhen you have created a level and want to have it included in the game mail it to:\n\n     pingus-devel@nongnu.org\n\nOnly levels published under the GPL are allowed into the game. The editor automatically inserts a reference \nto the GPL, if you want to have your level under a different license, you have to change that reference.\n" = "Именовать файлы уровней следует систематически, указывая их тему, номер и ваш псевдоним:\n\n     <название_уровня><номер>-<создатель>.pingus\n\nНапример, если вы создаёте второй уровень с темой stone, назовите его: stone2-ваше_имя.pingus\n\nЧтобы созданный вами уровень был включён в игру, отправьте его электронной почтой по адресу:\n\n     pingus-devel@nongnu.org\n\nВ игру включаются только уровни, опубликованные под GPL. Редактор автоматически вставляет\nссылку на GPL. Чтобы опубликовать уровень под другой лицензией, можете изменить эту ссылку.\n",
        @"Entrance" = "Вход",
        @"Groundpiece (ground)" = "Суша (земля)",
        @"Groundpiece (solid)" = "Суша (твёрдая)",
        @"Groundpiece (bridge)" = "Суша (мост)",
        @"Groundpiece (transparent)" = "Суша (прозрачная)",
        @"Groundpiece (remove)" = "Суша (удалить)",
        @"Hotspot" = "Горячая точка",
        @"Background" = "Фон",
        @"Liquid" = "Жидкость",
        @"Trap" = "Ловушка",
        @"Weather" = "Погода",
        @"Special Object" = "Спецобъект",
        @"Prefab Object" = "Заготовки объектов",
        @"Angel" = "Ангел",
        @"Boarder" = "Абордажник",
        @"Climber" = "Альпинист",
        @"Digger" = "Землекоп",
        @"Drown" = "Тонуть",
        @"Jumper" = "Прыгун",
        @"Miner" = "Шахтёр",
        @"Superman" = "Супермен",
        @"skip" = "пропустить",
        @"Time: " = "Время: ",
        @"Author: " = "Автор: ",
        @"Close" = "Закрыть",
        @"Mouse Grab" = "Захват мыши",
        @"Autoscrolling" = "Автопрокрутка",
        @"Drag&Drop Scrolling" = "Прокрутка перетаскиванием",
        @"Print FPS" = "Показывать FPS",
        @"Resolution:" = "Разрешение:",
        @"Language:" = "Язык:",
        @"Master Volume:" = "Общая громкость:",
        @"Sound Volume:" = "Громкость звуков:",
        @"Music Volume:" = "Громкость музыки:",
        @"Some options require a restart of the game to take effect." = "Для вступления в силу некоторых настроек требуется перезапустить игру.",
        @"Story" = "История",
        @"..:: Start the game ::.." = "..:: Начать игру ::..",
        @"Editor" = "Редактор",
        @"..:: Create your own levels ::.." = "..:: Создать ваши собственные уровни ::..",
        @"Options" = "Настройки",
        @"..:: Configure the game ::.." = "..:: Настроить игру ::..",
        @"Levelsets" = "Наборы уровней",
        @"..:: Play User Built levels ::.." = "..::Играть в созданные уровни::..",
        @"..:: Bye, bye ::.." = "..:: До свидания! ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: захват мыши   ::   F10: счётчик fps   ::   F11: во весь экран   ::   F12: снимок экрана ::..",
        @"Retry" = "Повторить",
        @"Success!" = "Успех!",
        @"Failure!" = "Неудача!",
        @"Perfect! You saved everyone possible - great!" = "Превосходно! Вы спасли всех, кого возможно — замечательно!",
        @"No-one got killed, pretty good work." = "Никто не погиб, очень хорошая работа.",
        @"Not everybody was saved, but still good work!" = "Спасены не все, но всё равно — хорошая работа!",
        @"What can I say, you made it - congratulations!" = "Что я могу сказать: вы сделали это — поздравляю!",
        @"You killed everybody, not good." = "Вы убили всех, это нехорошо.",
        @"No-one got saved - I know you can do better." = "Никто не спасся — я знаю, что вы можете лучше.",
        @"Better luck next time!" = "Удачи в следующий раз!",
        @"Saved: " = "Спаслись: ",
        @"Died: " = "Погибли: ",
        @"Time left: " = "Осталось времени: ",
        @"Solved:" = "Решено:",
        @"levels" = "уровни",
        @"Leave?" = "Выйти?",
        @"[OPTIONS]... [FILE]" = "[ОПЦИИ]... [ФАЙЛ]",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Pingus — головоломка, в которой нужно провести стаю маленьких пингвинов вокруг земного шара.",
        @"General Options:" = "Основные параметры:",
        @"Displays this help" = "Показать эту справку",
        @"Print version number and exit" = "Показать номер версии и выйти",
        @"Start in Window Mode" = "Запуск в оконном режиме",
        @"Start in Fullscreen" = "Запуск в полноэкранном режиме",
        @"Set the window resolution for pingus (default: 800x600)" = "Задать разрешение окна для pingus (по умолчанию: 800x600)",
        @"Set the resolution used in fullscreen mode (default: 800x600)" = "Задать разрешение для полноэкранного режима (по умолчанию: 800x600)",
        @"Game Options:" = "Параметры игры:",
        @"Disable automatic scrolling" = "Отключить автоматическую прокрутку",
        @"Sound Options:" = "Параметры звука:",
        @"Disable sound" = "Отключить звуки",
        @"Disable music" = "Отключить музыку",
        @"Select language to use with Pingus" = "Выберите язык для использования в Pingus",
        @"List all available languages" = "Список всех доступных языков",
        @"Loads the level editor" = "Загружает редактор уровней",
        @"Directory Options:" = "Параметры каталогов:",
        @"Don't read ~/.pingus/config" = "Не читать ~/.pingus/config",
        @"Debug Options:" = "Параметры отладки:",
        @"Set the game speed (0=fastest, >0=slower)" = "Задать скорость игры (0=самая быстрая, >0=медленнее)",
        @"Set the desired game framerate (frames per second)" = "Задать частоту кадров (кадры в секунду)",
        @"Pingus: Out of memory!" = "Pingus: не хватает памяти!",
        @"unlimited" = "без ограничений",
        @"Screenshot: Saving screenshot to: " = "Снимок экрана: сохранение снимка в: ",
        @"Screenshot: Screenshot is done." = "Снимок экрана: снимок сделан.",
        @"Screenshot: Couldn't write file: " = "Снимок экрана: не удалось записать файл: ",
        @"Sacrifice a few and save the rest" = "Пожертвуйте несколькими и спасите остальных",
        @"Sometimes no other actions are available, so you have to bomb your way through the ground. The Pingus can do this by actually self- destructing. This will kill them, but it is sometimes necessary to sacrifice a few to save the rest. " = "Иногда недоступны никакие другие действия, кроме как пробиться через землю с помощью бомб. Пингусы могут делать это весьма саморазрушительно. Это убьёт их, но иногда необходимо пожертвовать несколькими, чтобы спасти остальных. ",
        @"Learning to dig" = "Учимся копать",
        @"This is your first mission. As always, it's pretty easy. All you have to do is to give a Pingu the command to dig a hole into the ground so that they can reach the exit. This can be accomplished simply by clicking on a Pingu. " = "Это ваша первая миссия. Как всегда, она очень простая. Всё, что нужно сделать — это дать пингвину команду копать яму в земле, чтобы достичь выхода. Для этого просто щёлкните на пингвине. ",
        @"Float or Die" = "Лети или умри",
        @"Well done in mission one! Now let's start the next one. This time you will need to equip your Pingus with a little propeller, so that they can float to the ground smoothly. If Pingus fall too far, they will not be able to survive the fall, so keep your eyes open! " = "Миссия 1 успешно пройдена! Давайте начнём следующую. На этот раз нужно оснастить пингвина небольшим пропеллером, чтобы он мог плавно спуститься на землю. Если Пингус упадёт слишком далеко, он погибнет, так что будьте внимательны! ",
        @"Miner's heaven" = "Рай для шахтёра",
        @"Bridging gets more complicated..." = "Строительство мостов усложняется...",
        @"Once again you have to combine actions carefully and wisely. If you don't you could end up in the hole just before the exit, so think about how to avoid that. " = "И снова вам нужно осторожно и мудро комбинировать действия. Иначе вы можете оказаться в яме прямо перед выходом. Подумайте, как её избежать. ",
        @"Learn to use the bridge" = "Учимся использовать мост",
        @"Three solutions, it's up to you" = "Три решения — выбор за вами",
        @"Now that you've learned all the actions, it's time for some more practice. This level presents you with at least three different ways to solve it. It's up to you which one you pick. " = "Теперь, когда вы освоили все действия, самое время немного попрактиковаться. Этот уровень можно пройти как минимум тремя различными способами. Какой использовать — решать вам. ",
        @"Entering the pyramid" = "Вход в пирамиду",
        @"The window room" = "Комната с окном",
        @"After the Pingus have entered the pyramid, they reach a large room with a large window. The only problem they have is that the entrance to the room is much too high to survive the landing. Can you help them?" = "Войдя в пирамиду, Пингусы дошли до большой комнаты с большим окном. Единственная проблема: вход в комнату расположен слишком высоко, чтобы выжить при приземлении. Сможете ли вы помочь им?",
        @"Claustrophobia" = "Клаустрофобия",
        @"Hidden deep below the pyramid the pingus come across a small underground room, but unfortunatley a large tree root blocks their path..." = "Глубоко под пирамидой Пингусы собираются пройти маленькую поземную комнату, но корень огромного дерева закрывает им дорогу...",
        @"A bit to the right a bit to left" = "Шаг вправо, шаг влево",
        @"Only the most audacious Pingus will be allowed to continue." = "Только самые бесстрашные Пингусы смогут пройти.",
        @"Pingus Jones and the Last Exit" = "Пингус Джонс и последний выход",
        @"Dr. Jones' notebook:\n\n  (1) the breath of God: only the penitent pingus will pass;\n  (2) the word of God... in reverse;\n  (3) the path of God: leap from the head of something like a cat." = "Из записок доктора Джонса:\n\n  (1) дыхание Бога: только раскаявшийся Пингус может пройти;\n  (2) слово Бога... в обратном порядке;\n  (3) путь Бога: прыгнув с головы чего-то вроде кошки.",
        @"Experimentation" = "Эксперименты",
        @"A mad scientist has captured the penguins and is experimenting on them. How can the penguins escape the guillotine?" = "Сумасшедший учёный захватил пингвинов и проводит над ними эксперименты. Как пингвинам избежать гильотины?",
        @"Hall of Illusion" = "Зал иллюзий",
        @"Revenge is sweet" = "Месть сладка",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down." = "Пингвины убежали от сумасшедшего учёного, но теперь они жаждут мести. Они собираются уничтожить поддерживающие структуры, чтобы дьявольская лаборатория обрушилась.",
        @"The penguins had escaped the mad scientist but now they wanted revenge. They intended to destroy the support structures, sending the evil laboratory crashing down. They had to move fast though, because the mad scientist would detect and recapture them if they weren't fast enough." = "Пингвины убежали от сумасшедшего учёного, но теперь они жаждут мести. Они собираются уничтожить поддерживающие структуры, чтобы дьявольская лаборатория обрушилась. Это нужно сделать быстро, иначе сумасшедший учёный обнаружит и снова захватит их.",
        @"Shipwrecked" = "Кораблекрушение",
        @"Lost in Space" = "Затерянные в пространстве",
        @"We don't know where we are but we don't leave anybody behind." = "Мы не знаем, где мы, но мы не должны никого здесь оставить.",
        @"Going back home" = "Возвращение домой",
        @"Your mission is over. Pingus can go back home, but be careful!" = "Ваша миссия завершена. Пингусы могут возвращаться домой, но будьте осторожны!",
        @"Bonus track" = "Призовой уровень",
        @"Pingus are at home, but after the climate change living on the South Pole became more dangerous. There is one more mission for you." = "Пингусы дома, но климат меняется, и жить на Южном полюсе становится опаснее. Это ещё одна миссия для вас.",
        @"Falling down" = "Падение",
        @"Pingus intelligence reported that a huge factory located in the subtropical zone might be a reason of a climate change. They decided to go there and shut down the factories. This will be a long and dangerous expedition. Pingus and you will have to face many difficulties on your way. As the ice is melting, at first you have to build some bridges and watch out for the cliff." = "Разведка Пингусов сообщила, что причиной изменения климата может быть огромная фабрика, расположенная в субтропиках. Они решили пойти туда и закрыть фабрику. Это долгая и опасная экспедиция. Пингусам и вам придётся встретиться со множеством трудностей на своём пути. Лёд тает, поэтому сначала нужно построить несколько мостов. Опасайтесь скалы.",
        @"Destination North" = "Назначение — север",
        @"For now, Pingus are leaving South Pole and moving North. You have to help them!" = "Пингусы покинули Южный полюс и двигаются на север. Вы должны помочь им!",
        @"Four ways out" = "Четыре пути наружу",
        @"It's getting warmer but Pingus are bravely moving North. This time it will be much easier. There are at least four ways out. Could you find them?" = "Становится теплее, но Пингусы смело идут на север. На этот раз будет намного проще. Существует по крайней мере четыре пути наружу. Сможете найти их?",
        @"Egypt - So easy" = "Египет — так просто!",
        @"Pingus reached Egypt. Looks easy, but is it really so easy? Try it out." = "Пингусы дошли до Египта. Выглядит просто, но так ли это на самом деле? Попробуйте.",
        @"Egypt - Oasis" = "Египет — оазис",
        @"Last time it was easy. Now it will be a little bit harder. Pingus are entering oasis. Watch out for the water." = "В прошлый раз было просто, теперь будет немного сложнее. Пингусы входят в оазис. Остерегайтесь воды!",
        @"Egypt - The Maze" = "Египет — лабиринт",
        @"You came across a maze. Can you find the way out? Think twice before digging." = "Вы в лабиринте. Сможете ли вы найти выход? Подумайте дважды, прежде чем копать.",
        @"Egypt - Pyramids" = "Египет — пирамиды",
        @"The maze led you to the big pyramids. Now you have 4 minutes to escape. Hurry up!" = "Лабиринт привёл вас к большим пирамидам. У вас 4 минуты, чтобы выйти отсюда. Торопитесь!",
        @"Ice Block Blockage" = "Ледяное препятствие",
        @"What's this? A gigantic ice block straight in the path? Where did that come from? No time wondering about things like that. The Pingus need to get to the exit and it's your job to find a way around the block." = "Что это? Гигантская глыба льда прямо на пути? Откуда она взялась? Но размышлять об этом нет времени. Пингусам нужно дойти до выхода, и ваша задача — найти путь в обход глыбы.",
        @"The Impossible Bridge" = "Невероятный мост",
        @"Two groups of Pingus separated by a deep byss, joining them by a bridge seems impossible, but wise coordination of the two groups and a brave leap should let you make it to the exit." = "Две группы Пингусов разделены глубокой пропастью. Кажется, что построить мост невозможно, но мудрая координация двух групп и отважный прыжок должны помочь им дойти до выхода.",
        @"Tutorial Island" = "Учебный остров",
        @"Watch Ending" = "Показать окончание",
        @"Watch Intro" = "Показать вступление",
        @"The Journey Begins" = "Путешествие начинается",
        @"For a long time, the Pingus have lived happily in peace on the South Pole along with all the other animals. Everything was in balance and it seemed like nothing could disrupt their peace.  The Pingus were happy and it seemed like this could never end." = "Долгое время Пингусы, вместе с другими животными, мирно и счастливо жили на Южном полюсе. Всё вокруг было в равновесии и, казалось, ничто не может нарушить их мирную жизнь. Пингусы были счастливы и думали, что это никогда не закончится.",
        @"But then one day, things began to change slowly: the sky got darker and the earth got warmer. Firstly, they thought this was just a normal fluctuation in the world's climate, but things seemed to get worse and worse with every year." = "Но однажды всё начало медленно изменяться: небо стало темнее, а земля — теплее. Сначала они думали, что это обычные колебания мирового климата, но с каждым годом становилось всё хуже и хуже.",
        @"The snow began to melt away in a few areas and food became an issue. Other animals tried to leave the region to search for colder areas, but the Pingus knew that this wouldn't help: they knew that they had to do something about it." = "Снег в нескольких областях начал таять и добывать пищу стало проблемой. Другие животные попытались покинуть дом в поиске более холодных областей, но Пингусы знали, что это не поможет: им придётся что-то делать.",
        @"So the circle of the eldest came together to decide what to do about it. They decided to send out an expedition around the world to find the cause of this warming. The expedition consisted of hundreds of the bravest Pingus on the South Pole." = "Был собран круг старейшин, чтобы решить, что следует предпринять. Они решили отправить экспедицию вокруг земного шара, чтобы найти причину потепления. Экспедиция состояла из сотен самых смелых Пингусов на Южном полюсе.",
        @"And they picked you to lead them on their journey around the world. Since the journey will be dangerous and difficult, your first goal is the Island of Mogorok, also known as the Tutorial Island. According to the eldest, this island has always been the first stop of Pingus that were sent out into the world." = "И они выбрали вас своим лидером в путешествии вокруг Земли. Поскольку путешествие будет опасным и трудным, ваша первая цель — остров Могорок, известный также под названием «Учебный остров». По словам старейшин, этот остров всегда был первой остановкой для Пингусов, отправляющихся в странствия.",
        @"Now that you and the Pingus have arrived at Tutorial Island it is time to take command and begin your mission.\n\nGood Luck!" = "Теперь, когда вы с Пингусами прибыли на Учебный остров, для вас пришло время взять командование в свои руки и начать вашу миссию.\n\nУдачи!",
        @"The Journey Continues" = "Путешествие продолжается",
        @"But as the eldest have said, the Tutorial Island provides not only a good way to practice, but it is also the starting point into the world. After some searching the Pingus discovered the meaning of this, and they found the large tree at the end of the island which gave them wood to construct a float." = "Но, как говорят старейшины, Учебный остров — не только хорошее место для тренировки, но ещё и отправная точка во внешний мир. После недолгих поисков Пингусы поняли значение их слов и нашли на краю острова большое дерево, из древесины которого можно изготовить плот.",
        @"So the Pingus set out and constructed some large rafts, enough to carry them all. After also packing a bunch of provisions they were prepared to start their journey and leave their familiar ground and enter the unknown parts of the world." = "Пингусы изготовили несколько больших плотов, способных уместить их всех. Они запаслись провизией и готовы начать путешествие, покинуть родную землю и вступить в незнакомые области мира.",
        @"Desert" = "Пустыня",
        @"Getting hot outside..." = "Снаружи становится жарко...",
        @"Halloween 2011" = "Хэллоуин 2011",
        @"Going Underground" = "Спускаемся под землю",
        @"Halloween 2007" = "Хэллоуин 2007",
        @"Trapped at All Hallows Eve" = "В ловушке в канун Дня всех святых",
        @"Hellmouth" = "Адская пасть",
        @"A cave full of slime..." = "Пещера, полная слизи...",
        @"Jungle" = "Джунгли",
        @"Xmas 2011" = "Рождество 2011",
        @"Merry Christmas and a Happy New Year" = "Весёлого рождества и счастливого Нового года!",
    ],
]
