:pingus.po [
    lang = "bg",
    texts = [
        @"Exit" = "Излез",
        @"Released:%3d/%d   Out:%3d   Saved:%3d/%d" = "Пуснати:%3d от %d Вън:%3d Спасени:%3d/%d",
        @"Angel" = "Ангел",
        @"Number of Pingus: " = "Брой пингута: ",
        @"Number to Save: " = "Трябва да бъдат спасени: ",
        @"Time: " = "Време: ",
        @"Author: " = "Автор: ",
        @"Close" = "Затвори",
        @"Resolution:" = "Разредителна способност:",
        @"Language:" = "Език:",
        @"Master Volume:" = "Ниво на звука:",
        @"Sound Volume:" = "Сила на звуците:",
        @"Music Volume:" = "Сила на музиката:",
        @"Option Menu" = "Настройки",
        @"Story" = "История",
        @"..:: Start the game ::.." = "..:: Започни играта ::..",
        @"Editor" = "Редактор",
        @"..:: Create your own levels ::.." = "..:: Построете Ваши си нива ::..",
        @"..:: Play User Built levels ::.." = "..:: Играй потребителски нива ::..",
        @"..:: Bye, bye ::.." = "..:: Чао, чао ::..",
        @"..:: Ctrl-g: mouse grab   ::   F10: fps counter   ::   F11: fullscreen   ::   F12: screenshot ::.." = "..:: Ctrl-g: дръж мишката в игровия прозорец   ::   F10: кадри в секунда   ::   F11: на пълен екран   ::   F12: снимай ::..",
        @"Retry" = "Опитай пак",
        @"Success!" = "Успех!",
        @"Failure!" = "Провал!",
        @"Perfect! You saved everyone possible - great!" = "Отлично! Спасихте всички, които можеха да бъдат спасени!",
        @"No-one got killed, pretty good work." = "Добра работа, всичко мина без жертви.",
        @"You saved exactly what you needed - you made it, but\nmaybe you can do better?" = "Спасихте точно колкото Ви трябваха. \nА може би можете и по-добре?",
        @"Not everybody was saved, but still good work!" = "Не спасихте всички, но добра работа, все пак.",
        @"What can I say, you made it - congratulations!" = "Какво да кажа, успяхте. Честито!",
        @"You killed everybody, not good." = "Лошо, убихте всички.",
        @"No-one got saved - I know you can do better." = "Оцелели няма. Знам, че можете да се справите и по-добре.",
        @"You didn't save enough, but you saved a few.  Next\ntime you might do better." = "Не спасихте колкото трябва, но все пак\nима оцелели. Следващия път може да се\nсправите по-добре.",
        @"Only one more and you would have made it - try again!" = "Само един още да бяхте спасили и щяхте да сте се справили. Опитайте пак!",
        @"Only a handful more and you would have made it - try again!" = "Да бяхте спасили още няколко и щяхте да сте се справили. Пробвайте отново!",
        @"Better luck next time!" = "Късмет другия път!",
        @"Saved: " = "Спасени: ",
        @"Died: " = "Загинали: ",
        @"Time left: " = "Оставащо време: ",
        @"levels" = "нива",
        @"Pingus is a puzzle game where you need to guide a bunch of little penguins around the world." = "Пингус е логическа игра, в която вашата задача е да напътствате отряд пингвинчета из целия свят.",
        @"Displays this help" = "Показва това упътване",
        @"unlimited" = "без ограничение",
    ],
]
