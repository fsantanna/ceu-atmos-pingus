;; Pingus in Atmos.
;;
;;      ./run.sh                    the menu
;;      ./run.sh main.atm FILE      a level (.pingus.atm), a worldmap
;;                                  (.worldmap.atm), a story (.story.atm),
;;                                  or a levelset (.levelset.atm)
;;
;; The main is a sequence of screens: each screen is a task, and what
;; it returns selects the next one.
;;
;; The options are global: F5, or the button of the menu, pause the
;; screens (a `toggle` block) and show the options over them. The
;; overlay (the cursor of the game, the frames per second) is the last
;; branch, so that it draws over all the others.

include "engine/engine.atm"
include "game/game.atm"
include "screens/common.atm"
include "screens/start.atm"
include "screens/result.atm"
include "screens/menu.atm"
include "screens/story.atm"
include "screens/credits.atm"
include "screens/levels.atm"
include "screens/worldmap.atm"
include "screens/options.atm"

if pg.testing() {
    math.randomseed(0)
} else {
    math.randomseed(os.time())
}

func ends (s, suffix) {
    (#s >= #suffix) && (string.sub(s, #s - #suffix) == suffix)
}

val args = [...]
val file = args@0

par :any {
    toggle on :screens {
        ifs {
            file == nil => {
                loop {
                    val opt = await Menu()
                    match opt {
                        :story     => await Worldmap("data/worldmaps/tutorial.worldmap.atm")
                        :credits   => await Credits()
                        :levelsets => await LevelsetsMenu()
                        :exit      => break
                    }
                }
            }
            ends(file, ".worldmap.atm") => await Worldmap(file)
            ends(file, ".story.atm")    => await Story(file)
            ends(file, ".levelset.atm") => do {
                val ls = data_load(file)
                set ls.paths = []
                loop _, l in ls.levels {
                    vector.insert(ls.paths, "data/levels/" ++ l.filename ++ ".pingus.atm")
                }
                loop {
                    val j = await Levels(ls)
                    until j == nil
                    await Play(ls.paths@j)
                }
            }
            else => do {
                val r = await Play(file)
                if r {
                    print(string.format("saved %d/%d, killed %d, needed %d: %s", r.saved,
                        r.total, r.killed, r.needed, if r.saved >= r.needed => "solved" => "failed"))
                }
            }
        }
    }
} with {
    loop {
        await <:go.options || :sdl.key.dn [name="F5"]>
        emit :screens [false]
        await Options()
        emit :screens [true]
    }
} with {
    ;; on top of all the screens: the cursor of the game, the frames
    await Overlay()
} with {
    await :sdl.quit
}
