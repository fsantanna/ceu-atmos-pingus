;; Levelsets and levels: two lists on the blackboard, with pages that
;; scroll with the arrows.

;; List(items, per, height, title, draw, can, marker): a list of
;; `items`, `per` at a time, each drawn by `draw(item, i, r)`, over the
;; image `marker` while the mouse is over it, if `can(item, i)`. Returns
;; the index of the clicked item, or nil to go back.
;;
;; The first visible item is the data of the view: it is changed by the
;; arrows, and each change restarts the visible items.
task List (items, per, height, title, draw, can, marker) {
    spawn Board()
    spawn Label("Back", BACK_R.x + (BACK_R.w//2), BACK_R.y)
    spawn {
        loop on :sdl.draw {
            text(FONT.chalk_large, title, BOARD.x + (BOARD.w//2), BOARD.y + 40, :center)
        }
    }
    val uw, uh = res_frame_size("core/menu/arrow_up")
    val up = [x=BOARD.x + BOARD.w - 35 - uw, y=BOARD.y + (BOARD.h//2) - 10 - uh, w=uw, h=uh]
    val dn = [x=up.x, y=BOARD.y + (BOARD.h//2) + 10, w=uw, h=uh]
    var top = 0
    par :any {
        await Back()
        nil
    } with {
        await Key("Escape")
        nil
    } with {
        loop {
            val e = par :any {
                ;; the visible items
                pin vis = tasks()
                loop i in (top, math.min(#items, top + per) - 1) {
                    val r = [x=BOARD.x + 44, y=BOARD.y + 155 - (height//2) + ((i - top) * height),
                             w=680 - 90, h=height - 1]
                    spawn @vis Item(items@i, i, r, draw, can, marker)
                }
                await :any vis
            } with {
                await Button(up, "core/menu/arrow_up", "core/menu/arrow_up_hover", "core/menu/arrow_up_pressed")
                :up
            } with {
                await Button(dn, "core/menu/arrow_down", "core/menu/arrow_down_hover", "core/menu/arrow_down_pressed")
                :down
            }
            match e {
                :up   => set top = math.max(0, top - 1)
                :down => set top = math.max(0, math.min(#items - per, top + 1))
                else  => break e
            }
        }
    }
}

;; Item: an item of a list, with the marker while the mouse is over it.
;; Terminates with its index when clicked, if it can be chosen.
task Item (it_, i, r, draw, can, marker) {
    val ok = !can || can(it_, i)
    val _, mh = pg.size(marker)
    spawn {
        ;; the marker, under the item, while the mouse is over it
        val over = \(x, y) { inside(r, x, y) }
        if !over(MOUSE.x, MOUSE.y) {
            await :sdl.mouse.motion until over(it.x, it.y)
        }
        loop {
            sound "tick"
            watching :sdl.mouse.motion until !over(it.x, it.y) {
                loop on :sdl.draw {
                    if ok {
                        pg.draw(marker, r.x, r.y + (r.h//2) - (mh//2))
                    }
                }
            }
            await :sdl.mouse.motion until over(it.x, it.y)
        }
    }
    spawn {
        loop on :sdl.draw {
            draw(it_, i, r)
        }
    }
    loop {
        await Click(r)
        until ok
    }
    i
}

;; The levelsets, with the levels that the game supports.
func levelsets () {
    val out = []
    loop f in io.lines("data/levelsets/index.txt") {
        val ls = data_load("data/levelsets/" ++ f)
        if !ls.developer_only {
            val lv = []
            loop _, l in ls.levels {
                val path = "data/levels/" ++ l.filename ++ ".pingus.atm"
                if LEVELS_OK@(path) {
                    vector.insert(lv, path)
                }
            }
            if #lv > 0 {
                set ls.paths = lv
                vector.insert(out, ls)
            }
        }
    }
    vector.sort(out, \(a, b) { (a.priority || 0) > (b.priority || 0) })
    out
}

func levelset_solved (ls) {
    var n = 0
    loop _, p in ls.paths {
        if level_solved(p) {
            set n += 1
        }
    }
    (n * 100) // #ls.paths
}

;; A level is open if it is the first, the previous one is solved, or
;; the levelset is not locked.
func level_open (ls, i) {
    (i == 0) || (ls.locked == false) || level_solved(ls.paths@(i - 1))
}

task Levelsets () {
    val sets = levelsets()
    await List(sets, 4, 95, "Levelsets", \(ls, i, r) {
        pg.draw(res_surface(ls.image), r.x + 25, r.y)
        text(FONT.chalk_normal, ls.title, r.x + 105, r.y + 15)
        text(FONT.chalk_small, ls.description, r.x + 105, r.y + 40)
        text(FONT.chalk_normal, "Solved: " ++ levelset_solved(ls) ++ "%", r.x + r.w - 25, r.y + 15, :right)
        text(FONT.chalk_normal, #ls.paths ++ " levels", r.x + r.w - 25, r.y + 40, :right)
    }, nil, res_surface("core/menu/marker"))
}

task Levels (ls) {
    val heads = []
    loop _, p in ls.paths {
        vector.insert(heads, [path=p, name=level_load(p).head.levelname])
    }
    val locked = res_surface("core/menu/locked_small")
    val solved = res_surface("core/menu/checkbox_marked_small")
    val open = res_surface("core/menu/checkbox_small")
    await List(heads, 10, 32, ls.title, \(l, i, r) {
        val ok = level_open(ls, i)
        pg.draw(if !ok => locked => (if level_solved(l.path) => solved => open), r.x + 10, r.y)
        text(FONT.chalk_normal, l.name, r.x + 40, r.y + 4)
    }, \(l, i) { level_open(ls, i) }, res_surface("core/menu/marker2"))
}

;; LevelsetsMenu(): the levelsets, their levels, and playing them.
task LevelsetsMenu () {
    loop {
        val i = await Levelsets()
        until i == nil
        val ls = levelsets()@i
        loop {
            val j = await Levels(ls)
            until j == nil
            await Play(ls.paths@j)
        }
    }
}
